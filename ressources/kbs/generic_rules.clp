  (interaction
    (title "IMAO IRRÉVERSIBLES + TRIPTANS NON MÉTABOLISÉS PAR LA MAO")
    (level "Association DECONSEILLEE")
    (drugs-a "iproniazide" "phenelzine")
    (drugs-b "eletriptan" "frovatriptan" "naratriptan")
    (alert "Interaction IMAO IRRÉVERSIBLES + TRIPTANS NON MÉTABOLISÉS PAR LA MAO (Association DECONSEILLEE) : Risque d'hypertension artérielle, de vasoconstriction artérielle coronaire."))
  (interaction
    (title "IMAO-A RÉVERSIBLES, Y COMPRIS OXAZOLIDINONES ET BLEU DE MÉTHYLÈNE + IMAO-B")
    (level "CONTRE-INDICATION")
    (drugs-a "bleu de methylene" "linezolide" "moclobemide" "tedizolide")
    (drugs-b "rasagiline" "safinamide" "selegiline")
    (alert "Interaction IMAO-A RÉVERSIBLES, Y COMPRIS OXAZOLIDINONES ET BLEU DE MÉTHYLÈNE + IMAO-B (CONTRE-INDICATION) : Risque de poussée hypertensive, par absence de sélectivité sur la monoamine oxydase, notamment en cas d’alimentation riche en tyramine (fromage, bière,…)."))
  (interaction
    (title "IMAO-A RÉVERSIBLES, Y COMPRIS OXAZOLIDINONES ET BLEU DE MÉTHYLÈNE + INHIBITEURS SÉLECTIFS DE LA RECAPTURE DE LA SÉROTONINE")
    (level "Association DECONSEILLEE")
    (drugs-a "bleu de methylene" "linezolide" "moclobemide" "tedizolide")
    (drugs-b "citalopram" "dapoxetine" "escitalopram" "fluoxetine" "fluvoxamine" "paroxetine" "sertraline" "vortioxetine")
    (alert "Interaction IMAO-A RÉVERSIBLES, Y COMPRIS OXAZOLIDINONES ET BLEU DE MÉTHYLÈNE + INHIBITEURS SÉLECTIFS DE LA RECAPTURE DE LA SÉROTONINE (Association DECONSEILLEE) : Risque d'apparition d'un syndrome sérotoninergique : diarrhée, tachycardie, sueurs, tremblements, confusion voire coma. Conduite à tenir : Si l'association ne peut être évitée, surveillance clinique très étroite. Débuter l'association aux posologies minimales recommandées."))
  (interaction
    (title "IMAO-A RÉVERSIBLES, Y COMPRIS OXAZOLIDINONES ET BLEU DE MÉTHYLÈNE + MÉDICAMENTS MIXTES ADRÉNERGIQUES-SÉROTONINERGIQUES")
    (level "Association DECONSEILLEE")
    (drugs-a "bleu de methylene" "linezolide" "moclobemide" "tedizolide")
    (drugs-b "amitriptyline" "clomipramine" "duloxetine" "imipramine" "milnacipran" "oxitriptan" "venlafaxine")
    (alert "Interaction IMAO-A RÉVERSIBLES, Y COMPRIS OXAZOLIDINONES ET BLEU DE MÉTHYLÈNE + MÉDICAMENTS MIXTES ADRÉNERGIQUES-SÉROTONINERGIQUES (Association DECONSEILLEE) : Risque d'apparition d'un syndrome sérotoninergique : diarrhée, tachycardie, sueur, confusion voire coma. Conduite à tenir : Si l'association ne peut être évitée, surveillance clinique très étroite. Débuter l'association aux posologies minimales recommandées."))
  (interaction
    (title "IMAO-A RÉVERSIBLES, Y COMPRIS OXAZOLIDINONES ET BLEU DE MÉTHYLÈNE + MILLEPERTUIS")
