  (interaction
    (title "MILLEPERTUIS + PACLITAXEL")
    (level "CONTRE-INDICATION")
    (drugs-a "millepertuis")
    (drugs-b "paclitaxel")
    (alert "Interaction MILLEPERTUIS + PACLITAXEL (CONTRE-INDICATION) : Risque de moindre efficacité du taxane par augmentation de son métabolisme par le millepertuis."))
  (interaction
    (title "MILLEPERTUIS + PROGESTATIFS CONTRACEPTIFS")
    (level "CONTRE-INDICATION")
    (drugs-a "millepertuis")
    (drugs-b "desogestrel" "dienogest" "drospirenone" "etonogestrel" "levonorgestrel" "medroxyprogesterone" "nomegestrol" "norelgestromine" "norethisterone" "norgestimate")
    (alert "Interaction MILLEPERTUIS + PROGESTATIFS CONTRACEPTIFS (CONTRE-INDICATION) : Diminution des concentrations plasmatiques du contraceptif hormonal, en raison de l'effet inducteur enzymatique du millepertuis, avec risque de baisse d'efficacité voire d'annulation de l'effet dont les conséquences peuvent être éventuellement graves (survenue d'une grossesse)."))
  (interaction
    (title "MILLEPERTUIS + PROPAFENONE")
