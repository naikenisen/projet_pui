  (interaction
    (title "INDUCTEURS ENZYMATIQUES PUISSANTS + TIAGABINE")
    (level "Précaution d'emploi")
    (drugs-a "apalutamide" "carbamazepine" "enzalutamide" "fosphenytoine" "phenobarbital" "phenytoine" "primidone")
    (drugs-b "tiagabine")
    (alert "Interaction INDUCTEURS ENZYMATIQUES PUISSANTS + TIAGABINE (Précaution d'emploi) : Diminution des concentrations plasmatiques de la tiagabine par augmentation de son métabolisme hépatique par l'inducteur. Conduite à tenir : Une augmentation de la posologie de tiagabine peut s'avérer nécessaire en cas d'association à un anticonvulsivant inducteur enzymatique."))
  (interaction
    (title "INDUCTEURS ENZYMATIQUES PUISSANTS + TICAGRELOR")
    (level "Association DECONSEILLEE")
    (drugs-a "apalutamide" "carbamazepine" "enzalutamide" "fosphenytoine" "phenobarbital" "phenytoine" "primidone")
    (drugs-b "ticagrelor")
    (alert "Interaction INDUCTEURS ENZYMATIQUES PUISSANTS + TICAGRELOR (Association DECONSEILLEE) : Diminution importante des concentrations plasmatiques de ticagrelor par augmentation de son métabolisme hépatique par l'inducteur enzymatique, avec risque de diminution de l’effet thérapeutique."))
  (interaction
    (title "INDUCTEURS ENZYMATIQUES PUISSANTS + ULIPRISTAL")
    (level "Association DECONSEILLEE")
    (drugs-a "apalutamide" "carbamazepine" "enzalutamide" "fosphenytoine" "phenobarbital" "phenytoine" "primidone")
    (drugs-b "ulipristal")
    (alert "Interaction INDUCTEURS ENZYMATIQUES PUISSANTS + ULIPRISTAL (Association DECONSEILLEE) : Risque de diminution de l’effet de l’ulipristal, par augmentation de son métabolisme hépatique par l’inducteur. Conduite à tenir : Préférer une alternative thérapeutique peu ou pas métabolisée."))
  (interaction
    (title "INDUCTEURS ENZYMATIQUES PUISSANTS + VELPATASVIR")
    (level "CONTRE-INDICATION")
