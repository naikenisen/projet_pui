    (drugs-b "nintedanib")
    (alert "Interaction MILLEPERTUIS + NINTÉDANIB (Association DECONSEILLEE) : Diminution des concentrations plasmatiques du nintédanib par diminution de son absorption par le millepertuis."))
  (interaction
    (title "MILLEPERTUIS + OLAPARIB")
    (level "CONTRE-INDICATION")
    (drugs-a "millepertuis")
    (drugs-b "olaparib")
    (alert "Interaction MILLEPERTUIS + OLAPARIB (CONTRE-INDICATION) : Risque de diminution des concentrations plasmatiques d’olaparib et de son efficacité, par augmentation de son métabolisme par le millepertuis."))
  (interaction
    (title "MILLEPERTUIS + OXYCODONE")
