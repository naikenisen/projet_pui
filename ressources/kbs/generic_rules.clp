    (level "Précaution d'emploi")
    (drugs-a "nintedanib")
    (drugs-b "verapamil")
    (alert "Interaction NINTÉDANIB + VERAPAMIL (Précaution d'emploi) : Augmentation des concentrations plasmatiques du nintédanib par augmentation de son absorption par le vérapamil. Conduite à tenir : Surveillance clinique pendant l’association."))
  (interaction
