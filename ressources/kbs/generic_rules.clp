    (drugs-b "ranolazine")
    (alert "Interaction INDUCTEURS ENZYMATIQUES PUISSANTS + RANOLAZINE (Association DECONSEILLEE) : Risque de diminution importante des concentrations de ranolazine."))
  (interaction
    (title "INDUCTEURS ENZYMATIQUES PUISSANTS + RIVAROXABAN")
    (level "Association DECONSEILLEE")
    (drugs-a "apalutamide" "carbamazepine" "enzalutamide" "fosphenytoine" "phenobarbital" "phenytoine" "primidone")
    (drugs-b "rivaroxaban")
    (alert "Interaction INDUCTEURS ENZYMATIQUES PUISSANTS + RIVAROXABAN (Association DECONSEILLEE) : Diminution des concentrations plasmatiques de rivaroxaban, avec risque de diminution de l'effet thérapeutique."))
  (interaction
    (title "INDUCTEURS ENZYMATIQUES PUISSANTS + SOTORASIB")
    (level "Association DECONSEILLEE")
    (drugs-a "apalutamide" "carbamazepine" "enzalutamide" "fosphenytoine" "phenobarbital" "phenytoine" "primidone")
    (drugs-b "sotorasib")
    (alert "Interaction INDUCTEURS ENZYMATIQUES PUISSANTS + SOTORASIB (Association DECONSEILLEE) : Diminution notable des concentrations plasmatiques du sotorasib, avec risque de moindre efficacité."))
  (interaction
    (title "INDUCTEURS ENZYMATIQUES PUISSANTS + STIRIPENTOL")
    (level "Précaution d'emploi")
    (drugs-a "apalutamide" "carbamazepine" "enzalutamide" "fosphenytoine" "phenobarbital" "phenytoine" "primidone")
    (drugs-b "stiripentol")
    (alert "Interaction INDUCTEURS ENZYMATIQUES PUISSANTS + STIRIPENTOL (Précaution d'emploi) : Augmentation des concentrations plasmatiques de l'inducteur, avec risque de surdosage, par inhibition de son métabolisme hépatique par le stiripentol. Conduite à tenir : Surveillance clinique et dosage plasmatique, lorsque cela est possible, de l'inducteur associé au stiripentol et adaptation éventuelle de sa posologie."))
  (interaction
    (title "INDUCTEURS ENZYMATIQUES PUISSANTS + TELITHROMYCINE")
