  (interaction
    (title "OMBITASVIR + PARITAPRÉVIR + SIROLIMUS")
    (level "Association DECONSEILLEE")
    (drugs-a "ombitasvir" "paritaprevir")
    (drugs-b "sirolimus")
    (alert "Interaction OMBITASVIR + PARITAPRÉVIR + SIROLIMUS (Association DECONSEILLEE) : En association avec le ritonavir : augmentation significative des concentrations de l’immunosuppresseur avec risque de majoration de sa toxicité par la bithérapie. Conduite à tenir : Si l’association s’avère nécessaire, contrôle strict de la fonction rénale, dosage des concentrations sanguines de l'immunosuppresseur et adaptation éventuelle de la posologie."))
  (interaction
    (title "OMBITASVIR + PARITAPRÉVIR + TACROLIMUS")
    (level "Association DECONSEILLEE")
    (drugs-a "ombitasvir" "paritaprevir")
    (drugs-b "tacrolimus")
    (alert "Interaction OMBITASVIR + PARITAPRÉVIR + TACROLIMUS (Association DECONSEILLEE) : En association avec le ritonavir : augmentation significative des concentrations de l’immunosuppresseur avec risque de majoration de sa toxicité par la bithérapie. Conduite à tenir : Si l’association s’avère nécessaire, contrôle strict de la fonction rénale, dosage des concentrations sanguines de l'immunosuppresseur et adaptation éventuelle de la posologie."))
  (interaction
