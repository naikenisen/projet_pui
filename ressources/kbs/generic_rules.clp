  (interaction
    (title "MILLEPERTUIS + QUETIAPINE")
    (level "Association DECONSEILLEE")
    (drugs-a "millepertuis")
    (drugs-b "quetiapine")
    (alert "Interaction MILLEPERTUIS + QUETIAPINE (Association DECONSEILLEE) : Diminution très importante des concentrations plasmatiques de quétiapine par augmentation de son métabolisme hépatique par l'inducteur, avec risque d’inefficacité."))
  (interaction
    (title "MILLEPERTUIS + RÉGORAFÉNIB")
    (level "Association DECONSEILLEE")
