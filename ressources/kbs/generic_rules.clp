  (interaction
    (title "BOSENTAN + RIFAMPICINE")
    (level "Association DECONSEILLEE")
    (drugs-a "bosentan")
    (drugs-b "rifampicine")
    (alert "Interaction BOSENTAN + RIFAMPICINE (Association DECONSEILLEE) : Risque de diminution, importante pour la rifampicine, des concentrations plasmatiques de bosentan."))
