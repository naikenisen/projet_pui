  (interaction
    (title "ALCALINISANTS URINAIRES + HYDROQUINIDINE")
    (level "Précaution d'emploi")
    (drugs-a "acetazolamide" "bicarbonate de sodium" "sodium bicarbonate" "trometamol")
    (drugs-b "hydroquinidine")
