    (drugs-a "ozanimod")
    (drugs-b "rifampicine")
    (alert "Interaction OZANIMOD + RIFAMPICINE (Association DECONSEILLEE) : Diminution des concentrations des métabolites actifs de l’ozanimod d’environ 60%."))
  (interaction
    (title "PACLITAXEL + TRIMETHOPRIME")
    (level "Précaution d'emploi")
