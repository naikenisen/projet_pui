; Règles génériques : interactions médicamenteuses du Thésaurus ANSM et de DDI-Predictor.
; Chaque fait interaction est lu par la règle drug-interaction de base.clp.
; Fichier non modifiable depuis l'interface.

; Thésaurus ANSM des interactions médicamenteuses (septembre 2023)
(deffacts ansm-thesaurus
  (interaction
    (title "ABATACEPT + ANTI-TNF ALPHA")
    (level "Association DECONSEILLEE")
    (drugs-a "abatacept")
    (drugs-b "adalimumab" "certolizumab" "etanercept" "golimumab" "infliximab")
    (alert "Interaction ABATACEPT + ANTI-TNF ALPHA (Association DECONSEILLEE) : Majoration de l’immunodépression."))
  (interaction
    (title "ABATACEPT + VACCINS VIVANTS ATTÉNUÉS")
    (level "Association DECONSEILLEE")
    (drugs-a "abatacept")
    (drugs-b "bcg" "rotavirus" "virus de la fievre jaune" "virus de la rougeole" "virus des oreillons" "virus rubeoleux" "virus varicelle-zona" "virus vivant attenue de la grippe")
    (alert "Interaction ABATACEPT + VACCINS VIVANTS ATTÉNUÉS (Association DECONSEILLEE) : Risque de maladie vaccinale généralisée, éventuellement mortelle. Conduite à tenir : ainsi que pendant les 3 mois suivant l'arrêt du traitement."))
  (interaction
    (title "ABIRATERONE + INDUCTEURS ENZYMATIQUES PUISSANTS")
    (level "Association DECONSEILLEE")
    (drugs-a "abiraterone")
    (drugs-b "apalutamide" "carbamazepine" "enzalutamide" "fosphenytoine" "phenobarbital" "phenytoine" "primidone")
    (alert "Interaction ABIRATERONE + INDUCTEURS ENZYMATIQUES PUISSANTS (Association DECONSEILLEE) : Diminution notable des concentrations plasmatiques de l’abiratérone, avec risque de moindre efficacité."))
  (interaction
    (title "ABIRATERONE + METOPROLOL")
    (level "Précaution d'emploi")
    (drugs-a "abiraterone")
    (drugs-b "metoprolol")
    (alert "Interaction ABIRATERONE + METOPROLOL (Précaution d'emploi) : Chez l'insuffisant cardiaque, risque d'augmentation des effets indésirables du métoprolol, par diminution de son métabolisme hépatique par l'abiratérone. Conduite à tenir : Surveillance clinique. Si besoin, adaptation de la posologie du métoprolol pendant le traitement par l'abiratérone."))
  (interaction
    (title "ABIRATERONE + PROPAFENONE")
    (level "Précaution d'emploi")
    (drugs-a "abiraterone")
    (drugs-b "propafenone")
    (alert "Interaction ABIRATERONE + PROPAFENONE (Précaution d'emploi) : Risque d'augmentation des effets indésirables de la propafénone, par diminution de son métabolisme hépatique par l'abiratérone. Conduite à tenir : Surveillance clinique. Si besoin, adaptation de la posologie de la propafénone pendant le traitement par l'abiratérone."))
  (interaction
    (title "ABIRATERONE + RIFAMPICINE")
    (level "Association DECONSEILLEE")
    (drugs-a "abiraterone")
    (drugs-b "rifampicine")
    (alert "Interaction ABIRATERONE + RIFAMPICINE (Association DECONSEILLEE) : Diminution notable des concentrations plasmatiques de l’abiratérone, avec risque de moindre efficacité."))
  (interaction
    (title "ABROCITINIB + FLUCONAZOLE")
    (level "Précaution d'emploi")
    (drugs-a "abrocitinib")
    (drugs-b "fluconazole")
    (alert "Interaction ABROCITINIB + FLUCONAZOLE (Précaution d'emploi) : Risque de majoration des effets indésirables de l’abrocitinib par diminution de son métabolisme. Conduite à tenir : Réduire la posologie de l’abrocitinib de moitié en cas de traitement par le fluconazole."))
  (interaction
    (title "ABROCITINIB + FLUVOXAMINE")
    (level "Précaution d'emploi")
    (drugs-a "abrocitinib")
    (drugs-b "fluvoxamine")
    (alert "Interaction ABROCITINIB + FLUVOXAMINE (Précaution d'emploi) : Risque de majoration des effets indésirables de l’abrocitinib par diminution de son métabolisme. Conduite à tenir : Réduire la posologie de l’abrocitinib de moitié en cas de traitement par la fluvoxamine."))
  (interaction
    (title "ACETAZOLAMIDE + ACIDE ACETYLSALICYLIQUE")
    (level "Association DECONSEILLEE")
    (drugs-a "acetazolamide")
    (drugs-b "acetylsalicylique")
    (alert "Interaction ACETAZOLAMIDE + ACIDE ACETYLSALICYLIQUE (Association DECONSEILLEE) : Majoration des effets indésirables, et notamment de l'acidose métabolique, de l'acide acétylsalicylique à doses élevées et de l'acétazolamide, par diminution de l'élimination de l'acide acétylsalicylique par l'acétazolamide."))
  (interaction
    (title "ACETAZOLAMIDE + CARBAMAZEPINE")
    (level "Précaution d'emploi")
    (drugs-a "acetazolamide")
    (drugs-b "carbamazepine")
    (alert "Interaction ACETAZOLAMIDE + CARBAMAZEPINE (Précaution d'emploi) : Augmentation des concentrations plasmatiques de carbamazépine avec signes de surdosage. Conduite à tenir : Surveillance clinique et, si besoin, contrôle des concentrations plasmatiques de carbamazépine et réduction éventuelle de sa posologie."))
  (interaction
    (title "ACETAZOLAMIDE + LITHIUM")
    (level "Précaution d'emploi")
    (drugs-a "acetazolamide")
    (drugs-b "lithium")
    (alert "Interaction ACETAZOLAMIDE + LITHIUM (Précaution d'emploi) : Diminution de la lithémie avec risque de baisse de l’efficacité thérapeutique. Conduite à tenir : Surveillance stricte de la lithémie et adaptation éventuelle de la posologie du lithium."))
  (interaction
    (title "ACETAZOLAMIDE + VALPROÏQUE (ACIDE) ET, PAR EXTRAPOLATION, VALPROMIDE")
    (level "Précaution d'emploi")
    (drugs-a "acetazolamide")
    (drugs-b "valproique" "valpromide")
    (alert "Interaction ACETAZOLAMIDE + VALPROÏQUE (ACIDE) ET, PAR EXTRAPOLATION, VALPROMIDE (Précaution d'emploi) : Augmentation de l'hyperammoniémie, avec risque accru d'encéphalopathie. Conduite à tenir : Surveillance clinique et biologique régulière."))
  (interaction
    (title "ACIDE ACETYLSALICYLIQUE + ANTAGONISTES DES RÉCEPTEURS DE L'ANGIOTENSINE II")
    (level "Précaution d'emploi")
    (drugs-a "acetylsalicylique")
    (drugs-b "azilsartan" "candesartan cilexetil" "eprosartan" "irbesartan" "losartan" "olmesartan" "telmisartan" "valsartan")
    (alert "Interaction ACIDE ACETYLSALICYLIQUE + ANTAGONISTES DES RÉCEPTEURS DE L'ANGIOTENSINE II (Précaution d'emploi) : Pour des doses anti-inflammatoires d'acide acétylsalicylique (>= 1g par prise et/ou >= 3g par jour) ou pour des doses antalgiques ou antipyrétiques (>= 500 mg par prise et/ou < 3g par jour) : Insuffisance rénale aiguë chez le patient à risque (âgé, déshydraté, sous diurétiques, avec une fonction rénale altérée), par diminution de la filtration glomérulaire secondaire à une diminution de la synthèse des prostaglandines rénales. Par ailleurs, réduction de l'effet antihypertenseur. Conduite à tenir : Hydrater le malade et surveiller la fonction rénale en début de traitement et régulièrement pendant l’association."))
  (interaction
    (title "ACIDE ACETYLSALICYLIQUE + ANTICOAGULANTS ORAUX")
    (level "CI - ASDEC - APEC")
    (drugs-a "acetylsalicylique")
    (drugs-b "acenocoumarol" "apixaban" "dabigatran" "edoxaban" "fluindione" "phenindione" "rivaroxaban" "warfarine")
    (alert "Interaction ACIDE ACETYLSALICYLIQUE + ANTICOAGULANTS ORAUX (CI - ASDEC - APEC) : Majoration du risque hémorragique, notamment en cas d’antécédent d’ulcère gastro-duodénal. Conduite à tenir : Contre-indication avec : - des doses anti-inflammatoires d'acide acétylsalicylique (>=1g par prise et/ou >=3g par jour) - des doses antalgiques ou antipyrétiques (>=500 mg par prise et/ou <3g par jour) et en cas d’antécédent d’ulcère gastro-duodénal Association déconseillée avec : - des doses antalgiques ou antipyrétiques (>=500 mg par prise et/ou <3g par jour) en l'absence d’antécédent d’ulcère gastro-duodénal - des doses antiagrégantes (de 50 mg à 375 mg par jour) et en cas d’antécédent d’ulcère gastro-duodénal. Nécessité d'un contrôle le cas échéant, en particulier du temps de saignement. A prendre en compte avec : - des doses antiagrégantes (de 50 mg à 375 mg par jour)."))
  (interaction
    (title "ACIDE ACETYLSALICYLIQUE + ANTI-INFLAMMATOIRES NON STÉROÏDIENS")
    (level "ASDEC - APEC")
    (drugs-a "acetylsalicylique")
    (drugs-b "aceclofenac" "alminoprofene" "celecoxib" "dexketoprofene trometamol" "diclofenac" "etodolac" "etoricoxib" "fenoprofene" "flurbiprofene" "ibuprofene" "indometacine" "ketoprofene" "mefenamique" "meloxicam" "morniflumate" "nabumetone" "naproxene" "niflumique" "nimesulide" "parecoxib" "piroxicam" "rofecoxib" "sulindac" "tenoxicam" "tiaprofenique")
    (alert "Interaction ACIDE ACETYLSALICYLIQUE + ANTI-INFLAMMATOIRES NON STÉROÏDIENS (ASDEC - APEC) : Majoration du risque ulcérogène et hémorragique digestif. Conduite à tenir : Association déconseillée avec : - des doses anti-inflammatoires d'acide acétylsalicylique (>=1g par prise et/ou >=3g par jour) - des doses antalgiques ou antipyrétiques (>=500 mg par prise et/ou <3g par jour) A prendre en compte avec : - des doses antiagrégantes (de 50 mg à 375 mg par jour en 1 ou plusieurs prises)."))
  (interaction
    (title "ACIDE ACETYLSALICYLIQUE + CLOPIDOGREL")
    (level "ASDEC - PE")
    (drugs-a "acetylsalicylique")
    (drugs-b "clopidogrel")
    (alert "Interaction ACIDE ACETYLSALICYLIQUE + CLOPIDOGREL (ASDEC - PE) : Majoration du risque hémorragique par addition des activités antiagrégantes plaquettaires. Conduite à tenir : Association déconseillée : - en dehors des indications validées pour cette association dans les syndromes coronariens aigus. Précaution d'emploi : - dans les indications validées pour cette association dans les syndromes coronariens aigus. Surveillance clinique."))
  (interaction
    (title "ACIDE ACETYLSALICYLIQUE + DIURÉTIQUES")
    (level "Précaution d'emploi")
    (drugs-a "acetylsalicylique")
    (drugs-b "altizide" "amiloride" "bendroflumethiazide" "bumetanide" "canrenoate de potassium" "chlortalidone" "cicletanine" "clopamide" "eplerenone" "furosemide" "hydrochlorothiazide" "indapamide" "methyclothiazide" "piretanide" "spironolactone" "triamterene")
    (alert "Interaction ACIDE ACETYLSALICYLIQUE + DIURÉTIQUES (Précaution d'emploi) : Pour des doses anti-inflammatoires d'acide acétylsalicylique (>= 1g par prise et/ou >= 3g par jour) ou pour des doses antalgiques ou antipyrétiques (>= 500 mg par prise et/ou < 3g par jour) : Insuffisance rénale aiguë chez le patient à risque (âgé, déshydraté, avec une fonction rénale altérée), par diminution de la filtration glomérulaire secondaire à une diminution de la synthèse des prostaglandines rénales. Par ailleurs, réduction de l'effet antihypertenseur. Conduite à tenir : Hydrater le malade et surveiller la fonction rénale en début de traitement et régulièrement pendant l’association."))
  (interaction
    (title "ACIDE ACETYLSALICYLIQUE + GLUCOCORTICOÏDES (SAUF HYDROCORTISONE)")
    (level "ASDEC - APEC")
    (drugs-a "acetylsalicylique")
    (drugs-b "betamethasone" "budesonide" "cortisone" "cortivazol" "dexamethasone" "methylprednisolone" "prednisolone" "prednisone" "tetracosactide" "triamcinolone")
    (alert "Interaction ACIDE ACETYLSALICYLIQUE + GLUCOCORTICOÏDES (SAUF HYDROCORTISONE) (ASDEC - APEC) : Majoration du risque hémorragique. Conduite à tenir : Association déconseillée avec : - des doses anti-inflammatoires d'acide acétylsalicylique (>=1g par prise et/ou >=3g par jour) A prendre en compte avec : - des doses antalgiques ou antipyrétiques (>=500 mg par prise et/ou <3g par jour)."))
  (interaction
    (title "ACIDE ACETYLSALICYLIQUE + HÉPARINES (DOSES CURATIVES ET/OU SUJET ÂGÉ)")
    (level "ASDEC - APEC")
    (drugs-a "acetylsalicylique")
    (drugs-b "dalteparine sodique" "danaparoide sodique" "enoxaparine" "fondaparinux" "heparine calcique" "heparine sodique" "nadroparine calcique" "reviparine" "tinzaparine")
    (alert "Interaction ACIDE ACETYLSALICYLIQUE + HÉPARINES (DOSES CURATIVES ET/OU SUJET ÂGÉ) (ASDEC - APEC) : Augmentation du risque hémorragique (inhibition de la fonction plaquettaire et agression de la muqueuse gastroduodénale par l’acide acétylsalicylique. Conduite à tenir : Association déconseillée avec : - des doses anti-inflammatoires d'acide acétylsalicylique (>=1g par prise et/ou >=3g par jour) - des doses antalgiques ou antipyrétiques (>=500 mg par prise et/ou <3g par jour) Utiliser un autre anti-inflammatoire ou un autre antalgique ou antipyrétique. A prendre en compte avec : - des doses antiagrégantes (de 50 mg à 375 mg par jour)."))
  (interaction
    (title "ACIDE ACETYLSALICYLIQUE + INHIBITEURS DE L'ENZYME DE CONVERSION")
    (level "Précaution d'emploi")
    (drugs-a "acetylsalicylique")
    (drugs-b "benazepril" "captopril" "cilazapril" "enalapril" "fosinopril" "lisinopril" "moexipril" "perindopril" "quinapril" "ramipril" "trandolapril" "zofenopril")
    (alert "Interaction ACIDE ACETYLSALICYLIQUE + INHIBITEURS DE L'ENZYME DE CONVERSION (Précaution d'emploi) : Pour des doses anti-inflammatoires d'acide acétylsalicylique (>= 1g par prise et/ou >= 3g par jour) ou pour des doses antalgiques ou antipyrétiques (>= 500 mg par prise et/ou < 3g par jour) : Insuffisance rénale aiguë chez le patient à risque (âgé, déshydraté, sous diurétiques, avec une fonction rénale altérée), par diminution de la filtration glomérulaire secondaire à une diminution de la synthèse des prostaglandines rénales. Par ailleurs, réduction de l'effet antihypertenseur. Conduite à tenir : Hydrater le malade et surveiller la fonction rénale en début de traitement et régulièrement pendant l’association."))
  (interaction
    (title "ACIDE ACETYLSALICYLIQUE + METHOTREXATE")
    (level "CI - PE")
    (drugs-a "acetylsalicylique")
    (drugs-b "methotrexate")
    (alert "Interaction ACIDE ACETYLSALICYLIQUE + METHOTREXATE (CI - PE) : Majoration de la toxicité, notamment hématologique, du méthotrexate (diminution de sa clairance rénale par l'acide acétylsalicylique). Conduite à tenir : Avec le méthotrexate utilisé à des doses > 20 mg/semaine : - contre-indication avec l'acide acétylsalicylique utilisé à doses antalgiques, antipyrétiques ou anti-inflammatoires - précaution d'emploi avec des doses antiagrégantes plaquettaires d'acide acétylsalicylique. Contrôle hebdomadaire de l’hémogramme durant les premières semaines de l’association. Surveillance accrue en cas d’altération (même légère) de la fonction rénale, ainsi que chez le sujet âgé. Avec le méthotrexate utilisé à des doses =< 20 mg/semaine : - précaution d'emploi avec l'acide acétylsalicylique utilisé à doses antalgiques, antipyrétiques ou anti-inflammatoires. Contrôle hebdomadaire de l’hémogramme durant les premières semaines de l’association. Surveillance accrue en cas d’altération (même légère) de la fonction rénale, ainsi que chez le sujet âgé."))
  (interaction
    (title "ACIDE ACETYLSALICYLIQUE + NICORANDIL")
    (level "Association DECONSEILLEE")
    (drugs-a "acetylsalicylique")
    (drugs-b "nicorandil")
    (alert "Interaction ACIDE ACETYLSALICYLIQUE + NICORANDIL (Association DECONSEILLEE) : Majoration du risque ulcérogène et hémorragique digestif."))
  (interaction
    (title "ACIDE ACETYLSALICYLIQUE + PEMETREXED")
    (level "ASDEC - PE")
    (drugs-a "acetylsalicylique")
    (drugs-b "pemetrexed")
    (alert "Interaction ACIDE ACETYLSALICYLIQUE + PEMETREXED (ASDEC - PE) : Risque de majoration de la toxicité du pemetrexed (diminution de sa clairance rénale par l’acide acétylsalicylique à doses anti- inflammatoires). Conduite à tenir : Association déconseillée : - en cas de fonction rénale faible à modérée . Précaution d'emploi : - en cas de fonction rénale normale. Surveillance biologique de la fonction rénale."))
  (interaction
    (title "ACIDE ACETYLSALICYLIQUE + PROBENECIDE")
    (level "Association DECONSEILLEE")
    (drugs-a "acetylsalicylique")
    (drugs-b "probenecide")
    (alert "Interaction ACIDE ACETYLSALICYLIQUE + PROBENECIDE (Association DECONSEILLEE) : Diminution de l’effet uricosurique par compétition de l’élimination de l’acide urique au niveau des tubules rénaux."))
  (interaction
    (title "ACIDE ACETYLSALICYLIQUE + TICAGRELOR")
    (level "ASDEC - PE")
    (drugs-a "acetylsalicylique")
    (drugs-b "ticagrelor")
    (alert "Interaction ACIDE ACETYLSALICYLIQUE + TICAGRELOR (ASDEC - PE) : Majoration du risque hémorragique par addition des activités antiagrégantes plaquettaires. Conduite à tenir : Association déconseillée : - en dehors des indications validées pour cette association dans les syndromes coronariens aigus. Précaution d'emploi : - dans les indications validées pour cette association dans les syndromes coronariens aigus. Surveillance clinique."))
  (interaction
    (title "ACIDE ACETYLSALICYLIQUE + TICLOPIDINE")
    (level "Association DECONSEILLEE")
    (drugs-a "acetylsalicylique")
    (drugs-b "ticlopidine")
    (alert "Interaction ACIDE ACETYLSALICYLIQUE + TICLOPIDINE (Association DECONSEILLEE) : Majoration du risque hémorragique par addition des activités antiagrégantes plaquettaires. Conduite à tenir : Si l’association ne peut être évitée, surveillance clinique étroite."))
  (interaction
    (title "ACIDE ASCORBIQUE + DÉFÉRIPRONE")
    (level "Précaution d'emploi")
    (drugs-a "ascorbique")
    (drugs-b "deferiprone")
    (alert "Interaction ACIDE ASCORBIQUE + DÉFÉRIPRONE (Précaution d'emploi) : Par extrapolation à partir de l’interaction avec la déféroxamine : avec l’acide ascorbique à fortes doses et par voie IV, risque d’anomalies de la fonction cardiaque, voire insuffisance cardiaque aiguë (en général réversible à l’arrêt de la vitamine C)."))
  (interaction
    (title "ACIDE ASCORBIQUE + DÉFÉROXAMINE")
    (level "Précaution d'emploi")
    (drugs-a "ascorbique")
    (drugs-b "deferoxamine")
    (alert "Interaction ACIDE ASCORBIQUE + DÉFÉROXAMINE (Précaution d'emploi) : Avec l'acide ascorbique à fortes doses et par voie IV : anomalies de la fonction cardiaque, voire insuffisance cardiaque aiguë (en général réversible à l'arrêt de la vitamine C). Conduite à tenir : En cas d'hémochromatose, ne donner de la vitamine C qu'après avoir commencé le traitement par la déféroxamine. Surveiller la fonction cardiaque en cas d'association."))
  (interaction
    (title "ACIDE CHOLIQUE + PHÉNOBARBITAL (ET, PAR EXTRAPOLATION, PRIMIDONE)")
    (level "CONTRE-INDICATION")
    (drugs-a "cholique")
    (drugs-b "phenobarbital" "primidone")
    (alert "Interaction ACIDE CHOLIQUE + PHÉNOBARBITAL (ET, PAR EXTRAPOLATION, PRIMIDONE) (CONTRE-INDICATION) : Effet antagoniste du barbiturique."))
  (interaction
    (title "ACIDE CLODRONIQUE + ESTRAMUSTINE")
    (level "Précaution d'emploi")
    (drugs-a "clodronique")
    (drugs-b "estramustine")
    (alert "Interaction ACIDE CLODRONIQUE + ESTRAMUSTINE (Précaution d'emploi) : Risque d’augmentation des concentrations plasmatiques d’estramustine par le clodronate. Conduite à tenir : Surveillance clinique au cours de l’association."))
  (interaction
    (title "ACIDE FUSIDIQUE + INHIBITEURS DE L'HMG-COA RÉDUCTASE (STATINES)")
    (level "CONTRE-INDICATION")
    (drugs-a "fusidique")
    (drugs-b "atorvastatine" "fluvastatine" "pitavastatine" "pravastatine" "rosuvastatine" "simvastatine")
    (alert "Interaction ACIDE FUSIDIQUE + INHIBITEURS DE L'HMG-COA RÉDUCTASE (STATINES) (CONTRE-INDICATION) : Risque majoré d'effets indésirables (concentration-dépendants) à type de rhabdomyolyse. Conduite à tenir : Arrêter le traitement par l'inhibiteur de l'HMG Co-A réductase avant d'initier un traitement par acide fusidique ou utiliser un autre antibiotique."))
  (interaction
    (title "ACIDE FUSIDIQUE + OMBITASVIR + PARITAPRÉVIR")
    (level "CONTRE-INDICATION")
    (drugs-a "fusidique")
    (drugs-b "ombitasvir" "paritaprevir")
    (alert "Interaction ACIDE FUSIDIQUE + OMBITASVIR + PARITAPRÉVIR (CONTRE-INDICATION) : Augmentation des concentrations plasmatiques de l'acide fusidique par diminution de son métabolisme hépatique par la bithérapie."))
  (interaction
    (title "ACITRETINE + METHOTREXATE")
    (level "CONTRE-INDICATION")
    (drugs-a "acitretine")
    (drugs-b "methotrexate")
    (alert "Interaction ACITRETINE + METHOTREXATE (CONTRE-INDICATION) : Risque de majoration de l'hépatotoxicité du méthotrexate."))
  (interaction
    (title "ADRÉNALINE (VOIE BUCCO-DENTAIRE OU SOUS-CUTANÉE) + ANESTHÉSIQUES VOLATILS HALOGÉNÉS")
    (level "Précaution d'emploi")
    (drugs-a "adrenaline")
    (drugs-b "desflurane" "halothane" "isoflurane" "methoxyflurane" "sevoflurane")
    (alert "Interaction ADRÉNALINE (VOIE BUCCO-DENTAIRE OU SOUS-CUTANÉE) + ANESTHÉSIQUES VOLATILS HALOGÉNÉS (Précaution d'emploi) : Troubles du rythme ventriculaire graves par augmentation de l'excitabilité cardiaque. Conduite à tenir : Limiter l'apport, par exemple : moins de 0,1 mg d'adrénaline en 10 minutes ou 0,3 mg en 1 heure chez l'adulte."))
  (interaction
    (title "ADRÉNALINE (VOIE BUCCO-DENTAIRE OU SOUS-CUTANÉE) + ANTIDÉPRESSEURS IMIPRAMINIQUES")
    (level "Précaution d'emploi")
    (drugs-a "adrenaline")
    (drugs-b "amitriptyline" "amoxapine" "clomipramine" "dosulepine" "doxepine" "imipramine" "maprotiline" "trimipramine")
    (alert "Interaction ADRÉNALINE (VOIE BUCCO-DENTAIRE OU SOUS-CUTANÉE) + ANTIDÉPRESSEURS IMIPRAMINIQUES (Précaution d'emploi) : Troubles du rythme ventriculaire graves par augmentation de l'excitabilité cardiaque. Conduite à tenir : Limiter l'apport, par exemple : moins de 0,1 mg d'adrénaline en 10 minutes ou 0,3 mg en 1 heure chez l'adulte."))
  (interaction
    (title "ADRÉNALINE (VOIE BUCCO-DENTAIRE OU SOUS-CUTANÉE) + IMAO IRRÉVERSIBLES")
    (level "Précaution d'emploi")
    (drugs-a "adrenaline")
    (drugs-b "iproniazide" "phenelzine")
    (alert "Interaction ADRÉNALINE (VOIE BUCCO-DENTAIRE OU SOUS-CUTANÉE) + IMAO IRRÉVERSIBLES (Précaution d'emploi) : Troubles du rythme ventriculaire graves par augmentation de l'excitabilité cardiaque. Conduite à tenir : Limiter l'apport, par exemple : moins de 0,1 mg d'adrénaline en 10 minutes ou 0,3 mg en 1 heure chez l'adulte."))
  (interaction
    (title "ADRÉNALINE (VOIE BUCCO-DENTAIRE OU SOUS-CUTANÉE) + MÉDICAMENTS MIXTES ADRÉNERGIQUES-SÉROTONINERGIQUES")
    (level "Précaution d'emploi")
    (drugs-a "adrenaline")
    (drugs-b "amitriptyline" "clomipramine" "duloxetine" "imipramine" "milnacipran" "oxitriptan" "venlafaxine")
    (alert "Interaction ADRÉNALINE (VOIE BUCCO-DENTAIRE OU SOUS-CUTANÉE) + MÉDICAMENTS MIXTES ADRÉNERGIQUES-SÉROTONINERGIQUES (Précaution d'emploi) : Troubles du rythme ventriculaire graves par augmentation de l'excitabilité cardiaque. Conduite à tenir : Limiter l'apport, par exemple : moins de 0,1 mg d'adrénaline en 10 minutes ou 0,3 mg en 1 heure chez l'adulte."))
  (interaction
    (title "AFATINIB + AMIODARONE")
    (level "Précaution d'emploi")
    (drugs-a "afatinib")
    (drugs-b "amiodarone")
    (alert "Interaction AFATINIB + AMIODARONE (Précaution d'emploi) : Augmentation des concentrations plasmatiques d’afatinib par augmentation de son absorption par l'amiodarone. Conduite à tenir : Il est recommandé d’administrer l'amiodarone le plus à distance possible de l’afatinib, en respectant de préférence un intervalle de 6 heures ou de 12 heures par rapport à la prise d’afatinib."))
  (interaction
    (title "AFATINIB + CICLOSPORINE")
    (level "Précaution d'emploi")
