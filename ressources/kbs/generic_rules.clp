  (interaction
    (title "BUPROPION + MEQUITAZINE")
    (level "Association DECONSEILLEE")
    (drugs-a "bupropion")
    (drugs-b "mequitazine")
    (alert "Interaction BUPROPION + MEQUITAZINE (Association DECONSEILLEE) : Risque de majoration des effets indésirables de la méquitazine, par inhibition de son métabolisme par l’inhibiteur enzymatique."))
