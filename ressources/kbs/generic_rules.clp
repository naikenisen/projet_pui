    (drugs-a "cabotegravir")
    (drugs-b "apalutamide" "carbamazepine" "cenobamate" "dabrafenib" "efavirenz" "enzalutamide" "eslicarbazepine" "fosphenytoine" "letermovir" "lorlatinib" "lumacaftor" "nevirapine" "oxcarbazepine" "phenobarbital" "phenytoine" "pitolisant" "primidone" "rifabutine" "rifampicine" "sotorasib")
    (alert "Interaction CABOTEGRAVIR + INDUCTEURS ENZYMATIQUES (CI - APEC) : Diminution importante des concentrations de cabotégravir avec la rifampicine, avec risque de réduction de la réponse virologique. Conduite à tenir : Contre-indication : - avec la rifampicine, la carbamazépine, l'oxcarbazépine, la phénytoïne, le phénobarbital A prendre en compte : - avec les autres inducteurs."))
  (interaction
    (title "CAFEINE + DIPYRIDAMOLE")
    (level "Précaution d'emploi")
    (drugs-a "cafeine")
    (drugs-b "dipyridamole")
    (alert "Interaction CAFEINE + DIPYRIDAMOLE (Précaution d'emploi) : Avec le dipyridamole par voie injectable : réduction de l’effet vasodilatateur du dipyridamole par la caféine. Conduite à tenir : Interrompre un traitement à base de caféine au moins 5 jours avant une imagerie myocardique avec le dipyridamole et éviter la consommation de café, thé, chocolat ou cola dans les 24 heures qui précèdent le test."))
  (interaction
    (title "CAFEINE + ENOXACINE")
    (level "Association DECONSEILLEE")
    (drugs-a "cafeine")
    (drugs-b "enoxacine")
    (alert "Interaction CAFEINE + ENOXACINE (Association DECONSEILLEE) : Augmentation des concentrations plasmatiques de caféine, pouvant entraîner excitations et hallucinations, par diminution de son métabolisme hépatique."))
  (interaction
    (title "CAFEINE + STIRIPENTOL")
    (level "Précaution d'emploi")
    (drugs-a "cafeine")
    (drugs-b "stiripentol")
    (alert "Interaction CAFEINE + STIRIPENTOL (Précaution d'emploi) : Augmentation possible des concentrations plasmatiques de la caféine, avec risque de surdosage, par inhibition de son métabolisme hépatique. Conduite à tenir : Surveillance clinique et adaptation éventuelle de la posologie de caféine."))
  (interaction
    (title "CALCITONINE + LITHIUM")
    (level "Précaution d'emploi")
    (drugs-a "calcitonine")
    (drugs-b "lithium")
    (alert "Interaction CALCITONINE + LITHIUM (Précaution d'emploi) : Risque de baisse de l’efficacité du lithium par augmentation de son élimination rénale par la calcitonine. Conduite à tenir : Surveillance clinique et biologique régulière, notamment en début d’association."))
  (interaction
    (title "CALCIUM + CIPROFLOXACINE")
    (level "Précaution d'emploi")
    (drugs-a "calcium")
    (drugs-b "ciprofloxacine")
    (alert "Interaction CALCIUM + CIPROFLOXACINE (Précaution d'emploi) : Diminution de l'absorption digestive de la ciprofloxacine. Conduite à tenir : Prendre les sels de calcium à distance de la ciprofloxacine (plus de 2 heures, si possible)."))
  (interaction
    (title "CALCIUM + CYCLINES")
    (level "Précaution d'emploi")
    (drugs-a "calcium")
    (drugs-b "chlortetracycline" "demeclocycline" "doxycycline" "lymecycline" "methylenecycline" "minocycline" "oxytetracycline" "tetracycline" "tigecycline")
    (alert "Interaction CALCIUM + CYCLINES (Précaution d'emploi) : Diminution de l'absorption digestive des cyclines. Conduite à tenir : Prendre les sels de calcium à distance des cyclines (plus de deux heures, si possible)."))
  (interaction
    (title "CALCIUM + DIGOXINE")
    (level "CI - PE")
    (drugs-a "calcium")
    (drugs-b "digoxine")
    (alert "Interaction CALCIUM + DIGOXINE (CI - PE) : Risque de troubles du rythme graves, voire mortels avec les sels de calcium administrés par voie IV. Conduite à tenir : Contre-indication : - avec les sels de calcium IV, hormis supplémentation parentérale. Précaution d'emploi : - avec les sels de calcium par voie orale. Surveillance clinique et, s'il y a lieu, contrôle de l'ECG et de la calcémie."))
  (interaction
    (title "CALCIUM + ESTRAMUSTINE")
    (level "Précaution d'emploi")
    (drugs-a "calcium")
    (drugs-b "estramustine")
    (alert "Interaction CALCIUM + ESTRAMUSTINE (Précaution d'emploi) : Diminution de l'absorption digestive de l'estramustine. Conduite à tenir : Prendre les sels de calcium à distance de l'estramustine (plus de 2 heures, si possible)."))
  (interaction
    (title "CALCIUM + FER")
    (level "Précaution d'emploi")
    (drugs-a "calcium")
    (drugs-b "fer")
    (alert "Interaction CALCIUM + FER (Précaution d'emploi) : Avec les sels de fer par voie orale : diminution de l'absorption digestive des sels de fer. Conduite à tenir : Prendre les sels de fer à distance des repas et en l'absence de calcium."))
  (interaction
    (title "CALCIUM + HORMONES THYROÏDIENNES")
    (level "Précaution d'emploi")
    (drugs-a "calcium")
    (drugs-b "levothyroxine" "liothyronine sodique" "thyroxines" "tiratricol")
    (alert "Interaction CALCIUM + HORMONES THYROÏDIENNES (Précaution d'emploi) : Diminution de l’absorption digestive des hormones thyroïdiennes. Conduite à tenir : Prendre les sels de calcium à distance des hormones thyroïdiennes (plus de 2 heures, si possible)."))
  (interaction
    (title "CALCIUM + INHIBITEURS D'INTÉGRASE")
    (level "Précaution d'emploi")
    (drugs-a "calcium")
    (drugs-b "bictegravir" "cabotegravir" "dolutegravir" "raltegravir")
    (alert "Interaction CALCIUM + INHIBITEURS D'INTÉGRASE (Précaution d'emploi) : Diminution de l'absorption digestive des inhibiteurs d’intégrase. Conduite à tenir : Prendre les sels de calcium à distance de l’antirétroviral (plus de 2 heures, si possible)."))
  (interaction
    (title "CALCIUM + NORFLOXACINE")
    (level "Précaution d'emploi")
    (drugs-a "calcium")
    (drugs-b "norfloxacine")
    (alert "Interaction CALCIUM + NORFLOXACINE (Précaution d'emploi) : Diminution de l'absorption digestive de la norflloxacine. Conduite à tenir : Prendre les sels de calcium à distance de la norfloxacine (plus de 2 heures, si possible)."))
  (interaction
    (title "CALCIUM + ROXADUSTAT")
    (level "Précaution d'emploi")
    (drugs-a "calcium")
    (drugs-b "roxadustat")
    (alert "Interaction CALCIUM + ROXADUSTAT (Précaution d'emploi) : La prise de cation divalent peut diminuer l’absorption intestinale et, potentiellement, l’efficacité du roxadustat pris simultanément. Conduite à tenir : Prendre le roxadustat à distance des sels de calcium (plus de 1 heure, si possible)."))
  (interaction
    (title "CALCIUM + STRONTIUM")
    (level "Précaution d'emploi")
    (drugs-a "calcium")
    (drugs-b "strontium")
    (alert "Interaction CALCIUM + STRONTIUM (Précaution d'emploi) : Avec les sels de calcium administrés par voie orale : diminution de l'absorption digestive du strontium. Conduite à tenir : Prendre le strontium à distance des sels de calcium (plus de deux heures, si possible)."))
  (interaction
    (title "CALCIUM + ZINC")
    (level "Précaution d'emploi")
    (drugs-a "calcium")
    (drugs-b "zinc")
    (alert "Interaction CALCIUM + ZINC (Précaution d'emploi) : Diminution de l’absorption digestive du zinc par le calcium. Conduite à tenir : Prendre les sels de calcium à distance du zinc (plus de 2 heures si possible)."))
  (interaction
    (title "CANNABIDIOL + INDUCTEURS ENZYMATIQUES PUISSANTS")
    (level "Association DECONSEILLEE")
    (drugs-a "cannabidiol")
    (drugs-b "apalutamide" "carbamazepine" "enzalutamide" "fosphenytoine" "phenobarbital" "phenytoine" "primidone")
    (alert "Interaction CANNABIDIOL + INDUCTEURS ENZYMATIQUES PUISSANTS (Association DECONSEILLEE) : Diminution des concentrations plasmatiques de cannabidiol avec risque de perte d’efficacité."))
  (interaction
    (title "CANNABIDIOL + MILLEPERTUIS")
    (level "CONTRE-INDICATION")
    (drugs-a "cannabidiol")
    (drugs-b "millepertuis")
    (alert "Interaction CANNABIDIOL + MILLEPERTUIS (CONTRE-INDICATION) : Diminution des concentrations plasmatiques de cannabidiol avec risque de perte d’efficacité."))
  (interaction
    (title "CANNABIDIOL + RIFAMPICINE")
    (level "Association DECONSEILLEE")
    (drugs-a "cannabidiol")
    (drugs-b "rifampicine")
    (alert "Interaction CANNABIDIOL + RIFAMPICINE (Association DECONSEILLEE) : Diminution des concentrations plasmatiques de cannabidiol avec risque de perte d’efficacité."))
  (interaction
    (title "CARBAMAZEPINE + CIMETIDINE")
    (level "Précaution d'emploi")
    (drugs-a "carbamazepine")
    (drugs-b "cimetidine")
    (alert "Interaction CARBAMAZEPINE + CIMETIDINE (Précaution d'emploi) : Avec la cimétidine utilisée à des doses supérieures ou égales à 800 mg/j : en début de traitement, augmentation des concentrations plasmatiques de carbamazépine par inhibition de son métabolisme hépatique par la cimétidine. Conduite à tenir : Surveillance clinique et réduction éventuelle de la posologie de la carbamazépine, spécialement pendant les premiers jours de traitement par la cimétidine."))
  (interaction
    (title "CARBAMAZEPINE + CLARITHROMYCINE")
    (level "Précaution d'emploi")
    (drugs-a "carbamazepine")
    (drugs-b "clarithromycine")
    (alert "Interaction CARBAMAZEPINE + CLARITHROMYCINE (Précaution d'emploi) : Augmentation des concentrations plasmatiques de carbamazépine avec signes de surdosage, par inhibition de son métabolisme hépatique. Conduite à tenir : Surveillance clinique et réduction éventuelle de la posologie de la carbamazépine."))
  (interaction
    (title "CARBAMAZEPINE + CLONAZEPAM")
    (level "Précaution d'emploi")
    (drugs-a "carbamazepine")
    (drugs-b "clonazepam")
    (alert "Interaction CARBAMAZEPINE + CLONAZEPAM (Précaution d'emploi) : Augmentation des concentrations plasmatiques du métabolite actif de la carbamazépine. De plus, diminution des concentrations plasmatiques du clonazépam par augmentation de son métabolisme hépatique par la carbamazépine. Conduite à tenir : Surveillance clinique, dosages plasmatiques et adaptation éventuelle des posologies des deux anticonvulsivants."))
  (interaction
    (title "CARBAMAZEPINE + DANAZOL")
    (level "Précaution d'emploi")
    (drugs-a "carbamazepine")
    (drugs-b "danazol")
    (alert "Interaction CARBAMAZEPINE + DANAZOL (Précaution d'emploi) : Augmentation des concentrations plasmatiques de carbamazépine, avec signes de surdosage. Conduite à tenir : Surveillance clinique et réduction éventuelle de la posologie de la carbamazépine."))
  (interaction
    (title "CARBAMAZEPINE + DIGOXINE")
    (level "Précaution d'emploi")
    (drugs-a "carbamazepine")
    (drugs-b "digoxine")
    (alert "Interaction CARBAMAZEPINE + DIGOXINE (Précaution d'emploi) : Augmentation des concentrations plasmatiques de carbamazépine et diminution de la digoxinémie. Conduite à tenir : Prudence dans l'interprétation des concentrations plasmatiques."))
  (interaction
    (title "CARBAMAZEPINE + DIURÉTIQUES HYPOKALIÉMIANTS")
    (level "Précaution d'emploi")
    (drugs-a "carbamazepine")
    (drugs-b "altizide" "bendroflumethiazide" "bumetanide" "chlortalidone" "cicletanine" "clopamide" "furosemide" "hydrochlorothiazide" "indapamide" "methyclothiazide" "piretanide")
    (alert "Interaction CARBAMAZEPINE + DIURÉTIQUES HYPOKALIÉMIANTS (Précaution d'emploi) : Risque d'hyponatrémie symptomatique. Conduite à tenir : Surveillance clinique et biologique. Si possible, utiliser une autre classe de diurétiques."))
  (interaction
    (title "CARBAMAZEPINE + ERYTHROMYCINE")
    (level "Association DECONSEILLEE")
    (drugs-a "carbamazepine")
    (drugs-b "erythromycine")
    (alert "Interaction CARBAMAZEPINE + ERYTHROMYCINE (Association DECONSEILLEE) : Augmentation des concentrations plasmatiques de carbamazépine, avec signes de surdosage, par inhibition de son métabolisme hépatique."))
  (interaction
    (title "CARBAMAZEPINE + ETHOSUXIMIDE")
    (level "Précaution d'emploi")
    (drugs-a "carbamazepine")
    (drugs-b "ethosuximide")
    (alert "Interaction CARBAMAZEPINE + ETHOSUXIMIDE (Précaution d'emploi) : Diminution des concentrations plasmatiques d'éthosuximide. Conduite à tenir : Surveillance clinique, dosage plasmatique de l'éthosuximide et augmentation éventuelle de sa posologie."))
  (interaction
    (title "CARBAMAZEPINE + FELBAMATE")
    (level "Précaution d'emploi")
    (drugs-a "carbamazepine")
    (drugs-b "felbamate")
    (alert "Interaction CARBAMAZEPINE + FELBAMATE (Précaution d'emploi) : Augmentation des concentrations plasmatiques du métabolite actif de la carbamazépine. De plus, diminution des concentrations plasmatiques de felbamate par augmentation de son métabolisme hépatique par la carbamazépine. Conduite à tenir : Surveillance clinique, dosages plasmatiques et adaptation éventuelle des posologies des deux anticonvulsivants."))
  (interaction
    (title "CARBAMAZEPINE + FLUCONAZOLE")
    (level "Précaution d'emploi")
    (drugs-a "carbamazepine")
    (drugs-b "fluconazole")
    (alert "Interaction CARBAMAZEPINE + FLUCONAZOLE (Précaution d'emploi) : Pour des doses de fluconazole >= 200 mg par jour : augmentation possible des effets indésirables de la carbamazépine. Conduite à tenir : Adapter la posologie de carbamazépine, pendant et après l’arrêt du traitement antifongique."))
  (interaction
    (title "CARBAMAZEPINE + FLUOXETINE")
    (level "Précaution d'emploi")
    (drugs-a "carbamazepine")
    (drugs-b "fluoxetine")
    (alert "Interaction CARBAMAZEPINE + FLUOXETINE (Précaution d'emploi) : Augmentation des concentrations plasmatiques de carbamazépine avec signes de surdosage. Conduite à tenir : Surveillance clinique, contrôle des concentrations plasmatiques de carbamazépine et réduction éventuelle de la posologie de la carbamazépine pendant le traitement par l'antidépresseur sérotoninergique et après son arrêt."))
  (interaction
    (title "CARBAMAZEPINE + FLUVOXAMINE")
    (level "Précaution d'emploi")
    (drugs-a "carbamazepine")
    (drugs-b "fluvoxamine")
    (alert "Interaction CARBAMAZEPINE + FLUVOXAMINE (Précaution d'emploi) : Augmentation des concentrations plasmatiques de carbamazépine avec signes de surdosage. Conduite à tenir : Surveillance clinique, contrôle des concentrations plasmatiques de carbamazépine et réduction éventuelle de la posologie de la carbamazépine pendant le traitement par l'antidépresseur sérotoninergique et après son arrêt."))
  (interaction
    (title "CARBAMAZEPINE + ISONIAZIDE")
    (level "Association DECONSEILLEE")
    (drugs-a "carbamazepine")
    (drugs-b "isoniazide")
    (alert "Interaction CARBAMAZEPINE + ISONIAZIDE (Association DECONSEILLEE) : Augmentation des concentrations plasmatiques de carbamazépine avec signes de surdosage par inhibition de son métabolisme hépatique."))
  (interaction
    (title "CARBAMAZEPINE + JOSAMYCINE")
    (level "Précaution d'emploi")
    (drugs-a "carbamazepine")
    (drugs-b "josamycine")
    (alert "Interaction CARBAMAZEPINE + JOSAMYCINE (Précaution d'emploi) : Augmentation des concentrations plasmatiques de carbamazépine avec signes de surdosage, par diminution de son métabolisme hépatique. Conduite à tenir : Surveillance clinique et, si besoin, dosage plasmatique et réduction éventuelle de la posologie de la carbamazépine."))
  (interaction
    (title "CARBAMAZEPINE + LAMOTRIGINE")
    (level "Précaution d'emploi")
    (drugs-a "carbamazepine")
    (drugs-b "lamotrigine")
    (alert "Interaction CARBAMAZEPINE + LAMOTRIGINE (Précaution d'emploi) : Risque d'augmentation des effets neurologiques (vertiges, ataxie, diplopie) de la carbamazépine lors de l'introduction de la lamotrigine. Conduite à tenir : Surveillance clinique et réduction éventuelle de la posologie de la carbamazépine."))
  (interaction
    (title "CARBAMAZEPINE + LITHIUM")
    (level "Association DECONSEILLEE")
    (drugs-a "carbamazepine")
    (drugs-b "lithium")
    (alert "Interaction CARBAMAZEPINE + LITHIUM (Association DECONSEILLEE) : Risque de neurotoxicité se manifestant par des troubles cérébelleux, confusion, somnolence, ataxie. Ces troubles sont réversibles à l'arrêt du traitement par le lithium."))
  (interaction
    (title "CARBAMAZEPINE + MILLEPERTUIS")
    (level "Association DECONSEILLEE")
    (drugs-a "carbamazepine")
    (drugs-b "millepertuis")
    (alert "Interaction CARBAMAZEPINE + MILLEPERTUIS (Association DECONSEILLEE) : Risque de diminution des concentrations plasmatiques et de l'efficacité de la carbamazepine."))
  (interaction
    (title "CARBAMAZEPINE + NINTÉDANIB")
    (level "Précaution d'emploi")
    (drugs-a "carbamazepine")
    (drugs-b "nintedanib")
    (alert "Interaction CARBAMAZEPINE + NINTÉDANIB (Précaution d'emploi) : Diminution des concentrations plasmatiques du nintédanib par diminution de son absorption par la carbamazépine. Conduite à tenir : Surveillance clinique pendant l’association."))
  (interaction
    (title "CARBAMAZEPINE + OLANZAPINE")
    (level "Précaution d'emploi")
    (drugs-a "carbamazepine")
    (drugs-b "olanzapine")
    (alert "Interaction CARBAMAZEPINE + OLANZAPINE (Précaution d'emploi) : Risque de diminution des concentrations plasmatiques de l'olanzapine et de son efficacité thérapeutique, par augmentation de son métabolisme hépatique par la carbamazépine. Conduite à tenir : Surveillance clinique, et si besoin, adaptation posologique de l'olanzapine."))
  (interaction
    (title "CARBAMAZEPINE + PAROXETINE")
    (level "Précaution d'emploi")
    (drugs-a "carbamazepine")
    (drugs-b "paroxetine")
    (alert "Interaction CARBAMAZEPINE + PAROXETINE (Précaution d'emploi) : Augmentation des concentrations plasmatiques de carbamazépine avec signes de surdosage. Conduite à tenir : Surveillance clinique, contrôle des concentrations plasmatiques de carbamazépine et réduction éventuelle de la posologie de la carbamazépine pendant le traitement par l'antidépresseur sérotoninergique et après son arrêt."))
  (interaction
    (title "CARBAMAZEPINE + RIFAMPICINE")
    (level "Précaution d'emploi")
    (drugs-a "carbamazepine")
    (drugs-b "rifampicine")
    (alert "Interaction CARBAMAZEPINE + RIFAMPICINE (Précaution d'emploi) : Diminution des concentrations plasmatiques et de l'efficacité de la carbamazépine par augmentation de son métabolisme hépatique par la rifampicine. Conduite à tenir : Surveillance clinique, contrôle des concentrations plasmatiques et adaptation de la posologie de la carbamazépine pendant le traitement par la rifampicine et après son arrêt."))
  (interaction
    (title "CARBAMAZEPINE + RISPERIDONE")
    (level "Précaution d'emploi")
    (drugs-a "carbamazepine")
    (drugs-b "risperidone")
    (alert "Interaction CARBAMAZEPINE + RISPERIDONE (Précaution d'emploi) : Risque de diminution de la fraction active de la rispéridone et de son efficacité thérapeutique par augmentation de son métabolisme hépatique par la carbamazépine. Conduite à tenir : Surveillance clinique, et si besoin, adaptation posologique de la rispéridone."))
  (interaction
    (title "CARBAMAZEPINE + SIMVASTATINE")
    (level "Association DECONSEILLEE")
    (drugs-a "carbamazepine")
    (drugs-b "simvastatine")
    (alert "Interaction CARBAMAZEPINE + SIMVASTATINE (Association DECONSEILLEE) : Diminution importante des concentrations plasmatiques de simvastatine, par augmentation de son métabolisme hépatique."))
  (interaction
    (title "CARBAMAZEPINE + TOPIRAMATE")
    (level "Précaution d'emploi")
    (drugs-a "carbamazepine")
    (drugs-b "topiramate")
    (alert "Interaction CARBAMAZEPINE + TOPIRAMATE (Précaution d'emploi) : Diminution des concentrations du topiramate avec risque de moindre efficacité, par augmentation de son métabolisme hépatique par la carbamazépine. Conduite à tenir : Surveillance clinique, et si besoin, adaptation posologique du topiramate pendant le traitement par la carbamazépine et après son arrêt."))
  (interaction
    (title "CARBAMAZEPINE + VALPROÏQUE (ACIDE) ET, PAR EXTRAPOLATION, VALPROMIDE")
    (level "Précaution d'emploi")
    (drugs-a "carbamazepine")
    (drugs-b "valproique" "valpromide")
    (alert "Interaction CARBAMAZEPINE + VALPROÏQUE (ACIDE) ET, PAR EXTRAPOLATION, VALPROMIDE (Précaution d'emploi) : Augmentation des concentrations plasmatiques du métabolite actif de la carbamazépine avec signes de surdosage. De plus, diminution des concentrations plasmatiques d'acide valproïque par augmentation de son métabolisme hépatique par la carbamazépine. Conduite à tenir : Surveillance clinique, dosages plasmatiques et adaptation de la posologie des deux anticonvulsivants."))
  (interaction
    (title "CARBAMAZEPINE + VERAPAMIL")
    (level "Précaution d'emploi")
    (drugs-a "carbamazepine")
    (drugs-b "verapamil")
    (alert "Interaction CARBAMAZEPINE + VERAPAMIL (Précaution d'emploi) : Augmentation des concentrations de carbamazépine et de sa neurotoxicité par inhibition de son métabolisme par le vérapamil. De plus, diminution des concentrations du vérapamil par augmentation de son métabolisme par la carbamazépine. Conduite à tenir : Surveillance clinique et adaptation éventuelle des posologies des deux médicaments."))
  (interaction
    (title "CARMUSTINE + CIMETIDINE")
    (level "Association DECONSEILLEE")
    (drugs-a "carmustine")
    (drugs-b "cimetidine")
    (alert "Interaction CARMUSTINE + CIMETIDINE (Association DECONSEILLEE) : Avec la cimétidine utilisée à des doses supérieures ou égales à 800 mg/j : toxicité médullaire accrue (inhibition du métabolisme de la carmustine)."))
  (interaction
    (title "CARVEDILOL + CIMETIDINE")
    (level "CONTRE-INDICATION")
    (drugs-a "carvedilol")
    (drugs-b "cimetidine")
    (alert "Interaction CARVEDILOL + CIMETIDINE (CONTRE-INDICATION) : Avec la cimétidine utilisée à des doses supérieures ou égales à 800 mg/j : augmentation des concentrations du carvédilol, pouvant être préjudiciables dans le cas du traitement de l'insuffisance cardiaque, par diminution de son métabolisme hépatique par la cimétidine. Conduite à tenir : Utiliser un autre antisécrétoire gastrique."))
  (interaction
    (title "CARVEDILOL + RIFAMPICINE")
    (level "Précaution d'emploi")
    (drugs-a "carvedilol")
    (drugs-b "rifampicine")
    (alert "Interaction CARVEDILOL + RIFAMPICINE (Précaution d'emploi) : Diminution importante des concentrations plasmatiques du carvédilol, par augmentation de son métabolisme hépatique par la rifampicine. Conduite à tenir : Surveillance clinique régulière et adaptation de la posologie du carvédilol pendant le traitement par la rifampicine. A l'arrêt de la rifampicine, risque de remontée importante des concentrations plasmatiques de carvédilol imposant une réduction posologique et une surveillance clinique étroite."))
  (interaction
    (title "CASPOFUNGINE + INDUCTEURS ENZYMATIQUES")
    (level "Précaution d'emploi")
    (drugs-a "caspofungine")
    (drugs-b "apalutamide" "carbamazepine" "cenobamate" "dabrafenib" "efavirenz" "enzalutamide" "eslicarbazepine" "fosphenytoine" "letermovir" "lorlatinib" "lumacaftor" "nevirapine" "oxcarbazepine" "phenobarbital" "phenytoine" "pitolisant" "primidone" "rifabutine" "rifampicine" "sotorasib")
    (alert "Interaction CASPOFUNGINE + INDUCTEURS ENZYMATIQUES (Précaution d'emploi) : Diminution des concentrations plasmatiques de caspofungine. Conduite à tenir : En cas de traitement par inducteur, maintenir la posologie à 70 mg par jour dès le 2e jour."))
  (interaction
    (title "CHLORDIAZEPOXIDE + CIMETIDINE")
    (level "Précaution d'emploi")
    (drugs-a "chlordiazepoxide")
    (drugs-b "cimetidine")
    (alert "Interaction CHLORDIAZEPOXIDE + CIMETIDINE (Précaution d'emploi) : Avec la cimétidine utilisée à des doses supérieures ou égales à 800 mg/j : risque accru de somnolence. Conduite à tenir : Avertir les patients de l'augmentation du risque en cas de conduite automobile ou d'utilisation de machines."))
  (interaction
    (title "CHLOROQUINE + CICLOSPORINE")
    (level "Précaution d'emploi")
    (drugs-a "chloroquine")
    (drugs-b "ciclosporine")
    (alert "Interaction CHLOROQUINE + CICLOSPORINE (Précaution d'emploi) : Risque d'augmentation des concentrations sanguines de ciclosporine et de la créatininémie. Conduite à tenir : Dosage des concentrations sanguines de ciclosporine, contrôle de la fonction rénale et adaptation de la posologie pendant l'association et après l'arrêt de la chloroquine."))
  (interaction
    (title "CHLOROQUINE + HORMONES THYROÏDIENNES")
    (level "Précaution d'emploi")
    (drugs-a "chloroquine")
    (drugs-b "levothyroxine" "liothyronine sodique" "thyroxines" "tiratricol")
    (alert "Interaction CHLOROQUINE + HORMONES THYROÏDIENNES (Précaution d'emploi) : Risque d’hypothyroïdie clinique chez les patients substitués par hormones thyroïdiennes. Conduite à tenir : Surveillance clinique et biologique. Adaptation, si besoin, de la posologie des hormones thyroïdiennes pendant le traitement par chloroquine et après son arrêt."))
  (interaction
    (title "CHLORPROMAZINE + INSULINE")
    (level "Précaution d'emploi")
    (drugs-a "chlorpromazine")
    (drugs-b "insuline")
    (alert "Interaction CHLORPROMAZINE + INSULINE (Précaution d'emploi) : A fortes posologies (100 mg par jour de chlorpromazine) : élévation de la glycémie (diminution de la libération de l'insuline). Conduite à tenir : Prévenir le patient et renforcer l'autosurveillance glycémique. Adapter éventuellement la posologie de l'insuline pendant le traitement par le neuroleptique et après son arrêt."))
  (interaction
    (title "CHLORPROMAZINE + SULFAMIDES HYPOGLYCÉMIANTS")
    (level "Précaution d'emploi")
    (drugs-a "chlorpromazine")
    (drugs-b "glibenclamide" "gliclazide" "glimepiride" "glipizide")
    (alert "Interaction CHLORPROMAZINE + SULFAMIDES HYPOGLYCÉMIANTS (Précaution d'emploi) : A fortes posologies (100 mg par jour de chlorpromazine) : élévation de la glycémie (diminution de la libération de l'insuline). Conduite à tenir : Prévenir le patient et renforcer l'autosurveillance glycémique. Adapter éventuellement la posologie du neuroleptique pendant le traitement et après son arrêt."))
  (interaction
    (title "CICLOSPORINE + CLINDAMYCINE")
    (level "Précaution d'emploi")
    (drugs-a "ciclosporine")
    (drugs-b "clindamycine")
    (alert "Interaction CICLOSPORINE + CLINDAMYCINE (Précaution d'emploi) : Diminution des concentrations sanguines de l'immunosuppresseur avec risque de perte de l'activité immunosuppressive. Conduite à tenir : Contrôle renforcé des dosages sanguins de ciclosporine et augmentation éventuelle de sa posologie."))
  (interaction
    (title "CICLOSPORINE + COLCHICINE")
    (level "Association DECONSEILLEE")
    (drugs-a "ciclosporine")
    (drugs-b "colchicine")
    (alert "Interaction CICLOSPORINE + COLCHICINE (Association DECONSEILLEE) : Risque d’addition des effets indésirables neuromusculaires et augmentation de la toxicité de la colchicine avec risque de surdosage par inhibition de son élimination par la ciclosporine, notamment en cas d’insuffisance rénale préexistante."))
  (interaction
    (title "CICLOSPORINE + DABIGATRAN")
    (level "CONTRE-INDICATION")
    (drugs-a "ciclosporine")
    (drugs-b "dabigatran")
    (alert "Interaction CICLOSPORINE + DABIGATRAN (CONTRE-INDICATION) : Augmentation de plus du double des concentrations plasmatiques de dabigatran, avec majoration du risque de saignement."))
  (interaction
    (title "CICLOSPORINE + DANAZOL")
    (level "Précaution d'emploi")
    (drugs-a "ciclosporine")
    (drugs-b "danazol")
    (alert "Interaction CICLOSPORINE + DANAZOL (Précaution d'emploi) : Augmentation des concentrations sanguines de ciclosporine par inhibition de son métabolisme hépatique. Conduite à tenir : Dosage des concentrations sanguines de ciclosporine, contrôle de la fonction rénale et adaptation de la posologie pendant l’association et après son arrêt."))
  (interaction
    (title "CICLOSPORINE + DIURÉTIQUES ÉPARGNEURS DE POTASSIUM (SEULS OU ASSOCIÉS)")
    (level "Association DECONSEILLEE")
    (drugs-a "ciclosporine")
    (drugs-b "amiloride" "canrenoate de potassium" "eplerenone" "spironolactone" "triamterene")
    (alert "Interaction CICLOSPORINE + DIURÉTIQUES ÉPARGNEURS DE POTASSIUM (SEULS OU ASSOCIÉS) (Association DECONSEILLEE) : Hyperkaliémie potentiellement létale, surtout lors d'une insuffisance rénale (addition des effets hyperkaliémiants)."))
  (interaction
    (title "CICLOSPORINE + ÉDOXABAN")
    (level "Précaution d'emploi")
    (drugs-a "ciclosporine")
    (drugs-b "edoxaban")
    (alert "Interaction CICLOSPORINE + ÉDOXABAN (Précaution d'emploi) : Augmentation des concentrations plasmatiques de l’édoxaban, avec majoration du risque de saignement. Conduite à tenir : Réduire la dose d’édoxaban de moitié."))
  (interaction
    (title "CICLOSPORINE + EVEROLIMUS")
    (level "Précaution d'emploi")
    (drugs-a "ciclosporine")
    (drugs-b "everolimus")
    (alert "Interaction CICLOSPORINE + EVEROLIMUS (Précaution d'emploi) : Augmentation des concentrations sanguines de l’évérolimus par la ciclosporine. La néphrotoxicité de la ciclosporine est également augmentée lors de l’association. Conduite à tenir : Dosage des concentrations sanguines d’évérolimus, éventuellement adaptation de la posologie et contrôle de la fonction rénale, pendant l’association et après son arrêt."))
  (interaction
    (title "CICLOSPORINE + EZETIMIBE")
    (level "Association DECONSEILLEE")
    (drugs-a "ciclosporine")
    (drugs-b "ezetimibe")
    (alert "Interaction CICLOSPORINE + EZETIMIBE (Association DECONSEILLEE) : D’une part, risque majoré d'effets indésirables (concentration- dépendants) à type de rhabdomyolyse, par augmentation des concentrations d’ézétimibe ; d’autre part, possible augmentation des concentrations de ciclosporine."))
  (interaction
    (title "CICLOSPORINE + FENOFIBRATE")
    (level "Précaution d'emploi")
    (drugs-a "ciclosporine")
    (drugs-b "fenofibrate")
    (alert "Interaction CICLOSPORINE + FENOFIBRATE (Précaution d'emploi) : Risque d'augmentation de la néphrotoxicité de la ciclosporine. Conduite à tenir : Surveillance clinique et biologique de la fonction rénale, pendant et après l'association."))
  (interaction
    (title "CICLOSPORINE + FIDAXOMICINE")
    (level "Association DECONSEILLEE")
    (drugs-a "ciclosporine")
    (drugs-b "fidaxomicine")
    (alert "Interaction CICLOSPORINE + FIDAXOMICINE (Association DECONSEILLEE) : Augmentation des concentrations plasmatiques de la fidaxomicine."))
  (interaction
    (title "CICLOSPORINE + FLUVASTATINE")
    (level "Précaution d'emploi")
    (drugs-a "ciclosporine")
    (drugs-b "fluvastatine")
    (alert "Interaction CICLOSPORINE + FLUVASTATINE (Précaution d'emploi) : Augmentation modérée des concentrations de fluvastatine, avec risque musculaire non exclu. Conduite à tenir : Surveillance clinique et biologique pendant l’association."))
  (interaction
    (title "CICLOSPORINE + GRAZOPREVIR + ELBASVIR")
    (level "CONTRE-INDICATION")
    (drugs-a "ciclosporine")
    (drugs-b "elbasvir" "grazoprevir")
    (alert "Interaction CICLOSPORINE + GRAZOPREVIR + ELBASVIR (CONTRE-INDICATION) : Augmentation des concentrations de grazoprévir et d’elbasvir."))
  (interaction
    (title "CICLOSPORINE + JOSAMYCINE")
    (level "Précaution d'emploi")
    (drugs-a "ciclosporine")
    (drugs-b "josamycine")
    (alert "Interaction CICLOSPORINE + JOSAMYCINE (Précaution d'emploi) : Risque d'augmentation des concentrations sanguines de ciclosporine et de la créatininémie. Conduite à tenir : Dosage des concentrations sanguines de la ciclosporine, contrôle de la fonction rénale et adaptation de la posologie pendant l'association et après l'arrêt du macrolide."))
  (interaction
    (title "CICLOSPORINE + LERCANIDIPINE")
    (level "Précaution d'emploi")
    (drugs-a "ciclosporine")
    (drugs-b "lercanidipine")
    (alert "Interaction CICLOSPORINE + LERCANIDIPINE (Précaution d'emploi) : Augmentation modérée des concentrations sanguines de l'immunosuppresseur et augmentation plus notable des concentrations de lercanidipine. Conduite à tenir : Décaler les prises des deux médicaments. Dosage des concentrations sanguines de l'immunosuppresseur, et adaptation si nécessaire de sa posologie pendant l'association et après son arrêt."))
  (interaction
    (title "CICLOSPORINE + METHOTREXATE")
    (level "Précaution d'emploi")
    (drugs-a "ciclosporine")
    (drugs-b "methotrexate")
    (alert "Interaction CICLOSPORINE + METHOTREXATE (Précaution d'emploi) : Augmentation de la toxicité du méthotrexate et de la ciclosporine avec augmentation de la créatininémie : diminution réciproque des clairances des deux médicaments. Conduite à tenir : Dosage des concentrations sanguines de ciclosporine et de méthotrexate. Adaptation posologique si nécessaire pendant l'association et après son arrêt."))
  (interaction
    (title "CICLOSPORINE + MIDECAMYCINE")
    (level "Précaution d'emploi")
    (drugs-a "ciclosporine")
    (drugs-b "midecamycine")
    (alert "Interaction CICLOSPORINE + MIDECAMYCINE (Précaution d'emploi) : Risque d'augmentation des concentrations sanguines de ciclosporine et de la créatininémie. Conduite à tenir : Dosage des concentrations sanguines de la ciclosporine, contrôle de la fonction rénale et adaptation de la posologie pendant l'association et après l'arrêt du macrolide."))
  (interaction
    (title "CICLOSPORINE + MIFAMURTIDE")
    (level "CONTRE-INDICATION")
    (drugs-a "ciclosporine")
    (drugs-b "mifamurtide")
    (alert "Interaction CICLOSPORINE + MIFAMURTIDE (CONTRE-INDICATION) : Risque d'atteinte des macrophages spléniques et des cellules phagocytaires mononuclées."))
  (interaction
    (title "CICLOSPORINE + MODAFINIL")
    (level "Association DECONSEILLEE")
    (drugs-a "ciclosporine")
    (drugs-b "modafinil")
    (alert "Interaction CICLOSPORINE + MODAFINIL (Association DECONSEILLEE) : Risque de diminution des concentrations sanguines et de l'efficacité de l'immunosuppresseur."))
  (interaction
    (title "CICLOSPORINE + NIFEDIPINE")
    (level "Association DECONSEILLEE")
    (drugs-a "ciclosporine")
    (drugs-b "nifedipine")
    (alert "Interaction CICLOSPORINE + NIFEDIPINE (Association DECONSEILLEE) : Risque d'addition d'effets indésirables à type de gingivopathies. Conduite à tenir : Utiliser une autre dihydropyridine."))
  (interaction
    (title "CICLOSPORINE + NINTÉDANIB")
    (level "Précaution d'emploi")
    (drugs-a "ciclosporine")
    (drugs-b "nintedanib")
    (alert "Interaction CICLOSPORINE + NINTÉDANIB (Précaution d'emploi) : Augmentation des concentrations plasmatiques du nintédanib par augmentation de son absorption par la ciclosporine. Conduite à tenir : Surveillance clinique pendant l’association."))
  (interaction
    (title "CICLOSPORINE + ORLISTAT")
    (level "Association DECONSEILLEE")
    (drugs-a "ciclosporine")
    (drugs-b "orlistat")
    (alert "Interaction CICLOSPORINE + ORLISTAT (Association DECONSEILLEE) : Diminution des concentrations sanguines de ciclosporine par diminution de son absorption intestinale, avec risque de perte de l'activité immunosuppressive. Conduite à tenir : Prendre l'orlistat à distance de la ciclosporine (au moins 3 heures). Contrôle renforcé des dosages sanguins de ciclosporine, notamment en début d’association, et lors d’augmentation éventuelle de la posologie de l’orlistat."))
  (interaction
    (title "CICLOSPORINE + OZANIMOD")
    (level "Association DECONSEILLEE")
    (drugs-a "ciclosporine")
    (drugs-b "ozanimod")
    (alert "Interaction CICLOSPORINE + OZANIMOD (Association DECONSEILLEE) : Risque d’augmentation des effets indésirables de l’ozanimod."))
  (interaction
    (title "CICLOSPORINE + PITAVASTATINE")
    (level "CONTRE-INDICATION")
    (drugs-a "ciclosporine")
    (drugs-b "pitavastatine")
    (alert "Interaction CICLOSPORINE + PITAVASTATINE (CONTRE-INDICATION) : Risque majoré d'effets indésirables (concentration-dépendants) à type de rhabdomyolyse, ou de néphrotoxicité, par diminution du métabolisme de la pitavastatine."))
  (interaction
    (title "CICLOSPORINE + POTASSIUM")
    (level "Association DECONSEILLEE")
    (drugs-a "ciclosporine")
    (drugs-b "potassium")
    (alert "Interaction CICLOSPORINE + POTASSIUM (Association DECONSEILLEE) : Pour une quantité de potassium > à 1 mmol/prise, hyperkaliémie potentiellement létale, notamment chez l'insuffisant rénale ( addition des effets hyperkaliémiants). Conduite à tenir : Sauf en cas d'hypokaliémie."))
  (interaction
    (title "CICLOSPORINE + PRAVASTATINE")
    (level "Précaution d'emploi")
    (drugs-a "ciclosporine")
    (drugs-b "pravastatine")
    (alert "Interaction CICLOSPORINE + PRAVASTATINE (Précaution d'emploi) : Augmentation des concentrations de pravastatine, avec risque musculaire non exclu. Conduite à tenir : Surveillance clinique et biologique pendant l’association. Débuter le traitement à la dose minimale de pravastatine."))
  (interaction
    (title "CICLOSPORINE + REPAGLINIDE")
    (level "Association DECONSEILLEE")
    (drugs-a "ciclosporine")
    (drugs-b "repaglinide")
    (alert "Interaction CICLOSPORINE + REPAGLINIDE (Association DECONSEILLEE) : Augmentation de plus du double des concentrations du répaglinide par augmentation de son absorption."))
  (interaction
    (title "CICLOSPORINE + ROSUVASTATINE")
    (level "CONTRE-INDICATION")
    (drugs-a "ciclosporine")
    (drugs-b "rosuvastatine")
    (alert "Interaction CICLOSPORINE + ROSUVASTATINE (CONTRE-INDICATION) : Risque majoré d'effets indésirables (concentration-dépendants) à type de rhabdomyolyse, ou de néphrotoxicité, par diminution du métabolisme de la rosuvastatine."))
  (interaction
    (title "CICLOSPORINE + ROXITHROMYCINE")
    (level "Précaution d'emploi")
    (drugs-a "ciclosporine")
    (drugs-b "roxithromycine")
    (alert "Interaction CICLOSPORINE + ROXITHROMYCINE (Précaution d'emploi) : Risque d'augmentation des concentrations sanguines de ciclosporine et de la créatininémie. Conduite à tenir : Dosage des concentrations sanguines de la ciclosporine, contrôle de la fonction rénale et adaptation de la posologie pendant l'association et après l'arrêt du macrolide."))
  (interaction
    (title "CICLOSPORINE + SIMVASTATINE")
    (level "CONTRE-INDICATION")
    (drugs-a "ciclosporine")
    (drugs-b "simvastatine")
    (alert "Interaction CICLOSPORINE + SIMVASTATINE (CONTRE-INDICATION) : Risque majoré d'effets indésirables (concentration-dépendants) à type de rhabdomyolyse par diminution du métabolisme de la simvastatine."))
  (interaction
    (title "CICLOSPORINE + SIROLIMUS")
    (level "Précaution d'emploi")
    (drugs-a "ciclosporine")
    (drugs-b "sirolimus")
    (alert "Interaction CICLOSPORINE + SIROLIMUS (Précaution d'emploi) : Augmentation des concentrations sanguines de sirolimus par la ciclosporine. La néphrotoxicité de la ciclosporine est également augmentée lors de l’association. Conduite à tenir : Il est recommandé d’administrer le sirolimus 4 heures après la ciclosporine. Contrôle de la fonction rénale, pendant l’association et après son arrêt."))
  (interaction
    (title "CICLOSPORINE + SULFINPYRAZONE")
    (level "Précaution d'emploi")
    (drugs-a "ciclosporine")
    (drugs-b "sulfinpyrazone")
    (alert "Interaction CICLOSPORINE + SULFINPYRAZONE (Précaution d'emploi) : Diminution des concentrations sanguines de ciclosporine par augmentation de son métabolisme par la sulfinpyrazone. Conduite à tenir : Contrôle des concentrations sanguines de ciclosporine et adaptation éventuelle de sa posologie pendant le traitement par sulfinpyrazone et après son arrêt."))
  (interaction
    (title "CICLOSPORINE + TALAZOPARIB")
    (level "Précaution d'emploi")
    (drugs-a "ciclosporine")
    (drugs-b "talazoparib")
    (alert "Interaction CICLOSPORINE + TALAZOPARIB (Précaution d'emploi) : Augmentation des concentrations de talazoparib avec risque de majoration de la toxicité. Conduite à tenir : Réduire la dose de talazoparib."))
  (interaction
    (title "CICLOSPORINE + TÉNOFOVIR ALAFÉNAMIDE")
    (level "Précaution d'emploi")
    (drugs-a "ciclosporine")
    (drugs-b "tenofovir alafenamide")
    (alert "Interaction CICLOSPORINE + TÉNOFOVIR ALAFÉNAMIDE (Précaution d'emploi) : Augmentation des concentrations plasmatiques du ténofovir alafénamide par augmentation de son absorption. Conduite à tenir : En cas de co-administration avec la ciclosporine, la dose de ténofovir alafénamide doit être limitée à 10 mg par jour."))
  (interaction
    (title "CICLOSPORINE + TERBINAFINE")
    (level "Précaution d'emploi")
    (drugs-a "ciclosporine")
    (drugs-b "terbinafine")
    (alert "Interaction CICLOSPORINE + TERBINAFINE (Précaution d'emploi) : Diminution des concentrations sanguines de ciclosporine. Conduite à tenir : Contrôle des concentrations sanguines de ciclosporine et adaptation éventuelle de sa posologie pendant le traitement par terbinafine et après son arrêt."))
  (interaction
    (title "CICLOSPORINE + TICLOPIDINE")
    (level "Précaution d'emploi")
    (drugs-a "ciclosporine")
    (drugs-b "ticlopidine")
    (alert "Interaction CICLOSPORINE + TICLOPIDINE (Précaution d'emploi) : Diminution des concentrations sanguines de ciclosporine. Conduite à tenir : Augmentation de la posologie de la ciclosporine sous contrôle des concentrations sanguines. Réduction de la posologie en cas d'arrêt de la ticlopidine."))
  (interaction
    (title "CICLOSPORINE + TIGECYCLINE")
    (level "Précaution d'emploi")
    (drugs-a "ciclosporine")
    (drugs-b "tigecycline")
    (alert "Interaction CICLOSPORINE + TIGECYCLINE (Précaution d'emploi) : Augmentation des concentrations sanguines de l’immunosuppresseur, avec risque d'effets néphrotoxiques. Conduite à tenir : Dosage des concentrations sanguines de l’immunosuppresseur, contrôle de la fonction rénale et adaptation de la posologie pendant le traitement par la tigécycline."))
  (interaction
    (title "CICLOSPORINE + VERAPAMIL")
    (level "Précaution d'emploi")
    (drugs-a "ciclosporine")
    (drugs-b "verapamil")
    (alert "Interaction CICLOSPORINE + VERAPAMIL (Précaution d'emploi) : Augmentation des concentrations sanguines de la ciclosporine (diminution de son métabolisme hépatique), et majoration du risque de gingivopathies. Conduite à tenir : Dosage des concentrations sanguines de la ciclosporine, contrôle de la fonction rénale et adaptation de la posologie pendant l’association et après son arrêt."))
  (interaction
    (title "CIMETIDINE + DIAZEPAM")
    (level "Précaution d'emploi")
    (drugs-a "cimetidine")
    (drugs-b "diazepam")
    (alert "Interaction CIMETIDINE + DIAZEPAM (Précaution d'emploi) : Avec la cimétidine utilisée à des doses supérieures ou égales à 800 mg/j : risque accru de somnolence. Conduite à tenir : Avertir les patients de l'augmentation du risque en cas de conduite automobile ou d'utilisation de machines."))
  (interaction
    (title "CIMETIDINE + LIDOCAINE")
    (level "Précaution d'emploi")
    (drugs-a "cimetidine")
    (drugs-b "lidocaine")
    (alert "Interaction CIMETIDINE + LIDOCAINE (Précaution d'emploi) : Avec la cimétidine utilisée à des doses supérieures ou égales à 800 mg/j : augmentation des concentrations plasmatiques de lidocaïne avec risque d'effets indésirables neurologiques et cardiaques (inhibition du métabolisme hépatique de la lidocaïne). Conduite à tenir : Surveillance clinique, ECG et éventuellement des concentrations plasmatiques de la lidocaïne ; s'il y a lieu, adaptation de la posologie de la lidocaïne pendant le traitement par la cimétidine et après son arrêt."))
  (interaction
    (title "CIMETIDINE + LOMUSTINE")
    (level "Association DECONSEILLEE")
    (drugs-a "cimetidine")
    (drugs-b "lomustine")
    (alert "Interaction CIMETIDINE + LOMUSTINE (Association DECONSEILLEE) : Avec la cimétidine utilisée à des doses supérieures ou égales à 800 mg/j : toxicité médullaire accrue (inhibition du métabolisme de la lomustine)."))
  (interaction
    (title "CIMETIDINE + METHADONE")
    (level "Précaution d'emploi")
    (drugs-a "cimetidine")
    (drugs-b "methadone")
    (alert "Interaction CIMETIDINE + METHADONE (Précaution d'emploi) : Augmentation des concentrations plasmatiques de méthadone avec surdosage et risque majoré d’allongement de l’intervalle QT et de troubles du rythme ventriculaire, notamment de torsades de pointes. Conduite à tenir : Surveillance clinique et électrocardiographique renforcée ; si besoin, adaptation de la posologie de la méthadone pendant le traitement par la cimétidine et après son arrêt."))
  (interaction
    (title "CIMETIDINE + METOPROLOL")
    (level "Précaution d'emploi")
    (drugs-a "cimetidine")
    (drugs-b "metoprolol")
    (alert "Interaction CIMETIDINE + METOPROLOL (Précaution d'emploi) : Avec le métoprolol utilisé dans l'insuffisance cardiaque, et la cimétidine utilisée à des doses supérieures ou égales à 800 mg/j : augmentation des concentrations du métoprolol, pouvant être préjudiciables dans le cas du traitement de l'insuffisance cardiaque, par diminution de son métabolisme hépatique par la cimétidine. Conduite à tenir : Surveillance clinique. Si besoin, adaptation de la posologie du métoprolol pendant le traitement par la cimétidine."))
  (interaction
    (title "CIMETIDINE + MOCLOBEMIDE")
    (level "Précaution d'emploi")
    (drugs-a "cimetidine")
    (drugs-b "moclobemide")
    (alert "Interaction CIMETIDINE + MOCLOBEMIDE (Précaution d'emploi) : Avec la cimétidine utilisée à des doses supérieures ou égales à 800 mg/j : augmentation des concentrations du moclobémide, par diminution de son métabolisme hépatique. Conduite à tenir : Surveillance clinique avec adaptation éventuelle de la posologie de moclobémide."))
  (interaction
    (title "CIMETIDINE + NIFEDIPINE")
    (level "Précaution d'emploi")
    (drugs-a "cimetidine")
    (drugs-b "nifedipine")
    (alert "Interaction CIMETIDINE + NIFEDIPINE (Précaution d'emploi) : Avec la cimétidine utilisée à des doses supérieures ou égales à 800 mg/j : augmentation de l'effet hypotenseur de la nifédipine par inhibition de son métabolisme hépatique par la cimétidine. Conduite à tenir : Surveillance clinique accrue : adapter la posologie de la nifédipine pendant le tratiement par la cimétidine et après son arrêt."))
  (interaction
    (title "CIMETIDINE + PHÉNYTOÏNE (ET, PAR EXTRAPOLATION, FOSPHÉNYTOÏNE)")
    (level "Association DECONSEILLEE")
    (drugs-a "cimetidine")
    (drugs-b "fosphenytoine" "phenytoine")
    (alert "Interaction CIMETIDINE + PHÉNYTOÏNE (ET, PAR EXTRAPOLATION, FOSPHÉNYTOÏNE) (Association DECONSEILLEE) : Avec la cimétidine utilisée à des doses supérieures ou égales à 800 mg/j : augmentation des concentrations plasmatiques de phénytoïne avec possibilité d'apparition des signes habituels de surdosage. Conduite à tenir : Si l'association ne peut être évitée, surveillance clinique étroite, dosage des concentrations plasmatiques de phénytoïne et adaptation éventuelle de sa posologie pendant le traitement par la cimétidine et après son arrêt."))
  (interaction
    (title "CIMETIDINE + THÉOPHYLLINE (ET, PAR EXTRAPOLATION, AMINOPHYLLINE)")
    (level "Précaution d'emploi")
    (drugs-a "cimetidine")
    (drugs-b "aminophylline" "theophylline")
    (alert "Interaction CIMETIDINE + THÉOPHYLLINE (ET, PAR EXTRAPOLATION, AMINOPHYLLINE) (Précaution d'emploi) : Avec la cimétidine utilisée à des doses supérieures ou égales à 800 mg/j : augmentation de la théophyllinémie avec risque de surdosage (diminution du métabolisme de la théophylline). Conduite à tenir : Surveillance clinique et éventuellement de la théophyllinémie. S'il y a lieu, adaptation de la théophylline pendant le traitement par la cimétidine et après son arrêt."))
  (interaction
    (title "CINACALCET + CODEINE")
    (level "Association DECONSEILLEE")
    (drugs-a "cinacalcet")
    (drugs-b "codeine")
    (alert "Interaction CINACALCET + CODEINE (Association DECONSEILLEE) : Risque d’inefficacité de l’opiacé par inhibition de son métabolisme par l’inhibiteur."))
  (interaction
    (title "CINACALCET + DEXTROMETHORPHANE")
    (level "CONTRE-INDICATION")
    (drugs-a "cinacalcet")
    (drugs-b "dextromethorphane")
    (alert "Interaction CINACALCET + DEXTROMETHORPHANE (CONTRE-INDICATION) : Augmentation très importante des concentrations plasmatiques de dextrométhorphane avec risque de surdosage, par diminution de son métabolisme hépatique par le cinacalcet."))
  (interaction
    (title "CINACALCET + ÉTELCALCÉTIDE")
    (level "Association DECONSEILLEE")
    (drugs-a "cinacalcet")
    (drugs-b "etelcalcetide")
    (alert "Interaction CINACALCET + ÉTELCALCÉTIDE (Association DECONSEILLEE) : Risque d’hypocalcémie sévère."))
  (interaction
    (title "CINACALCET + MEQUITAZINE")
    (level "Association DECONSEILLEE")
    (drugs-a "cinacalcet")
    (drugs-b "mequitazine")
    (alert "Interaction CINACALCET + MEQUITAZINE (Association DECONSEILLEE) : Risque de majoration des effets indésirables de la méquitazine, par inhibition de son métabolisme par l’inhibiteur enzymatique."))
  (interaction
    (title "CINACALCET + METOPROLOL")
    (level "Précaution d'emploi")
    (drugs-a "cinacalcet")
    (drugs-b "metoprolol")
    (alert "Interaction CINACALCET + METOPROLOL (Précaution d'emploi) : Augmentation des concentrations plasmatiques de métroprolol avec risque de surdosage, par diminution de son métabolisme hépatique par le cinacalcet. Conduite à tenir : Surveillance clinique et réduction de la posologie du métroprolol pendant le traitement par cinacalcet."))
  (interaction
    (title "CINACALCET + PROPAFENONE")
    (level "Précaution d'emploi")
    (drugs-a "cinacalcet")
    (drugs-b "propafenone")
    (alert "Interaction CINACALCET + PROPAFENONE (Précaution d'emploi) : Augmentation des concentrations plasmatiques de propafénone avec risque de surdosage, par diminution de son métabolisme hépatique par le cinacalcet. Conduite à tenir : Surveillance clinique et réduction de la posologie de la propafénone pendant le traitement par cinacalcet."))
  (interaction
    (title "CINACALCET + TETRABENAZINE")
    (level "CONTRE-INDICATION")
    (drugs-a "cinacalcet")
    (drugs-b "tetrabenazine")
    (alert "Interaction CINACALCET + TETRABENAZINE (CONTRE-INDICATION) : Augmentation possiblement très importante de l’exposition des métabolites actifs de la tétrabénazine."))
  (interaction
    (title "CINACALCET + TRAMADOL")
    (level "Association DECONSEILLEE")
    (drugs-a "cinacalcet")
    (drugs-b "tramadol")
    (alert "Interaction CINACALCET + TRAMADOL (Association DECONSEILLEE) : Risque d’inefficacité de l’opiacé par inhibition de son métabolisme par l’inhibiteur."))
  (interaction
    (title "CIPROFLOXACINE + CLOZAPINE")
    (level "Précaution d'emploi")
    (drugs-a "ciprofloxacine")
    (drugs-b "clozapine")
    (alert "Interaction CIPROFLOXACINE + CLOZAPINE (Précaution d'emploi) : Augmentation des concentrations de clozapine avec risque de surdosage, par diminution de son métabolisme hépatique par la ciprofloxacine. Conduite à tenir : Surveillance clinique et réduction éventuelle de la posologie de la clozapine pendant le traitement par la ciprofloxacine et après son arrêt."))
  (interaction
    (title "CIPROFLOXACINE + METHOTREXATE")
    (level "Association DECONSEILLEE")
    (drugs-a "ciprofloxacine")
    (drugs-b "methotrexate")
    (alert "Interaction CIPROFLOXACINE + METHOTREXATE (Association DECONSEILLEE) : Augmentation de la toxicité du méthotrexate par inhibition de sa sécrétion tubulaire rénale par la ciprofloxacine."))
  (interaction
    (title "CIPROFLOXACINE + PHÉNYTOÏNE (ET, PAR EXTRAPOLATION, FOSPHÉNYTOÏNE)")
    (level "Précaution d'emploi")
    (drugs-a "ciprofloxacine")
    (drugs-b "fosphenytoine" "phenytoine")
    (alert "Interaction CIPROFLOXACINE + PHÉNYTOÏNE (ET, PAR EXTRAPOLATION, FOSPHÉNYTOÏNE) (Précaution d'emploi) : Variation, éventuellement importante, des concentrations de phénytoïne en cas de traitement par la ciprofloxacine. Conduite à tenir : Surveillance clinique et contrôle des concentrations plasmatiques de l’anticonvulsivant pendant le traitement par ciprofloxacine et après son arrêt."))
  (interaction
    (title "CIPROFLOXACINE + ROPINIROLE")
    (level "Précaution d'emploi")
    (drugs-a "ciprofloxacine")
    (drugs-b "ropinirole")
    (alert "Interaction CIPROFLOXACINE + ROPINIROLE (Précaution d'emploi) : Augmentation des concentrations de ropinirole avec risque de surdosage, par diminution de son métabolisme hépatique par la ciprofloxacine. Conduite à tenir : Surveillance clinique et réduction éventuelle de la posologie du ropinirole pendant le traitement par la ciprofloxacine et après son arrêt."))
  (interaction
    (title "CIPROFLOXACINE + SUBSTANCES SUSCEPTIBLES DE DONNER DES TORSADES DE POINTES")
    (level "Précaution d'emploi")
    (drugs-a "ciprofloxacine")
    (drugs-b "amiodarone" "amisulpride" "arsenieux" "chloroquine" "chlorpromazine" "citalopram" "cocaine" "crizotinib" "cyamemazine" "disopyramide" "domperidone" "dronedarone" "droperidol" "erythromycine" "escitalopram" "flupentixol" "fluphenazine" "halofantrine" "haloperidol" "hydroquinidine" "hydroxychloroquine" "hydroxyzine" "levomepromazine" "lumefantrine" "mequitazine" "methadone" "moxifloxacine" "pentamidine" "pimozide" "pipamperone" "piperaquine" "pipotiazine" "quinidine" "sotalol" "spiramycine" "sulpiride" "tiapride" "toremifene" "vandetanib" "vincamine" "zuclopenthixol")
    (alert "Interaction CIPROFLOXACINE + SUBSTANCES SUSCEPTIBLES DE DONNER DES TORSADES DE POINTES (Précaution d'emploi) : Risque majoré de troubles du rythme ventriculaire, notamment de torsades de pointes. Conduite à tenir : Surveillance clinique et électrocardiographique pendant l'association."))
  (interaction
    (title "CIPROFLOXACINE + THÉOPHYLLINE (ET, PAR EXTRAPOLATION, AMINOPHYLLINE)")
    (level "Précaution d'emploi")
    (drugs-a "ciprofloxacine")
    (drugs-b "aminophylline" "theophylline")
    (alert "Interaction CIPROFLOXACINE + THÉOPHYLLINE (ET, PAR EXTRAPOLATION, AMINOPHYLLINE) (Précaution d'emploi) : Augmentation de la théophyllinémie avec risque de surdosage, par diminution de son métabolisme hépatique par la ciprofloxacine. Conduite à tenir : Surveillance clinique et éventuellement de la théophyllinémie."))
  (interaction
    (title "CLADRIBINE + LAMIVUDINE")
    (level "Association DECONSEILLEE")
    (drugs-a "cladribine")
    (drugs-b "lamivudine")
    (alert "Interaction CLADRIBINE + LAMIVUDINE (Association DECONSEILLEE) : Risque de diminution de l’efficacité de la cladribine par la lamivudine."))
  (interaction
    (title "CLARITHROMYCINE + FIDAXOMICINE")
    (level "Association DECONSEILLEE")
    (drugs-a "clarithromycine")
    (drugs-b "fidaxomicine")
    (alert "Interaction CLARITHROMYCINE + FIDAXOMICINE (Association DECONSEILLEE) : Augmentation des concentrations plasmatiques de la fidaxomicine."))
  (interaction
    (title "CLARITHROMYCINE + IMMUNOSUPPRESSEURS")
    (level "Association DECONSEILLEE")
    (drugs-a "clarithromycine")
    (drugs-b "ciclosporine" "everolimus" "sirolimus" "tacrolimus" "temsirolimus")
    (alert "Interaction CLARITHROMYCINE + IMMUNOSUPPRESSEURS (Association DECONSEILLEE) : Augmentation très importante des concentrations sanguines de l'immunosuppresseur par inhibition de son métabolisme hépatique. Conduite à tenir : En cas d’association, contrôle strict de la fonction rénale, dosage des concentrations sanguines de l'immunosuppresseur et adaptation éventuelle de la posologie."))
  (interaction
    (title "CLARITHROMYCINE + INHIBITEURS DE PROTÉASES BOOSTÉS PAR RITONAVIR")
    (level "Précaution d'emploi")
    (drugs-a "clarithromycine")
    (drugs-b "atazanavir" "darunavir" "fosamprenavir" "lopinavir" "nirmatrelvir" "ritonavir" "saquinavir" "tipranavir")
    (alert "Interaction CLARITHROMYCINE + INHIBITEURS DE PROTÉASES BOOSTÉS PAR RITONAVIR (Précaution d'emploi) : Augmentation des concentrations de la clarithromycine et de son métabolite actif par diminution de son métabolisme hépatique par l'inhibiteur de protéases. Conduite à tenir : Surveillance clinique et biologique régulière, notamment en début d'association."))
  (interaction
    (title "CLARITHROMYCINE + PRAVASTATINE")
    (level "Précaution d'emploi")
    (drugs-a "clarithromycine")
    (drugs-b "pravastatine")
    (alert "Interaction CLARITHROMYCINE + PRAVASTATINE (Précaution d'emploi) : Augmentation de la concentration plasmatique de la pravastatine par la clarithromycine. Conduite à tenir : Surveillance clinique et biologique pendant le traitement par l'antibiotique."))
  (interaction
    (title "CLARITHROMYCINE + REPAGLINIDE")
    (level "Précaution d'emploi")
    (drugs-a "clarithromycine")
    (drugs-b "repaglinide")
    (alert "Interaction CLARITHROMYCINE + REPAGLINIDE (Précaution d'emploi) : Risque d'hypoglycémie par augmentation des concentrations plasmatiques du répaglinide. Conduite à tenir : Prévenir le patient, renforcer l'autosurveillance glycémique et adapter éventuellement la posologie de l'hypoglycémiant pendant le traitement par la clarithromycine."))
  (interaction
    (title "CLARITHROMYCINE + RIFABUTINE")
    (level "Précaution d'emploi")
    (drugs-a "clarithromycine")
    (drugs-b "rifabutine")
    (alert "Interaction CLARITHROMYCINE + RIFABUTINE (Précaution d'emploi) : Risque d'augmentation des effets indésirables de la rifabutine (uvéites) par augmentation de ses concentrations et de celle de son métabolite actif par la clarithromycine. De plus, augmentation du métabolisme de la clarithromycine par la rifabutine, avec augmentation des concentrations de son métabolite actif. Conduite à tenir : Surveillance clinique et biologique régulière, notamment en début d'association."))
  (interaction
    (title "CLARITHROMYCINE + RIFAMPICINE")
    (level "Précaution d'emploi")
    (drugs-a "clarithromycine")
    (drugs-b "rifampicine")
    (alert "Interaction CLARITHROMYCINE + RIFAMPICINE (Précaution d'emploi) : Diminution des concentrations plasmatiques et risque de baisse de l'efficacité de la clarithromycine, notamment chez le patient HIV, par augmentation de son métabolisme hépatique par la rifampicine. Conduite à tenir : Surveillance clinique et biologique régulière."))
  (interaction
    (title "CLARITHROMYCINE + SUBSTANCES SUSCEPTIBLES DE DONNER DES TORSADES DE POINTES")
    (level "Précaution d'emploi")
    (drugs-a "clarithromycine")
    (drugs-b "amiodarone" "amisulpride" "arsenieux" "chloroquine" "chlorpromazine" "citalopram" "cocaine" "crizotinib" "cyamemazine" "disopyramide" "domperidone" "dronedarone" "droperidol" "erythromycine" "escitalopram" "flupentixol" "fluphenazine" "halofantrine" "haloperidol" "hydroquinidine" "hydroxychloroquine" "hydroxyzine" "levomepromazine" "lumefantrine" "mequitazine" "methadone" "moxifloxacine" "pentamidine" "pimozide" "pipamperone" "piperaquine" "pipotiazine" "quinidine" "sotalol" "spiramycine" "sulpiride" "tiapride" "toremifene" "vandetanib" "vincamine" "zuclopenthixol")
    (alert "Interaction CLARITHROMYCINE + SUBSTANCES SUSCEPTIBLES DE DONNER DES TORSADES DE POINTES (Précaution d'emploi) : Risque majoré de troubles du rythme ventriculaire, notamment de torsades de pointes. Conduite à tenir : Surveillance clinique et électrocardiographique pendant l'association."))
  (interaction
    (title "CLARITHROMYCINE + SULFAMIDES HYPOGLYCÉMIANTS")
    (level "Précaution d'emploi")
    (drugs-a "clarithromycine")
    (drugs-b "glibenclamide" "gliclazide" "glimepiride" "glipizide")
    (alert "Interaction CLARITHROMYCINE + SULFAMIDES HYPOGLYCÉMIANTS (Précaution d'emploi) : Risque d'hypoglycémie par augmentation des concentrations plasmatiques de l’antidiabétique. Conduite à tenir : Prévenir le patient, renforcer l'autosurveillance glycémique et adapter éventuellement la posologie du sulfamide hypoglycémiant pendant le traitement par la clarithromycine."))
  (interaction
    (title "CLARITHROMYCINE + TALAZOPARIB")
    (level "Précaution d'emploi")
    (drugs-a "clarithromycine")
    (drugs-b "talazoparib")
    (alert "Interaction CLARITHROMYCINE + TALAZOPARIB (Précaution d'emploi) : Augmentation des concentrations de talazoparib avec risque de majoration de la toxicité. Conduite à tenir : Réduire la dose de talazoparib."))
  (interaction
    (title "CLINDAMYCINE + TACROLIMUS")
    (level "Précaution d'emploi")
    (drugs-a "clindamycine")
    (drugs-b "tacrolimus")
    (alert "Interaction CLINDAMYCINE + TACROLIMUS (Précaution d'emploi) : Diminution des concentrations sanguines de l'immunosuppresseur, avec risque de perte de l'activité immunosuppressive. Conduite à tenir : Contrôle renforcé des dosages sanguins de tacrolimus et augmentation éventuelle de sa posologie."))
  (interaction
    (title "CLOBAZAM + STIRIPENTOL")
    (level "Précaution d'emploi")
    (drugs-a "clobazam")
    (drugs-b "stiripentol")
    (alert "Interaction CLOBAZAM + STIRIPENTOL (Précaution d'emploi) : Augmentation des concentrations plasmatiques de ces anticonvulsivants, avec risque de surdosage, par inhibition de leur métabolisme hépatique. Conduite à tenir : Surveillance clinique, dosage plasmatique, lorsque cela est possible, de l'anticonvulsivant associé au stiripentol et éventuelle adaptation posologique de l'anticonvulsivant associé."))
  (interaction
    (title "CLOPIDOGREL + PHÉNYTOÏNE (ET, PAR EXTRAPOLATION, FOSPHÉNYTOÏNE)")
    (level "Précaution d'emploi")
    (drugs-a "clopidogrel")
    (drugs-b "fosphenytoine" "phenytoine")
    (alert "Interaction CLOPIDOGREL + PHÉNYTOÏNE (ET, PAR EXTRAPOLATION, FOSPHÉNYTOÏNE) (Précaution d'emploi) : Augmentation des concentrations plasmatiques de phénytoïne avec signes de surdosage (inhibition du métabolisme de la. Conduite à tenir : Surveillance clinique et contrôle des concentrations plasmatiques de phénytoïne."))
  (interaction
    (title "CLOPIDOGREL + SELEXIPAG")
    (level "Précaution d'emploi")
    (drugs-a "clopidogrel")
    (drugs-b "selexipag")
    (alert "Interaction CLOPIDOGREL + SELEXIPAG (Précaution d'emploi) : Risque d’augmentation des effets indésirables du sélexipag par diminution de son métabolisme. Conduite à tenir : Surveillance clinique étroite pendant l’association. Réduire de moitié la posologie (une seule prise par jour)."))
  (interaction
    (title "CLOZAPINE + FLUVOXAMINE")
    (level "Précaution d'emploi")
    (drugs-a "clozapine")
    (drugs-b "fluvoxamine")
    (alert "Interaction CLOZAPINE + FLUVOXAMINE (Précaution d'emploi) : Augmentation des concentrations plasmatiques de clozapine avec signes de surdosage. Conduite à tenir : Surveillance clinique accrue ; si besoin, adaptation de la posologie de la clozapine pendant le traitement par la fluvoxamine et après son arrêt."))
  (interaction
    (title "CLOZAPINE + INDUCTEURS ENZYMATIQUES PUISSANTS")
    (level "ASDEC - PE")
    (drugs-a "clozapine")
    (drugs-b "apalutamide" "carbamazepine" "enzalutamide" "fosphenytoine" "phenobarbital" "phenytoine" "primidone")
    (alert "Interaction CLOZAPINE + INDUCTEURS ENZYMATIQUES PUISSANTS (ASDEC - PE) : Diminution des concentrations plasmatiques de clozapine avec risque de perte d’efficacité. De plus, avec la carbamazépine, risque de majoration des effets hématologiques graves. Conduite à tenir : Association déconseillée: - avec la carbamazépine, l'apalutamide, l'enzalutamide Précaution d'emploi: - Avec la phénytoïne, la fosphénytoïne, la primidone, le phénobarbital. Surveillance clinique et adaptation posologique de la clozapine pendant l’association et après l’arrêt de l’inducteur - Avec l'apalutamide, l'enzalutamide : risque vraisemblablement modéré."))
  (interaction
    (title "CLOZAPINE + MILLEPERTUIS")
    (level "CONTRE-INDICATION")
    (drugs-a "clozapine")
    (drugs-b "millepertuis")
    (alert "Interaction CLOZAPINE + MILLEPERTUIS (CONTRE-INDICATION) : Risque d’inefficacité du traitement antipsychotique (diminution des concentrations plasmatiques de clozapine par augmentation de son métabolisme hépatique)."))
  (interaction
    (title "CLOZAPINE + RIFAMPICINE")
    (level "Précaution d'emploi")
    (drugs-a "clozapine")
    (drugs-b "rifampicine")
    (alert "Interaction CLOZAPINE + RIFAMPICINE (Précaution d'emploi) : Risque d'inefficacité du traitement antipsychotique (diminution des concentrations plasmatiques de clozapine par augmentation de son métabolisme hépatique). Conduite à tenir : Surveillance clinique et augmentation éventuelle de la posologie de la clozapine durant le traitement par la rifampicine."))
  (interaction
    (title "COBICISTAT + ETRAVIRINE")
    (level "Association DECONSEILLEE")
    (drugs-a "cobicistat")
    (drugs-b "etravirine")
    (alert "Interaction COBICISTAT + ETRAVIRINE (Association DECONSEILLEE) : Risque de diminution des concentrations plasmatiques du cobicistat par l’étravirine."))
  (interaction
    (title "COBICISTAT + GLUCOCORTICOÏDES PAR VOIE INTRA-ARTICULAIRE ET MÉTABOLISÉS")
    (level "Précaution d'emploi")
    (drugs-a "cobicistat")
    (drugs-b "betamethasone" "dexamethasone" "methylprednisolone" "triamcinolone")
    (alert "Interaction COBICISTAT + GLUCOCORTICOÏDES PAR VOIE INTRA-ARTICULAIRE ET MÉTABOLISÉS (Précaution d'emploi) : Décrit chez des patients HIV. Risque d’insuffisance surrénale aiguë, même en cas d’injection unique. L’articulation peut constituer un réservoir relarguant de façon continue le corticoïde CYP3A4-dépendant dans la circulation générale, avec augmentation possiblement très importante des concentrations du corticoïde, à l’origine d’une freination de la réponse hypothalamo- hypophysaire. Conduite à tenir : Préférer un corticoïde non CYP3A4-dépendant (hydrocortisone)."))
  (interaction
    (title "COBICISTAT + INDUCTEURS ENZYMATIQUES PUISSANTS")
    (level "CONTRE-INDICATION")
    (drugs-a "cobicistat")
    (drugs-b "apalutamide" "carbamazepine" "enzalutamide" "fosphenytoine" "phenobarbital" "phenytoine" "primidone")
    (alert "Interaction COBICISTAT + INDUCTEURS ENZYMATIQUES PUISSANTS (CONTRE-INDICATION) : Risque de diminution de l’efficacité du cobicistat par augmentation de son métabolisme par l’inducteur."))
  (interaction
    (title "COBICISTAT + MILLEPERTUIS")
    (level "CONTRE-INDICATION")
    (drugs-a "cobicistat")
    (drugs-b "millepertuis")
    (alert "Interaction COBICISTAT + MILLEPERTUIS (CONTRE-INDICATION) : Risque de diminution de l’efficacité du cobicistat par augmentation de son métabolisme par l’inducteur."))
  (interaction
    (title "COBICISTAT + QUINIDINE")
    (level "CONTRE-INDICATION")
    (drugs-a "cobicistat")
    (drugs-b "quinidine")
    (alert "Interaction COBICISTAT + QUINIDINE (CONTRE-INDICATION) : Risque de majoration des effets indésirables de la quinidine par diminution de son métabolisme par le cobicistat. Conduite à tenir : Surveillance clinique."))
  (interaction
    (title "COBICISTAT + RIFABUTINE")
    (level "Précaution d'emploi")
    (drugs-a "cobicistat")
    (drugs-b "rifabutine")
    (alert "Interaction COBICISTAT + RIFABUTINE (Précaution d'emploi) : Augmentation très importante du métabolite de la rifabutine, avec risque de majoration de sa toxicité (uvéites, neutropénies). Par ailleurs, possible diminution des concentrations de cobicistat. Conduite à tenir : Réduction de la dose de rifabutine (150 mg 1 jour sur deux). Surveillance clinique et biologique régulière, notamment en début d'association."))
  (interaction
    (title "COBICISTAT + RIFAMPICINE")
    (level "CONTRE-INDICATION")
    (drugs-a "cobicistat")
    (drugs-b "rifampicine")
    (alert "Interaction COBICISTAT + RIFAMPICINE (CONTRE-INDICATION) : Risque de diminution de l’efficacité du cobicistat par augmentation de son métabolisme par l’inducteur."))
  (interaction
    (title "COBICISTAT + TÉNOFOVIR ALAFÉNAMIDE")
    (level "Précaution d'emploi")
    (drugs-a "cobicistat")
    (drugs-b "tenofovir alafenamide")
    (alert "Interaction COBICISTAT + TÉNOFOVIR ALAFÉNAMIDE (Précaution d'emploi) : Avec l'atazanavir, le darunavir ou le lopinavir boostés par cobicistat, augmentation des concentrations plasmatiques du ténofovir alafénamide par augmentation de son absorption. Conduite à tenir : En cas de co-administration, la dose de ténofovir alafénamide doit être limitée à 10 mg par jour. L’association avec les autres inhibiteurs de protéases du VIH n’a pas été étudiée."))
  (interaction
    (title "COBIMÉTINIB + DÉFIBROTIDE")
    (level "Précaution d'emploi")
    (drugs-a "cobimetinib")
    (drugs-b "defibrotide")
    (alert "Interaction COBIMÉTINIB + DÉFIBROTIDE (Précaution d'emploi) : Augmentation du risque hémorragique. Conduite à tenir : Surveillance clinique."))
  (interaction
    (title "COBIMÉTINIB + GLUCOCORTICOÏDES (SAUF HYDROCORTISONE)")
    (level "Précaution d'emploi")
    (drugs-a "cobimetinib")
    (drugs-b "betamethasone" "budesonide" "cortisone" "cortivazol" "dexamethasone" "methylprednisolone" "prednisolone" "prednisone" "tetracosactide" "triamcinolone")
    (alert "Interaction COBIMÉTINIB + GLUCOCORTICOÏDES (SAUF HYDROCORTISONE) (Précaution d'emploi) : Augmentation du risque hémorragique. Conduite à tenir : Surveillance clinique."))
  (interaction
    (title "COBIMÉTINIB + HÉPARINES")
    (level "Précaution d'emploi")
    (drugs-a "cobimetinib")
    (drugs-b "dalteparine sodique" "danaparoide sodique" "enoxaparine" "fondaparinux" "heparine calcique" "heparine sodique" "nadroparine calcique" "reviparine" "tinzaparine")
    (alert "Interaction COBIMÉTINIB + HÉPARINES (Précaution d'emploi) : Augmentation du risque hémorragique. Conduite à tenir : Surveillance clinique."))
  (interaction
    (title "COBIMÉTINIB + INHIBITEURS SÉLECTIFS DE LA RECAPTURE DE LA SÉROTONINE")
    (level "Précaution d'emploi")
    (drugs-a "cobimetinib")
    (drugs-b "citalopram" "dapoxetine" "escitalopram" "fluoxetine" "fluvoxamine" "paroxetine" "sertraline" "vortioxetine")
    (alert "Interaction COBIMÉTINIB + INHIBITEURS SÉLECTIFS DE LA RECAPTURE DE LA SÉROTONINE (Précaution d'emploi) : Augmentation du risque hémorragique. Conduite à tenir : Surveillance clinique."))
  (interaction
    (title "COBIMÉTINIB + MÉDICAMENTS MIXTES ADRÉNERGIQUES-SÉROTONINERGIQUES")
    (level "Précaution d'emploi")
    (drugs-a "cobimetinib")
    (drugs-b "amitriptyline" "clomipramine" "duloxetine" "imipramine" "milnacipran" "oxitriptan" "venlafaxine")
    (alert "Interaction COBIMÉTINIB + MÉDICAMENTS MIXTES ADRÉNERGIQUES-SÉROTONINERGIQUES (Précaution d'emploi) : Augmentation du risque hémorragique. Conduite à tenir : Surveillance clinique."))
  (interaction
    (title "COBIMÉTINIB + PENTOXIFYLLINE")
    (level "Précaution d'emploi")
    (drugs-a "cobimetinib")
    (drugs-b "pentoxifylline")
    (alert "Interaction COBIMÉTINIB + PENTOXIFYLLINE (Précaution d'emploi) : Augmentation du risque hémorragique. Conduite à tenir : Surveillance clinique."))
  (interaction
    (title "CODEINE + DULOXETINE")
    (level "Association DECONSEILLEE")
    (drugs-a "codeine")
    (drugs-b "duloxetine")
    (alert "Interaction CODEINE + DULOXETINE (Association DECONSEILLEE) : Risque d’inefficacité de l’opiacé par inhibition de son métabolisme par l’inhibiteur."))
  (interaction
    (title "CODEINE + FLUOXETINE")
    (level "Association DECONSEILLEE")
    (drugs-a "codeine")
    (drugs-b "fluoxetine")
    (alert "Interaction CODEINE + FLUOXETINE (Association DECONSEILLEE) : Diminution de l’efficacité de l’opiacé par inhibition de son métabolisme par l’inhibiteur."))
  (interaction
    (title "CODEINE + PAROXETINE")
    (level "Association DECONSEILLEE")
    (drugs-a "codeine")
    (drugs-b "paroxetine")
    (alert "Interaction CODEINE + PAROXETINE (Association DECONSEILLEE) : Diminution de l’efficacité de l’opiacé par inhibition de son métabolisme par l’inhibiteur."))
  (interaction
    (title "CODEINE + QUINIDINE")
    (level "Association DECONSEILLEE")
    (drugs-a "codeine")
    (drugs-b "quinidine")
    (alert "Interaction CODEINE + QUINIDINE (Association DECONSEILLEE) : Diminution de l’efficacité de l’opiacé par inhibition de son métabolisme par l’inhibiteur."))
  (interaction
    (title "CODEINE + TERBINAFINE")
    (level "Association DECONSEILLEE")
    (drugs-a "codeine")
    (drugs-b "terbinafine")
    (alert "Interaction CODEINE + TERBINAFINE (Association DECONSEILLEE) : Risque d’inefficacité de l’opiacé par inhibition de son métabolisme par l’inhibiteur."))
  (interaction
    (title "COLCHICINE + FIBRATES")
    (level "Précaution d'emploi")
    (drugs-a "colchicine")
    (drugs-b "bezafibrate" "ciprofibrate" "fenofibrate" "gemfibrozil")
    (alert "Interaction COLCHICINE + FIBRATES (Précaution d'emploi) : Risque de majoration des effets indésirables musculaires de ces substances, et notamment de rhabdomyolyse. Conduite à tenir : Surveillance clinique et biologique, particulièrement au début de l’association."))
  (interaction
    (title "COLCHICINE + FLUCONAZOLE")
    (level "Association DECONSEILLEE")
    (drugs-a "colchicine")
    (drugs-b "fluconazole")
    (alert "Interaction COLCHICINE + FLUCONAZOLE (Association DECONSEILLEE) : Augmentation des effets indésirables de la colchicine, aux conséquences potentiellement fatales."))
  (interaction
    (title "COLCHICINE + INHIBITEURS DE L'HMG-COA RÉDUCTASE (STATINES)")
    (level "Précaution d'emploi")
    (drugs-a "colchicine")
    (drugs-b "atorvastatine" "fluvastatine" "pitavastatine" "pravastatine" "rosuvastatine" "simvastatine")
    (alert "Interaction COLCHICINE + INHIBITEURS DE L'HMG-COA RÉDUCTASE (STATINES) (Précaution d'emploi) : Risque de majoration des effets indésirables musculaires de ces substances, et notamment de rhabdomyolyse. Conduite à tenir : Surveillance clinique et biologique, notamment au début de l'association."))
  (interaction
    (title "COLCHICINE + INHIBITEURS PUISSANTS DU CYP3A4")
    (level "CI - ASDEC")
    (drugs-a "colchicine")
    (drugs-b "clarithromycine" "cobicistat" "erythromycine" "itraconazole" "ketoconazole" "posaconazole" "ritonavir" "telithromycine" "tucatinib" "voriconazole")
    (alert "Interaction COLCHICINE + INHIBITEURS PUISSANTS DU CYP3A4 (CI - ASDEC) : Augmentation des effets indésirables de la colchicine, aux conséquences potentiellement fatales. Conduite à tenir : Contre-indication : - avec les macrolides Association déconseillée : - avec les antifongiques azolés, les inhibiteurs de protéases boostés par ritonavir et le cobicistat."))
  (interaction
    (title "COLCHICINE + MACROLIDES (SAUF SPIRAMYCINE)")
    (level "CONTRE-INDICATION")
    (drugs-a "colchicine")
    (drugs-b "azithromycine" "clarithromycine" "erythromycine" "josamycine" "midecamycine" "roxithromycine" "telithromycine")
    (alert "Interaction COLCHICINE + MACROLIDES (SAUF SPIRAMYCINE) (CONTRE-INDICATION) : Augmentation des effets indésirables de la colchicine, aux conséquences potentiellement fatales."))
  (interaction
    (title "COLCHICINE + OMBITASVIR + PARITAPRÉVIR")
    (level "CI - ASDEC")
    (drugs-a "colchicine")
    (drugs-b "ombitasvir" "paritaprevir")
    (alert "Interaction COLCHICINE + OMBITASVIR + PARITAPRÉVIR (CI - ASDEC) : Augmentation des concentrations plasmatiques de la colchicine par diminution de son métabolisme hépatique par la bithérapie. Conduite à tenir : Contre-indication: - chez les patients insuffisants rénaux et/ou hépatiques. Association déconseillée - chez les patients ayant une fonction rénale et hépatique normale. Si l’association s'avère nécessaire, une réduction de la dose de colchicine ou une interruption du traitement par la colchicine est recommandée."))
  (interaction
    (title "COLCHICINE + PONATINIB")
    (level "Précaution d'emploi")
    (drugs-a "colchicine")
    (drugs-b "ponatinib")
    (alert "Interaction COLCHICINE + PONATINIB (Précaution d'emploi) : Risque d’augmentation des concentrations plasmatiques de la colchicine par augmentation de son absorption intestinale par le ponatinib. Conduite à tenir : Surveillance clinique et biologique étroite pendant l’association."))
  (interaction
    (title "COLCHICINE + PRISTINAMYCINE")
    (level "CONTRE-INDICATION")
    (drugs-a "colchicine")
    (drugs-b "pristinamycine")
    (alert "Interaction COLCHICINE + PRISTINAMYCINE (CONTRE-INDICATION) : Augmentation des effets indésirables de la colchicine aux conséquences potentiellement fatales."))
  (interaction
    (title "COLCHICINE + ROLAPITANT")
    (level "Précaution d'emploi")
    (drugs-a "colchicine")
    (drugs-b "rolapitant")
    (alert "Interaction COLCHICINE + ROLAPITANT (Précaution d'emploi) : Risque d’augmentation des effets indésirables de la colchicine, aux conséquences potentiellement fatales. Conduite à tenir : Surveillance clinique et biologique étroite pendant l’association."))
  (interaction
    (title "COLCHICINE + VERAPAMIL")
    (level "Association DECONSEILLEE")
    (drugs-a "colchicine")
    (drugs-b "verapamil")
    (alert "Interaction COLCHICINE + VERAPAMIL (Association DECONSEILLEE) : Risque de majoration des effets indésirables de la colchicine, par augmentation de ses concentrations plasmatiques par le vérapamil."))
  (interaction
    (title "COLISTINE + CURARES")
    (level "Précaution d'emploi")
    (drugs-a "colistine")
    (drugs-b "atracurium" "cisatracurium" "mivacurium" "rocuronium" "suxamethonium" "vecuronium")
    (alert "Interaction COLISTINE + CURARES (Précaution d'emploi) : Potentialisation des curares lorque l'antibiotique est administré par voie parentérale et/ou péritonéale avant, pendant ou après l'agent curarisant. Conduite à tenir : Surveiller le degré de curarisation en fin d'anesthésie."))
  (interaction
    (title "CORTICOÏDES + MIFAMURTIDE")
    (level "Association DECONSEILLEE")
    (drugs-a "betamethasone" "cortisone" "cortivazol" "desoxycortone" "dexamethasone" "fludrocortisone" "hydrocortisone" "methylprednisolone" "prednisolone" "prednisone" "tetracosactide" "triamcinolone")
    (drugs-b "mifamurtide")
    (alert "Interaction CORTICOÏDES + MIFAMURTIDE (Association DECONSEILLEE) : Risque de moindre efficacité du mifamurtide."))
  (interaction
    (title "CORTICOÏDES MÉTABOLISÉS, NOTAMMENT INHALÉS + INHIBITEURS PUISSANTS DU CYP3A4")
    (level "Association DECONSEILLEE")
    (drugs-a "budesonide" "ciclesonide" "dexamethasone" "fluticasone" "methylprednisolone" "mometasone" "prednisolone" "prednisone" "triamcinolone")
    (drugs-b "clarithromycine" "cobicistat" "erythromycine" "itraconazole" "ketoconazole" "posaconazole" "ritonavir" "telithromycine" "tucatinib" "voriconazole")
    (alert "Interaction CORTICOÏDES MÉTABOLISÉS, NOTAMMENT INHALÉS + INHIBITEURS PUISSANTS DU CYP3A4 (Association DECONSEILLEE) : En cas d’utilisation prolongée par voie orale ou inhalée : augmentation des concentrations plasmatiques du corticoïde par diminution de son métabolisme hépatique par l’inhibiteur, avec risque d’apparition d’un syndrome cushingoïde voire d’une insuffisance surrénalienne. Conduite à tenir : Préférer un corticoïde non métabolisé."))
  (interaction
    (title "CRIZOTINIB + IBRUTINIB")
    (level "Association DECONSEILLEE")
    (drugs-a "crizotinib")
    (drugs-b "ibrutinib")
    (alert "Interaction CRIZOTINIB + IBRUTINIB (Association DECONSEILLEE) : Risque d’augmentation des concentrations plasmatiques d’ibrutinib par diminution de son métabolisme hépatique par le crizotinib. Conduite à tenir : Si l’association ne peut être évitée, surveillance clinique étroite et réduction de la dose d’ibrutinib à 280 mg par jour pendant la durée de l’association."))
  (interaction
    (title "CRIZOTINIB + SUBSTANCES SUSCEPTIBLES DE DONNER DES TORSADES DE POINTES")
    (level "Association DECONSEILLEE")
    (drugs-a "crizotinib")
    (drugs-b "amiodarone" "amisulpride" "arsenieux" "chloroquine" "chlorpromazine" "citalopram" "cocaine" "crizotinib" "cyamemazine" "disopyramide" "domperidone" "dronedarone" "droperidol" "erythromycine" "escitalopram" "flupentixol" "fluphenazine" "halofantrine" "haloperidol" "hydroquinidine" "hydroxychloroquine" "hydroxyzine" "levomepromazine" "lumefantrine" "mequitazine" "methadone" "moxifloxacine" "pentamidine" "pimozide" "pipamperone" "piperaquine" "pipotiazine" "quinidine" "sotalol" "spiramycine" "sulpiride" "tiapride" "toremifene" "vandetanib" "vincamine" "zuclopenthixol")
    (alert "Interaction CRIZOTINIB + SUBSTANCES SUSCEPTIBLES DE DONNER DES TORSADES DE POINTES (Association DECONSEILLEE) : Risque majoré de troubles du rythme ventriculaire, notamment de torsades de pointes. Conduite à tenir : Contre-indication : - avec le citalopram, la dompéridone, l'escitalopram, l'hydroxyzine et la pipéraquine. Association déconseillée: - avec les autres médicaments susceptibles de donner des torsades de pointes. Si l’association ne peut être évitée, contrôle clinique et électrocardiographique régulier."))
  (interaction
    (title "CRIZOTINIB + SUBSTRATS À RISQUE DU CYP3A4")
    (level "Association DECONSEILLEE")
    (drugs-a "crizotinib")
    (drugs-b "abemaciclib" "alfentanil" "apixaban" "atorvastatine" "axitinib" "bortezomib" "bosutinib" "brigatinib" "cabazitaxel" "cabozantinib" "ceritinib" "ciclosporine" "cobimetinib" "crizotinib" "dabrafenib" "dasatinib" "dihydroergotamine" "docetaxel" "ergotamine" "erlotinib" "everolimus" "gefitinib" "halofantrine" "ibrutinib" "imatinib" "irinotecan" "lapatinib" "lorlatinib" "lumefantrine" "midazolam" "nilotinib" "osimertinib" "oxycodone" "paclitaxel" "palbociclib" "pazopanib" "pimozide" "ponatinib" "quetiapine" "quinine" "rivaroxaban" "ruxolitinib" "simvastatine" "sirolimus" "sorafenib" "sufentanil" "sunitinib" "tacrolimus" "temsirolimus" "ticagrelor" "vandetanib" "vinblastine" "vincristine" "vindesine" "vinflunine" "vinorelbine")
    (alert "Interaction CRIZOTINIB + SUBSTRATS À RISQUE DU CYP3A4 (Association DECONSEILLEE) : Risque de majoration de la toxicité de ces molécules par diminution de leur métabolisme et/ou augmentation de leur biodisponibilité par le crizotinib."))
  (interaction
    (title "CURARES + LINCOSANIDES")
    (level "Précaution d'emploi")
    (drugs-a "atracurium" "cisatracurium" "mivacurium" "rocuronium" "suxamethonium" "vecuronium")
    (drugs-b "clindamycine" "lincomycine")
    (alert "Interaction CURARES + LINCOSANIDES (Précaution d'emploi) : Potentialisation des curares lorque l'antibiotique est administré par voie parentérale et/ou péritonéale avant, pendant ou après l'agent curarisant. Conduite à tenir : Surveiller le degré de curarisation en fin d'anesthésie."))
  (interaction
    (title "CURARES + POLYMYXINE B")
    (level "Précaution d'emploi")
    (drugs-a "atracurium" "cisatracurium" "mivacurium" "rocuronium" "suxamethonium" "vecuronium")
    (drugs-b "polymyxine b")
    (alert "Interaction CURARES + POLYMYXINE B (Précaution d'emploi) : Potentialisation des curares lorque l'antibiotique est administré par voie parentérale et/ou péritonéale avant, pendant ou après l'agent curarisant. Conduite à tenir : Surveiller le degré de curarisation en fin d'anesthésie."))
  (interaction
    (title "CYCLINES + FER")
    (level "Précaution d'emploi")
    (drugs-a "chlortetracycline" "demeclocycline" "doxycycline" "lymecycline" "methylenecycline" "minocycline" "oxytetracycline" "tetracycline" "tigecycline")
    (drugs-b "fer")
    (alert "Interaction CYCLINES + FER (Précaution d'emploi) : Diminution de l'absorption digestive des cyclines et du fer. Conduite à tenir : Prendre les sels de fer à distance des cyclines (plus de 2 heures, si possible)."))
  (interaction
    (title "CYCLINES + RÉTINOÏDES")
    (level "CONTRE-INDICATION")
    (drugs-a "chlortetracycline" "demeclocycline" "doxycycline" "lymecycline" "methylenecycline" "minocycline" "oxytetracycline" "tetracycline" "tigecycline")
    (drugs-b "acitretine" "alitretinoine" "isotretinoine" "tretinoine")
    (alert "Interaction CYCLINES + RÉTINOÏDES (CONTRE-INDICATION) : Risque d'hypertension intracrânienne."))
  (interaction
    (title "CYCLINES + STRONTIUM")
    (level "Précaution d'emploi")
    (drugs-a "chlortetracycline" "demeclocycline" "doxycycline" "lymecycline" "methylenecycline" "minocycline" "oxytetracycline" "tetracycline" "tigecycline")
    (drugs-b "strontium")
    (alert "Interaction CYCLINES + STRONTIUM (Précaution d'emploi) : Diminution de l'absorption digestive du strontium. Conduite à tenir : Prendre le strontium à distance des cyclines (plus de deux heures, si possible)."))
  (interaction
    (title "CYCLINES + VITAMINE A")
    (level "CONTRE-INDICATION")
    (drugs-a "chlortetracycline" "demeclocycline" "doxycycline" "lymecycline" "methylenecycline" "minocycline" "oxytetracycline" "tetracycline" "tigecycline")
    (drugs-b "vitamine a")
    (alert "Interaction CYCLINES + VITAMINE A (CONTRE-INDICATION) : En cas d'apport de 10,000 UI/j et plus : risque d’hypertension intracrânienne."))
  (interaction
    (title "CYCLINES + ZINC")
    (level "Précaution d'emploi")
    (drugs-a "chlortetracycline" "demeclocycline" "doxycycline" "lymecycline" "methylenecycline" "minocycline" "oxytetracycline" "tetracycline" "tigecycline")
    (drugs-b "zinc")
    (alert "Interaction CYCLINES + ZINC (Précaution d'emploi) : Diminution de l'absorption digestive des cyclines. Conduite à tenir : Prendre les sels de zinc à distance des cyclines (plus de 2 heures si possible)."))
  (interaction
    (title "CYCLOPHOSPHAMIDE + INDUCTEURS ENZYMATIQUES")
    (level "Association DECONSEILLEE")
    (drugs-a "cyclophosphamide")
    (drugs-b "apalutamide" "carbamazepine" "cenobamate" "dabrafenib" "efavirenz" "enzalutamide" "eslicarbazepine" "fosphenytoine" "letermovir" "lorlatinib" "lumacaftor" "nevirapine" "oxcarbazepine" "phenobarbital" "phenytoine" "pitolisant" "primidone" "rifabutine" "rifampicine" "sotorasib")
    (alert "Interaction CYCLOPHOSPHAMIDE + INDUCTEURS ENZYMATIQUES (Association DECONSEILLEE) : Risque d’augmentation des concentrations plasmatiques du métabolite actif du cyclophosphamide par l'inducteur, et donc de sa toxicité."))
  (interaction
    (title "CYCLOPHOSPHAMIDE + MILLEPERTUIS")
    (level "CONTRE-INDICATION")
    (drugs-a "cyclophosphamide")
    (drugs-b "millepertuis")
    (alert "Interaction CYCLOPHOSPHAMIDE + MILLEPERTUIS (CONTRE-INDICATION) : Risque d’augmentation des concentrations plasmatiques du métabolite actif du cyclophosphamide par le millepertuis, et donc de sa toxicité."))
  (interaction
    (title "CYCLOPHOSPHAMIDE + PENTOSTATINE")
    (level "Association DECONSEILLEE")
    (drugs-a "cyclophosphamide")
    (drugs-b "pentostatine")
    (alert "Interaction CYCLOPHOSPHAMIDE + PENTOSTATINE (Association DECONSEILLEE) : Majoration du risque de toxicité pulmonaire pouvant être fatale."))
  (interaction
    (title "CYPROTERONE + INDUCTEURS ENZYMATIQUES")
    (level "ASDEC - PE")
    (drugs-a "cyproterone")
    (drugs-b "apalutamide" "carbamazepine" "cenobamate" "dabrafenib" "efavirenz" "enzalutamide" "eslicarbazepine" "fosphenytoine" "letermovir" "lorlatinib" "lumacaftor" "nevirapine" "oxcarbazepine" "phenobarbital" "phenytoine" "pitolisant" "primidone" "rifabutine" "rifampicine" "sotorasib")
    (alert "Interaction CYPROTERONE + INDUCTEURS ENZYMATIQUES (ASDEC - PE) : Risque de diminution de l'efficacité de la cyprotérone. Conduite à tenir : Association déconseillée: - dans son utilisation comme contraceptif hormonal: utiliser de préférence une autre méthode de contraception en particulier de type mécanique, pendant la durée de l'association et un cycle suivant. Précaution d'emploi - dans ses indications comme anti-androgène: surveillance clinique et adaptation éventuelle de la posologie de la cyprotérone pendant l'association et après son arrêt."))
  (interaction
    (title "CYPROTERONE + INHIBITEURS DE PROTÉASES BOOSTÉS PAR RITONAVIR")
    (level "ASDEC - PE")
    (drugs-a "cyproterone")
    (drugs-b "atazanavir" "darunavir" "fosamprenavir" "lopinavir" "nirmatrelvir" "ritonavir" "saquinavir" "tipranavir")
    (alert "Interaction CYPROTERONE + INHIBITEURS DE PROTÉASES BOOSTÉS PAR RITONAVIR (ASDEC - PE) : Risque de diminution de l'efficacité de la cyprotérone. Conduite à tenir : Association déconseillée - dans son utilisation comme contraceptif hormonal: utiliser de préférence une autre méthode de contraception en particulier de type mécanique, pendant la durée de l'association et un cycle suivant. Précaution d'emploi - dans ses indications comme anti-androgène: surveillance clinique et adaptation éventuelle de la posologie de la cyprotérone pendant l'association et après son arrêt."))
  (interaction
    (title "CYPROTERONE + MILLEPERTUIS")
    (level "CONTRE-INDICATION")
    (drugs-a "cyproterone")
    (drugs-b "millepertuis")
    (alert "Interaction CYPROTERONE + MILLEPERTUIS (CONTRE-INDICATION) : Risque de diminution de l'efficacité de la cyprotérone, par augmentation de son métabolisme hépatique par le millepertuis."))
  (interaction
    (title "CYPROTERONE + PÉRAMPANEL")
    (level "Association DECONSEILLEE")
    (drugs-a "cyproterone")
    (drugs-b "perampanel")
    (alert "Interaction CYPROTERONE + PÉRAMPANEL (Association DECONSEILLEE) : Pour des doses de pérampanel > ou = à 12 mg/jour, risque de diminution de l'efficacité de la cyprotérone. Conduite à tenir : Dans son utilisation comme contraceptif hormonal: utiliser de préférence une autre méthode de contraception en particulier de type mécanique, pendant la durée de l'association et un cycle suivant."))
  (interaction
    (title "CYPROTERONE + ULIPRISTAL")
    (level "ASDEC - APEC")
    (drugs-a "cyproterone")
    (drugs-b "ulipristal")
    (alert "Interaction CYPROTERONE + ULIPRISTAL (ASDEC - APEC) : Dans l'indication contraception d'urgence de l'ulipristal : Antagonisme des effets de l’ulipristal en cas de reprise d’un contraceptif hormonal moins de 5 jours après la prise de la contraception d’urgence. Dans l’indication fibrome de l'ulipristal : Antagonisme réciproque des effets de l’ulipristal et du progestatif, avec risque d’inefficacité. Conduite à tenir : Association déconseillée Dans l'utilisation à visée contraceptive de la cyprotérone - Dans l'indication contraception d'urgence de l'ulipristal Dans le cas où la (re)prise d’une contraception hormonale est envisagée, utiliser une contraception additionnelle de type mécanique pendant les 12 jours qui suivent la (dernière) prise de l’ulipristal (au cas où il y en aurait eu plus d’une). - Dans l’indication fibrome de l'ulipristal : Dans le cas où la (re)prise d’une contraception hormonale est envisagée, utiliser une contraception de type mécanique pendant les 7 premiers jours de la contraception hormonale. Association à prendre en compte Lorsque la cyprotérone n'est pas à visée contraceptive."))
  (interaction
    (title "CYTOTOXIQUES + OLAPARIB")
    (level "Association DECONSEILLEE")
    (drugs-a "altretamine" "amsacrine" "asparaginase" "azacitidine" "azathioprine" "bendamustine" "bleomycine" "bortezomib" "busulfan" "cabazitaxel" "capecitabine" "carboplatine" "carmustine" "chlorambucil" "cisplatine" "cladribine" "clofarabine" "cyclophosphamide" "cytarabine" "dacarbazine" "dactinomycine" "daunorubicine" "decitabine" "dexrazoxane" "docetaxel" "doxorubicine" "epirubicine" "eribuline" "estramustine" "etoposide" "fludarabine" "fluorouracile" "fotemustine" "gemcitabine" "gimeracil" "hydroxycarbamide" "idarubicine" "ifosfamide" "irinotecan" "lomustine" "melphalan" "mercaptopurine" "methotrexate" "mitomycine c" "mitoxantrone" "nelarabine" "oteracil" "oxaliplatine" "paclitaxel" "pemetrexed" "pentostatine" "pipobroman" "pixantrone" "procarbazine" "raltitrexed" "streptozocine" "tegafur" "temozolomide" "thiotepa" "tioguanine" "topotecane" "vinblastine" "vincristine" "vindesine" "vinflunine" "vinorelbine")
    (drugs-b "olaparib")
    (alert "Interaction CYTOTOXIQUES + OLAPARIB (Association DECONSEILLEE) : Risque de majoration de l’effet myélosuppresseur du cytotoxique."))
  (interaction
    (title "CYTOTOXIQUES + PHÉNYTOÏNE (ET, PAR EXTRAPOLATION, FOSPHÉNYTOÏNE)")
    (level "Association DECONSEILLEE")
    (drugs-a "altretamine" "amsacrine" "asparaginase" "azacitidine" "azathioprine" "bendamustine" "bleomycine" "bortezomib" "busulfan" "cabazitaxel" "capecitabine" "carboplatine" "carmustine" "chlorambucil" "cisplatine" "cladribine" "clofarabine" "cyclophosphamide" "cytarabine" "dacarbazine" "dactinomycine" "daunorubicine" "decitabine" "dexrazoxane" "docetaxel" "doxorubicine" "epirubicine" "eribuline" "estramustine" "etoposide" "fludarabine" "fluorouracile" "fotemustine" "gemcitabine" "gimeracil" "hydroxycarbamide" "idarubicine" "ifosfamide" "irinotecan" "lomustine" "melphalan" "mercaptopurine" "methotrexate" "mitomycine c" "mitoxantrone" "nelarabine" "oteracil" "oxaliplatine" "paclitaxel" "pemetrexed" "pentostatine" "pipobroman" "pixantrone" "procarbazine" "raltitrexed" "streptozocine" "tegafur" "temozolomide" "thiotepa" "tioguanine" "topotecane" "vinblastine" "vincristine" "vindesine" "vinflunine" "vinorelbine")
    (drugs-b "fosphenytoine" "phenytoine")
    (alert "Interaction CYTOTOXIQUES + PHÉNYTOÏNE (ET, PAR EXTRAPOLATION, FOSPHÉNYTOÏNE) (Association DECONSEILLEE) : Risque de survenue de convulsions par diminution de l'absorption digestive de la seule phénytoïne par le cytotoxique, ou bien risque de majoration de la toxicité ou de perte d'efficacité du cytotoxique par augmentation de son métabolisme hépatique par la phénytoïne ou la fosphénytoïne."))
  (interaction
    (title "CYTOTOXIQUES + VACCINS VIVANTS ATTÉNUÉS")
    (level "CONTRE-INDICATION")
    (drugs-a "altretamine" "amsacrine" "asparaginase" "azacitidine" "azathioprine" "bendamustine" "bleomycine" "bortezomib" "busulfan" "cabazitaxel" "capecitabine" "carboplatine" "carmustine" "chlorambucil" "cisplatine" "cladribine" "clofarabine" "cyclophosphamide" "cytarabine" "dacarbazine" "dactinomycine" "daunorubicine" "decitabine" "dexrazoxane" "docetaxel" "doxorubicine" "epirubicine" "eribuline" "estramustine" "etoposide" "fludarabine" "fluorouracile" "fotemustine" "gemcitabine" "gimeracil" "hydroxycarbamide" "idarubicine" "ifosfamide" "irinotecan" "lomustine" "melphalan" "mercaptopurine" "methotrexate" "mitomycine c" "mitoxantrone" "nelarabine" "oteracil" "oxaliplatine" "paclitaxel" "pemetrexed" "pentostatine" "pipobroman" "pixantrone" "procarbazine" "raltitrexed" "streptozocine" "tegafur" "temozolomide" "thiotepa" "tioguanine" "topotecane" "vinblastine" "vincristine" "vindesine" "vinflunine" "vinorelbine")
    (drugs-b "bcg" "rotavirus" "virus de la fievre jaune" "virus de la rougeole" "virus des oreillons" "virus rubeoleux" "virus varicelle-zona" "virus vivant attenue de la grippe")
    (alert "Interaction CYTOTOXIQUES + VACCINS VIVANTS ATTÉNUÉS (CONTRE-INDICATION) : Risque de maladie vaccinale généralisée éventuellement mortelle. Conduite à tenir : - Et pendant les 6 mois suivant l'arrêt de la chimiothérapie. - Et, à l'exception de l'hydroxycarbamide dans son indication chez le patient drépanocytaire."))
  (interaction
    (title "DABIGATRAN + DRONEDARONE")
    (level "CONTRE-INDICATION")
    (drugs-a "dabigatran")
    (drugs-b "dronedarone")
    (alert "Interaction DABIGATRAN + DRONEDARONE (CONTRE-INDICATION) : Doublement des concentrations plasmatiques de dabigatran, avec majoration du risque de saignement."))
  (interaction
    (title "DABIGATRAN + GLÉCAPRÉVIR + PIBRENTASVIR")
    (level "CONTRE-INDICATION")
    (drugs-a "dabigatran")
    (drugs-b "glecaprevir" "pibrentasvir")
    (alert "Interaction DABIGATRAN + GLÉCAPRÉVIR + PIBRENTASVIR (CONTRE-INDICATION) : Doublement des concentrations plasmatiques de dabigatran, avec majoration du risque de saignements."))
  (interaction
    (title "DABIGATRAN + INDUCTEURS ENZYMATIQUES PUISSANTS")
    (level "Association DECONSEILLEE")
    (drugs-a "dabigatran")
    (drugs-b "apalutamide" "carbamazepine" "enzalutamide" "fosphenytoine" "phenobarbital" "phenytoine" "primidone")
    (alert "Interaction DABIGATRAN + INDUCTEURS ENZYMATIQUES PUISSANTS (Association DECONSEILLEE) : Diminution des concentrations plasmatiques de dabigatran, avec risque de diminution de l'effet thérapeutique."))
  (interaction
    (title "DABIGATRAN + ITRACONAZOLE")
    (level "CONTRE-INDICATION")
    (drugs-a "dabigatran")
    (drugs-b "itraconazole")
    (alert "Interaction DABIGATRAN + ITRACONAZOLE (CONTRE-INDICATION) : Augmentation de plus du double des concentrations plasmatiques de dabigatran, avec majoration du risque de saignement."))
  (interaction
    (title "DABIGATRAN + KETOCONAZOLE")
    (level "CONTRE-INDICATION")
    (drugs-a "dabigatran")
    (drugs-b "ketoconazole")
    (alert "Interaction DABIGATRAN + KETOCONAZOLE (CONTRE-INDICATION) : Augmentation de plus du double des concentrations plasmatiques de dabigatran, avec majoration du risque de saignement."))
  (interaction
    (title "DABIGATRAN + PONATINIB")
    (level "Précaution d'emploi")
    (drugs-a "dabigatran")
    (drugs-b "ponatinib")
    (alert "Interaction DABIGATRAN + PONATINIB (Précaution d'emploi) : Risque d’augmentation des concentrations plasmatiques du dabigatran par augmentation de son absorption intestinale par le ponatinib. Conduite à tenir : Surveillance clinique et biologique étroite pendant l’association."))
  (interaction
    (title "DABIGATRAN + QUINIDINE")
    (level "Précaution d'emploi")
    (drugs-a "dabigatran")
    (drugs-b "quinidine")
    (alert "Interaction DABIGATRAN + QUINIDINE (Précaution d'emploi) : Augmentation des concentrations plasmatiques de dabigatran, avec majoration du risque de saignement. Conduite à tenir : Dans l'indication post-chirurgicale : surveillance clinique et adaptation de la posologie du dabigatran à 150 mg/j en une prise."))
  (interaction
    (title "DABIGATRAN + RIFAMPICINE")
    (level "Association DECONSEILLEE")
    (drugs-a "dabigatran")
    (drugs-b "rifampicine")
    (alert "Interaction DABIGATRAN + RIFAMPICINE (Association DECONSEILLEE) : Diminution des concentrations plasmatiques de dabigatran, avec risque de diminution de l'effet thérapeutique."))
  (interaction
    (title "DABIGATRAN + ROLAPITANT")
    (level "Précaution d'emploi")
    (drugs-a "dabigatran")
    (drugs-b "rolapitant")
    (alert "Interaction DABIGATRAN + ROLAPITANT (Précaution d'emploi) : Risque d’augmentation des concentrations plasmatiques du dabigatran par augmentation de son absorption intestinale par le rolapitant. Conduite à tenir : Surveillance clinique et biologique étroite pendant l’association."))
  (interaction
    (title "DABIGATRAN + TACROLIMUS")
    (level "Association DECONSEILLEE")
    (drugs-a "dabigatran")
    (drugs-b "tacrolimus")
    (alert "Interaction DABIGATRAN + TACROLIMUS (Association DECONSEILLEE) : Risque d'augmentation des concentrations plasmatiques de dabigatran."))
  (interaction
    (title "DABIGATRAN + VERAPAMIL")
    (level "Précaution d'emploi")
    (drugs-a "dabigatran")
    (drugs-b "verapamil")
    (alert "Interaction DABIGATRAN + VERAPAMIL (Précaution d'emploi) : Augmentation des concentrations plasmatiques de dabigatran, avec majoration du risque de saignement. Conduite à tenir : Dans l'indication post-chirurgicale : surveillance clinique et adaptation de la posologie du dabigatran à 150 mg/j en une prise, voire 75 mg/j en cas d'insuffisance rénale modérée. Dans l'indication fibrillation auriculaire : surveillance clinique et adaptation de la posologie du dabigatran à 220 mg/j en deux prises."))
  (interaction
    (title "DACARBAZINE + FOTEMUSTINE")
    (level "Précaution d'emploi")
    (drugs-a "dacarbazine")
    (drugs-b "fotemustine")
    (alert "Interaction DACARBAZINE + FOTEMUSTINE (Précaution d'emploi) : Avec la dacarbazine à doses élevées : risque de toxicité pulmonaire (syndrome de détresse respiratoire aiguë de l'adulte). Conduite à tenir : Ne pas utiliser simultanément mais respecter un délai d'une semaine entre la dernière administration de fotémustine et le premier jour de la cure de dacarbazine."))
  (interaction
    (title "DALFOPRISTINE + DIHYDROERGOTAMINE")
    (level "CONTRE-INDICATION")
    (drugs-a "dalfopristine")
    (drugs-b "dihydroergotamine")
    (alert "Interaction DALFOPRISTINE + DIHYDROERGOTAMINE (CONTRE-INDICATION) : Ergotisme avec possibilité de nécrose des extrémités (inhibition du métabolisme hépatique de l'alcaloïde de l'ergot de seigle)."))
  (interaction
    (title "DALFOPRISTINE + ERGOTAMINE")
    (level "CONTRE-INDICATION")
    (drugs-a "dalfopristine")
    (drugs-b "ergotamine")
    (alert "Interaction DALFOPRISTINE + ERGOTAMINE (CONTRE-INDICATION) : Ergotisme avec possibilité de nécrose des extrémités (inhibition du métabolisme hépatique de l'alcaloïde de l'ergot de seigle)."))
  (interaction
    (title "DALFOPRISTINE + IMMUNOSUPPRESSEURS")
    (level "Précaution d'emploi")
    (drugs-a "dalfopristine")
    (drugs-b "ciclosporine" "everolimus" "sirolimus" "tacrolimus" "temsirolimus")
    (alert "Interaction DALFOPRISTINE + IMMUNOSUPPRESSEURS (Précaution d'emploi) : Augmentation des concentrations sanguines de l'immunosuppresseur par inhibition de son métabolisme hépatique. Conduite à tenir : Dosage des concentrations sanguines de l'immunosuppresseur, contrôle de la fonction rénale et adaptation de la posologie pendant l'association et après son arrêt."))
  (interaction
    (title "DALFOPRISTINE + PIMOZIDE")
    (level "Association DECONSEILLEE")
    (drugs-a "dalfopristine")
    (drugs-b "pimozide")
    (alert "Interaction DALFOPRISTINE + PIMOZIDE (Association DECONSEILLEE) : Risque majoré de troubles du rythme ventriculaire, notamment de torsades de pointes."))
  (interaction
    (title "DANAZOL + INSULINE")
    (level "Association DECONSEILLEE")
    (drugs-a "danazol")
    (drugs-b "insuline")
    (alert "Interaction DANAZOL + INSULINE (Association DECONSEILLEE) : Effet diabétogène du danazol. Conduite à tenir : Si l'association ne peut être évitée, prévenir le patient et renforcer l'autosurveillance glycémique. Adapter éventuellement la posologie de l'insuline pendant le traitement par le danazol et après son arrêt."))
  (interaction
    (title "DANAZOL + SIMVASTATINE")
    (level "CONTRE-INDICATION")
    (drugs-a "danazol")
    (drugs-b "simvastatine")
    (alert "Interaction DANAZOL + SIMVASTATINE (CONTRE-INDICATION) : Risque majoré d'effets indésirables (concentration-dépendants) à type de rhabdomyolyse par diminution du métabolisme de la simvastatine."))
  (interaction
    (title "DANAZOL + SULFAMIDES HYPOGLYCÉMIANTS")
    (level "Association DECONSEILLEE")
    (drugs-a "danazol")
    (drugs-b "glibenclamide" "gliclazide" "glimepiride" "glipizide")
    (alert "Interaction DANAZOL + SULFAMIDES HYPOGLYCÉMIANTS (Association DECONSEILLEE) : Effet diabétogène du danazol. Conduite à tenir : Si l'association ne peut être évitée, prévenir le patient et renforcer l'autosurveillance glycémique. Adapter éventuellement la posologie de l'antidiabétique pendant le traitement par le danazol et après son arrêt."))
  (interaction
    (title "DANAZOL + TACROLIMUS")
    (level "Précaution d'emploi")
    (drugs-a "danazol")
    (drugs-b "tacrolimus")
    (alert "Interaction DANAZOL + TACROLIMUS (Précaution d'emploi) : Augmentation des concentrations sanguines du tacrolimus par inhibition de son métabolisme hépatique. Conduite à tenir : Dosage des concentrations sanguines du tacrolimus et adaptation de sa posologie pendant l'association et après son arrêt, avec contrôle de la fonction rénale."))
  (interaction
    (title "DANTROLENE + DIHYDROPYRIDINES")
    (level "Association DECONSEILLEE")
    (drugs-a "dantrolene")
    (drugs-b "amlodipine" "clevidipine" "felodipine" "isradipine" "lacidipine" "lercanidipine" "manidipine" "nicardipine" "nifedipine" "nimodipine" "nitrendipine")
    (alert "Interaction DANTROLENE + DIHYDROPYRIDINES (Association DECONSEILLEE) : Avec le dantrolène administré par perfusion : chez l'animal des cas de fibrillations ventriculaires mortelles sont constamment observés lors de l'administration de vérapamil et de dantrolène IV. L'association d'un antagoniste du calcium et de dantrolène est donc potentiellement dangereuse. Cependant, quelques patients ont reçu l'association nifédipine et dantrolène sans inconvénient."))
  (interaction
    (title "DANTROLENE + DILTIAZEM")
    (level "CONTRE-INDICATION")
    (drugs-a "dantrolene")
    (drugs-b "diltiazem")
    (alert "Interaction DANTROLENE + DILTIAZEM (CONTRE-INDICATION) : Avec le dantrolène administré par perfusion : chez l'animal, des cas de fibrillations ventriculaires mortelles sont constamment observés lors de l'administration de vérapamil et de dantrolène par voie IV. L'association d'un antagoniste du calcium et de dantrolène est donc potentiellement dangereuse. Cependant, quelques patients ont reçu l'association nifédipine et dantrolène sans inconvénient."))
  (interaction
    (title "DANTROLENE + VERAPAMIL")
    (level "CONTRE-INDICATION")
    (drugs-a "dantrolene")
    (drugs-b "verapamil")
    (alert "Interaction DANTROLENE + VERAPAMIL (CONTRE-INDICATION) : Avec le dantrolène administré par perfusion : chez l'animal, des cas de fibrillations ventriculaires mortelles sont constamment observés lors de l'administration de vérapamil et de dantrolène par voie IV. L'association d'un antagoniste du calcium et de dantrolène est donc potentiellement dangereuse. Cependant, quelques patients ont reçu l'association nifédipine et dantrolène sans inconvénient."))
  (interaction
    (title "DAPOXÉTINE + INHIBITEURS PUISSANTS DU CYP3A4")
    (level "CONTRE-INDICATION")
    (drugs-a "dapoxetine")
    (drugs-b "clarithromycine" "cobicistat" "erythromycine" "itraconazole" "ketoconazole" "posaconazole" "ritonavir" "telithromycine" "tucatinib" "voriconazole")
    (alert "Interaction DAPOXÉTINE + INHIBITEURS PUISSANTS DU CYP3A4 (CONTRE-INDICATION) : Risque de majoration des effets indésirables, notamment à type de vertiges ou de syncopes."))
  (interaction
    (title "DAPOXÉTINE + MÉDICAMENTS À L'ORIGINE D'UNE HYPOTENSION ORTHOSTATIQUE")
    (level "ASDEC - APEC")
    (drugs-a "dapoxetine")
    (drugs-b "alfuzosine" "alimemazine" "alizapride" "amantadine" "amifostine" "amisulpride" "amitriptyline" "amoxapine" "apomorphine" "aripiprazole" "avanafil" "baclofene" "bromocriptine" "chlorpromazine" "clomipramine" "clozapine" "cyamemazine" "dinitrate d'isosorbide" "dosulepine" "doxazosine" "doxepine" "droperidol" "entacapone" "flupentixol" "fluphenazine" "haloperidol" "imipramine" "isosorbide" "levodopa" "levomepromazine" "levosimendan" "lisuride" "loxapine" "maprotiline" "metopimazine" "molsidomine" "nicorandil" "olanzapine" "oxomemazine" "paliperidone" "penfluridol" "perindopril" "pimozide" "pipamperone" "pipotiazine" "piribedil" "pramipexole" "prazosine" "promethazine" "propericiazine" "quetiapine" "rasagiline" "riociguat" "risperidone" "ropinirole" "rotigotine" "selegiline" "sildenafil" "silodosine" "sulpiride" "tadalafil" "tamsulosine" "terazosine" "tiapride" "tolcapone" "trimipramine" "trinitrine" "vardenafil" "vortioxetine" "zuclopenthixol")
    (alert "Interaction DAPOXÉTINE + MÉDICAMENTS À L'ORIGINE D'UNE HYPOTENSION ORTHOSTATIQUE (ASDEC - APEC) : Risque de majoration des effets indésirables, notamment à type de vertiges ou de syncopes. Conduite à tenir : Association déconseillée - avec les inhibiteurs de la phosphodiestérase de type 5 A prendre en compte - avec les autres classes thérapeutiques."))
  (interaction
    (title "DAPSONE + ZIDOVUDINE")
    (level "Précaution d'emploi")
    (drugs-a "dapsone")
    (drugs-b "zidovudine")
    (alert "Interaction DAPSONE + ZIDOVUDINE (Précaution d'emploi) : Augmentation de la toxicité hématologique (addition d'effets de toxicité médullaire). Conduite à tenir : Contrôle plus fréquent de l'hémogramme."))
  (interaction
    (title "DAPTOMYCINE + INHIBITEURS DE L'HMG-COA RÉDUCTASE (STATINES)")
    (level "Association DECONSEILLEE")
    (drugs-a "daptomycine")
    (drugs-b "atorvastatine" "fluvastatine" "pitavastatine" "pravastatine" "rosuvastatine" "simvastatine")
    (alert "Interaction DAPTOMYCINE + INHIBITEURS DE L'HMG-COA RÉDUCTASE (STATINES) (Association DECONSEILLEE) : Risque d’addition des effets indésirables (dose-dépendant) à type de rhabdomyolyse. Conduite à tenir : Si l’association ne peut être évitée, renforcer la surveillance biologique (dosage des CPK plus d’une fois par semaine) et surveillance clinique étroite."))
  (interaction
    (title "DARIFENACINE + METOPROLOL")
    (level "Précaution d'emploi")
    (drugs-a "darifenacine")
    (drugs-b "metoprolol")
    (alert "Interaction DARIFENACINE + METOPROLOL (Précaution d'emploi) : Augmentation des concentrations plasmatiques du métoprolol, avec risque de surdosage, par diminution de son métabolisme hépatique par la darifénacine. Conduite à tenir : Surveillance clinique et réduction de la posologie du métoprolol pendant le traitement par darifénacine."))
  (interaction
    (title "DARIFENACINE + PROPAFENONE")
    (level "Précaution d'emploi")
    (drugs-a "darifenacine")
    (drugs-b "propafenone")
    (alert "Interaction DARIFENACINE + PROPAFENONE (Précaution d'emploi) : Augmentation des concentrations plasmatiques de propafénone, avec risque de surdosage, par diminution de son métabolisme hépatique par la darifénacine. Conduite à tenir : Surveillance clinique et réduction de la posologie de la propafénone pendant le traitement par darifénacine."))
  (interaction
    (title "DAROLUTAMIDE + INDUCTEURS ENZYMATIQUES PUISSANTS")
    (level "Association DECONSEILLEE")
    (drugs-a "darolutamide")
    (drugs-b "apalutamide" "carbamazepine" "enzalutamide" "fosphenytoine" "phenobarbital" "phenytoine" "primidone")
    (alert "Interaction DAROLUTAMIDE + INDUCTEURS ENZYMATIQUES PUISSANTS (Association DECONSEILLEE) : Diminution des concentrations plasmatiques de dalorutamide avec risque de perte d’efficacité."))
  (interaction
    (title "DAROLUTAMIDE + RIFAMPICINE")
    (level "Association DECONSEILLEE")
    (drugs-a "darolutamide")
    (drugs-b "rifampicine")
    (alert "Interaction DAROLUTAMIDE + RIFAMPICINE (Association DECONSEILLEE) : Diminution des concentrations plasmatiques de dalorutamide avec risque de perte d’efficacité."))
  (interaction
    (title "DAROLUTAMIDE + ROSUVASTATINE")
    (level "Association DECONSEILLEE")
    (drugs-a "darolutamide")
    (drugs-b "rosuvastatine")
    (alert "Interaction DAROLUTAMIDE + ROSUVASTATINE (Association DECONSEILLEE) : Augmentation considérable (d’un facteur 5) des concentrations de rosuvastatine avec risque de rhabdomyolyse et/ou de néphrotoxicité, par augmentation de sa biodisponibilité."))
  (interaction
    (title "DARUNAVIR + ETRAVIRINE")
    (level "Association DECONSEILLEE")
    (drugs-a "darunavir")
    (drugs-b "etravirine")
    (alert "Interaction DARUNAVIR + ETRAVIRINE (Association DECONSEILLEE) : Risque de diminution des concentrations plasmatiques du darunavir par l’étravirine."))
  (interaction
    (title "DASABUVIR + ETHINYLESTRADIOL")
    (level "CONTRE-INDICATION")
    (drugs-a "dasabuvir")
    (drugs-b "ethinylestradiol")
    (alert "Interaction DASABUVIR + ETHINYLESTRADIOL (CONTRE-INDICATION) : Augmentation de l’hépatotoxicité."))
  (interaction
    (title "DASABUVIR + GEMFIBROZIL")
    (level "CONTRE-INDICATION")
    (drugs-a "dasabuvir")
    (drugs-b "gemfibrozil")
    (alert "Interaction DASABUVIR + GEMFIBROZIL (CONTRE-INDICATION) : Risque d’augmentation des concentrations plasmatiques du dasabuvir par le gemfibrozil."))
  (interaction
    (title "DASABUVIR + INDUCTEURS ENZYMATIQUES")
    (level "CONTRE-INDICATION")
    (drugs-a "dasabuvir")
    (drugs-b "apalutamide" "carbamazepine" "cenobamate" "dabrafenib" "efavirenz" "enzalutamide" "eslicarbazepine" "fosphenytoine" "letermovir" "lorlatinib" "lumacaftor" "nevirapine" "oxcarbazepine" "phenobarbital" "phenytoine" "pitolisant" "primidone" "rifabutine" "rifampicine" "sotorasib")
    (alert "Interaction DASABUVIR + INDUCTEURS ENZYMATIQUES (CONTRE-INDICATION) : Risque de diminution des concentrations plasmatiques du dasabuvir par l’inducteur."))
  (interaction
    (title "DASABUVIR + MILLEPERTUIS")
    (level "CONTRE-INDICATION")
    (drugs-a "dasabuvir")
    (drugs-b "millepertuis")
    (alert "Interaction DASABUVIR + MILLEPERTUIS (CONTRE-INDICATION) : Risque de diminution des concentrations plasmatiques du dasabuvir par le millepertuis."))
  (interaction
    (title "DASABUVIR + MITOTANE")
    (level "CONTRE-INDICATION")
    (drugs-a "dasabuvir")
    (drugs-b "mitotane")
    (alert "Interaction DASABUVIR + MITOTANE (CONTRE-INDICATION) : Risque de diminution des concentrations plasmatiques du dasabuvir par le mitotane."))
  (interaction
    (title "DEFERASIROX + DÉFÉRIPRONE")
    (level "CONTRE-INDICATION")
    (drugs-a "deferasirox")
    (drugs-b "deferiprone")
    (alert "Interaction DEFERASIROX + DÉFÉRIPRONE (CONTRE-INDICATION) : Risque d'hyperchélation."))
  (interaction
    (title "DEFERASIROX + DÉFÉROXAMINE")
    (level "CONTRE-INDICATION")
    (drugs-a "deferasirox")
    (drugs-b "deferoxamine")
    (alert "Interaction DEFERASIROX + DÉFÉROXAMINE (CONTRE-INDICATION) : Risque d'hyperchélation."))
  (interaction
    (title "DEFERASIROX + INDUCTEURS ENZYMATIQUES PUISSANTS")
    (level "Précaution d'emploi")
    (drugs-a "deferasirox")
    (drugs-b "apalutamide" "carbamazepine" "enzalutamide" "fosphenytoine" "phenobarbital" "phenytoine" "primidone")
    (alert "Interaction DEFERASIROX + INDUCTEURS ENZYMATIQUES PUISSANTS (Précaution d'emploi) : Risque de diminution des concentrations plasmatiques de déférasirox. Conduite à tenir : Surveiller la ferritinémie pendant et après le traitement par l’inducteur enzymatique. Si besoin, adaptation de la posologie de déférasirox."))
  (interaction
    (title "DEFERASIROX + PACLITAXEL")
    (level "Précaution d'emploi")
    (drugs-a "deferasirox")
    (drugs-b "paclitaxel")
    (alert "Interaction DEFERASIROX + PACLITAXEL (Précaution d'emploi) : Risque d’augmentation des concentrations plasmatiques du paclitaxel par inhibition de son métabolisme hépatique par le deferasirox. Conduite à tenir : Surveillance clinique et biologique étroite."))
  (interaction
    (title "DEFERASIROX + REPAGLINIDE")
    (level "Association DECONSEILLEE")
    (drugs-a "deferasirox")
    (drugs-b "repaglinide")
    (alert "Interaction DEFERASIROX + REPAGLINIDE (Association DECONSEILLEE) : Risque d’augmentation des concentrations plasmatique de répaglinide, par inhibition de son métabolisme hépatique par le deferasirox. Conduite à tenir : Si l’association ne peut être évitée, surveillance clinique et biologique étroite."))
  (interaction
    (title "DEFERASIROX + RIFAMPICINE")
    (level "Précaution d'emploi")
    (drugs-a "deferasirox")
    (drugs-b "rifampicine")
    (alert "Interaction DEFERASIROX + RIFAMPICINE (Précaution d'emploi) : Risque de diminution des concentrations plasmatiques de déférasirox. Conduite à tenir : Surveiller la ferritinémie pendant et après le traitement par l’inducteur enzymatique. Si besoin, adaptation de la posologie de déférasirox."))
  (interaction
    (title "DEFERASIROX + SELEXIPAG")
    (level "Précaution d'emploi")
    (drugs-a "deferasirox")
    (drugs-b "selexipag")
    (alert "Interaction DEFERASIROX + SELEXIPAG (Précaution d'emploi) : Risque d’augmentation des effets indésirables du sélexipag par diminution de son métabolisme. Conduite à tenir : Surveillance clinique étroite pendant l’association. Réduire de moitié la posologie (une seule prise par jour)."))
  (interaction
    (title "DÉFIBROTIDE + HÉPARINES")
    (level "Association DECONSEILLEE")
    (drugs-a "defibrotide")
    (drugs-b "dalteparine sodique" "danaparoide sodique" "enoxaparine" "fondaparinux" "heparine calcique" "heparine sodique" "nadroparine calcique" "reviparine" "tinzaparine")
    (alert "Interaction DÉFIBROTIDE + HÉPARINES (Association DECONSEILLEE) : Risque hémorragique accru."))
  (interaction
    (title "DÉFIBROTIDE + THROMBOLYTIQUES")
    (level "CONTRE-INDICATION")
    (drugs-a "defibrotide")
    (drugs-b "alteplase recombinante" "reteplase" "streptokinase" "tenecteplase" "urokinase")
    (alert "Interaction DÉFIBROTIDE + THROMBOLYTIQUES (CONTRE-INDICATION) : Risque hémorragique accru."))
  (interaction
    (title "DÉLAMANID + INDUCTEURS ENZYMATIQUES PUISSANTS")
    (level "CONTRE-INDICATION")
    (drugs-a "delamanid")
    (drugs-b "apalutamide" "carbamazepine" "enzalutamide" "fosphenytoine" "phenobarbital" "phenytoine" "primidone")
    (alert "Interaction DÉLAMANID + INDUCTEURS ENZYMATIQUES PUISSANTS (CONTRE-INDICATION) : Diminution des concentrations plasmatiques de delamanid par augmentation de son métabolisme hépatique par l’inducteur."))
  (interaction
    (title "DÉLAMANID + INHIBITEURS PUISSANTS DU CYP3A4")
    (level "Association DECONSEILLEE")
    (drugs-a "delamanid")
    (drugs-b "clarithromycine" "cobicistat" "erythromycine" "itraconazole" "ketoconazole" "posaconazole" "ritonavir" "telithromycine" "tucatinib" "voriconazole")
    (alert "Interaction DÉLAMANID + INHIBITEURS PUISSANTS DU CYP3A4 (Association DECONSEILLEE) : Risque majoré de troubles du rythme ventriculaires, notamment de torsades de pointes. Conduite à tenir : Si l’association ne peut être évitée, contrôle clinique et électrocardiographique régulier."))
  (interaction
    (title "DÉLAMANID + RIFAMPICINE")
    (level "CONTRE-INDICATION")
    (drugs-a "delamanid")
    (drugs-b "rifampicine")
    (alert "Interaction DÉLAMANID + RIFAMPICINE (CONTRE-INDICATION) : Diminution des concentrations plasmatiques de delamanid par augmentation de son métabolisme hépatique par l’inducteur."))
  (interaction
    (title "DÉLAMANID + SUBSTANCES SUSCEPTIBLES DE DONNER DES TORSADES DE POINTES")
    (level "CI - ASDEC")
    (drugs-a "delamanid")
    (drugs-b "amiodarone" "amisulpride" "arsenieux" "chloroquine" "chlorpromazine" "citalopram" "cocaine" "crizotinib" "cyamemazine" "disopyramide" "domperidone" "dronedarone" "droperidol" "erythromycine" "escitalopram" "flupentixol" "fluphenazine" "halofantrine" "haloperidol" "hydroquinidine" "hydroxychloroquine" "hydroxyzine" "levomepromazine" "lumefantrine" "mequitazine" "methadone" "moxifloxacine" "pentamidine" "pimozide" "pipamperone" "piperaquine" "pipotiazine" "quinidine" "sotalol" "spiramycine" "sulpiride" "tiapride" "toremifene" "vandetanib" "vincamine" "zuclopenthixol")
    (alert "Interaction DÉLAMANID + SUBSTANCES SUSCEPTIBLES DE DONNER DES TORSADES DE POINTES (CI - ASDEC) : Risque majoré de troubles du rythme ventriculaire, notamment de torsades de pointes. Conduite à tenir : Contre-indication: - avec citalopram, dompéridone, escitalopram, hydroxyzine et pipéraquine Associations déconseillées - avec les autres susbtances susceptibles de donner des torsades de pointes. Si l’association ne peut être évitée, contrôle clinique et électrocardiographique régulier."))
  (interaction
    (title "DÉRIVÉS NITRÉS ET APPARENTÉS + INHIBITEURS DE LA PHOSPHODIESTERASE DE TYPE 5")
    (level "CONTRE-INDICATION")
    (drugs-a "dinitrate d'isosorbide" "isosorbide" "molsidomine" "nicorandil" "trinitrine")
    (drugs-b "avanafil" "sildenafil" "tadalafil" "vardenafil")
    (alert "Interaction DÉRIVÉS NITRÉS ET APPARENTÉS + INHIBITEURS DE LA PHOSPHODIESTERASE DE TYPE 5 (CONTRE-INDICATION) : Risque d'hypotension importante (effet synergique) pouvant aggraver l'état d'ischémie myocardique et provoquer notamment un accident coronarien aigu."))
  (interaction
    (title "DÉRIVÉS NITRÉS ET APPARENTÉS + RIOCIGUAT")
    (level "CONTRE-INDICATION")
    (drugs-a "dinitrate d'isosorbide" "isosorbide" "molsidomine" "nicorandil" "trinitrine")
    (drugs-b "riociguat")
    (alert "Interaction DÉRIVÉS NITRÉS ET APPARENTÉS + RIOCIGUAT (CONTRE-INDICATION) : Risque d'hypotension importante (effet synergique)."))
  (interaction
    (title "DEXAMETHASONE + PRAZIQUANTEL")
    (level "Précaution d'emploi")
    (drugs-a "dexamethasone")
    (drugs-b "praziquantel")
    (alert "Interaction DEXAMETHASONE + PRAZIQUANTEL (Précaution d'emploi) : Diminution des concentrations plasmatiques du praziquantel, avec risque d'échec du traitement, par augmentation du métabolisme hépatique du praziquantel par la dexaméthasone. Conduite à tenir : Décaler l'administration des deux médicaments d'au moins une semaine."))
  (interaction
    (title "DEXAMETHASONE + RILPIVIRINE")
    (level "CONTRE-INDICATION")
    (drugs-a "dexamethasone")
    (drugs-b "rilpivirine")
    (alert "Interaction DEXAMETHASONE + RILPIVIRINE (CONTRE-INDICATION) : Avec la dexaméthasone par voie systémique (sauf en cas de prise unique), risque de diminution des concentrations plasmatiques de rilpivirine par augmentation de son métabolisme hépatique par la dexamethasone."))
  (interaction
    (title "DEXTRAN + HÉPARINES (DOSES CURATIVES ET/OU SUJET ÂGÉ)")
    (level "Association DECONSEILLEE")
    (drugs-a "dextran")
    (drugs-b "dalteparine sodique" "danaparoide sodique" "enoxaparine" "fondaparinux" "heparine calcique" "heparine sodique" "nadroparine calcique" "reviparine" "tinzaparine")
    (alert "Interaction DEXTRAN + HÉPARINES (DOSES CURATIVES ET/OU SUJET ÂGÉ) (Association DECONSEILLEE) : Augmentation du risque hémorragique (inhibition de la fonction plaquettaire par le dextran 40)."))
  (interaction
    (title "DEXTROMETHORPHANE + IMAO IRRÉVERSIBLES")
    (level "CONTRE-INDICATION")
    (drugs-a "dextromethorphane")
    (drugs-b "iproniazide" "phenelzine")
    (alert "Interaction DEXTROMETHORPHANE + IMAO IRRÉVERSIBLES (CONTRE-INDICATION) : Risque d'apparition d'un syndrome sérotoninergique : diarrhée, tachycardie, sueurs, tremblements, confusion voire coma."))
  (interaction
    (title "DEXTROMETHORPHANE + IMAO-A RÉVERSIBLES, Y COMPRIS OXAZOLIDINONES ET BLEU DE MÉTHYLÈNE")
    (level "Association DECONSEILLEE")
    (drugs-a "dextromethorphane")
    (drugs-b "bleu de methylene" "linezolide" "moclobemide" "tedizolide")
    (alert "Interaction DEXTROMETHORPHANE + IMAO-A RÉVERSIBLES, Y COMPRIS OXAZOLIDINONES ET BLEU DE MÉTHYLÈNE (Association DECONSEILLEE) : Risque d'apparition d'un syndrome sérotoninergique : diarrhée, tachycardie, sueurs, tremblements, confusion voire coma."))
  (interaction
    (title "DIAZEPAM + PHÉNYTOÏNE (ET, PAR EXTRAPOLATION, FOSPHÉNYTOÏNE)")
    (level "Précaution d'emploi")
    (drugs-a "diazepam")
    (drugs-b "fosphenytoine" "phenytoine")
    (alert "Interaction DIAZEPAM + PHÉNYTOÏNE (ET, PAR EXTRAPOLATION, FOSPHÉNYTOÏNE) (Précaution d'emploi) : Variations imprévisibles : les concentrations plasmatiques de phénytoïne peuvent augmenter, avec signes de surdosage, mais aussi diminuer ou rester stables. Conduite à tenir : Surveillance clinique et contrôle des concentrations plasmatiques de phénytoïne."))
  (interaction
    (title "DIAZEPAM + STIRIPENTOL")
    (level "Précaution d'emploi")
    (drugs-a "diazepam")
    (drugs-b "stiripentol")
    (alert "Interaction DIAZEPAM + STIRIPENTOL (Précaution d'emploi) : Augmentation des concentrations plasmatiques du diazépam, avec risque de surdosage, par inhibition de son métabolisme hépatique. Conduite à tenir : Surveillance clinique et dosage plasmatique, lorsque cela est possible, de l'anticonvulsivant associé au stiripentol et éventuelle adaptation posologique de l'anticonvulsivant associé."))
  (interaction
    (title "DIDANOSINE + GANCICLOVIR")
    (level "Association DECONSEILLEE")
    (drugs-a "didanosine")
    (drugs-b "ganciclovir")
    (alert "Interaction DIDANOSINE + GANCICLOVIR (Association DECONSEILLEE) : Risque d'augmentation des effets indésirables de la didanosine, et notamment la toxicité mitochondriale, par augmentation importante de ses concentrations. De plus risque de diminution de l'efficacité du ganciclovir par diminution de ses concentrations, si les deux médicaments sont ingérés à moins de 2 heures d'intervalle."))
  (interaction
    (title "DIDANOSINE + PENTAMIDINE")
    (level "Précaution d'emploi")
    (drugs-a "didanosine")
    (drugs-b "pentamidine")
    (alert "Interaction DIDANOSINE + PENTAMIDINE (Précaution d'emploi) : Risque majoré de survenue de pancréatite par addition d'effets indésirables. Conduite à tenir : Surveillance de l'amylasémie. Ne pas associer si l'amylasémie est à la limite supérieure de la normale."))
  (interaction
    (title "DIDANOSINE + RIBAVIRINE")
    (level "Association DECONSEILLEE")
    (drugs-a "didanosine")
    (drugs-b "ribavirine")
    (alert "Interaction DIDANOSINE + RIBAVIRINE (Association DECONSEILLEE) : Risque de majoration de la toxicité mitochondriale de la didanosine par augmentation de son métabolite actif."))
  (interaction
    (title "DIDANOSINE + TENOFOVIR DISOPROXIL")
    (level "Association DECONSEILLEE")
    (drugs-a "didanosine")
    (drugs-b "tenofovir disoproxil")
    (alert "Interaction DIDANOSINE + TENOFOVIR DISOPROXIL (Association DECONSEILLEE) : Risque d'échec du traitement antirétroviral, voire émergence de résistances. De plus, majoration du risque de la toxicité mitochondriale de la didanosine."))
  (interaction
    (title "DIDANOSINE + THALIDOMIDE")
    (level "Précaution d'emploi")
    (drugs-a "didanosine")
    (drugs-b "thalidomide")
    (alert "Interaction DIDANOSINE + THALIDOMIDE (Précaution d'emploi) : Risque majoré de survenue de neuropathies périphériques par addition d'effets indésirables. Conduite à tenir : Surveillance clinique et biologique régulière, notamment en début d'association."))
  (interaction
    (title "DIGOXINE + DRONEDARONE")
    (level "Association DECONSEILLEE")
    (drugs-a "digoxine")
    (drugs-b "dronedarone")
    (alert "Interaction DIGOXINE + DRONEDARONE (Association DECONSEILLEE) : Dépression de l'automatisme (bradycardie excessive) et troubles de la conduction auriculo-ventriculaire. En outre, augmentation de la digoxinémie par diminution du métabolisme de la digoxine. Surveillance clinique et ECG. Conduite à tenir : Réduire de moitié les doses de digoxine."))
  (interaction
    (title "DIGOXINE + GLÉCAPRÉVIR + PIBRENTASVIR")
    (level "Précaution d'emploi")
    (drugs-a "digoxine")
    (drugs-b "glecaprevir" "pibrentasvir")
    (alert "Interaction DIGOXINE + GLÉCAPRÉVIR + PIBRENTASVIR (Précaution d'emploi) : Augmentation des concentrations plasmatiques de la digoxine par la bithérapie. Conduite à tenir : Surveillance clinique et éventuellement de la digoxinémie pendant le traitement par glécaprévir/ pibrentasvir."))
  (interaction
    (title "DIGOXINE + HYDROQUINIDINE")
    (level "Précaution d'emploi")
    (drugs-a "digoxine")
    (drugs-b "hydroquinidine")
    (alert "Interaction DIGOXINE + HYDROQUINIDINE (Précaution d'emploi) : Augmentation de la digoxinémie par diminution de la clairance rénale de la digoxine. De plus, troubles de l'automatisme (bradycardie excessive et troubles de la conduction auriculo- ventriculaire). Conduite à tenir : Surveillance clinique et ECG. En cas de réponse inattendue, contrôler la digoxinémie et adapter la posologie."))
  (interaction
    (title "DIGOXINE + HYPOKALIÉMIANTS")
    (level "Précaution d'emploi")
    (drugs-a "digoxine")
    (drugs-b "ricinoleate de)" "tetracosactide" "triamcinolone")
    (alert "Interaction DIGOXINE + HYPOKALIÉMIANTS (Précaution d'emploi) : Hypokaliémie favorisant les effets toxiques des digitaliques. Conduite à tenir : Corriger auparavant toute hypokaliémie et réaliser une surveillance clinique, électrolytique et électrocardiographique."))
  (interaction
    (title "DIGOXINE + INHIBITEURS DE PROTÉASES BOOSTÉS PAR RITONAVIR")
    (level "Précaution d'emploi")
    (drugs-a "digoxine")
    (drugs-b "atazanavir" "darunavir" "fosamprenavir" "lopinavir" "nirmatrelvir" "ritonavir" "saquinavir" "tipranavir")
    (alert "Interaction DIGOXINE + INHIBITEURS DE PROTÉASES BOOSTÉS PAR RITONAVIR (Précaution d'emploi) : Augmentation de la digoxinémie, plus marquée pour la voie intraveineuse, par augmentation de l’absorption de la digoxine ou diminution de sa clairance rénale. Conduite à tenir : Surveillance clinique et, s’il y a lieu, de l’ECG et de la digoxinémie, avec adaptation éventuelle de la posologie de digoxine."))
  (interaction
    (title "DIGOXINE + ITRACONAZOLE")
    (level "Précaution d'emploi")
    (drugs-a "digoxine")
    (drugs-b "itraconazole")
    (alert "Interaction DIGOXINE + ITRACONAZOLE (Précaution d'emploi) : Augmentation de la digoxinémie avec nausées, vomissements, troubles du rythme. Conduite à tenir : Surveillance clinique et, s'il y a lieu, de l'ECG et de la digoxinémie avec adaptation de la posologie de la digoxine pendant le traitement par l'itraconazole et après son arrêt."))
  (interaction
    (title "DIGOXINE + MACROLIDES (SAUF SPIRAMYCINE)")
    (level "Précaution d'emploi")
    (drugs-a "digoxine")
    (drugs-b "azithromycine" "clarithromycine" "erythromycine" "josamycine" "midecamycine" "roxithromycine" "telithromycine")
    (alert "Interaction DIGOXINE + MACROLIDES (SAUF SPIRAMYCINE) (Précaution d'emploi) : Augmentation de la digoxinémie par augmentation de son absorption. Conduite à tenir : Surveillance clinique et éventuellement de la digoxinémie pendant le traitement par le macrolide et après son arrêt."))
  (interaction
    (title "DIGOXINE + MIDODRINE")
    (level "Association DECONSEILLEE")
    (drugs-a "digoxine")
    (drugs-b "midodrine")
    (alert "Interaction DIGOXINE + MIDODRINE (Association DECONSEILLEE) : Troubles de l'automatisme (majoration de l'effet bradycardisant de la midodrine) et troubles de la conduction auriculo-ventriculaire. Conduite à tenir : Si cette association ne peut être évitée, renforcer la surveillance clinique et ECG."))
  (interaction
    (title "DIGOXINE + MILLEPERTUIS")
    (level "CONTRE-INDICATION")
    (drugs-a "digoxine")
    (drugs-b "millepertuis")
    (alert "Interaction DIGOXINE + MILLEPERTUIS (CONTRE-INDICATION) : Diminution de la digoxinémie, en raison de l'effet inducteur du millepertuis, avec risque de baisse d'efficacité voire d'annulation de l'effet, dont les conséquences peuvent être éventuellement graves (décompensation d'une insuffisance cardiaque). Conduite à tenir : En cas d'association fortuite, ne pas interrompre brutalement la prise de millepertuis mais contrôler les concentrations plasmatiques (ou l'efficacité) de la digoxine avant puis après l'arrêt du millepertuis."))
  (interaction
    (title "DIGOXINE + OMEPRAZOLE")
    (level "Précaution d'emploi")
    (drugs-a "digoxine")
    (drugs-b "omeprazole")
    (alert "Interaction DIGOXINE + OMEPRAZOLE (Précaution d'emploi) : Augmentation modérée de la digoxinémie par majoration de son absorption par l'oméprazole. Conduite à tenir : Surveillance clinique, ECG et de la digoxinémie, particulièrement chez le sujet âgé."))
  (interaction
    (title "DIGOXINE + PONATINIB")
    (level "Précaution d'emploi")
    (drugs-a "digoxine")
    (drugs-b "ponatinib")
    (alert "Interaction DIGOXINE + PONATINIB (Précaution d'emploi) : Risque d’augmentation des concentrations plasmatiques de la digoxine par augmentation de son absorption intestinale par le ponatinib. Conduite à tenir : Surveillance clinique et biologique étroite pendant l’association."))
  (interaction
    (title "DIGOXINE + POSACONAZOLE")
    (level "Précaution d'emploi")
    (drugs-a "digoxine")
    (drugs-b "posaconazole")
    (alert "Interaction DIGOXINE + POSACONAZOLE (Précaution d'emploi) : Augmentation de la digoxinémie avec nausées, vomissements, troubles du rythme. Conduite à tenir : Surveillance clinique et, s'il y a lieu, de l'ECG et de la digoxinémie, avec adaptation de la posologie de la digoxine pendant le traitement par le posaconazole et après son arrêt."))
  (interaction
    (title "DIGOXINE + PROPAFENONE")
    (level "Précaution d'emploi")
    (drugs-a "digoxine")
    (drugs-b "propafenone")
    (alert "Interaction DIGOXINE + PROPAFENONE (Précaution d'emploi) : Risque d’augmentation de la digoxinémie, notamment chez le sujet âgé. Conduite à tenir : Surveillance clinique et éventuellement de la digoxinémie pendant le traitement par propafénone et après son arrêt."))
  (interaction
    (title "DIGOXINE + QUINIDINE")
    (level "Précaution d'emploi")
    (drugs-a "digoxine")
    (drugs-b "quinidine")
    (alert "Interaction DIGOXINE + QUINIDINE (Précaution d'emploi) : Augmentation de la digoxinémie par diminution de la clairance rénale de la digoxine. De plus, troubles de l'automatisme (bradycardie excessive et troubles de la conduction auriculo- ventriculaire). Conduite à tenir : Surveillance clinique et ECG. En cas de réponse inattendue, contrôler la digoxinémie et adapter la posologie."))
  (interaction
    (title "DIGOXINE + QUININE")
    (level "Précaution d'emploi")
    (drugs-a "digoxine")
    (drugs-b "quinine")
    (alert "Interaction DIGOXINE + QUININE (Précaution d'emploi) : Augmentation modérée de la digoxinémie. Conduite à tenir : Surveillance clinique et ECG, si besoin, avec adaptation éventuelle des doses de digoxine."))
  (interaction
    (title "DIGOXINE + RANOLAZINE")
    (level "Précaution d'emploi")
    (drugs-a "digoxine")
    (drugs-b "ranolazine")
    (alert "Interaction DIGOXINE + RANOLAZINE (Précaution d'emploi) : Augmentation de la digoxinémie. Conduite à tenir : Surveillance clinique, biologique et éventuellement ECG. Adaptation de la posologie de la digoxine, si besoin."))
  (interaction
    (title "DIGOXINE + RIFAMPICINE")
    (level "Précaution d'emploi")
    (drugs-a "digoxine")
    (drugs-b "rifampicine")
    (alert "Interaction DIGOXINE + RIFAMPICINE (Précaution d'emploi) : Diminution modeste des concentrations de digoxine. Conduite à tenir : Surveillance clinique et ECG."))
  (interaction
    (title "DIGOXINE + ROLAPITANT")
    (level "Précaution d'emploi")
    (drugs-a "digoxine")
    (drugs-b "rolapitant")
    (alert "Interaction DIGOXINE + ROLAPITANT (Précaution d'emploi) : Augmentation de la digoxinémie par majoration de son absorption. Conduite à tenir : Surveillance clinique et ECG pendant le traitement par le rolapitant et après son arrêt."))
  (interaction
    (title "DIGOXINE + SUCRALFATE")
    (level "Précaution d'emploi")
    (drugs-a "digoxine")
    (drugs-b "sucralfate")
    (alert "Interaction DIGOXINE + SUCRALFATE (Précaution d'emploi) : Diminution de l'absorption digestive de la digoxine. Conduite à tenir : Prendre le sucralfate à distance de la digoxine (plus de 2 heures, si possible)."))
  (interaction
    (title "DIGOXINE + SULFASALAZINE")
    (level "Précaution d'emploi")
    (drugs-a "digoxine")
    (drugs-b "sulfasalazine")
    (alert "Interaction DIGOXINE + SULFASALAZINE (Précaution d'emploi) : Diminution de la digoxinémie pouvant atteindre 50 %. Conduite à tenir : Surveillance clinique, ECG et, éventuellement, de la digoxinémie. S'il y a lieu, adaptation de la posologie de la digoxine pendant le traitement par la sulfasalazine et après son arrêt."))
  (interaction
    (title "DIGOXINE + TELITHROMYCINE")
    (level "Précaution d'emploi")
    (drugs-a "digoxine")
    (drugs-b "telithromycine")
    (alert "Interaction DIGOXINE + TELITHROMYCINE (Précaution d'emploi) : Augmentation de la digoxinémie par augmentation de son absorption. Conduite à tenir : Surveillance clinique et éventuellement de la digoxinémie pendant le traitement par la télithromycine et après son arrêt."))
  (interaction
    (title "DIGOXINE + VERAPAMIL")
    (level "Précaution d'emploi")
    (drugs-a "digoxine")
    (drugs-b "verapamil")
    (alert "Interaction DIGOXINE + VERAPAMIL (Précaution d'emploi) : Bradycardie excessive et bloc auriculo-ventriculaire par majoration des effets de la digoxine sur l'automatisme et la conduction et par diminution de l'élimination rénale et extrarénale de la digoxine. Conduite à tenir : Surveillance clinique, ECG et, éventuellement, contrôle de la digoxinémie. S'il y a lieu, adaptation de la posologie de la digoxine pendant le traitement par le vérapamil et après son arrêt."))
  (interaction
    (title "DIHYDROERGOTAMINE + DILTIAZEM")
    (level "CONTRE-INDICATION")
    (drugs-a "dihydroergotamine")
    (drugs-b "diltiazem")
    (alert "Interaction DIHYDROERGOTAMINE + DILTIAZEM (CONTRE-INDICATION) : Ergotisme avec possibilité de nécrose des extrémités (inhibition du métabolisme hépatique de l'alcaloïde de l'ergot de seigle)."))
  (interaction
    (title "DIHYDROERGOTAMINE + EFAVIRENZ")
    (level "CONTRE-INDICATION")
    (drugs-a "dihydroergotamine")
    (drugs-b "efavirenz")
    (alert "Interaction DIHYDROERGOTAMINE + EFAVIRENZ (CONTRE-INDICATION) : Ergotisme avec possibilité de nécrose des extrémités (inhibition du métabolisme hépatique de l'alcaloïde de l'ergot de seigle)."))
  (interaction
    (title "DIHYDROERGOTAMINE + MACROLIDES (SAUF SPIRAMYCINE)")
    (level "CONTRE-INDICATION")
    (drugs-a "dihydroergotamine")
    (drugs-b "azithromycine" "clarithromycine" "erythromycine" "josamycine" "midecamycine" "roxithromycine" "telithromycine")
    (alert "Interaction DIHYDROERGOTAMINE + MACROLIDES (SAUF SPIRAMYCINE) (CONTRE-INDICATION) : Ergotisme avec possibilité de nécrose des extrémités (inhibition de l’élimination hépatique de l'alcaloïde de l’ergot de seigle)."))
  (interaction
    (title "DIHYDROERGOTAMINE + QUINUPRISTINE")
    (level "CONTRE-INDICATION")
    (drugs-a "dihydroergotamine")
    (drugs-b "quinupristine")
    (alert "Interaction DIHYDROERGOTAMINE + QUINUPRISTINE (CONTRE-INDICATION) : Ergotisme avec possibilité de nécrose des extrémités (inhibition du métabolisme hépatique de l'alcaloïde de l'ergot de seigle)."))
  (interaction
    (title "DIHYDROERGOTAMINE + STIRIPENTOL")
    (level "CONTRE-INDICATION")
    (drugs-a "dihydroergotamine")
    (drugs-b "stiripentol")
    (alert "Interaction DIHYDROERGOTAMINE + STIRIPENTOL (CONTRE-INDICATION) : Ergotisme avec possibilité de nécrose des extrémités (inhibition de l’élimination hépatique de l'alcaloïde de l’ergot de seigle)."))
  (interaction
    (title "DIHYDROERGOTAMINE + TRICLABENDAZOLE")
    (level "CONTRE-INDICATION")
    (drugs-a "dihydroergotamine")
    (drugs-b "triclabendazole")
    (alert "Interaction DIHYDROERGOTAMINE + TRICLABENDAZOLE (CONTRE-INDICATION) : Ergotisme avec possibilité de nécrose des extrémités (inhibition du métabolisme hépatique de l’alcaloïde de l’ergot de seigle). Conduite à tenir : Respecter un délai de 24 heures entre l’arrêt du triclabendazole et la prise du médicament dérivé de l’ergot, et inversement."))
  (interaction
    (title "DILTIAZEM + DRONEDARONE")
    (level "Précaution d'emploi")
    (drugs-a "diltiazem")
    (drugs-b "dronedarone")
    (alert "Interaction DILTIAZEM + DRONEDARONE (Précaution d'emploi) : Risque de bradycardie ou de bloc auriculo-ventriculaire, notamment chez le sujet âgé. Par ailleurs, légère augmentation des concentrations de dronédarone par diminution de son métabolisme par l’antagoniste des canaux calciques. Conduite à tenir : Débuter le traitement par l’antagoniste calcique aux posologies minimales recommandées, et ajuster les doses en fonction de l’ECG."))
  (interaction
    (title "DILTIAZEM + ERGOTAMINE")
    (level "CONTRE-INDICATION")
    (drugs-a "diltiazem")
    (drugs-b "ergotamine")
    (alert "Interaction DILTIAZEM + ERGOTAMINE (CONTRE-INDICATION) : Ergotisme avec possibilité de nécrose des extrémités (inhibition du métabolisme hépatique de l'alcaloïde de l'ergot de seigle)."))
  (interaction
    (title "DILTIAZEM + ESMOLOL")
    (level "ASDEC - PE")
    (drugs-a "diltiazem")
    (drugs-b "esmolol")
    (alert "Interaction DILTIAZEM + ESMOLOL (ASDEC - PE) : Troubles de l'automatisme (bradycardie excessive, arrêt sinusal), troubles de la conduction sino-auriculaire et auriculo-ventriculaire et défaillance cardiaque. Conduite à tenir : Association déconseillée : - en cas d'altération de la fonction ventriculaire gauche. Précaution d'emploi : - si la fonction ventriculaire gauche est normale. Surveillance clinique et ECG."))
  (interaction
    (title "DILTIAZEM + IBRUTINIB")
    (level "Association DECONSEILLEE")
    (drugs-a "diltiazem")
    (drugs-b "ibrutinib")
    (alert "Interaction DILTIAZEM + IBRUTINIB (Association DECONSEILLEE) : Risque d'augmentation des concentrations plasmatiques d’ibrutinib par diminution de son métabolisme hépatique par le diltiazem. Conduite à tenir : Si l’association ne peut être évitée, surveillance clinique étroite et réduction de la dose d’ibrutinib à 280 mg par jour pendant la durée de l’association."))
  (interaction
    (title "DILTIAZEM + IMMUNOSUPPRESSEURS")
    (level "Précaution d'emploi")
    (drugs-a "diltiazem")
    (drugs-b "ciclosporine" "everolimus" "sirolimus" "tacrolimus" "temsirolimus")
    (alert "Interaction DILTIAZEM + IMMUNOSUPPRESSEURS (Précaution d'emploi) : Augmentation des concentrations sanguines de l'immunosuppresseur par diminution de son métabolisme. Conduite à tenir : Dosage des concentrations sanguines de l'immunosuppresseur, contrôle de la fonction rénale et adaptation de la posologie pendant l'association et après son arrêt."))
  (interaction
    (title "DILTIAZEM + IVABRADINE")
    (level "CONTRE-INDICATION")
    (drugs-a "diltiazem")
    (drugs-b "ivabradine")
    (alert "Interaction DILTIAZEM + IVABRADINE (CONTRE-INDICATION) : Augmentation des concentrations plasmatiques de l’ivabradine et de ses effets indésirables, notamment cardiaques (inhibition de son métabolisme hépatique par le diltiazem), qui s’ajoutent aux effets bradycardisants de ces substances."))
  (interaction
    (title "DILTIAZEM + LOMITAPIDE")
    (level "CONTRE-INDICATION")
    (drugs-a "diltiazem")
    (drugs-b "lomitapide")
    (alert "Interaction DILTIAZEM + LOMITAPIDE (CONTRE-INDICATION) : Augmentation des concentrations de lomitapide, avec risque d’hépatotoxicité."))
  (interaction
    (title "DILTIAZEM + MIDAZOLAM")
    (level "Précaution d'emploi")
    (drugs-a "diltiazem")
    (drugs-b "midazolam")
    (alert "Interaction DILTIAZEM + MIDAZOLAM (Précaution d'emploi) : Augmentation des concentrations plasmatiques de midazolam par diminution de son métabolisme hépatique, avec majoration de la sédation. Conduite à tenir : Surveillance clinique et réduction de la posologie pendant le traitement par le diltiazem."))
  (interaction
    (title "DILTIAZEM + NALOXEGOL")
    (level "Précaution d'emploi")
    (drugs-a "diltiazem")
    (drugs-b "naloxegol")
    (alert "Interaction DILTIAZEM + NALOXEGOL (Précaution d'emploi) : Augmentation des concentrations plasmatiques de naloxegol par le diltiazem. Conduite à tenir : Adaptation posologique pendant l’association."))
  (interaction
    (title "DILTIAZEM + NIFEDIPINE")
    (level "CONTRE-INDICATION")
    (drugs-a "diltiazem")
    (drugs-b "nifedipine")
    (alert "Interaction DILTIAZEM + NIFEDIPINE (CONTRE-INDICATION) : Augmentation importantes des concentrations de nifédipine par diminution de son métabolisme hépatique par le diltiazem, avec risque d'hypotension sévère."))
  (interaction
    (title "DILTIAZEM + OLAPARIB")
    (level "Association DECONSEILLEE")
    (drugs-a "diltiazem")
    (drugs-b "olaparib")
    (alert "Interaction DILTIAZEM + OLAPARIB (Association DECONSEILLEE) : Augmentation des concentrations plasmatiques d’olaparib par le diltiazem. Conduite à tenir : Si l’association ne peut être évitée, limiter la dose d’olaparib à 200 mg deux fois par jour."))
  (interaction
    (title "DILTIAZEM + PIMOZIDE")
    (level "CONTRE-INDICATION")
    (drugs-a "diltiazem")
    (drugs-b "pimozide")
    (alert "Interaction DILTIAZEM + PIMOZIDE (CONTRE-INDICATION) : Risque majoré de troubles du rythme ventriculaire, notamment de torsades de pointes."))
  (interaction
    (title "DILTIAZEM + SIMVASTATINE")
    (level "Précaution d'emploi")
    (drugs-a "diltiazem")
    (drugs-b "simvastatine")
    (alert "Interaction DILTIAZEM + SIMVASTATINE (Précaution d'emploi) : Risque majoré d'effets indésirables (concentration-dépendants) à type de rhabdomyolyse, par diminution du métabolisme hépatique de l'hypocholestérolémiant. Conduite à tenir : Ne pas dépasser la posologie de 20 mg/jour de simvastatine. Si l'objectif thérapeutique n'est pas atteint à cette posologie, utiliser une autre statine non concernée par ce type d'interaction."))
  (interaction
    (title "DILTIAZEM + TAMSULOSINE")
    (level "Précaution d'emploi")
    (drugs-a "diltiazem")
    (drugs-b "tamsulosine")
    (alert "Interaction DILTIAZEM + TAMSULOSINE (Précaution d'emploi) : Risque de majoration des effets indésirables de la tamsulosine, par inhibition de son métabolisme hépatique. Conduite à tenir : Surveillance clinique et adaptation de la posologie de la tamsulosine pensant le traitement par l’inhibiteur enzymatique et après son arrêt, le cas échéant."))
  (interaction
    (title "DILTIAZEM + TOLVAPTAN")
    (level "Précaution d'emploi")
    (drugs-a "diltiazem")
    (drugs-b "tolvaptan")
    (alert "Interaction DILTIAZEM + TOLVAPTAN (Précaution d'emploi) : Augmentation des concentrations de tolvaptan, avec risque de majoration importante des effets indésirables, notamment diurèse importante, déshydratation, insuffisance rénale aiguë. Conduite à tenir : Réduire la posologie de tolvaptan de moitié."))
  (interaction
    (title "DILTIAZEM + VÉNÉTOCLAX")
    (level "Précaution d'emploi")
    (drugs-a "diltiazem")
    (drugs-b "venetoclax")
    (alert "Interaction DILTIAZEM + VÉNÉTOCLAX (Précaution d'emploi) : Risque d’augmentation des effets indésirables du vénétoclax par diminution de son métabolisme hépatique. Conduite à tenir : Surveillance clinique et biologique régulière, notamment hématologique, et adaptation de la posologie du vénétoclax."))
  (interaction
    (title "DIPROPHYLLINE + PROBENECIDE")
    (level "Précaution d'emploi")
    (drugs-a "diprophylline")
    (drugs-b "probenecide")
    (alert "Interaction DIPROPHYLLINE + PROBENECIDE (Précaution d'emploi) : Risque de surdosage par augmentation des concentrations plasmatiques de diprophylline (inhibition de sa sécrétion tubulaire rénale). Conduite à tenir : Réduire la posologie de diprophylline pendant le traitement par le probénécide."))
  (interaction
    (title "DIPYRIDAMOLE + THÉINE")
    (level "Précaution d'emploi")
    (drugs-a "dipyridamole")
    (drugs-b "theine" "cafeine")
    (alert "Interaction DIPYRIDAMOLE + THÉINE (Précaution d'emploi) : Avec le dipyridamole par voie injectable : réduction de l’effet vasodilatateur du dipyridamole par la théine. Conduite à tenir : Eviter la consommation de produits à base de théine dans les 24 heures qui précèdent une imagerie myocardique avec le dipyridamole."))
  (interaction
    (title "DIPYRIDAMOLE + THÉOPHYLLINE (ET, PAR EXTRAPOLATION, AMINOPHYLLINE)")
    (level "Précaution d'emploi")
    (drugs-a "dipyridamole")
    (drugs-b "aminophylline" "theophylline")
    (alert "Interaction DIPYRIDAMOLE + THÉOPHYLLINE (ET, PAR EXTRAPOLATION, AMINOPHYLLINE) (Précaution d'emploi) : Avec le dipyridamole par voie injectable : réduction de l’effet vasodilatateur du dipyridamole par la théophylline. Conduite à tenir : Interrompre un traitement par théophylline au moins 5 jours avant une imagerie myocardique avec le dipyridamole."))
  (interaction
    (title "DISOPYRAMIDE + INDUCTEURS ENZYMATIQUES")
    (level "Précaution d'emploi")
    (drugs-a "disopyramide")
    (drugs-b "apalutamide" "carbamazepine" "cenobamate" "dabrafenib" "efavirenz" "enzalutamide" "eslicarbazepine" "fosphenytoine" "letermovir" "lorlatinib" "lumacaftor" "nevirapine" "oxcarbazepine" "phenobarbital" "phenytoine" "pitolisant" "primidone" "rifabutine" "rifampicine" "sotorasib")
    (alert "Interaction DISOPYRAMIDE + INDUCTEURS ENZYMATIQUES (Précaution d'emploi) : Risque de diminution des concentrations du disopyramide par l’inducteur. Conduite à tenir : Surveillance clinique et éventuellement adaptation de la posologie du disopyramide pendant l’association et 1 à 2 semaines après l’arrêt de l’inducteur."))
  (interaction
    (title "DISOPYRAMIDE + INHIBITEURS PUISSANTS DU CYP3A4")
    (level "Précaution d'emploi")
    (drugs-a "disopyramide")
    (drugs-b "clarithromycine" "cobicistat" "erythromycine" "itraconazole" "ketoconazole" "posaconazole" "ritonavir" "telithromycine" "tucatinib" "voriconazole")
    (alert "Interaction DISOPYRAMIDE + INHIBITEURS PUISSANTS DU CYP3A4 (Précaution d'emploi) : Risque d’augmentation des effets indésirables du disopyramide par diminution de son métabolisme. Conduite à tenir : Surveillance clinique et adaptation éventuelle de la posologie du disopyramide."))
  (interaction
    (title "DISOPYRAMIDE + JOSAMYCINE")
    (level "Précaution d'emploi")
    (drugs-a "disopyramide")
    (drugs-b "josamycine")
    (alert "Interaction DISOPYRAMIDE + JOSAMYCINE (Précaution d'emploi) : Risque de majoration des effets indésirables du disopyramide : hypoglycémies sévères, allongement de l’intervalle QT et troubles du rythme ventriculaire graves, notamment à type de torsades de pointes. Conduite à tenir : Surveillance clinique, biologique et électrocardiographique régulière."))
  (interaction
    (title "DISOPYRAMIDE + OMBITASVIR + PARITAPRÉVIR")
    (level "CONTRE-INDICATION")
    (drugs-a "disopyramide")
    (drugs-b "ombitasvir" "paritaprevir")
    (alert "Interaction DISOPYRAMIDE + OMBITASVIR + PARITAPRÉVIR (CONTRE-INDICATION) : Risque d’augmentation des concentrations plasmatiques de disopyramide et de ses effets indésirables."))
  (interaction
    (title "DISULFIRAME + ISONIAZIDE")
    (level "Association DECONSEILLEE")
    (drugs-a "disulfirame")
    (drugs-b "isoniazide")
    (alert "Interaction DISULFIRAME + ISONIAZIDE (Association DECONSEILLEE) : Troubles du comportement et de la coordination."))
  (interaction
    (title "DISULFIRAME + METRONIDAZOLE")
    (level "Association DECONSEILLEE")
    (drugs-a "disulfirame")
    (drugs-b "metronidazole")
    (alert "Interaction DISULFIRAME + METRONIDAZOLE (Association DECONSEILLEE) : Risque d’épisodes de psychose aiguë ou d’état confusionnel, réversibles à l’arrêt de l’association."))
  (interaction
    (title "DISULFIRAME + PHÉNYTOÏNE (ET, PAR EXTRAPOLATION, FOSPHÉNYTOÏNE)")
    (level "Association DECONSEILLEE")
    (drugs-a "disulfirame")
    (drugs-b "fosphenytoine" "phenytoine")
    (alert "Interaction DISULFIRAME + PHÉNYTOÏNE (ET, PAR EXTRAPOLATION, FOSPHÉNYTOÏNE) (Association DECONSEILLEE) : Augmentation importante et rapide des concentrations plasmatiques de phénytoïne avec signes toxiques (inhibition de son métabolisme). Conduite à tenir : Si elle ne peut être évitée, contrôle clinique et des concentrations plasmatiques de phénytoïne pendant le traitement par le disulfirame et après son arrêt."))
  (interaction
    (title "DIURÉTIQUES + PRODUITS DE CONTRASTE IODÉS")
    (level "Précaution d'emploi")
    (drugs-a "altizide" "amiloride" "bendroflumethiazide" "bumetanide" "canrenoate de potassium" "chlortalidone" "cicletanine" "clopamide" "eplerenone" "furosemide" "hydrochlorothiazide" "indapamide" "methyclothiazide" "piretanide" "spironolactone" "triamterene")
    (drugs-b "amidotrizoique" "iobitridol" "iodixanol" "iohexol" "iomeprol" "iopamidol" "iopromide" "ioversol" "ioxaglique" "ioxitalamique")
    (alert "Interaction DIURÉTIQUES + PRODUITS DE CONTRASTE IODÉS (Précaution d'emploi) : En cas de déshydratation provoquée par les diurétiques, risque majoré d'insuffisance rénale fonctionnelle aiguë, en particulier lors d'utilisation de doses importantes de produits de contraste iodés. Conduite à tenir : Réhydratation avant administration du produit iodé."))
  (interaction
    (title "DIURÉTIQUES DE L'ANSE + LITHIUM")
    (level "Association DECONSEILLEE")
    (drugs-a "bumetanide" "furosemide" "piretanide")
    (drugs-b "lithium")
    (alert "Interaction DIURÉTIQUES DE L'ANSE + LITHIUM (Association DECONSEILLEE) : Augmentation de la lithémie avec signes de surdosage en lithium, comme lors d’un régime désodé (diminution de l’excrétion urinaire du lithium). Conduite à tenir : Si l'association ne peut être évitée, surveillance stricte de la lithémie et adaptation de la posologie du lithium."))
  (interaction
    (title "DIURÉTIQUES DE L'ANSE + METFORMINE")
    (level "Précaution d'emploi")
    (drugs-a "bumetanide" "furosemide" "piretanide")
    (drugs-b "metformine")
    (alert "Interaction DIURÉTIQUES DE L'ANSE + METFORMINE (Précaution d'emploi) : Acidose lactique due à la metformine, déclenchée par une éventuelle insuffisance rénale fonctionnelle, liée aux diurétiques de l'anse. Conduite à tenir : Ne pas utiliser la metformine lorsque la créatininémie dépasse 15 mg/l (135 µmol/l) chez l'homme, et 12 mg/l (110 µmol/l) chez la femme."))
  (interaction
    (title "DIURÉTIQUES ÉPARGNEURS DE POTASSIUM (SEULS OU ASSOCIÉS) + AUTRES DIURÉTIQUES ÉPARGNEURS DE POTASSIUM (SEULS OU ASSOCIÉS)")
    (level "CONTRE-INDICATION")
    (drugs-a "amiloride" "canrenoate de potassium" "eplerenone" "spironolactone" "triamterene")
    (drugs-b "amiloride" "canrenoate de potassium" "eplerenone" "spironolactone" "triamterene")
    (alert "Interaction DIURÉTIQUES ÉPARGNEURS DE POTASSIUM (SEULS OU ASSOCIÉS) + AUTRES DIURÉTIQUES ÉPARGNEURS DE POTASSIUM (SEULS OU ASSOCIÉS) (CONTRE-INDICATION) : Hyperkaliémie potentiellement létale, notamment chez l'insuffisant rénal (addition des effets hyperkaliémiants). Conduite à tenir : Contre-indiqué sauf s'il existe une hypokaliémie."))
  (interaction
    (title "DIURÉTIQUES ÉPARGNEURS DE POTASSIUM (SEULS OU ASSOCIÉS) + DIURÉTIQUES HYPOKALIÉMIANTS")
    (level "Précaution d'emploi")
    (drugs-a "amiloride" "canrenoate de potassium" "eplerenone" "spironolactone" "triamterene")
    (drugs-b "altizide" "bendroflumethiazide" "bumetanide" "chlortalidone" "cicletanine" "clopamide" "furosemide" "hydrochlorothiazide" "indapamide" "methyclothiazide" "piretanide")
    (alert "Interaction DIURÉTIQUES ÉPARGNEURS DE POTASSIUM (SEULS OU ASSOCIÉS) + DIURÉTIQUES HYPOKALIÉMIANTS (Précaution d'emploi) : L'association rationnelle, utile pour certains patients, n'exclut pas la survenue d'hypokaliémie ou, en particulier chez l'insuffisant rénal et le diabétique, d'hyperkaliémie. Conduite à tenir : Surveiller la kaliémie, éventuellement l'ECG et, s'il y a lieu, reconsidérer le traitement."))
  (interaction
    (title "DIURÉTIQUES ÉPARGNEURS DE POTASSIUM (SEULS OU ASSOCIÉS) + INHIBITEURS DE L'ENZYME DE CONVERSION")
    (level "ASDEC - PE")
    (drugs-a "amiloride" "canrenoate de potassium" "eplerenone" "spironolactone" "triamterene")
    (drugs-b "benazepril" "captopril" "cilazapril" "enalapril" "fosinopril" "lisinopril" "moexipril" "perindopril" "quinapril" "ramipril" "trandolapril" "zofenopril")
    (alert "Interaction DIURÉTIQUES ÉPARGNEURS DE POTASSIUM (SEULS OU ASSOCIÉS) + INHIBITEURS DE L'ENZYME DE CONVERSION (ASDEC - PE) : Risque d'hyperkaliémie (potentiellement létale) surtout en cas d'insuffisance rénale (addition des effets hyperkaliémiants). Conduite à tenir : Association déconseillée : - si l'association est justifiée, contrôle strict de la kaliémie et de la fonction rénale. Précaution d'emploi : - pour la spironolactone à des doses comprises entre 12,5 mg et 50 mg/jour, et pour l’éplérénone utilisées dans le traitement de l'insuffisance cardiaque, ainsi qu'en cas d'hypokaliémie : contrôle strict de la kaliémie et de la fonction rénale."))
  (interaction
    (title "DIURÉTIQUES ÉPARGNEURS DE POTASSIUM (SEULS OU ASSOCIÉS) + LITHIUM")
    (level "Précaution d'emploi")
    (drugs-a "amiloride" "canrenoate de potassium" "eplerenone" "spironolactone" "triamterene")
    (drugs-b "lithium")
    (alert "Interaction DIURÉTIQUES ÉPARGNEURS DE POTASSIUM (SEULS OU ASSOCIÉS) + LITHIUM (Précaution d'emploi) : Augmentation de la lithémie avec signes de surdosage en lithium, comme lors d’un régime désodé (diminution de l’excrétion urinaire du lithium). Conduite à tenir : Surveillance stricte de la lithémie et adaptation éventuelle de la posologie du lithium."))
  (interaction
    (title "DIURÉTIQUES ÉPARGNEURS DE POTASSIUM (SEULS OU ASSOCIÉS) + POTASSIUM")
    (level "Association DECONSEILLEE")
    (drugs-a "amiloride" "canrenoate de potassium" "eplerenone" "spironolactone" "triamterene")
    (drugs-b "potassium")
    (alert "Interaction DIURÉTIQUES ÉPARGNEURS DE POTASSIUM (SEULS OU ASSOCIÉS) + POTASSIUM (Association DECONSEILLEE) : Pour une quantité de potassium > à 1 mmol/prise, hyperkaliémie potentiellement létale, notamment chez l'insuffisant rénal (addition des effets hyperkaliémiants). Conduite à tenir : Sauf en cas d'hypokaliémie."))
  (interaction
    (title "DIURÉTIQUES ÉPARGNEURS DE POTASSIUM (SEULS OU ASSOCIÉS) + TACROLIMUS")
    (level "Association DECONSEILLEE")
    (drugs-a "amiloride" "canrenoate de potassium" "eplerenone" "spironolactone" "triamterene")
    (drugs-b "tacrolimus")
    (alert "Interaction DIURÉTIQUES ÉPARGNEURS DE POTASSIUM (SEULS OU ASSOCIÉS) + TACROLIMUS (Association DECONSEILLEE) : Hyperkaliémie potentiellement létale, surtout lors d'une insuffisance rénale (addition des effets hyperkaliémiants)."))
  (interaction
    (title "DIURÉTIQUES HYPOKALIÉMIANTS + INHIBITEURS DE L'ENZYME DE CONVERSION")
    (level "Précaution d'emploi")
    (drugs-a "altizide" "bendroflumethiazide" "bumetanide" "chlortalidone" "cicletanine" "clopamide" "furosemide" "hydrochlorothiazide" "indapamide" "methyclothiazide" "piretanide")
    (drugs-b "benazepril" "captopril" "cilazapril" "enalapril" "fosinopril" "lisinopril" "moexipril" "perindopril" "quinapril" "ramipril" "trandolapril" "zofenopril")
    (alert "Interaction DIURÉTIQUES HYPOKALIÉMIANTS + INHIBITEURS DE L'ENZYME DE CONVERSION (Précaution d'emploi) : Risque d'hypotension artérielle brutale et/ou d'insuffisance rénale aiguë lors de l'instauration ou de l'augmentation de la posologie d'un traitement par un inhibiteur de l'enzyme de conversion en cas de déplétion hydrosodée préexistante. Conduite à tenir : Dans l'hypertension artérielle, lorsqu'un traitement diurétique préalable a pu entraîner une déplétion hydrosodée, il faut : - soit arrêter le diurétique avant de débuter le traitement par l'IEC, et réintroduire un diurétique hypokaliémiant si nécessaire ultérieurement ; - soit administrer des doses initiales réduites d'IEC et augmenter progressivement la posologie. Dans l'insuffisance cardiaque congestive traitée par diurétiques, commencer par une dose très faible d'IEC, éventuellement après réduction de la dose du diurétique hypokaliémient associé. Dans tous les cas : surveiller la fonction rénale (créatininémie) dans les premières semaines du traitement par l'IEC."))
  (interaction
    (title "DIURÉTIQUES THIAZIDIQUES ET APPARENTÉS + LITHIUM")
    (level "Association DECONSEILLEE")
    (drugs-a "altizide" "bendroflumethiazide" "chlortalidone" "cicletanine" "clopamide" "hydrochlorothiazide" "indapamide" "methyclothiazide")
    (drugs-b "lithium")
    (alert "Interaction DIURÉTIQUES THIAZIDIQUES ET APPARENTÉS + LITHIUM (Association DECONSEILLEE) : Augmentation de la lithémie avec signes de surdosage en lithium, comme lors d’un régime désodé (diminution de l’excrétion urinaire du lithium). Conduite à tenir : Si l'association ne peut être évitée, surveillance stricte de la lithémie et adaptation de la posologie du lithium."))
  (interaction
    (title "DOCETAXEL + DRONEDARONE")
    (level "Précaution d'emploi")
    (drugs-a "docetaxel")
    (drugs-b "dronedarone")
    (alert "Interaction DOCETAXEL + DRONEDARONE (Précaution d'emploi) : Risque de majoration de la toxicité du docétaxel par diminution de son métabolisme. Conduite à tenir : Surveillance clinique et adaptation éventuelle de la posologie du docétaxel pendant le traitement par l’inhibiteur enzymatique."))
  (interaction
    (title "DOCETAXEL + INDUCTEURS ENZYMATIQUES")
    (level "Association DECONSEILLEE")
    (drugs-a "docetaxel")
    (drugs-b "apalutamide" "carbamazepine" "cenobamate" "dabrafenib" "efavirenz" "enzalutamide" "eslicarbazepine" "fosphenytoine" "letermovir" "lorlatinib" "lumacaftor" "nevirapine" "oxcarbazepine" "phenobarbital" "phenytoine" "pitolisant" "primidone" "rifabutine" "rifampicine" "sotorasib")
    (alert "Interaction DOCETAXEL + INDUCTEURS ENZYMATIQUES (Association DECONSEILLEE) : Diminution des concentrations du cytotoxique par augmentation de son métabolisme par l’inducteur, avec risque de moindre efficacité."))
  (interaction
    (title "DOCETAXEL + INHIBITEURS PUISSANTS DU CYP3A4")
    (level "Précaution d'emploi")
    (drugs-a "docetaxel")
    (drugs-b "clarithromycine" "cobicistat" "erythromycine" "itraconazole" "ketoconazole" "posaconazole" "ritonavir" "telithromycine" "tucatinib" "voriconazole")
    (alert "Interaction DOCETAXEL + INHIBITEURS PUISSANTS DU CYP3A4 (Précaution d'emploi) : Risque de majoration des effets indésirables dose-dépendants du docétaxel par inhibition de son métabolisme par l’inhibiteur enzymatique. Conduite à tenir : Surveillance clinique et adaptation éventuelle de la posologie du docétaxel pendant le traitement par l’inhibiteur enzymatique."))
  (interaction
    (title "DOCETAXEL + MILLEPERTUIS")
    (level "CONTRE-INDICATION")
    (drugs-a "docetaxel")
    (drugs-b "millepertuis")
    (alert "Interaction DOCETAXEL + MILLEPERTUIS (CONTRE-INDICATION) : Risque de moindre efficacité du taxane par augmentation de son métabolisme par le millepertuis."))
  (interaction
    (title "DOLUTÉGRAVIR + INDUCTEURS ENZYMATIQUES")
    (level "ASDEC - PE")
    (drugs-a "dolutegravir")
    (drugs-b "apalutamide" "carbamazepine" "cenobamate" "dabrafenib" "efavirenz" "enzalutamide" "eslicarbazepine" "fosphenytoine" "letermovir" "lorlatinib" "lumacaftor" "nevirapine" "oxcarbazepine" "phenobarbital" "phenytoine" "pitolisant" "primidone" "rifabutine" "rifampicine" "sotorasib")
    (alert "Interaction DOLUTÉGRAVIR + INDUCTEURS ENZYMATIQUES (ASDEC - PE) : Diminution des concentrations plasmatiques de dolutégravir par augmentation de son métabolisme par l’inducteur. Conduite à tenir : Association déconseillée : - en cas de résistance à la classe des inhibiteurs d'intégrase Précaution d'emploi : - en l'absence de résistance à la classe des inhibiteurs d'intégrase Adaptation de la posologie de dolutégravir à 50 mg 2 fois par jour pendant l’association et une semaine après son arrêt."))
  (interaction
    (title "DOLUTÉGRAVIR + METFORMINE")
    (level "Précaution d'emploi")
    (drugs-a "dolutegravir")
    (drugs-b "metformine")
    (alert "Interaction DOLUTÉGRAVIR + METFORMINE (Précaution d'emploi) : Augmentation moyenne de moins de deux fois des concentrations plasmatiques de metformine. Conduite à tenir : Chez le patient avec une insuffisance rénale modérée, surveillance clinique et éventuelle réduction supplémentaire de la posologie de metformine."))
  (interaction
    (title "DOLUTÉGRAVIR + MILLEPERTUIS")
    (level "Association DECONSEILLEE")
    (drugs-a "dolutegravir")
    (drugs-b "millepertuis")
    (alert "Interaction DOLUTÉGRAVIR + MILLEPERTUIS (Association DECONSEILLEE) : Risque de diminution des concentrations plasmatiques de dolutégravir par augmentation de son métabolisme par le millepertuis."))
  (interaction
    (title "DOMPERIDONE + FLUCONAZOLE")
    (level "CONTRE-INDICATION")
    (drugs-a "domperidone")
    (drugs-b "fluconazole")
    (alert "Interaction DOMPERIDONE + FLUCONAZOLE (CONTRE-INDICATION) : Risque de troubles du rythme ventriculaire, notamment de torsades de pointes."))
  (interaction
    (title "DOMPERIDONE + INHIBITEURS PUISSANTS DU CYP3A4")
    (level "CONTRE-INDICATION")
    (drugs-a "domperidone")
    (drugs-b "clarithromycine" "cobicistat" "erythromycine" "itraconazole" "ketoconazole" "posaconazole" "ritonavir" "telithromycine" "tucatinib" "voriconazole")
    (alert "Interaction DOMPERIDONE + INHIBITEURS PUISSANTS DU CYP3A4 (CONTRE-INDICATION) : Augmentation des concentrations plasmatiques de dompéridone par diminution de son métabolisme hépatique par l’inhibiteur."))
  (interaction
    (title "DOPAMINERGIQUES + NEUROLEPTIQUES ANTIÉMÉTIQUES")
    (level "CONTRE-INDICATION")
    (drugs-a "amantadine" "apomorphine" "bromocriptine" "cabergoline" "entacapone" "lisuride" "piribedil" "pramipexole" "quinagolide" "rasagiline" "ropinirole" "rotigotine" "selegiline" "tolcapone")
    (drugs-b "alizapride" "metoclopramide")
    (alert "Interaction DOPAMINERGIQUES + NEUROLEPTIQUES ANTIÉMÉTIQUES (CONTRE-INDICATION) : Antagonisme réciproque entre le dopaminergique et le neuroleptique. Conduite à tenir : Utiliser un antiémétique dénué d'effets extrapyramidaux."))
  (interaction
    (title "DOPAMINERGIQUES + TETRABENAZINE")
    (level "Association DECONSEILLEE")
    (drugs-a "amantadine" "apomorphine" "bromocriptine" "cabergoline" "entacapone" "lisuride" "piribedil" "pramipexole" "quinagolide" "rasagiline" "ropinirole" "rotigotine" "selegiline" "tolcapone")
    (drugs-b "tetrabenazine")
    (alert "Interaction DOPAMINERGIQUES + TETRABENAZINE (Association DECONSEILLEE) : Antagonisme réciproque entre le dopaminergique et la tétrabénazine."))
  (interaction
    (title "DOPAMINERGIQUES, HORS PARKINSON + NEUROLEPTIQUES ANTIPSYCHOTIQUES (SAUF CLOZAPINE)")
    (level "CONTRE-INDICATION")
    (drugs-a "cabergoline" "quinagolide")
    (drugs-b "amisulpride" "aripiprazole" "asenapine" "chlorpromazine" "cyamemazine" "droperidol" "flupentixol" "fluphenazine" "haloperidol" "levomepromazine" "loxapine" "olanzapine" "paliperidone" "penfluridol" "pimozide" "pipamperone" "pipotiazine" "propericiazine" "quetiapine" "risperidone" "sulpiride" "tiapride" "zuclopenthixol")
    (alert "Interaction DOPAMINERGIQUES, HORS PARKINSON + NEUROLEPTIQUES ANTIPSYCHOTIQUES (SAUF CLOZAPINE) (CONTRE-INDICATION) : Antagonisme réciproque de l'agoniste dopaminergique et des neuroleptiques."))
  (interaction
    (title "DRONEDARONE + ÉDOXABAN")
    (level "Précaution d'emploi")
    (drugs-a "dronedarone")
    (drugs-b "edoxaban")
    (alert "Interaction DRONEDARONE + ÉDOXABAN (Précaution d'emploi) : Augmentation des concentrations plasmatiques de l’édoxaban, avec majoration du risque de saignement. Conduite à tenir : Réduire la dose d’édoxaban de moitié."))
  (interaction
    (title "DRONEDARONE + FIDAXOMICINE")
    (level "Association DECONSEILLEE")
    (drugs-a "dronedarone")
    (drugs-b "fidaxomicine")
    (alert "Interaction DRONEDARONE + FIDAXOMICINE (Association DECONSEILLEE) : Augmentation des concentrations plasmatiques de la fidaxomicine."))
  (interaction
    (title "DRONEDARONE + IBRUTINIB")
    (level "Association DECONSEILLEE")
    (drugs-a "dronedarone")
    (drugs-b "ibrutinib")
    (alert "Interaction DRONEDARONE + IBRUTINIB (Association DECONSEILLEE) : Risque d’augmentation des concentrations plasmatiques d’ibrutinib par diminution de son métabolisme hépatique par la dronédarone. Conduite à tenir : Si l’association ne peut être évitée, surveillance clinique étroite et réduction de la dose d’ibrutinib à 280 mg par jour pendant la durée de l’association."))
  (interaction
    (title "DRONEDARONE + IMMUNOSUPPRESSEURS")
    (level "Association DECONSEILLEE")
    (drugs-a "dronedarone")
    (drugs-b "ciclosporine" "everolimus" "sirolimus" "tacrolimus" "temsirolimus")
    (alert "Interaction DRONEDARONE + IMMUNOSUPPRESSEURS (Association DECONSEILLEE) : Augmentation importante des concentrations sanguines de l’immunosuppresseur par diminution de son métabolisme."))
  (interaction
    (title "DRONEDARONE + INDUCTEURS ENZYMATIQUES PUISSANTS")
    (level "Association DECONSEILLEE")
    (drugs-a "dronedarone")
    (drugs-b "apalutamide" "carbamazepine" "enzalutamide" "fosphenytoine" "phenobarbital" "phenytoine" "primidone")
    (alert "Interaction DRONEDARONE + INDUCTEURS ENZYMATIQUES PUISSANTS (Association DECONSEILLEE) : Diminution importante des concentrations de dronédarone par augmentation de son métabolisme, sans modification notable du métabolite actif."))
  (interaction
    (title "DRONEDARONE + INHIBITEURS PUISSANTS DU CYP3A4")
    (level "CONTRE-INDICATION")
    (drugs-a "dronedarone")
    (drugs-b "clarithromycine" "cobicistat" "erythromycine" "itraconazole" "ketoconazole" "posaconazole" "ritonavir" "telithromycine" "tucatinib" "voriconazole")
    (alert "Interaction DRONEDARONE + INHIBITEURS PUISSANTS DU CYP3A4 (CONTRE-INDICATION) : Augmentation importante des concentrations de dronédarone par diminution de son métabolisme."))
  (interaction
    (title "DRONEDARONE + MILLEPERTUIS")
    (level "Association DECONSEILLEE")
    (drugs-a "dronedarone")
    (drugs-b "millepertuis")
    (alert "Interaction DRONEDARONE + MILLEPERTUIS (Association DECONSEILLEE) : Diminution importante des concentrations de dronédarone par augmentation de son métabolisme, sans modification notable du métabolite actif."))
  (interaction
    (title "DRONEDARONE + QUINIDINE")
    (level "Précaution d'emploi")
    (drugs-a "dronedarone")
    (drugs-b "quinidine")
    (alert "Interaction DRONEDARONE + QUINIDINE (Précaution d'emploi) : Risque de bradycardie ou de bloc auriculo-ventriculaire, notamment chez le sujet âgé. Par ailleurs, légère augmentation des concentrations de dronédarone par diminution de son métabolisme par la quinidine. Conduite à tenir : Débuter le traitement par la quinidine aux posologies minimales recommandées, et ajuster les doses en fonction de l’ECG."))
  (interaction
    (title "DRONEDARONE + RIFAMPICINE")
    (level "Association DECONSEILLEE")
    (drugs-a "dronedarone")
    (drugs-b "rifampicine")
    (alert "Interaction DRONEDARONE + RIFAMPICINE (Association DECONSEILLEE) : Diminution importante des concentrations de dronédarone par augmentation de son métabolisme, sans modification notable du métabolite actif."))
  (interaction
    (title "DRONEDARONE + SIMVASTATINE")
    (level "Association DECONSEILLEE")
    (drugs-a "dronedarone")
    (drugs-b "simvastatine")
    (alert "Interaction DRONEDARONE + SIMVASTATINE (Association DECONSEILLEE) : Risque majoré d'effets indésirables (concentration-dépendants) à type de rhabdomyolyse (diminution du métabolisme hépatique de la simvastatine)."))
  (interaction
    (title "DRONEDARONE + TALAZOPARIB")
    (level "Précaution d'emploi")
    (drugs-a "dronedarone")
    (drugs-b "talazoparib")
    (alert "Interaction DRONEDARONE + TALAZOPARIB (Précaution d'emploi) : Augmentation des concentrations de talazoparib avec risque de majoration de la toxicité. Conduite à tenir : Réduire la dose de talazoparib."))
  (interaction
    (title "DRONEDARONE + VERAPAMIL")
    (level "Précaution d'emploi")
    (drugs-a "dronedarone")
    (drugs-b "verapamil")
    (alert "Interaction DRONEDARONE + VERAPAMIL (Précaution d'emploi) : Risque de bradycardie ou de bloc auriculo-ventriculaire, notamment chez le sujet âgé. Par ailleurs, légère augmentation des concentrations de dronédarone par diminution de son métabolisme par l’antagoniste des canaux calciques. Conduite à tenir : Débuter le traitement par l’antagoniste calcique aux posologies minimales recommandées, et ajuster les doses en fonction de l’ECG."))
  (interaction
    (title "DULOXETINE + ENOXACINE")
    (level "CONTRE-INDICATION")
    (drugs-a "duloxetine")
    (drugs-b "enoxacine")
    (alert "Interaction DULOXETINE + ENOXACINE (CONTRE-INDICATION) : Risque d’augmentation des effets indésirables de la duloxétine par diminution de son métabolisme hépatique par l'énoxacine."))
  (interaction
    (title "DULOXETINE + FLUVOXAMINE")
    (level "CONTRE-INDICATION")
    (drugs-a "duloxetine")
    (drugs-b "fluvoxamine")
    (alert "Interaction DULOXETINE + FLUVOXAMINE (CONTRE-INDICATION) : Risque d’augmentation des effets indésirables de la duloxétine par diminution de son métabolisme hépatique par la fluvoxamine."))
  (interaction
    (title "DULOXETINE + MEQUITAZINE")
    (level "Association DECONSEILLEE")
    (drugs-a "duloxetine")
    (drugs-b "mequitazine")
    (alert "Interaction DULOXETINE + MEQUITAZINE (Association DECONSEILLEE) : Risque de majoration des effets indésirables de la méquitazine, par inhibition de son métabolisme par l’inhibiteur enzymatique."))
  (interaction
    (title "DULOXETINE + METOPROLOL")
    (level "Précaution d'emploi")
    (drugs-a "duloxetine")
    (drugs-b "metoprolol")
    (alert "Interaction DULOXETINE + METOPROLOL (Précaution d'emploi) : Augmentation des concentrations plasmatiques de métoprolol avec risque de surdosage, par diminution de son métabolisme hépatique par la duloxétine. Conduite à tenir : Surveillance clinique et réduction de la posologie du métoprolol pendant le traitement par la duloxétine et après son arrêt."))
  (interaction
    (title "DULOXETINE + PROPAFENONE")
    (level "Précaution d'emploi")
    (drugs-a "duloxetine")
    (drugs-b "propafenone")
    (alert "Interaction DULOXETINE + PROPAFENONE (Précaution d'emploi) : Augmentation des concentrations plasmatiques de propafénone avec risque de surdosage, par diminution de son métabolisme hépatique par la duloxétine. Conduite à tenir : Surveillance clinique et réduction de la posologie de la propafénone pendant le traitement par la duloxétine et après son arrêt."))
  (interaction
    (title "DULOXETINE + TAMOXIFENE")
    (level "Association DECONSEILLEE")
    (drugs-a "duloxetine")
    (drugs-b "tamoxifene")
    (alert "Interaction DULOXETINE + TAMOXIFENE (Association DECONSEILLEE) : Risque de baisse de l'efficacité du tamoxifène, par inhibition de la formation de son métabolite actif par la duloxétine."))
  (interaction
    (title "DULOXETINE + TETRABENAZINE")
    (level "CONTRE-INDICATION")
    (drugs-a "duloxetine")
    (drugs-b "tetrabenazine")
    (alert "Interaction DULOXETINE + TETRABENAZINE (CONTRE-INDICATION) : Augmentation possiblement très importante de l’exposition des métabolites actifs de la tétrabénazine."))
  (interaction
    (title "DULOXETINE + TRAMADOL")
    (level "Association DECONSEILLEE")
    (drugs-a "duloxetine")
    (drugs-b "tramadol")
    (alert "Interaction DULOXETINE + TRAMADOL (Association DECONSEILLEE) : Risque d’inefficacité de l’opiacé par inhibition de son métabolisme par l’inhibiteur."))
  (interaction
    (title "ÉDOXABAN + ERYTHROMYCINE")
    (level "Précaution d'emploi")
    (drugs-a "edoxaban")
    (drugs-b "erythromycine")
    (alert "Interaction ÉDOXABAN + ERYTHROMYCINE (Précaution d'emploi) : Augmentation des concentrations plasmatiques de l’édoxaban, avec majoration du risque de saignement. Conduite à tenir : Réduire la dose d’édoxaban de moitié."))
  (interaction
    (title "ÉDOXABAN + ITRACONAZOLE")
    (level "Précaution d'emploi")
    (drugs-a "edoxaban")
    (drugs-b "itraconazole")
    (alert "Interaction ÉDOXABAN + ITRACONAZOLE (Précaution d'emploi) : Augmentation des concentrations plasmatiques de l’édoxaban, avec majoration du risque de saignement. Conduite à tenir : Réduire la dose d’édoxaban de moitié."))
  (interaction
    (title "EFAVIRENZ + ERGOTAMINE")
    (level "CONTRE-INDICATION")
    (drugs-a "efavirenz")
    (drugs-b "ergotamine")
    (alert "Interaction EFAVIRENZ + ERGOTAMINE (CONTRE-INDICATION) : Ergotisme avec possibilité de nécrose des extrémités (inhibition du métabolisme hépatique de l'alcaloïde de l'ergot de seigle)."))
  (interaction
    (title "EFAVIRENZ + FOSAMPRENAVIR")
    (level "Précaution d'emploi")
    (drugs-a "efavirenz")
    (drugs-b "fosamprenavir")
    (alert "Interaction EFAVIRENZ + FOSAMPRENAVIR (Précaution d'emploi) : Risque de baisse de l'efficacité de l'amprénavir. Conduite à tenir : Surveillance clinique et biologique régulière, notamment en début d'association."))
  (interaction
    (title "EFAVIRENZ + GINKGO")
    (level "Association DECONSEILLEE")
    (drugs-a "efavirenz")
    (drugs-b "ginkgo")
    (alert "Interaction EFAVIRENZ + GINKGO (Association DECONSEILLEE) : Risque de moindre efficacité de l'éfavirenz."))
  (interaction
    (title "EFAVIRENZ + HORMONES THYROÏDIENNES")
    (level "Précaution d'emploi")
    (drugs-a "efavirenz")
    (drugs-b "levothyroxine" "liothyronine sodique" "thyroxines" "tiratricol")
    (alert "Interaction EFAVIRENZ + HORMONES THYROÏDIENNES (Précaution d'emploi) : Risque d'hypothyroïdie clinique chez les patients hypothyroïdiens, par augmentation du métabolisme de la T3 et de la T4. Conduite à tenir : Surveillance clinique et biologique. Adaptation, si besoin, de la posologie des hormones thyroïdiennes pendant le traitement par l'inducteur et après son arrêt."))
  (interaction
    (title "EFAVIRENZ + LÉNACAPAVIR")
    (level "Association DECONSEILLEE")
    (drugs-a "efavirenz")
    (drugs-b "lenacapavir")
    (alert "Interaction EFAVIRENZ + LÉNACAPAVIR (Association DECONSEILLEE) : Diminution importante des concentrations de lénacapavir."))
  (interaction
    (title "EFAVIRENZ + MILLEPERTUIS")
    (level "CONTRE-INDICATION")
    (drugs-a "efavirenz")
    (drugs-b "millepertuis")
    (alert "Interaction EFAVIRENZ + MILLEPERTUIS (CONTRE-INDICATION) : Risque de diminution des concentrations d'éfavirenz, avec baisse d'efficacité."))
  (interaction
    (title "EFAVIRENZ + PIMOZIDE")
    (level "CONTRE-INDICATION")
    (drugs-a "efavirenz")
    (drugs-b "pimozide")
    (alert "Interaction EFAVIRENZ + PIMOZIDE (CONTRE-INDICATION) : Risque majoré de troubles du rythme ventriculaire, notamment de torsades de pointes."))
  (interaction
    (title "EFAVIRENZ + RIFABUTINE")
    (level "Précaution d'emploi")
    (drugs-a "efavirenz")
    (drugs-b "rifabutine")
    (alert "Interaction EFAVIRENZ + RIFABUTINE (Précaution d'emploi) : Diminution importante des concentrations de rifabutine, par augmentation de son métabolisme hépatique par l’éfavirenz. Egalement, possibilité de diminution importante des concentrations d'éfavirenz par la rifabutine. Conduite à tenir : Adaptation éventuelle de la posologie de la rifabutine ou de l'éfavirenz pendant la durée de l'association."))
  (interaction
    (title "EFAVIRENZ + RIFAMPICINE")
    (level "Précaution d'emploi")
    (drugs-a "efavirenz")
    (drugs-b "rifampicine")
    (alert "Interaction EFAVIRENZ + RIFAMPICINE (Précaution d'emploi) : Diminution des concentrations plasmatiques et de l'efficacité de l'éfavirenz par augmentation de son métabolisme hépatique par la rifampicine. Conduite à tenir : Surveillance clinique et biologique régulière, notamment en début d'association."))
  (interaction
    (title "EFAVIRENZ + VELPATASVIR")
    (level "Association DECONSEILLEE")
    (drugs-a "efavirenz")
    (drugs-b "velpatasvir")
    (alert "Interaction EFAVIRENZ + VELPATASVIR (Association DECONSEILLEE) : Risque de diminution des concentrations de velpatasvir/sofosbuvir, avec possible retentissement sur l’efficacité."))
  (interaction
    (title "EFAVIRENZ + VORICONAZOLE")
    (level "Association DECONSEILLEE")
    (drugs-a "efavirenz")
    (drugs-b "voriconazole")
    (alert "Interaction EFAVIRENZ + VORICONAZOLE (Association DECONSEILLEE) : Risque de baisse de l'efficacité du voriconazole par augmentation de son métabolisme hépatique par l'efavirenz. Conduite à tenir : Si l'association ne peut être évitée, surveillance clinique étroite et adaptation de la posologie du voriconazole et de l'éfavirenz pendant l'association."))
  (interaction
    (title "ÉLIGLUSTAT + INHIBITEURS PUISSANTS DU CYP3A4")
    (level "CONTRE-INDICATION")
    (drugs-a "eliglustat")
    (drugs-b "clarithromycine" "cobicistat" "erythromycine" "itraconazole" "ketoconazole" "posaconazole" "ritonavir" "telithromycine" "tucatinib" "voriconazole")
    (alert "Interaction ÉLIGLUSTAT + INHIBITEURS PUISSANTS DU CYP3A4 (CONTRE-INDICATION) : Chez les patients ayant un génotype de métaboliseurs lents du CYP2D6, risque de majoration des effets indésirables de l’éliglustat."))
  (interaction
    (title "ELTROMBOPAG + INHIBITEURS DE L'HMG-COA RÉDUCTASE (STATINES)")
    (level "Précaution d'emploi")
    (drugs-a "eltrombopag")
    (drugs-b "atorvastatine" "fluvastatine" "pitavastatine" "pravastatine" "rosuvastatine" "simvastatine")
    (alert "Interaction ELTROMBOPAG + INHIBITEURS DE L'HMG-COA RÉDUCTASE (STATINES) (Précaution d'emploi) : Risque de majoration de la toxicité des statines, par inhibition de leur recapture hépatique. Conduite à tenir : Surveillance clinique et adaptation éventuelle de la posologie de la statine."))
  (interaction
    (title "ELTROMBOPAG + OZANIMOD")
    (level "Association DECONSEILLEE")
    (drugs-a "eltrombopag")
    (drugs-b "ozanimod")
    (alert "Interaction ELTROMBOPAG + OZANIMOD (Association DECONSEILLEE) : Risque d’augmentation des effets indésirables de l’ozanimod."))
  (interaction
    (title "ELVITÉGRAVIR + ESTROPROGESTATIFS CONTRACEPTIFS")
    (level "Précaution d'emploi")
    (drugs-a "elvitegravir")
    (drugs-b "estradiol" "ethinylestradiol")
    (alert "Interaction ELVITÉGRAVIR + ESTROPROGESTATIFS CONTRACEPTIFS (Précaution d'emploi) : Diminution de l’efficacité contraceptive par augmentation du métabolisme hépatique du contraceptif hormonal par l'elvitégravir. Conduite à tenir : Utiliser une méthode additionnelle de type mécanique (préservatif) pendant la durée de l’association, et un cycle suivant l’arrêt de l'elvitégravir."))
  (interaction
    (title "ELVITÉGRAVIR + ITRACONAZOLE")
    (level "Précaution d'emploi")
    (drugs-a "elvitegravir")
    (drugs-b "itraconazole")
    (alert "Interaction ELVITÉGRAVIR + ITRACONAZOLE (Précaution d'emploi) : Augmentation des concentrations plasmatiques d’elvitegravir par diminution de son métabolisme par l'itraconazole. Conduite à tenir : Avec l’elvitegravir co-administré avec le cobicistat, surveillance clinique. Limiter la dose maximale d’itraconazole à 200 mg/j."))
  (interaction
    (title "ELVITÉGRAVIR + KETOCONAZOLE")
    (level "Précaution d'emploi")
    (drugs-a "elvitegravir")
    (drugs-b "ketoconazole")
    (alert "Interaction ELVITÉGRAVIR + KETOCONAZOLE (Précaution d'emploi) : Augmentation des concentrations plasmatiques d’elvitegravir par diminution de son métabolisme par le kétoconazole. Conduite à tenir : Avec l’elvitegravir co-administré avec le cobicistat, surveillance clinique. Limiter la dose maximale de kétoconazole à 200 mg/j."))
  (interaction
    (title "ENOXACINE + ROPINIROLE")
    (level "Précaution d'emploi")
    (drugs-a "enoxacine")
    (drugs-b "ropinirole")
    (alert "Interaction ENOXACINE + ROPINIROLE (Précaution d'emploi) : Augmentation des concentrations plasmatiques de ropinirole avec signes de surdosage par diminution de son métabolisme hépatique. Conduite à tenir : Surveillance clinique et réduction de la posologie du ropinirole pendant le traitement par l'énoxacine et après son arrêt."))
  (interaction
    (title "ENOXACINE + THÉOPHYLLINE (ET, PAR EXTRAPOLATION, AMINOPHYLLINE)")
    (level "CONTRE-INDICATION")
    (drugs-a "enoxacine")
    (drugs-b "aminophylline" "theophylline")
    (alert "Interaction ENOXACINE + THÉOPHYLLINE (ET, PAR EXTRAPOLATION, AMINOPHYLLINE) (CONTRE-INDICATION) : Surdosage en théophylline par diminution importante de son métabolisme."))
  (interaction
    (title "ENTACAPONE + FER")
    (level "Précaution d'emploi")
    (drugs-a "entacapone")
    (drugs-b "fer")
    (alert "Interaction ENTACAPONE + FER (Précaution d'emploi) : Diminution de l'absorption digestive de l'entacapone et du fer par chélation de celui-ci par l'entacapone. Conduite à tenir : Prendre les sels de fer à distance de l'entacapone (plus de 2 heures si possible)."))
  (interaction
    (title "ENZALUTAMIDE + GEMFIBROZIL")
    (level "Précaution d'emploi")
    (drugs-a "enzalutamide")
    (drugs-b "gemfibrozil")
    (alert "Interaction ENZALUTAMIDE + GEMFIBROZIL (Précaution d'emploi) : Majoration de la fraction active de l’enzalutamide. Conduite à tenir : Réduire la dose d’enzalutamide de moitié en cas d’association au gemfibrozil."))
  (interaction
    (title "EPLERENONE + INHIBITEURS DE L'ENZYME DE CONVERSION")
    (level "Précaution d'emploi")
    (drugs-a "eplerenone")
    (drugs-b "benazepril" "captopril" "cilazapril" "enalapril" "fosinopril" "lisinopril" "moexipril" "perindopril" "quinapril" "ramipril" "trandolapril" "zofenopril")
    (alert "Interaction EPLERENONE + INHIBITEURS DE L'ENZYME DE CONVERSION (Précaution d'emploi) : Majoration du risque d’hyperkaliémie, notamment chez le sujet âgé. Conduite à tenir : Contrôle strict de la kaliémie et de la fonction rénale pendant l’association."))
  (interaction
    (title "EPLERENONE + INHIBITEURS PUISSANTS DU CYP3A4")
    (level "CONTRE-INDICATION")
    (drugs-a "eplerenone")
    (drugs-b "clarithromycine" "cobicistat" "erythromycine" "itraconazole" "ketoconazole" "posaconazole" "ritonavir" "telithromycine" "tucatinib" "voriconazole")
    (alert "Interaction EPLERENONE + INHIBITEURS PUISSANTS DU CYP3A4 (CONTRE-INDICATION) : Risque d’augmentation des concentrations plasmatiques de l’éplérénone par l'inhibiteur et de ses effets indésirables, notamment l’hyperkaliémie."))
  (interaction
    (title "ERGOTAMINE + MACROLIDES (SAUF SPIRAMYCINE)")
    (level "CONTRE-INDICATION")
    (drugs-a "ergotamine")
    (drugs-b "azithromycine" "clarithromycine" "erythromycine" "josamycine" "midecamycine" "roxithromycine" "telithromycine")
    (alert "Interaction ERGOTAMINE + MACROLIDES (SAUF SPIRAMYCINE) (CONTRE-INDICATION) : Ergotisme avec possibilité de nécrose des extrémités (diminution de l'élimination hépatique de l'ergotamine)."))
  (interaction
    (title "ERGOTAMINE + OXPRENOLOL")
    (level "Précaution d'emploi")
    (drugs-a "ergotamine")
    (drugs-b "oxprenolol")
    (alert "Interaction ERGOTAMINE + OXPRENOLOL (Précaution d'emploi) : Ergotisme : quelques cas de spasme artériel avec ischémie des extrémités ont été observés (addition d'effets vasculaires). Conduite à tenir : Surveillance clinique renforcée, en particulier pendant les premières semaines de l'association."))
  (interaction
    (title "ERGOTAMINE + PROPRANOLOL")
    (level "Précaution d'emploi")
    (drugs-a "ergotamine")
    (drugs-b "propranolol")
    (alert "Interaction ERGOTAMINE + PROPRANOLOL (Précaution d'emploi) : Ergotisme : quelques cas de spasme artériel avec ischémie des extrémités ont été observés (addition d'effets vasculaires). Conduite à tenir : Surveillance clinique renforcée, en particulier pendant les premières semaines de l'association."))
  (interaction
    (title "ERGOTAMINE + QUINUPRISTINE")
    (level "CONTRE-INDICATION")
    (drugs-a "ergotamine")
    (drugs-b "quinupristine")
    (alert "Interaction ERGOTAMINE + QUINUPRISTINE (CONTRE-INDICATION) : Ergotisme avec possibilité de nécrose des extrémités (inhibition du métabolisme hépatique de l'alcaloïde de l'ergot de seigle)."))
  (interaction
    (title "ERGOTAMINE + STIRIPENTOL")
    (level "CONTRE-INDICATION")
    (drugs-a "ergotamine")
    (drugs-b "stiripentol")
    (alert "Interaction ERGOTAMINE + STIRIPENTOL (CONTRE-INDICATION) : Ergotisme avec possibilité de nécrose des extrémités (inhibition de l’élimination hépatique de l'alcaloïde de l’ergot de seigle)."))
  (interaction
    (title "ERGOTAMINE + TRICLABENDAZOLE")
    (level "CONTRE-INDICATION")
    (drugs-a "ergotamine")
    (drugs-b "triclabendazole")
    (alert "Interaction ERGOTAMINE + TRICLABENDAZOLE (CONTRE-INDICATION) : Ergotisme avec possibilité de nécrose des extrémités (inhibition du métabolisme hépatique de l’alcaloïde de l’ergot de seigle). Conduite à tenir : Respecter un délai de 24 heures entre l’arrêt du triclabendazole et l’ergotamine, et inversement."))
  (interaction
    (title "ERYTHROMYCINE + FIDAXOMICINE")
    (level "Association DECONSEILLEE")
    (drugs-a "erythromycine")
    (drugs-b "fidaxomicine")
    (alert "Interaction ERYTHROMYCINE + FIDAXOMICINE (Association DECONSEILLEE) : Augmentation des concentrations plasmatiques de la fidaxomicine."))
  (interaction
    (title "ERYTHROMYCINE + GLIBENCLAMIDE")
    (level "Précaution d'emploi")
    (drugs-a "erythromycine")
    (drugs-b "glibenclamide")
    (alert "Interaction ERYTHROMYCINE + GLIBENCLAMIDE (Précaution d'emploi) : Risque d'hypoglycémie par augmentation de l’absorption et des concentrations plasmatiques de l’antidiabétique. Conduite à tenir : Prévenir le patient, renforcer l'autosurveillance glycémique et adapter éventuellement la posologie du sulfamide hypoglycémiant pendant le traitement par l’érythromycine."))
  (interaction
    (title "ERYTHROMYCINE + GLIMEPIRIDE")
    (level "Précaution d'emploi")
    (drugs-a "erythromycine")
    (drugs-b "glimepiride")
    (alert "Interaction ERYTHROMYCINE + GLIMEPIRIDE (Précaution d'emploi) : Risque d'hypoglycémie par augmentation de l’absorption et des concentrations plasmatiques de l’antidiabétique. Conduite à tenir : Prévenir le patient, renforcer l'autosurveillance glycémique et adapter éventuellement la posologie du sulfamide hypoglycémiant pendant le traitement par l’érythromycine."))
  (interaction
    (title "ERYTHROMYCINE + IMMUNOSUPPRESSEURS")
    (level "Association DECONSEILLEE")
    (drugs-a "erythromycine")
    (drugs-b "ciclosporine" "everolimus" "sirolimus" "tacrolimus" "temsirolimus")
    (alert "Interaction ERYTHROMYCINE + IMMUNOSUPPRESSEURS (Association DECONSEILLEE) : Augmentation très importante des concentrations sanguines de l'immunosuppresseur par inhibition de son métabolisme hépatique. Conduite à tenir : En cas d’association, contrôle strict de la fonction rénale, dosage des concentrations sanguines de l'immunosuppresseur et adaptation éventuelle de la posologie."))
  (interaction
    (title "ERYTHROMYCINE + NINTÉDANIB")
    (level "Précaution d'emploi")
    (drugs-a "erythromycine")
    (drugs-b "nintedanib")
    (alert "Interaction ERYTHROMYCINE + NINTÉDANIB (Précaution d'emploi) : Augmentation des concentrations plasmatiques du nintédanib par augmentation de son absorption par l'érythromycine. Conduite à tenir : Surveillance clinique pendant l’association."))
  (interaction
    (title "ERYTHROMYCINE + PRAVASTATINE")
    (level "Précaution d'emploi")
    (drugs-a "erythromycine")
    (drugs-b "pravastatine")
    (alert "Interaction ERYTHROMYCINE + PRAVASTATINE (Précaution d'emploi) : Avec l'érythromycine utilisée par voie orale : augmentation de la concentration plasmatique de la pravastatine par l' érythromycine. Conduite à tenir : Surveillance clinique et biologique pendant le traitement par l'antibiotique."))
  (interaction
    (title "ERYTHROMYCINE + TALAZOPARIB")
    (level "Précaution d'emploi")
    (drugs-a "erythromycine")
    (drugs-b "talazoparib")
    (alert "Interaction ERYTHROMYCINE + TALAZOPARIB (Précaution d'emploi) : Augmentation des concentrations de talazoparib avec risque de majoration de la toxicité. Conduite à tenir : Réduire la dose de talazoparib."))
  (interaction
    (title "ERYTHROMYCINE + THÉOPHYLLINE (ET, PAR EXTRAPOLATION, AMINOPHYLLINE)")
    (level "Association DECONSEILLEE")
    (drugs-a "erythromycine")
    (drugs-b "aminophylline" "theophylline")
    (alert "Interaction ERYTHROMYCINE + THÉOPHYLLINE (ET, PAR EXTRAPOLATION, AMINOPHYLLINE) (Association DECONSEILLEE) : Surdosage en théophylline par diminution de son élimination hépatique, plus particulièrement à risque chez l'enfant."))
  (interaction
    (title "ERYTHROMYCINE + VERAPAMIL")
    (level "Précaution d'emploi")
    (drugs-a "erythromycine")
    (drugs-b "verapamil")
    (alert "Interaction ERYTHROMYCINE + VERAPAMIL (Précaution d'emploi) : Bradycardie et/ou troubles de la conduction auriculo-ventriculaire, par diminution du métabolisme hépatique du vérapamil par l'érythromycine. Conduite à tenir : Surveillance clinique et ECG ; s'il y a lieu, adaptation de la posologie du vérapamil pendant le traitement par l'érythromycine et après son arrêt."))
  (interaction
    (title "ESCITALOPRAM + ESOMEPRAZOLE")
    (level "Précaution d'emploi")
    (drugs-a "escitalopram")
    (drugs-b "esomeprazole")
    (alert "Interaction ESCITALOPRAM + ESOMEPRAZOLE (Précaution d'emploi) : Risque majoré de troubles du rythme ventriculaire, notamment de torsades de pointes. Conduite à tenir : Surveillance clinique et électrocardiographique pendant l'association."))
  (interaction
    (title "ESCITALOPRAM + OMEPRAZOLE")
    (level "Précaution d'emploi")
    (drugs-a "escitalopram")
    (drugs-b "omeprazole")
    (alert "Interaction ESCITALOPRAM + OMEPRAZOLE (Précaution d'emploi) : Risque majoré de troubles du rythme ventriculaire, notamment de torsades de pointes. Conduite à tenir : Surveillance clinique et électrocardiographique pendant l'association."))
  (interaction
    (title "ESMOLOL + PROPAFENONE")
    (level "Précaution d'emploi")
    (drugs-a "esmolol")
    (drugs-b "propafenone")
    (alert "Interaction ESMOLOL + PROPAFENONE (Précaution d'emploi) : Troubles de la contractilité, de l'automatisme et de la conduction (suppression des mécanismes sympathiques compensateurs). Conduite à tenir : Surveillance clinique et ECG."))
  (interaction
    (title "ESMOLOL + VERAPAMIL")
    (level "ASDEC - PE")
    (drugs-a "esmolol")
    (drugs-b "verapamil")
    (alert "Interaction ESMOLOL + VERAPAMIL (ASDEC - PE) : Troubles de l'automatisme (bradycardie excessive, arrêt sinusal), troubles de la conduction sino-auriculaire et auriculo-ventriculaire et défaillance cardiaque. Conduite à tenir : Association déconseillée : - en cas d'altération de la fonction ventriculaire gauche. Précaution d'emploi : - si la fonction ventriculaire gauche est normale. Surveillance clinique et ECG."))
  (interaction
    (title "ESTRAMUSTINE + INHIBITEURS DE L'ENZYME DE CONVERSION")
    (level "Association DECONSEILLEE")
    (drugs-a "estramustine")
    (drugs-b "benazepril" "captopril" "cilazapril" "enalapril" "fosinopril" "lisinopril" "moexipril" "perindopril" "quinapril" "ramipril" "trandolapril" "zofenopril")
    (alert "Interaction ESTRAMUSTINE + INHIBITEURS DE L'ENZYME DE CONVERSION (Association DECONSEILLEE) : Risque de majoration des effets indésirables à type d'oedème angio-neurotique (angio-oedème)."))
  (interaction
    (title "ESTROGÈNES NON CONTRACEPTIFS + HORMONES THYROÏDIENNES")
    (level "Précaution d'emploi")
    (drugs-a "diethylstilbestrol" "estetrol" "estradiol" "estriol" "estrogenes conjugues" "estrone" "promestriene")
    (drugs-b "levothyroxine" "liothyronine sodique" "thyroxines" "tiratricol")
    (alert "Interaction ESTROGÈNES NON CONTRACEPTIFS + HORMONES THYROÏDIENNES (Précaution d'emploi) : Risque d'hypothyroïdie clinique en cas d'estrogénothérapie substitutive. Conduite à tenir : Surveillance clinique et biologique ; adaptation éventuelle des doses de l'hormone thyroïdienne chez les femmes ménopausées prenant des estrogènes."))
  (interaction
    (title "ESTROGÈNES NON CONTRACEPTIFS + INDUCTEURS ENZYMATIQUES PUISSANTS")
    (level "Précaution d'emploi")
    (drugs-a "diethylstilbestrol" "estetrol" "estradiol" "estriol" "estrogenes conjugues" "estrone" "promestriene")
    (drugs-b "apalutamide" "carbamazepine" "enzalutamide" "fosphenytoine" "phenobarbital" "phenytoine" "primidone")
    (alert "Interaction ESTROGÈNES NON CONTRACEPTIFS + INDUCTEURS ENZYMATIQUES PUISSANTS (Précaution d'emploi) : Diminution de l'efficacité de l'estrogène. Conduite à tenir : Surveillance clinique et adaptation éventuelle de la posologie du traitement hormonal pendant l'administration de l'inducteur et après son arrêt."))
  (interaction
    (title "ESTROGÈNES NON CONTRACEPTIFS + OXCARBAZEPINE")
    (level "Précaution d'emploi")
    (drugs-a "diethylstilbestrol" "estetrol" "estradiol" "estriol" "estrogenes conjugues" "estrone" "promestriene")
    (drugs-b "oxcarbazepine")
    (alert "Interaction ESTROGÈNES NON CONTRACEPTIFS + OXCARBAZEPINE (Précaution d'emploi) : Risque de diminution de l'efficacité du traitement hormonal, par augmentation de son métabolisme hépatique par l'oxcarbazépine. Conduite à tenir : Surveillance clinique et adaptation éventuelle de la posologie du traitement hormonal pendant le traitement par l'oxcarbazépine et après son arrêt."))
  (interaction
    (title "ESTROPROGESTATIFS CONTRACEPTIFS + FELBAMATE")
    (level "Précaution d'emploi")
    (drugs-a "estradiol" "ethinylestradiol")
    (drugs-b "felbamate")
    (alert "Interaction ESTROPROGESTATIFS CONTRACEPTIFS + FELBAMATE (Précaution d'emploi) : Risque de diminution de l’efficacité contraceptive, pendant le traitement et un cycle après l’arrêt du traitement par le felbamate, en raison de son potentiel inducteur enzymatique. Conduite à tenir : Utiliser une méthode additionnelle de type mécanique (préservatif) pendant la durée de l’association, et un cycle suivant l’arrêt du felbamate."))
  (interaction
    (title "ESTROPROGESTATIFS CONTRACEPTIFS + GRISEOFULVINE")
    (level "Précaution d'emploi")
    (drugs-a "estradiol" "ethinylestradiol")
    (drugs-b "griseofulvine")
    (alert "Interaction ESTROPROGESTATIFS CONTRACEPTIFS + GRISEOFULVINE (Précaution d'emploi) : Diminution de l’efficacité contraceptive par augmentation du métabolisme hépatique du contraceptif hormonal par la griséofulvine. Conduite à tenir : Utiliser une méthode additionnelle de type mécanique (préservatif) pendant la durée de l’association, et un cycle suivant l’arrêt de de la griséofulvine."))
  (interaction
    (title "ESTROPROGESTATIFS CONTRACEPTIFS + INDUCTEURS ENZYMATIQUES")
    (level "Association DECONSEILLEE")
    (drugs-a "estradiol" "ethinylestradiol")
    (drugs-b "apalutamide" "carbamazepine" "cenobamate" "dabrafenib" "efavirenz" "enzalutamide" "eslicarbazepine" "fosphenytoine" "letermovir" "lorlatinib" "lumacaftor" "nevirapine" "oxcarbazepine" "phenobarbital" "phenytoine" "pitolisant" "primidone" "rifabutine" "rifampicine" "sotorasib")
    (alert "Interaction ESTROPROGESTATIFS CONTRACEPTIFS + INDUCTEURS ENZYMATIQUES (Association DECONSEILLEE) : Diminution de l'efficacité contraceptive, par augmentation du métabolisme hépatique du contraceptif hormonal par l'inducteur. Conduite à tenir : Utiliser une méthode additionnelle de type mécanique (préservatif) pendant la durée de l’association, et un cycle suivant l’arrêt de l’inducteur."))
  (interaction
    (title "ESTROPROGESTATIFS CONTRACEPTIFS + INHIBITEURS DE PROTÉASES BOOSTÉS PAR RITONAVIR")
    (level "Association DECONSEILLEE")
    (drugs-a "estradiol" "ethinylestradiol")
    (drugs-b "atazanavir" "darunavir" "fosamprenavir" "lopinavir" "nirmatrelvir" "ritonavir" "saquinavir" "tipranavir")
    (alert "Interaction ESTROPROGESTATIFS CONTRACEPTIFS + INHIBITEURS DE PROTÉASES BOOSTÉS PAR RITONAVIR (Association DECONSEILLEE) : Risque de diminution de l'efficacité contraceptive par diminution des concentrations en contraceptif hormonal, dûe à l'augmentation de son métabolisme hépatique par le ritonavir. Conduite à tenir : Utiliser une méthode additionnelle de type mécanique (préservatif) pendant la durée de l’association, et un cycle suivant l’arrêt du ritonavir."))
  (interaction
    (title "ESTROPROGESTATIFS CONTRACEPTIFS + LAMOTRIGINE")
    (level "ASDEC - PE")
    (drugs-a "estradiol" "ethinylestradiol")
    (drugs-b "lamotrigine")
    (alert "Interaction ESTROPROGESTATIFS CONTRACEPTIFS + LAMOTRIGINE (ASDEC - PE) : Diminution des concentrations et de l’efficacité de la lamotrigine par augmentation de son métabolisme hépatique. Conduite à tenir : Association déconseillée: - Eviter de mettre en route une contraception orale pendant la période d'ajustement posologique de la lamotrigine. Précaution d'emploi: - Surveillance clinique et adaptation de la posologie de la lamotrigine lors de la mise en route d'une contraception orale et après son arrêt."))
  (interaction
    (title "ESTROPROGESTATIFS CONTRACEPTIFS + MILLEPERTUIS")
    (level "CONTRE-INDICATION")
    (drugs-a "estradiol" "ethinylestradiol")
    (drugs-b "millepertuis")
    (alert "Interaction ESTROPROGESTATIFS CONTRACEPTIFS + MILLEPERTUIS (CONTRE-INDICATION) : Diminution des concentrations plasmatiques du contraceptif hormonal, en raison de l'effet inducteur enzymatique du millepertuis, avec risque de baisse d'efficacité voire d'annulation de l'effet dont les conséquences peuvent être éventuellement graves (survenue d'une grossesse)."))
  (interaction
    (title "ESTROPROGESTATIFS CONTRACEPTIFS + MODAFINIL")
    (level "Association DECONSEILLEE")
    (drugs-a "estradiol" "ethinylestradiol")
    (drugs-b "modafinil")
    (alert "Interaction ESTROPROGESTATIFS CONTRACEPTIFS + MODAFINIL (Association DECONSEILLEE) : Risque de diminution de l’efficacité contraceptive, pendant le traitement et un cycle après l’arrêt du traitement par le modafinil, en raison de son potentiel inducteur enzymatique. Conduite à tenir : Utiliser une méthode additionnelle de type mécanique (préservatif) pendant la durée de l’association, et un cycle suivant l’arrêt du modafinil."))
  (interaction
    (title "ESTROPROGESTATIFS CONTRACEPTIFS + RUFINAMIDE")
    (level "Précaution d'emploi")
    (drugs-a "estradiol" "ethinylestradiol")
    (drugs-b "rufinamide")
    (alert "Interaction ESTROPROGESTATIFS CONTRACEPTIFS + RUFINAMIDE (Précaution d'emploi) : Diminution de l’efficacité contraceptive par augmentation du métabolisme hépatique du contraceptif hormonal par le rufinamide. Conduite à tenir : Utiliser une méthode additionnelle de type mécanique (préservatif) pendant la durée de l’association, et un cycle suivant l’arrêt du rufinamide."))
  (interaction
    (title "ESTROPROGESTATIFS CONTRACEPTIFS + TOPIRAMATE")
    (level "Association DECONSEILLEE")
    (drugs-a "estradiol" "ethinylestradiol")
    (drugs-b "topiramate")
    (alert "Interaction ESTROPROGESTATIFS CONTRACEPTIFS + TOPIRAMATE (Association DECONSEILLEE) : Pour des doses de topiramate >= 200 mg/jour : Risque de diminution de l’efficacité contraceptive par diminution des concentrations en estrogène. Conduite à tenir : Si l’association s’avère nécessaire, utiliser une méthode additionnel de type mécanique pendant la durée de l’association et un cycle suivant l’arrêt du topiramate."))
  (interaction
    (title "ESTROPROGESTATIFS CONTRACEPTIFS + VÉMURAFÉNIB")
    (level "Association DECONSEILLEE")
    (drugs-a "estradiol" "ethinylestradiol")
    (drugs-b "vemurafenib")
    (alert "Interaction ESTROPROGESTATIFS CONTRACEPTIFS + VÉMURAFÉNIB (Association DECONSEILLEE) : Risque de diminution des concentrations des estroprogestatifs, avec pour conséquence un risque d’inefficacité."))
  (interaction
    (title "ESZOPICLONE + INHIBITEURS PUISSANTS DU CYP3A4")
    (level "CI - PE")
    (drugs-a "eszopiclone")
    (drugs-b "clarithromycine" "cobicistat" "erythromycine" "itraconazole" "ketoconazole" "posaconazole" "ritonavir" "telithromycine" "tucatinib" "voriconazole")
    (alert "Interaction ESZOPICLONE + INHIBITEURS PUISSANTS DU CYP3A4 (CI - PE) : Augmentation de l'effet sédatif de l’eszopiclone. Conduite à tenir : Contre-indication - chez les patients âgés Précaution d'emploi En cas d’association chez les sujets non âgés, une réduction de la dose d’eszopiclone peut être nécessaire."))
  (interaction
    (title "ESZOPICLONE + RIFAMPICINE")
    (level "Précaution d'emploi")
    (drugs-a "eszopiclone")
    (drugs-b "rifampicine")
    (alert "Interaction ESZOPICLONE + RIFAMPICINE (Précaution d'emploi) : Risque de diminution des concentrations plasmatiques et de l'efficacité de l’eszopiclone par augmentation de son métabolisme hépatique par la rifampicine. Conduite à tenir : Surveillance clinique. Utiliser éventuellement un autre hypnotique."))
  (interaction
    (title "ETHINYLESTRADIOL + GLÉCAPRÉVIR + PIBRENTASVIR")
    (level "CONTRE-INDICATION")
    (drugs-a "ethinylestradiol")
    (drugs-b "glecaprevir" "pibrentasvir")
    (alert "Interaction ETHINYLESTRADIOL + GLÉCAPRÉVIR + PIBRENTASVIR (CONTRE-INDICATION) : Augmentation de l’hépatotoxicité avec la bithérapie."))
  (interaction
    (title "ETHINYLESTRADIOL + OMBITASVIR + PARITAPRÉVIR")
    (level "CONTRE-INDICATION")
    (drugs-a "ethinylestradiol")
    (drugs-b "ombitasvir" "paritaprevir")
    (alert "Interaction ETHINYLESTRADIOL + OMBITASVIR + PARITAPRÉVIR (CONTRE-INDICATION) : Augmentation de l’hépatotoxicité."))
  (interaction
    (title "ETOPOSIDE + INDUCTEURS ENZYMATIQUES")
    (level "Association DECONSEILLEE")
    (drugs-a "etoposide")
    (drugs-b "apalutamide" "carbamazepine" "cenobamate" "dabrafenib" "efavirenz" "enzalutamide" "eslicarbazepine" "fosphenytoine" "letermovir" "lorlatinib" "lumacaftor" "nevirapine" "oxcarbazepine" "phenobarbital" "phenytoine" "pitolisant" "primidone" "rifabutine" "rifampicine" "sotorasib")
    (alert "Interaction ETOPOSIDE + INDUCTEURS ENZYMATIQUES (Association DECONSEILLEE) : Diminution des concentrations plasmatiques d’étoposide par l’inducteur. Conduite à tenir : Si l'association s'avère nécessaire, surveillance clinique et adaptation éventuelle de la posologie d’étoposide pendant l’association, et 1 à 2 semaines après l’arrêt de l’inducteur."))
  (interaction
    (title "ETOPOSIDE + MILLEPERTUIS")
    (level "CONTRE-INDICATION")
    (drugs-a "etoposide")
    (drugs-b "millepertuis")
    (alert "Interaction ETOPOSIDE + MILLEPERTUIS (CONTRE-INDICATION) : Risque de diminution des concentrations plasmatiques d’étoposide par le millepertuis."))
  (interaction
    (title "ETRAVIRINE + GRAZOPREVIR + ELBASVIR")
    (level "CONTRE-INDICATION")
    (drugs-a "etravirine")
    (drugs-b "elbasvir" "grazoprevir")
    (alert "Interaction ETRAVIRINE + GRAZOPREVIR + ELBASVIR (CONTRE-INDICATION) : Risque de diminution des concentrations plasmatiques de grazoprevir/elbasvir par l’étravirine."))
  (interaction
    (title "EVEROLIMUS + OMBITASVIR + PARITAPRÉVIR")
    (level "Association DECONSEILLEE")
    (drugs-a "everolimus")
    (drugs-b "ombitasvir" "paritaprevir")
    (alert "Interaction EVEROLIMUS + OMBITASVIR + PARITAPRÉVIR (Association DECONSEILLEE) : En association avec le ritonavir : augmentation significative des concentrations de l’immunosuppresseur avec risque de majoration de sa toxicité par la bithérapie. Conduite à tenir : Si l’association s’avère nécessaire, contrôle strict de la fonction rénale, dosage des concentrations sanguines de l'immunosuppresseur et adaptation éventuelle de la posologie."))
  (interaction
    (title "EVEROLIMUS + VERAPAMIL")
    (level "Précaution d'emploi")
    (drugs-a "everolimus")
    (drugs-b "verapamil")
    (alert "Interaction EVEROLIMUS + VERAPAMIL (Précaution d'emploi) : Augmentation des concentrations sanguines de l'évérolimus par diminution de son métabolisme hépatique par le vérapamil. Conduite à tenir : Dosage des concentrations sanguines de l’immunosuppresseur, contrôle de la fonction rénale et adaptation de la posologie pendant l’association et après son arrêt."))
  (interaction
    (title "EZETIMIBE + FENOFIBRATE")
    (level "Association DECONSEILLEE")
    (drugs-a "ezetimibe")
    (drugs-b "fenofibrate")
    (alert "Interaction EZETIMIBE + FENOFIBRATE (Association DECONSEILLEE) : Risque de lithiase biliaire par augmentation de l’excrétion biliaire du cholestérol."))
  (interaction
    (title "FELBAMATE + PHÉNOBARBITAL (ET, PAR EXTRAPOLATION, PRIMIDONE)")
    (level "Précaution d'emploi")
    (drugs-a "felbamate")
    (drugs-b "phenobarbital" "primidone")
    (alert "Interaction FELBAMATE + PHÉNOBARBITAL (ET, PAR EXTRAPOLATION, PRIMIDONE) (Précaution d'emploi) : Diminution des concentrations plasmatiques et de l'efficacité du felbamate et augmentation des concentrations plasmatiques du phénobarbital, avec risque de surdosage. Conduite à tenir : Surveillance clinique et contrôle des concentrations plasmatiques de phénobarbital avec adaptation de la posologie si besoin."))
  (interaction
    (title "FELBAMATE + PHÉNYTOÏNE (ET, PAR EXTRAPOLATION, FOSPHÉNYTOÏNE)")
    (level "Précaution d'emploi")
    (drugs-a "felbamate")
    (drugs-b "fosphenytoine" "phenytoine")
    (alert "Interaction FELBAMATE + PHÉNYTOÏNE (ET, PAR EXTRAPOLATION, FOSPHÉNYTOÏNE) (Précaution d'emploi) : Augmentation des concentrations plasmatiques de phénytoïne avec risque de surdosage, par inhibition de son métabolisme par le felbamate. Conduite à tenir : Surveillance clinique, contrôle des concentrations plasmatiques de phénytoïne et si besoin, adaptation de sa posologie pendant le traitement par le felbamate."))
  (interaction
    (title "FELBAMATE + VALPROÏQUE (ACIDE) ET, PAR EXTRAPOLATION, VALPROMIDE")
    (level "Précaution d'emploi")
    (drugs-a "felbamate")
    (drugs-b "valproique" "valpromide")
    (alert "Interaction FELBAMATE + VALPROÏQUE (ACIDE) ET, PAR EXTRAPOLATION, VALPROMIDE (Précaution d'emploi) : Augmentation des concentrations plasmatiques de l'acide valproïque, avec risque de surdosage. Conduite à tenir : Surveillance clinique, contrôle biologique et adaptation éventuelle de la posologie du valproate ou du valpromide pendant le traitement par le felbamate et après son arrêt."))
  (interaction
    (title "FENTANYL + INDUCTEURS ENZYMATIQUES PUISSANTS")
    (level "Association DECONSEILLEE")
    (drugs-a "fentanyl")
    (drugs-b "apalutamide" "carbamazepine" "enzalutamide" "fosphenytoine" "phenobarbital" "phenytoine" "primidone")
    (alert "Interaction FENTANYL + INDUCTEURS ENZYMATIQUES PUISSANTS (Association DECONSEILLEE) : Diminution des concentrations plasmatiques de fentanyl par augmentation de son métabolisme hépatique par l'inducteur. Conduite à tenir : Préférer un autre morphinique."))
  (interaction
    (title "FENTANYL + INHIBITEURS PUISSANTS DU CYP3A4")
    (level "Précaution d'emploi")
    (drugs-a "fentanyl")
    (drugs-b "clarithromycine" "cobicistat" "erythromycine" "itraconazole" "ketoconazole" "posaconazole" "ritonavir" "telithromycine" "tucatinib" "voriconazole")
    (alert "Interaction FENTANYL + INHIBITEURS PUISSANTS DU CYP3A4 (Précaution d'emploi) : Risque d'augmentation de l’effet dépresseur respiratoire de l’analgésique opiacé par légère diminution de son métabolisme hépatique. Conduite à tenir : Surveillance clinique et adaptation éventuelle de la posologie de l’analgésique opiacé en cas de traitement par un inhibiteur puissant du CYP3A4."))
  (interaction
    (title "FENTANYL + RIFAMPICINE")
    (level "Association DECONSEILLEE")
    (drugs-a "fentanyl")
    (drugs-b "rifampicine")
    (alert "Interaction FENTANYL + RIFAMPICINE (Association DECONSEILLEE) : Diminution des concentrations plasmatiques de fentanyl par augmentation de son métabolisme hépatique par la rifampicine. Conduite à tenir : Préférer un autre morphinique."))
  (interaction
    (title "FER + SELS DE FER PAR VOIE INJECTABLE")
    (level "Association DECONSEILLEE")
    (drugs-a "fer")
    (drugs-b "carboxymaltose ferrique" "ferinject" "venofer" "fer saccharose")
    (alert "Interaction FER + SELS DE FER PAR VOIE INJECTABLE (Association DECONSEILLEE) : Lipothymie, voire choc attribué à la libération rapide du fer de sa forme complexe et à la saturation de la sidérophiline."))
  (interaction
    (title "FER + FLUOROQUINOLONES")
    (level "Précaution d'emploi")
    (drugs-a "fer")
    (drugs-b "ciprofloxacine" "delafloxacine" "enoxacine" "levofloxacine" "lomefloxacine" "moxifloxacine" "norfloxacine" "ofloxacine" "pefloxacine")
    (alert "Interaction FER + FLUOROQUINOLONES (Précaution d'emploi) : Diminution de l'absorption digestive des fluoroquinolones. Conduite à tenir : Prendre les sels de fer à distance des fluoroquinolones (plus de 2 heures, si possible)."))
  (interaction
    (title "FER + HORMONES THYROÏDIENNES")
    (level "Précaution d'emploi")
    (drugs-a "fer")
    (drugs-b "levothyroxine" "liothyronine sodique" "thyroxines" "tiratricol")
    (alert "Interaction FER + HORMONES THYROÏDIENNES (Précaution d'emploi) : Diminution de l'absorption digestive des hormones thyroïdiennes. Conduite à tenir : Prendre les hormones thyroïdiennes à distance du fer (plus de 2 heures, si possible)."))
  (interaction
    (title "FER + INHIBITEURS D'INTÉGRASE")
    (level "Précaution d'emploi")
    (drugs-a "fer")
    (drugs-b "bictegravir" "cabotegravir" "dolutegravir" "raltegravir")
    (alert "Interaction FER + INHIBITEURS D'INTÉGRASE (Précaution d'emploi) : Diminution de l'absorption digestive des inhibiteurs d’intégrase. Conduite à tenir : Prendre les sels de fer à distance de l’antirétroviral (plus de 2 heures, si possible)."))
  (interaction
    (title "FER + LEVODOPA")
    (level "Précaution d'emploi")
    (drugs-a "fer")
    (drugs-b "levodopa")
    (alert "Interaction FER + LEVODOPA (Précaution d'emploi) : Diminution de l'absorption digestive de la lévodopa. Conduite à tenir : Prendre les sels de fer à distance de la lévodopa (plus de 2 heures si possible)."))
  (interaction
    (title "FER + METHYLDOPA")
    (level "Précaution d'emploi")
    (drugs-a "fer")
    (drugs-b "methyldopa")
    (alert "Interaction FER + METHYLDOPA (Précaution d'emploi) : Diminution de l'absorption digestive de la méthyldopa (formation de complexes). Conduite à tenir : Prendre les sels de fer à distance de la méthyldopa (plus de deux heures, si possible)."))
  (interaction
    (title "FER + PENICILLAMINE")
    (level "Précaution d'emploi")
    (drugs-a "fer")
    (drugs-b "penicillamine")
    (alert "Interaction FER + PENICILLAMINE (Précaution d'emploi) : Diminution de l'absorption digestive de la pénicillamine. Conduite à tenir : Prendre les sels de fer à distance de la pénicillamine (plus de 2 heures, si possible)."))
  (interaction
    (title "FER + ROXADUSTAT")
    (level "Précaution d'emploi")
    (drugs-a "fer")
    (drugs-b "roxadustat")
    (alert "Interaction FER + ROXADUSTAT (Précaution d'emploi) : La prise de cation divalent peut diminuer l’absorption intestinale et, potentiellement, l’efficacité du roxadustat pris simultanément. Conduite à tenir : Prendre le roxadustat à distance des sels de fer (plus de 1 heure, si possible)."))
  (interaction
    (title "FER + STRONTIUM")
    (level "Précaution d'emploi")
    (drugs-a "fer")
    (drugs-b "strontium")
    (alert "Interaction FER + STRONTIUM (Précaution d'emploi) : Diminution de l'absorption digestive du strontium. Conduite à tenir : Prendre le strontium à distance des sels de fer (plus de deux heures, si possible)."))
  (interaction
    (title "FER + TRIENTINE")
    (level "Précaution d'emploi")
    (drugs-a "fer")
    (drugs-b "trientine")
    (alert "Interaction FER + TRIENTINE (Précaution d'emploi) : Diminution des concentrations de fer sérique. Conduite à tenir : Prendre la trientine à distance des sels de fer."))
  (interaction
    (title "FER + ZINC")
    (level "Précaution d'emploi")
    (drugs-a "fer")
    (drugs-b "zinc")
    (alert "Interaction FER + ZINC (Précaution d'emploi) : Diminution de l’absorption digestive du zinc par le fer. Conduite à tenir : Prendre les sels de fer à distance du zinc (plus de 2 heures si possible)."))
  (interaction
    (title "FEXOFENADINE + MILLEPERTUIS")
    (level "CONTRE-INDICATION")
    (drugs-a "fexofenadine")
    (drugs-b "millepertuis")
    (alert "Interaction FEXOFENADINE + MILLEPERTUIS (CONTRE-INDICATION) : Diminution des concentrations plasmatiques de la féxofénadine par le millepertuis."))
  (interaction
    (title "FIBRATES + FIBRATES (AUTRES)")
    (level "CONTRE-INDICATION")
    (drugs-a "bezafibrate" "ciprofibrate" "fenofibrate" "gemfibrozil")
    (drugs-b "bezafibrate" "ciprofibrate" "fenofibrate" "gemfibrozil")
    (alert "Interaction FIBRATES + FIBRATES (AUTRES) (CONTRE-INDICATION) : Risque majoré d'effets indésirables à type de rhabdomyolyse et d'antagonisme pharmacodynamique entre les deux molécules."))
  (interaction
    (title "FIBRATES + INHIBITEURS DE L'HMG-COA RÉDUCTASE (STATINES)")
    (level "CI - ASDEC")
    (drugs-a "bezafibrate" "ciprofibrate" "fenofibrate" "gemfibrozil")
    (drugs-b "atorvastatine" "fluvastatine" "pitavastatine" "pravastatine" "rosuvastatine" "simvastatine")
    (alert "Interaction FIBRATES + INHIBITEURS DE L'HMG-COA RÉDUCTASE (STATINES) (CI - ASDEC) : Risque d'addition d'effets indésirables (dose-dépendants) à type de rhabdomyolyse. En outre, avec le gemfibrozil, diminution du métabolisme de la simvastatine et de la rosuvastatine, ce qui majore le risque musculaire, ainsi que la néphrotoxicité de la rosuvastatine. Conduite à tenir : L'association d'un fibrate et d'une statine est au minmum déconseillée. Avec la simvastatine, ne pas dépasser 10 mg ( cette restriction de doses ne concerne pas le fénofibrate). La contre-indication s'applique : - entre le gemfibrozil et la simvastatine - pour des doses de rosuvastatine de 40 mg."))
  (interaction
    (title "FIDAXOMICINE + KETOCONAZOLE")
    (level "Association DECONSEILLEE")
    (drugs-a "fidaxomicine")
    (drugs-b "ketoconazole")
    (alert "Interaction FIDAXOMICINE + KETOCONAZOLE (Association DECONSEILLEE) : Augmentation des concentrations plasmatiques de la fidaxomicine."))
  (interaction
    (title "FIDAXOMICINE + VERAPAMIL")
    (level "Association DECONSEILLEE")
    (drugs-a "fidaxomicine")
    (drugs-b "verapamil")
    (alert "Interaction FIDAXOMICINE + VERAPAMIL (Association DECONSEILLEE) : Augmentation des concentrations plasmatiques de la fidaxomicine."))
  (interaction
    (title "FLUCLOXACILLINE + PARACETAMOL")
    (level "Association DECONSEILLEE")
    (drugs-a "flucloxacilline")
    (drugs-b "paracetamol")
    (alert "Interaction FLUCLOXACILLINE + PARACETAMOL (Association DECONSEILLEE) : Risque accru d'acidose métabolique à trou anionique élevé, notamment en cas d'insuffisance rénale sévère, de sepsis, de facteurs prédisposant à la déplétion en glutathion (malnutrition, alcoolisme chronique…), ainsi qu’en cas d’utilisation de paracétamol aux doses quotidiennes maximales. Conduite à tenir : Si l’association ne peut être évitée, surveillance étroite avec mesure de la 5-oxoproline urinaire."))
  (interaction
    (title "FLUCLOXACILLINE + VORICONAZOLE")
    (level "Association DECONSEILLEE")
    (drugs-a "flucloxacilline")
    (drugs-b "voriconazole")
    (alert "Interaction FLUCLOXACILLINE + VORICONAZOLE (Association DECONSEILLEE) : Diminution des concentrations de voriconazole, avec risque d'inefficacité de l'antifongique azolé."))
  (interaction
    (title "FLUCONAZOLE + HALOFANTRINE")
    (level "Association DECONSEILLEE")
    (drugs-a "fluconazole")
    (drugs-b "halofantrine")
    (alert "Interaction FLUCONAZOLE + HALOFANTRINE (Association DECONSEILLEE) : Risque majoré de troubles du rythme ventriculaires, notamment de torsades de pointes. Conduite à tenir : Si cela est possible, interrompre le fluconazole. Si l'association ne peut être évitée, contrôle préalable du QT et surveillance ECG monitorée."))
  (interaction
    (title "FLUCONAZOLE + IBRUTINIB")
    (level "Association DECONSEILLEE")
    (drugs-a "fluconazole")
    (drugs-b "ibrutinib")
    (alert "Interaction FLUCONAZOLE + IBRUTINIB (Association DECONSEILLEE) : Risque d’augmentation des concentrations plasmatiques d’ibrutinib par diminution de son métabolisme hépatique par le fluconazole. Conduite à tenir : Si l’association ne peut être évitée, surveillance clinique étroite et réduction de la dose d’ibrutinib à 280 mg par jour pendant la durée de l’association."))
  (interaction
    (title "FLUCONAZOLE + IMMUNOSUPPRESSEURS")
    (level "Précaution d'emploi")
    (drugs-a "fluconazole")
    (drugs-b "ciclosporine" "everolimus" "sirolimus" "tacrolimus" "temsirolimus")
    (alert "Interaction FLUCONAZOLE + IMMUNOSUPPRESSEURS (Précaution d'emploi) : Risque d'augmentation des concentrations sanguines de l'immunosuppresseur par inhibition de son métabolisme et de la créatininémie. Conduite à tenir : Dosage des concentrations sanguines de l'immunosuppresseur, contrôle de la fonction rénale et adaptation de sa posologie pendant l'association et après son arrêt."))
  (interaction
    (title "FLUCONAZOLE + IVACAFTOR (SEUL OU ASSOCIÉ)")
    (level "Précaution d'emploi")
    (drugs-a "fluconazole")
    (drugs-b "elexacaftor" "ivacaftor" "lumacaftor" "tezacaftor")
    (alert "Interaction FLUCONAZOLE + IVACAFTOR (SEUL OU ASSOCIÉ) (Précaution d'emploi) : Augmentation des concentrations d’ivacaftor, avec risque de majoration des effets indésirables. Conduite à tenir : Se référer à l'AMM pour les adaptations posologiques."))
  (interaction
    (title "FLUCONAZOLE + MIDAZOLAM")
    (level "Précaution d'emploi")
    (drugs-a "fluconazole")
    (drugs-b "midazolam")
    (alert "Interaction FLUCONAZOLE + MIDAZOLAM (Précaution d'emploi) : Augmentation des concentrations plasmatiques de midazolam par diminution de son métabolisme hépatique, avec majoration de la sédation. Conduite à tenir : Surveillance clinique et réduction de la posologie de midazolam en cas de traitement par le fluconazole."))
  (interaction
    (title "FLUCONAZOLE + NEVIRAPINE")
    (level "Précaution d'emploi")
    (drugs-a "fluconazole")
    (drugs-b "nevirapine")
    (alert "Interaction FLUCONAZOLE + NEVIRAPINE (Précaution d'emploi) : Doublement des concentrations de névirapine avec risque d'augmentation de ses effets indésirables. Conduite à tenir : Surveillance clinique et adaptation éventuelle de la posologie de la névirapine."))
  (interaction
    (title "FLUCONAZOLE + OLAPARIB")
    (level "Association DECONSEILLEE")
    (drugs-a "fluconazole")
    (drugs-b "olaparib")
    (alert "Interaction FLUCONAZOLE + OLAPARIB (Association DECONSEILLEE) : Augmentation des concentrations plasmatiques d’olaparib par le fluconazole. Conduite à tenir : Si l’association ne peut être évitée, limiter la dose d’olaparib à 200 mg deux fois par jour."))
  (interaction
    (title "FLUCONAZOLE + OXYCODONE")
    (level "Association DECONSEILLEE")
    (drugs-a "fluconazole")
    (drugs-b "oxycodone")
    (alert "Interaction FLUCONAZOLE + OXYCODONE (Association DECONSEILLEE) : Majoration des effets indésirables, notamment respiratoires, de l’oxycodone par diminution de son métabolisme hépatique par le fluconazole."))
  (interaction
    (title "FLUCONAZOLE + PHÉNYTOÏNE (ET, PAR EXTRAPOLATION, FOSPHÉNYTOÏNE)")
    (level "Précaution d'emploi")
    (drugs-a "fluconazole")
    (drugs-b "fosphenytoine" "phenytoine")
    (alert "Interaction FLUCONAZOLE + PHÉNYTOÏNE (ET, PAR EXTRAPOLATION, FOSPHÉNYTOÏNE) (Précaution d'emploi) : Augmentation des concentrations plasmatiques de phénytoïne pouvant atteindre des valeurs toxiques. Mécanisme invoqué : inhibition du métabolisme hépatique de la phénytoïne. Conduite à tenir : Surveillance clinique et biologique étroite."))
  (interaction
    (title "FLUCONAZOLE + PIMOZIDE")
    (level "CONTRE-INDICATION")
    (drugs-a "fluconazole")
    (drugs-b "pimozide")
    (alert "Interaction FLUCONAZOLE + PIMOZIDE (CONTRE-INDICATION) : Risque majoré de troubles du rythme ventriculaire, notamment de torsades de pointes."))
  (interaction
    (title "FLUCONAZOLE + RIFABUTINE")
    (level "Précaution d'emploi")
    (drugs-a "fluconazole")
    (drugs-b "rifabutine")
    (alert "Interaction FLUCONAZOLE + RIFABUTINE (Précaution d'emploi) : Risque d'accroissement des effets indésirables de la rifabutine (uvéites), par augmentation de ses concentrations et de celles de son métabolite actif. Conduite à tenir : Surveillance clinique et biologique régulière, notamment en début d'association."))
  (interaction
    (title "FLUCONAZOLE + RIFAMPICINE")
    (level "Association DECONSEILLEE")
    (drugs-a "fluconazole")
    (drugs-b "rifampicine")
    (alert "Interaction FLUCONAZOLE + RIFAMPICINE (Association DECONSEILLEE) : Diminution des concentrations plasmatiques et de l'efficacité du fluconazole par augmentation de son métabolisme par la rifampicine."))
  (interaction
    (title "FLUCONAZOLE + RIVAROXABAN")
    (level "Association DECONSEILLEE")
    (drugs-a "fluconazole")
    (drugs-b "rivaroxaban")
    (alert "Interaction FLUCONAZOLE + RIVAROXABAN (Association DECONSEILLEE) : Augmentation des concentrations plasmatiques du rivaroxaban par le fluconazole, avec majoration du risque de saignement."))
  (interaction
    (title "FLUCONAZOLE + SIMVASTATINE")
    (level "Précaution d'emploi")
    (drugs-a "fluconazole")
    (drugs-b "simvastatine")
    (alert "Interaction FLUCONAZOLE + SIMVASTATINE (Précaution d'emploi) : Risque majoré d'effets indésirables concentration-dépendants à type de rhabdomyolyse (diminution du métabolisme hépatique de la simvastatine). Conduite à tenir : Ne pas dépasser la posologie de 20 mg/j de simvastatine. Si l'objectif thérapeutique n'est pas atteint, utiliser une autre statine non concernée par ce type d’interaction."))
  (interaction
    (title "FLUCONAZOLE + SULFAMIDES HYPOGLYCÉMIANTS")
    (level "Précaution d'emploi")
    (drugs-a "fluconazole")
    (drugs-b "glibenclamide" "gliclazide" "glimepiride" "glipizide")
    (alert "Interaction FLUCONAZOLE + SULFAMIDES HYPOGLYCÉMIANTS (Précaution d'emploi) : Augmentation du temps de demi-vie du sulfamide avec survenue possible de manifestations d'hypoglycémie. Conduite à tenir : Prévenir le patient, renforcer l'autosurveillance glycémique et adapter éventuellement la posologie du sulfamide pendant le traitement par le fluconazole."))
  (interaction
    (title "FLUCONAZOLE + THÉOPHYLLINE (ET, PAR EXTRAPOLATION, AMINOPHYLLINE)")
    (level "Précaution d'emploi")
    (drugs-a "fluconazole")
    (drugs-b "aminophylline" "theophylline")
    (alert "Interaction FLUCONAZOLE + THÉOPHYLLINE (ET, PAR EXTRAPOLATION, AMINOPHYLLINE) (Précaution d'emploi) : Augmentation de la théophyllinémie avec risque de surdosage (diminution de la clairance de la théophylline). Conduite à tenir : Surveillance clinique et éventuellement de la théophyllinémie ; s'il y a lieu, adaptation de la posologie de la théophylline pendant le traitement par le fluconazole et après son arrêt."))
  (interaction
    (title "FLUCONAZOLE + TOLVAPTAN")
    (level "Précaution d'emploi")
    (drugs-a "fluconazole")
    (drugs-b "tolvaptan")
    (alert "Interaction FLUCONAZOLE + TOLVAPTAN (Précaution d'emploi) : Augmentation des concentrations de tolvaptan, avec risque de majoration importante des effets indésirables, notamment diurèse importante, déshydratation, insuffisance rénale aiguë. Conduite à tenir : Réduire la posologie de tolvaptan de moitié."))
  (interaction
    (title "FLUCONAZOLE + VINCA-ALCALOÏDES CYTOTOXIQUES")
    (level "Précaution d'emploi")
    (drugs-a "fluconazole")
    (drugs-b "vinblastine" "vincristine" "vindesine" "vinflunine" "vinorelbine")
    (alert "Interaction FLUCONAZOLE + VINCA-ALCALOÏDES CYTOTOXIQUES (Précaution d'emploi) : Risque de majoration de la toxicité de l’antimitotique par diminution de son métabolisme hépatique par le fluconazole. Conduite à tenir : Surveillance clinique et biologique étroite pendant l’association."))
  (interaction
    (title "FLUCYTOSINE + ZIDOVUDINE")
    (level "Précaution d'emploi")
    (drugs-a "flucytosine")
    (drugs-b "zidovudine")
    (alert "Interaction FLUCYTOSINE + ZIDOVUDINE (Précaution d'emploi) : Augmentation de la toxicité hématologique (addition d'effets de toxicité médullaire). Conduite à tenir : Contrôle plus fréquent de l'hémogramme."))
  (interaction
    (title "FLUDARABINE + PENTOSTATINE")
    (level "Association DECONSEILLEE")
    (drugs-a "fludarabine")
    (drugs-b "pentostatine")
    (alert "Interaction FLUDARABINE + PENTOSTATINE (Association DECONSEILLEE) : Majoration du risque de toxicité pulmonaire pouvant être fatale."))
  (interaction
    (title "FLUOROQUINOLONES + STRONTIUM")
    (level "Précaution d'emploi")
    (drugs-a "ciprofloxacine" "delafloxacine" "enoxacine" "levofloxacine" "lomefloxacine" "moxifloxacine" "norfloxacine" "ofloxacine" "pefloxacine")
    (drugs-b "strontium")
    (alert "Interaction FLUOROQUINOLONES + STRONTIUM (Précaution d'emploi) : Diminution de l'absorption digestive du strontium. Conduite à tenir : Prendre le strontium à distance des fluoroquinolones (plus de deux heures, si possible)."))
  (interaction
    (title "FLUOROQUINOLONES + SUCRALFATE")
    (level "Précaution d'emploi")
    (drugs-a "ciprofloxacine" "delafloxacine" "enoxacine" "levofloxacine" "lomefloxacine" "moxifloxacine" "norfloxacine" "ofloxacine" "pefloxacine")
    (drugs-b "sucralfate")
    (alert "Interaction FLUOROQUINOLONES + SUCRALFATE (Précaution d'emploi) : Diminution de l'absorption digestive des fluoroquinolones. Conduite à tenir : Prendre le sucralfate à distance des fluoroquinolones (plus de 2 heures, si possible)."))
  (interaction
    (title "FLUOROQUINOLONES + ZINC")
    (level "Précaution d'emploi")
    (drugs-a "ciprofloxacine" "delafloxacine" "enoxacine" "levofloxacine" "lomefloxacine" "moxifloxacine" "norfloxacine" "ofloxacine" "pefloxacine")
    (drugs-b "zinc")
    (alert "Interaction FLUOROQUINOLONES + ZINC (Précaution d'emploi) : Diminution de l'absorption digestive des fluoroquinolones. Conduite à tenir : Prendre les sels de zinc à distance des fluoroquinolones (plus de 2 heures, si possible)."))
  (interaction
    (title "FLUOXETINE + MEQUITAZINE")
    (level "Association DECONSEILLEE")
    (drugs-a "fluoxetine")
    (drugs-b "mequitazine")
    (alert "Interaction FLUOXETINE + MEQUITAZINE (Association DECONSEILLEE) : Risque de majoration des effets indésirables de la méquitazine, par inhibition de son métabolisme par l’inhibiteur enzymatique."))
  (interaction
    (title "FLUOXETINE + METOPROLOL")
    (level "Précaution d'emploi")
    (drugs-a "fluoxetine")
    (drugs-b "metoprolol")
    (alert "Interaction FLUOXETINE + METOPROLOL (Précaution d'emploi) : Risque de majoration des effets indésirables du métoprolol, avec notamment bradycardie excessive, par inhibition de son métabolisme par la fluoxétine. Conduite à tenir : Surveillance clinique accrue ; si besoin, adaptation de la posologie du métoprolol pendant la durée du traitement par la fluoxétine et après son arrêt."))
  (interaction
    (title "FLUOXETINE + NEBIVOLOL")
    (level "Précaution d'emploi")
    (drugs-a "fluoxetine")
    (drugs-b "nebivolol")
    (alert "Interaction FLUOXETINE + NEBIVOLOL (Précaution d'emploi) : Risque de majoration des effets indésirables du nébivolol avec notamment bradycardie excessive, par inhibition de son métabolisme par l’antidépresseur. Conduite à tenir : Surveillance clinique accrue ; si besoin, adaptation de la posologie du nébivolol pendant la durée du traitement par l’antidépresseur et après son arrêt."))
  (interaction
    (title "FLUOXETINE + PHÉNYTOÏNE (ET, PAR EXTRAPOLATION, FOSPHÉNYTOÏNE)")
    (level "Précaution d'emploi")
    (drugs-a "fluoxetine")
    (drugs-b "fosphenytoine" "phenytoine")
    (alert "Interaction FLUOXETINE + PHÉNYTOÏNE (ET, PAR EXTRAPOLATION, FOSPHÉNYTOÏNE) (Précaution d'emploi) : Augmentation des concentrations plasmatiques de phénytoïne avec signes de surdosage, par inhibition du métabolisme de la phénytoïne. Conduite à tenir : Surveillance clinique et éventuellement contrôle des concentrations plasmatiques de phénytoïne. Si besoin, adaptation posologique pendant le traitement par la fluoxétine et après son arrêt."))
  (interaction
    (title "FLUOXETINE + PIMOZIDE")
    (level "CONTRE-INDICATION")
    (drugs-a "fluoxetine")
    (drugs-b "pimozide")
    (alert "Interaction FLUOXETINE + PIMOZIDE (CONTRE-INDICATION) : Risque majoré de troubles du rythme ventriculaire, notamment de torsades de pointes."))
  (interaction
    (title "FLUOXETINE + RISPERIDONE")
    (level "Précaution d'emploi")
    (drugs-a "fluoxetine")
    (drugs-b "risperidone")
    (alert "Interaction FLUOXETINE + RISPERIDONE (Précaution d'emploi) : Augmentation de la fraction active de la rispéridone par diminution de son métabolisme hépatique par la fluoxétine, avec risque de majoration des effets indésirables. Conduite à tenir : Surveillance clinique et, si besoin, adaptation posologique de la rispéridone."))
  (interaction
    (title "FLUOXETINE + TAMOXIFENE")
    (level "Association DECONSEILLEE")
    (drugs-a "fluoxetine")
    (drugs-b "tamoxifene")
    (alert "Interaction FLUOXETINE + TAMOXIFENE (Association DECONSEILLEE) : Baisse de l’efficacité du tamoxifène, par inhibition de la formation de son métabolite actif par la fluoxétine."))
  (interaction
    (title "FLUOXETINE + TETRABENAZINE")
    (level "CONTRE-INDICATION")
    (drugs-a "fluoxetine")
    (drugs-b "tetrabenazine")
    (alert "Interaction FLUOXETINE + TETRABENAZINE (CONTRE-INDICATION) : Augmentation possiblement très importante de l’exposition des métabolites actifs de la tétrabénazine."))
  (interaction
    (title "FLUOXETINE + TRAMADOL")
    (level "Association DECONSEILLEE")
    (drugs-a "fluoxetine")
    (drugs-b "tramadol")
    (alert "Interaction FLUOXETINE + TRAMADOL (Association DECONSEILLEE) : Diminution de l’efficacité de l’opiacé par inhibition de son métabolisme par l’inhibiteur."))
  (interaction
    (title "FLUVOXAMINE + LIDOCAINE")
    (level "Précaution d'emploi")
    (drugs-a "fluvoxamine")
    (drugs-b "lidocaine")
    (alert "Interaction FLUVOXAMINE + LIDOCAINE (Précaution d'emploi) : Augmentation des concentrations plasmatiques de la lidocaïne avec possibilités d’effets indésirables neurologiques et cardiaques (diminution de la clairance hépatique de la lidocaïne). Conduite à tenir : Surveillance clinique, ECG et éventuellement contrôle des concentrations plasmatiques de la lidocaïne pendant et après l’arrêt de l’association. Adaptation, si besoin, de la posologie de la lidocaïne."))
  (interaction
    (title "FLUVOXAMINE + METHADONE")
    (level "Précaution d'emploi")
    (drugs-a "fluvoxamine")
    (drugs-b "methadone")
    (alert "Interaction FLUVOXAMINE + METHADONE (Précaution d'emploi) : Augmentation des concentrations plasmatiques de méthadone avec surdosage et risque majoré d’allongement de l’intervalle QT et de troubles du rythme ventriculaire, notamment de torsades de pointes. Conduite à tenir : Surveillance clinique et électrocardiographique renforcée ; si besoin, adaptation de la posologie de la méthadone pendant le traitement par la fluvoxamine et après son arrêt."))
  (interaction
    (title "FLUVOXAMINE + MEXILETINE")
    (level "Précaution d'emploi")
    (drugs-a "fluvoxamine")
    (drugs-b "mexiletine")
    (alert "Interaction FLUVOXAMINE + MEXILETINE (Précaution d'emploi) : Risque de majoration des effets indésirables de la méxilétine, par inhibition de son métabolisme par la fluvoxamine. Conduite à tenir : Surveillance clinique et ECG. Adaptation de la posologie de la méxilétine pendant le traitement par la fluvoxamine et après son arrêt."))
  (interaction
    (title "FLUVOXAMINE + OLANZAPINE")
    (level "Précaution d'emploi")
    (drugs-a "fluvoxamine")
    (drugs-b "olanzapine")
    (alert "Interaction FLUVOXAMINE + OLANZAPINE (Précaution d'emploi) : Augmentation des concentrations de l’olanzapine, avec risque de majoration des effets indésirables, par diminution de son métabolisme hépatique par la fluvoxamine. Conduite à tenir : Surveillance clinique et réduction éventuelle de la posologie de l’olanzapine pendant le traitement par fluvoxamine."))
  (interaction
    (title "FLUVOXAMINE + PHÉNYTOÏNE (ET, PAR EXTRAPOLATION, FOSPHÉNYTOÏNE)")
    (level "Précaution d'emploi")
    (drugs-a "fluvoxamine")
    (drugs-b "fosphenytoine" "phenytoine")
    (alert "Interaction FLUVOXAMINE + PHÉNYTOÏNE (ET, PAR EXTRAPOLATION, FOSPHÉNYTOÏNE) (Précaution d'emploi) : Augmentation des concentrations plasmatiques de phénytoïne avec signes de surdosage, par inhibition du métabolisme hépatique de la phénytoïne. Conduite à tenir : Surveillance clinique et éventuellement contröle des concentrations plamatiques de phénytoïne. Si besoin, adaptation posologique de la phénytoïne pendant le traitement par la fluvoxamine et après son arrët."))
  (interaction
    (title "FLUVOXAMINE + PIRFENIDONE")
    (level "CONTRE-INDICATION")
    (drugs-a "fluvoxamine")
    (drugs-b "pirfenidone")
    (alert "Interaction FLUVOXAMINE + PIRFENIDONE (CONTRE-INDICATION) : Augmentation des concentrations plasmatiques de pirfenidone avec signes de surdosage."))
  (interaction
    (title "FLUVOXAMINE + PROPRANOLOL")
    (level "Précaution d'emploi")
    (drugs-a "fluvoxamine")
    (drugs-b "propranolol")
    (alert "Interaction FLUVOXAMINE + PROPRANOLOL (Précaution d'emploi) : Augmentation des concentrations plasmatiques de propranolol par inhibition de son métabolisme hépatique, avec majoration de l'activité et des effets indésirables, par exemple : bradycardie importante. Conduite à tenir : Surveillance clinique accrue et, si besoin, adaptation de la posologie du propranolol pendant le traitement par la fluvoxamine et après son arrêt."))
  (interaction
    (title "FLUVOXAMINE + ROPINIROLE")
    (level "Précaution d'emploi")
    (drugs-a "fluvoxamine")
    (drugs-b "ropinirole")
    (alert "Interaction FLUVOXAMINE + ROPINIROLE (Précaution d'emploi) : Augmentation des concentrations de ropinirole, avec risque de surdosage, par diminution de son métabolisme hépatique par la fluvoxamine. Conduite à tenir : Surveillance clinique et réduction de la posologie du ropinirole pendant le traitement par fluvoxamine et après son arrêt."))
  (interaction
    (title "FLUVOXAMINE + THÉOPHYLLINE (ET, PAR EXTRAPOLATION, AMINOPHYLLINE)")
    (level "Précaution d'emploi")
    (drugs-a "fluvoxamine")
    (drugs-b "aminophylline" "theophylline")
    (alert "Interaction FLUVOXAMINE + THÉOPHYLLINE (ET, PAR EXTRAPOLATION, AMINOPHYLLINE) (Précaution d'emploi) : Augmentation de la théophyllinémie avec signes de surdosage (diminution du métabolisme hépatique de la théophylline). Conduite à tenir : Surveillance clinique et éventuellement de la théophyllinémie ; si besoin, adaptation de la posologie de la théophylline pendant le traitement par la fluvoxamine et après son arrêt."))
  (interaction
    (title "FOLATES + PHÉNOBARBITAL (ET, PAR EXTRAPOLATION, PRIMIDONE)")
    (level "Précaution d'emploi")
    (drugs-a "folinique" "folique")
    (drugs-b "phenobarbital" "primidone")
    (alert "Interaction FOLATES + PHÉNOBARBITAL (ET, PAR EXTRAPOLATION, PRIMIDONE) (Précaution d'emploi) : Diminution des concentrations plasmatiques du phénobarbital, par augmentation de son métabolisme dont les folates représentent un des cofacteurs. Conduite à tenir : Surveillance clinique, contrôle des concentrations plasmatiques, et adaptation, s'il y a lieu, de la posologie du phénobarbital pendant la supplémentation folique et après son arrêt."))
  (interaction
    (title "FOLATES + PHÉNYTOÏNE (ET, PAR EXTRAPOLATION, FOSPHÉNYTOÏNE)")
    (level "Précaution d'emploi")
    (drugs-a "folinique" "folique")
    (drugs-b "fosphenytoine" "phenytoine")
    (alert "Interaction FOLATES + PHÉNYTOÏNE (ET, PAR EXTRAPOLATION, FOSPHÉNYTOÏNE) (Précaution d'emploi) : Diminution des concentrations plasmatiques de phénytoïne par augmentation de son métabolisme dont les folates représentent un des cofacteurs. Conduite à tenir : Surveillance clinique et contrôle des concentrations plasmatiques de phénytoïne. Adaptation éventuelle de la posologie de la phénytoïne pendant la supplémentation folique et après son arrêt."))
  (interaction
    (title "FOSAMPRENAVIR + MARAVIROC")
    (level "Association DECONSEILLEE")
    (drugs-a "fosamprenavir")
    (drugs-b "maraviroc")
    (alert "Interaction FOSAMPRENAVIR + MARAVIROC (Association DECONSEILLEE) : Diminution significative des concentrations d’amprénavir pouvant conduire à une perte de la réponse virologique."))
  (interaction
    (title "FOSAMPRENAVIR + NEVIRAPINE")
    (level "Précaution d'emploi")
    (drugs-a "fosamprenavir")
    (drugs-b "nevirapine")
    (alert "Interaction FOSAMPRENAVIR + NEVIRAPINE (Précaution d'emploi) : Risque de baisse de l'efficacité de l'amprénavir. Conduite à tenir : Surveillance clinique et biologique régulière, notamment en début d'association."))
  (interaction
    (title "FOSCARNET + PENTAMIDINE")
    (level "Précaution d'emploi")
    (drugs-a "foscarnet")
    (drugs-b "pentamidine")
    (alert "Interaction FOSCARNET + PENTAMIDINE (Précaution d'emploi) : Risque d'hypocalcémie sévère. Conduite à tenir : Surveillance de la calcémie et supplémentation si nécessaire."))
  (interaction
    (title "FOSTAMATINIB + ROSUVASTATINE")
    (level "Précaution d'emploi")
    (drugs-a "fostamatinib")
    (drugs-b "rosuvastatine")
    (alert "Interaction FOSTAMATINIB + ROSUVASTATINE (Précaution d'emploi) : Doublement moyen des concentrations plasmatiques de la rosuvastatine. Conduite à tenir : Surveillance clinique et biologique, avec adaptation de la posologie de rosuvastatine si nécessaire."))
  (interaction
    (title "FOSTEMSAVIR + INDUCTEURS ENZYMATIQUES")
    (level "CI - APEC")
    (drugs-a "fostemsavir")
    (drugs-b "apalutamide" "carbamazepine" "cenobamate" "dabrafenib" "efavirenz" "enzalutamide" "eslicarbazepine" "fosphenytoine" "letermovir" "lorlatinib" "lumacaftor" "nevirapine" "oxcarbazepine" "phenobarbital" "phenytoine" "pitolisant" "primidone" "rifabutine" "rifampicine" "sotorasib")
    (alert "Interaction FOSTEMSAVIR + INDUCTEURS ENZYMATIQUES (CI - APEC) : Diminution significative des concentrations de fotemsavir avec la rifampicine, avec risque de réduction de la réponse virologique. Conduite à tenir : Contre-indication : - avec la rifampicine, la carbamazépine, la phénytoïne, l’enzalutamide A prendre en compte : - avec les autres inducteurs."))
  (interaction
    (title "FOSTEMSAVIR + MILLEPERTUIS")
    (level "CONTRE-INDICATION")
    (drugs-a "fostemsavir")
    (drugs-b "millepertuis")
    (alert "Interaction FOSTEMSAVIR + MILLEPERTUIS (CONTRE-INDICATION) : Risque de diminution significative des concentrations de fostemsavir avec le millepertuis, avec réduction de la réponse virologique."))
  (interaction
    (title "FOSTEMSAVIR + MITOTANE")
    (level "CONTRE-INDICATION")
    (drugs-a "fostemsavir")
    (drugs-b "mitotane")
    (alert "Interaction FOSTEMSAVIR + MITOTANE (CONTRE-INDICATION) : Diminution significative des concentrations de fostemsavir avec la rifampicine, avec risque de réduction de la réponse virologique. Éventualité non exclue avec le mitotane."))
  (interaction
    (title "FOSTEMSAVIR + ROSUVASTATINE")
    (level "Précaution d'emploi")
    (drugs-a "fostemsavir")
    (drugs-b "rosuvastatine")
    (alert "Interaction FOSTEMSAVIR + ROSUVASTATINE (Précaution d'emploi) : Augmentation modérée des concentrations de rosuvastatine. Conduite à tenir : Débuter par la dose minimale de rosuvastatine. Surveillance clinique régulière."))
  (interaction
    (title "FUROSEMIDE + PHÉNYTOÏNE (ET, PAR EXTRAPOLATION, FOSPHÉNYTOÏNE)")
    (level "Précaution d'emploi")
    (drugs-a "furosemide")
    (drugs-b "fosphenytoine" "phenytoine")
    (alert "Interaction FUROSEMIDE + PHÉNYTOÏNE (ET, PAR EXTRAPOLATION, FOSPHÉNYTOÏNE) (Précaution d'emploi) : Diminution de l'effet diurétique pouvant atteindre 50 %. Conduite à tenir : Utiliser éventuellement des doses plus élevées de furosémide."))
  (interaction
    (title "GANCICLOVIR + MARIBAVIR")
    (level "CONTRE-INDICATION")
    (drugs-a "ganciclovir")
    (drugs-b "maribavir")
    (alert "Interaction GANCICLOVIR + MARIBAVIR (CONTRE-INDICATION) : Antagonisme de la phosporylation et donc de l'effet pharmacologique du ganciclovir par le maribavir."))
  (interaction
    (title "GANCICLOVIR + ZIDOVUDINE")
    (level "Précaution d'emploi")
    (drugs-a "ganciclovir")
    (drugs-b "zidovudine")
    (alert "Interaction GANCICLOVIR + ZIDOVUDINE (Précaution d'emploi) : Augmentation de la toxicité hématologique (addition d'effets de toxicité médullaire). Conduite à tenir : Arrêter de façon transitoire la zidovudine ; contrôler la NFS et réintroduire, si possible, la zidovudine à doses faibles."))
  (interaction
    (title "GEMFIBROZIL + PACLITAXEL")
    (level "Précaution d'emploi")
    (drugs-a "gemfibrozil")
    (drugs-b "paclitaxel")
    (alert "Interaction GEMFIBROZIL + PACLITAXEL (Précaution d'emploi) : Risque d’augmentation des concentrations plasmatiques du paclitaxel par inhibition de son métabolisme hépatique par le gemfibrozil. Conduite à tenir : Surveillance clinique et biologique étroite et adaptation de la posologie du paclitaxel pendant l’association."))
  (interaction
    (title "GEMFIBROZIL + REPAGLINIDE")
    (level "CONTRE-INDICATION")
    (drugs-a "gemfibrozil")
    (drugs-b "repaglinide")
    (alert "Interaction GEMFIBROZIL + REPAGLINIDE (CONTRE-INDICATION) : Risque d'hypoglycémie sévère voire de coma, par augmentation importante des concentrations plasmatiques de repaglinide par le gemfibrozil."))
  (interaction
    (title "GEMFIBROZIL + ROXADUSTAT")
    (level "Précaution d'emploi")
    (drugs-a "gemfibrozil")
    (drugs-b "roxadustat")
    (alert "Interaction GEMFIBROZIL + ROXADUSTAT (Précaution d'emploi) : Augmentation de l’exposition du roxadustat, par diminution de son métabolisme par le gemfibrozil. Conduite à tenir : Surveillance clinique et biologique (hémoglobine)."))
  (interaction
    (title "GEMFIBROZIL + SELEXIPAG")
    (level "CONTRE-INDICATION")
    (drugs-a "gemfibrozil")
    (drugs-b "selexipag")
    (alert "Interaction GEMFIBROZIL + SELEXIPAG (CONTRE-INDICATION) : Risque d’augmentation des effets indésirables du sélexipag par diminution de son métabolisme."))
  (interaction
    (title "GEMFIBROZIL + TUCATINIB")
    (level "Association DECONSEILLEE")
    (drugs-a "gemfibrozil")
    (drugs-b "tucatinib")
    (alert "Interaction GEMFIBROZIL + TUCATINIB (Association DECONSEILLEE) : Augmentation importante des concentrations de tucatinib par diminution de son métabolisme par le gemfibrozil."))
  (interaction
    (title "GILTÉRITINIB + MILLEPERTUIS")
    (level "CONTRE-INDICATION")
    (drugs-a "gilteritinib")
    (drugs-b "millepertuis")
    (alert "Interaction GILTÉRITINIB + MILLEPERTUIS (CONTRE-INDICATION) : Diminution des concentrations plasmatiques de gilteritinib avec risque de perte d’efficacité."))
  (interaction
    (title "GIVOSIRAN + THEOPHYLLINE")
    (level "Précaution d'emploi")
    (drugs-a "givosiran")
    (drugs-b "theophylline")
    (alert "Interaction GIVOSIRAN + THEOPHYLLINE (Précaution d'emploi) : Risque d’augmentation de la théophyllinémie avec signes de surdosage par diminution de son métabolisme hépatique. Conduite à tenir : Surveillance clinique et éventuellement de la théophyllinémie."))
  (interaction
    (title "GLASDÉGIB + INDUCTEURS ENZYMATIQUES")
    (level "ASDEC - PE")
    (drugs-a "glasdegib")
    (drugs-b "apalutamide" "carbamazepine" "cenobamate" "dabrafenib" "efavirenz" "enzalutamide" "eslicarbazepine" "fosphenytoine" "letermovir" "lorlatinib" "lumacaftor" "nevirapine" "oxcarbazepine" "phenobarbital" "phenytoine" "pitolisant" "primidone" "rifabutine" "rifampicine" "sotorasib")
    (alert "Interaction GLASDÉGIB + INDUCTEURS ENZYMATIQUES (ASDEC - PE) : Diminution, éventuellement importante selon l'inducteur, des concentrations de glasdégib par augmentation de son métabolisme, avec risque d'inefficacité. Conduite à tenir : Association déconseillée - avec la rifampicine - avec les anticonvulsivants inducteurs enzymatiques (carbamazépine, phénytoïne, phénobarbital…) Précaution d'emploi - avec les autres inducteurs - si l’association ne peut être évitée, augmenter la dose de glasdégib."))
  (interaction
    (title "GLASDÉGIB + INHIBITEURS PUISSANTS DU CYP3A4")
    (level "Association DECONSEILLEE")
    (drugs-a "glasdegib")
    (drugs-b "clarithromycine" "cobicistat" "erythromycine" "itraconazole" "ketoconazole" "posaconazole" "ritonavir" "telithromycine" "tucatinib" "voriconazole")
    (alert "Interaction GLASDÉGIB + INHIBITEURS PUISSANTS DU CYP3A4 (Association DECONSEILLEE) : Risque de majoration des effets indésirables du glasdégib par diminution de son métabolisme. Conduite à tenir : Si l’association ne peut être évitée, surveillance clinique étroite."))
  (interaction
    (title "GLASDÉGIB + SUBSTANCES SUSCEPTIBLES DE DONNER DES TORSADES DE POINTES")
    (level "Précaution d'emploi")
    (drugs-a "glasdegib")
    (drugs-b "amiodarone" "amisulpride" "arsenieux" "chloroquine" "chlorpromazine" "citalopram" "cocaine" "crizotinib" "cyamemazine" "disopyramide" "domperidone" "dronedarone" "droperidol" "erythromycine" "escitalopram" "flupentixol" "fluphenazine" "halofantrine" "haloperidol" "hydroquinidine" "hydroxychloroquine" "hydroxyzine" "levomepromazine" "lumefantrine" "mequitazine" "methadone" "moxifloxacine" "pentamidine" "pimozide" "pipamperone" "piperaquine" "pipotiazine" "quinidine" "sotalol" "spiramycine" "sulpiride" "tiapride" "toremifene" "vandetanib" "vincamine" "zuclopenthixol")
    (alert "Interaction GLASDÉGIB + SUBSTANCES SUSCEPTIBLES DE DONNER DES TORSADES DE POINTES (Précaution d'emploi) : Risque majoré de troubles du rythme ventriculaire, notamment de torsades de pointes. Conduite à tenir : Surveillance clinique et électrocardiographique pendant l'association."))
  (interaction
    (title "GLÉCAPRÉVIR + PIBRENTASVIR + MILLEPERTUIS")
    (level "CONTRE-INDICATION")
    (drugs-a "glecaprevir" "pibrentasvir")
    (drugs-b "millepertuis")
    (alert "Interaction GLÉCAPRÉVIR + PIBRENTASVIR + MILLEPERTUIS (CONTRE-INDICATION) : Diminution des concentrations plasmatiques de la bithérapie par augmentation de son métabolisme par le millepertuis."))
  (interaction
    (title "GLÉCAPRÉVIR + PIBRENTASVIR + SIMVASTATINE")
    (level "CONTRE-INDICATION")
    (drugs-a "glecaprevir" "pibrentasvir")
    (drugs-b "simvastatine")
    (alert "Interaction GLÉCAPRÉVIR + PIBRENTASVIR + SIMVASTATINE (CONTRE-INDICATION) : Augmentation importante des concentrations plasmatiques de simvastatine par la bithérapie, avec risque majoré d’effets indésirables (concentration-dépendants) à type de rhabdomyolyses ."))
  (interaction
    (title "GLIPIZIDE + VORICONAZOLE")
    (level "Précaution d'emploi")
    (drugs-a "glipizide")
    (drugs-b "voriconazole")
    (alert "Interaction GLIPIZIDE + VORICONAZOLE (Précaution d'emploi) : Risque d’augmentation des concentrations plasmatiques du glipizide à l’origine d’hypoglycémies potentiellement sévères. Conduite à tenir : Prévenir le patient, renforcer l'autosurveillance glycémique et adapter éventuellement la posologie du sulfamide pendant et après le traitement par voriconazole."))
  (interaction
    (title "GLIPTINES + INHIBITEURS DE L'HMG-COA RÉDUCTASE (STATINES)")
    (level "Précaution d'emploi")
    (drugs-a "linagliptine" "saxagliptine" "sitagliptine" "vildagliptine")
    (drugs-b "atorvastatine" "fluvastatine" "pitavastatine" "pravastatine" "rosuvastatine" "simvastatine")
    (alert "Interaction GLIPTINES + INHIBITEURS DE L'HMG-COA RÉDUCTASE (STATINES) (Précaution d'emploi) : Possibilité de survenue d’effets indésirables musculaires à l’introduction d’une gliptine, malgré le traitement antérieur par statine bien toléré. Conduite à tenir : Le contrôle régulier de la fonction rénale et le strict respect des doses sont impératifs."))
  (interaction
    (title "GLUCOCORTICOÏDES (SAUF HYDROCORTISONE) + INDUCTEURS ENZYMATIQUES")
    (level "Précaution d'emploi")
    (drugs-a "betamethasone" "budesonide" "cortisone" "cortivazol" "dexamethasone" "methylprednisolone" "prednisolone" "prednisone" "tetracosactide" "triamcinolone")
    (drugs-b "apalutamide" "carbamazepine" "cenobamate" "dabrafenib" "efavirenz" "enzalutamide" "eslicarbazepine" "fosphenytoine" "letermovir" "lorlatinib" "lumacaftor" "nevirapine" "oxcarbazepine" "phenobarbital" "phenytoine" "pitolisant" "primidone" "rifabutine" "rifampicine" "sotorasib")
    (alert "Interaction GLUCOCORTICOÏDES (SAUF HYDROCORTISONE) + INDUCTEURS ENZYMATIQUES (Précaution d'emploi) : Diminution des concentrations plasmatiques et de l'efficacité des corticoïdes par augmentation de leur métabolisme hépatique par l'inducteur ; les conséquences sont particulièrement importantes chez les addisoniens traités par l'hydrocortisone et en cas de transplantation. Conduite à tenir : Surveillance clinique et biologique ; adaptation de la posologie des corticoïdes pendant le traitement par l'inducteur et après son arrêt."))
  (interaction
    (title "GLUCOCORTICOÏDES (SAUF HYDROCORTISONE) + ISONIAZIDE")
    (level "Précaution d'emploi")
    (drugs-a "betamethasone" "budesonide" "cortisone" "cortivazol" "dexamethasone" "methylprednisolone" "prednisolone" "prednisone" "tetracosactide" "triamcinolone")
    (drugs-b "isoniazide")
    (alert "Interaction GLUCOCORTICOÏDES (SAUF HYDROCORTISONE) + ISONIAZIDE (Précaution d'emploi) : Décrit pour la prednisolone. Diminution des concentrations plasmatiques de l'isoniazide. Mécanisme invoqué : augmentation du métabolisme hépatique de l'isoniazide et diminution de celui des glucocorticoïdes. Conduite à tenir : Surveillance clinique et biologique."))
  (interaction
    (title "GLUCOCORTICOÏDES (SAUF HYDROCORTISONE) + VACCINS VIVANTS ATTÉNUÉS")
    (level "CONTRE-INDICATION")
    (drugs-a "betamethasone" "budesonide" "cortisone" "cortivazol" "dexamethasone" "methylprednisolone" "prednisolone" "prednisone" "tetracosactide" "triamcinolone")
    (drugs-b "bcg" "rotavirus" "virus de la fievre jaune" "virus de la rougeole" "virus des oreillons" "virus rubeoleux" "virus varicelle-zona" "virus vivant attenue de la grippe")
    (alert "Interaction GLUCOCORTICOÏDES (SAUF HYDROCORTISONE) + VACCINS VIVANTS ATTÉNUÉS (CONTRE-INDICATION) : A l'exception des voies inhalées et locales, et pour des posologies supérieures à 10 mg/j d’équivalent-prednisone (ou > 2 mg/kg/j chez l’enfant ou > 20 mg/j chez l’enfant de plus de 10 kg) pendant plus de deux semaines et pour les « bolus » de corticoïdes: risque de maladie vaccinale généralisée éventuellement mortelle. Conduite à tenir : Et pendant les 3 mois suivant l'arrêt de la corticothérapie."))
  (interaction
    (title "GLUCOCORTICOÏDES PAR VOIE INTRA-ARTICULAIRE ET MÉTABOLISÉS + RITONAVIR")
    (level "Précaution d'emploi")
    (drugs-a "betamethasone" "dexamethasone" "methylprednisolone" "triamcinolone")
    (drugs-b "ritonavir")
    (alert "Interaction GLUCOCORTICOÏDES PAR VOIE INTRA-ARTICULAIRE ET MÉTABOLISÉS + RITONAVIR (Précaution d'emploi) : Décrit chez des patients HIV. Risque d’insuffisance surrénale aiguë, même en cas d’injection unique. L’articulation peut constituer un réservoir relarguant de façon continue le corticoïde CYP3A4-dépendant dans la circulation générale, avec augmentation possiblement très importante des concentrations du corticoïde, à l’origine d’une freination de la réponse hypothalamo-hypophysaire. Conduite à tenir : Préférer un corticoïde non CYP3A4-dépendant (hydrocortisone)."))
  (interaction
    (title "GLYCEROL + LITHIUM")
    (level "Précaution d'emploi")
    (drugs-a "glycerol")
    (drugs-b "lithium")
    (alert "Interaction GLYCEROL + LITHIUM (Précaution d'emploi) : Diminution de la lithémie avec risque de baisse de l’efficacité thérapeutique. Conduite à tenir : Surveillance stricte de la lithémie et adaptation éventuelle de la posologie du lithium."))
  (interaction
    (title "GRAZOPREVIR + ELBASVIR + INDUCTEURS ENZYMATIQUES")
    (level "CONTRE-INDICATION")
    (drugs-a "elbasvir" "grazoprevir")
    (drugs-b "apalutamide" "carbamazepine" "cenobamate" "dabrafenib" "efavirenz" "enzalutamide" "eslicarbazepine" "fosphenytoine" "letermovir" "lorlatinib" "lumacaftor" "nevirapine" "oxcarbazepine" "phenobarbital" "phenytoine" "pitolisant" "primidone" "rifabutine" "rifampicine" "sotorasib")
    (alert "Interaction GRAZOPREVIR + ELBASVIR + INDUCTEURS ENZYMATIQUES (CONTRE-INDICATION) : Risque de diminution des concentrations de grazoprévir et d’elbasvir par l’inducteur, avec possible retentissement sur l’efficacité."))
  (interaction
    (title "GRAZOPREVIR + ELBASVIR + INHIBITEURS DE L'HMG-COA RÉDUCTASE (STATINES)")
    (level "Précaution d'emploi")
    (drugs-a "elbasvir" "grazoprevir")
    (drugs-b "atorvastatine" "fluvastatine" "pitavastatine" "pravastatine" "rosuvastatine" "simvastatine")
    (alert "Interaction GRAZOPREVIR + ELBASVIR + INHIBITEURS DE L'HMG-COA RÉDUCTASE (STATINES) (Précaution d'emploi) : Augmentation des concentrations plasmatiques de l’hypochlestérolémiant par augmentation de son absorption intestinale. Conduite à tenir : Surveillance clinique et biologique pendant l’association. La dose de statine ne doit pas dépasser 20 mg par jour (10 mg avec la rosuvastatine)."))
  (interaction
    (title "GRAZOPREVIR + ELBASVIR + INHIBITEURS PUISSANTS DU CYP3A4")
    (level "CI - ASDEC")
    (drugs-a "elbasvir" "grazoprevir")
    (drugs-b "clarithromycine" "cobicistat" "erythromycine" "itraconazole" "ketoconazole" "posaconazole" "ritonavir" "telithromycine" "tucatinib" "voriconazole")
    (alert "Interaction GRAZOPREVIR + ELBASVIR + INHIBITEURS PUISSANTS DU CYP3A4 (CI - ASDEC) : Augmentation des concentrations plasmatiques de grazoprévir et d’elbasvir. Conduite à tenir : Contre-indication - avec le ritonavir et le cobicistat Association déconseillée - avec les autres inhibiteurs du CYP3A4."))
  (interaction
    (title "GRAZOPREVIR + ELBASVIR + SUNITINIB")
    (level "Association DECONSEILLEE")
    (drugs-a "elbasvir" "grazoprevir")
    (drugs-b "sunitinib")
    (alert "Interaction GRAZOPREVIR + ELBASVIR + SUNITINIB (Association DECONSEILLEE) : Risque d’augmentation des effets indésirables du sunitinib par le grazoprévir/elbasvir. Conduite à tenir : Si l’association ne peut être évitée, surveillance clinique étroite."))
  (interaction
    (title "GRAZOPREVIR + ELBASVIR + TACROLIMUS")
    (level "Précaution d'emploi")
    (drugs-a "elbasvir" "grazoprevir")
    (drugs-b "tacrolimus")
    (alert "Interaction GRAZOPREVIR + ELBASVIR + TACROLIMUS (Précaution d'emploi) : Augmentation des concentrations plasmatiques de tacrolimus par inhibition de son métabolisme hépatique. Conduite à tenir : Surveillance clinique et biologique étroite."))
  (interaction
    (title "GRISEOFULVINE + PROGESTATIFS CONTRACEPTIFS")
    (level "Précaution d'emploi")
    (drugs-a "griseofulvine")
    (drugs-b "desogestrel" "dienogest" "drospirenone" "etonogestrel" "levonorgestrel" "medroxyprogesterone" "nomegestrol" "norelgestromine" "norethisterone" "norgestimate")
    (alert "Interaction GRISEOFULVINE + PROGESTATIFS CONTRACEPTIFS (Précaution d'emploi) : Risque de diminution de l'efficacité du contraceptif hormonal par augmentation de son métabolisme hépatique. Conduite à tenir : Utiliser une méthode contraceptive fiable, additionnelle ou alternative, pendant la durée de l'association et un cycle suivant."))
  (interaction
    (title "GUANETHIDINE + IMAO IRRÉVERSIBLES")
    (level "CONTRE-INDICATION")
    (drugs-a "guanethidine")
    (drugs-b "iproniazide" "phenelzine")
    (alert "Interaction GUANETHIDINE + IMAO IRRÉVERSIBLES (CONTRE-INDICATION) : Avec la guanéthidine utilisée par voie IV : risque de réactions vasculaires imprévisibles, notamment d'hypotension. Conduite à tenir : Interrompre le traitement par IMAO 15 jours avant le traitement par guanéthidine."))
  (interaction
    (title "HALOFANTRINE + INHIBITEURS PUISSANTS DU CYP3A4")
    (level "Association DECONSEILLEE")
    (drugs-a "halofantrine")
    (drugs-b "clarithromycine" "cobicistat" "erythromycine" "itraconazole" "ketoconazole" "posaconazole" "ritonavir" "telithromycine" "tucatinib" "voriconazole")
    (alert "Interaction HALOFANTRINE + INHIBITEURS PUISSANTS DU CYP3A4 (Association DECONSEILLEE) : Risque majoré de troubles du rythme ventriculaires, notamment de torsades de pointes. Conduite à tenir : Si cela est possible, interrompre l'inhibiteur. Si l'association ne peut être évitée, contrôle préalable du QT et surveillance ECG monitorée."))
  (interaction
    (title "HALOFANTRINE + JOSAMYCINE")
    (level "Association DECONSEILLEE")
    (drugs-a "halofantrine")
    (drugs-b "josamycine")
    (alert "Interaction HALOFANTRINE + JOSAMYCINE (Association DECONSEILLEE) : Risque majoré de troubles du rythme ventriculaire, notamment de torsades de pointes. Conduite à tenir : Si cela est possible, interrompre le macrolide. Si l’association ne peut être évitée, contrôle préalable du QT et surveillance ECG monitorée."))
  (interaction
    (title "HALOFANTRINE + STIRIPENTOL")
    (level "Association DECONSEILLEE")
    (drugs-a "halofantrine")
    (drugs-b "stiripentol")
    (alert "Interaction HALOFANTRINE + STIRIPENTOL (Association DECONSEILLEE) : Risque majoré de troubles du rythme ventriculaire, notamment de torsades de pointes."))
  (interaction
    (title "HALOPERIDOL + INDUCTEURS ENZYMATIQUES PUISSANTS")
    (level "Précaution d'emploi")
    (drugs-a "haloperidol")
    (drugs-b "apalutamide" "carbamazepine" "enzalutamide" "fosphenytoine" "phenobarbital" "phenytoine" "primidone")
    (alert "Interaction HALOPERIDOL + INDUCTEURS ENZYMATIQUES PUISSANTS (Précaution d'emploi) : Risque de moindre efficacité de l'halopéridol par augmentation de son métabolisme hépatique par l'inducteur. Conduite à tenir : Surveillance clinique et, si besoin, adaptation posologique pendant le traitement par l'halopéridol et après son arrêt."))
  (interaction
    (title "HALOPERIDOL + RIFAMPICINE")
    (level "Précaution d'emploi")
    (drugs-a "haloperidol")
    (drugs-b "rifampicine")
    (alert "Interaction HALOPERIDOL + RIFAMPICINE (Précaution d'emploi) : Risque de diminution des concentrations plasmatiques de l'halopéridol et de son efficacité thérapeutique, par augmentation de son métabolisme hépatique par la rifampicine. Conduite à tenir : Surveillance clinique et, si besoin, adaptation posologique pendant le traitement par la rifampicine et après son arrêt."))
  (interaction
    (title "HALOTHANE + THÉOPHYLLINE (ET, PAR EXTRAPOLATION, AMINOPHYLLINE)")
    (level "Association DECONSEILLEE")
    (drugs-a "halothane")
    (drugs-b "aminophylline" "theophylline")
    (alert "Interaction HALOTHANE + THÉOPHYLLINE (ET, PAR EXTRAPOLATION, AMINOPHYLLINE) (Association DECONSEILLEE) : Troubles du rythme ventriculaire graves par augmentation de l'excitabilité cardiaque."))
  (interaction
    (title "HORMONES THYROÏDIENNES + INDUCTEURS ENZYMATIQUES PUISSANTS")
    (level "Précaution d'emploi")
    (drugs-a "levothyroxine" "liothyronine sodique" "thyroxines" "tiratricol")
    (drugs-b "apalutamide" "carbamazepine" "enzalutamide" "fosphenytoine" "phenobarbital" "phenytoine" "primidone")
    (alert "Interaction HORMONES THYROÏDIENNES + INDUCTEURS ENZYMATIQUES PUISSANTS (Précaution d'emploi) : Risque d'hypothyroïdie clinique chez les patients hypothyroïdiens, par augmentation du métabolisme de la T3 et de la T4. Conduite à tenir : Surveillance clinique et biologique. Adaptation, si besoin, de la posologie des hormones thyroïdiennes pendant le traitement par l'inducteur et après son arrêt."))
  (interaction
    (title "HORMONES THYROÏDIENNES + INHIBITEURS DE PROTÉASES BOOSTÉS PAR RITONAVIR")
    (level "Précaution d'emploi")
    (drugs-a "levothyroxine" "liothyronine sodique" "thyroxines" "tiratricol")
    (drugs-b "atazanavir" "darunavir" "fosamprenavir" "lopinavir" "nirmatrelvir" "ritonavir" "saquinavir" "tipranavir")
    (alert "Interaction HORMONES THYROÏDIENNES + INHIBITEURS DE PROTÉASES BOOSTÉS PAR RITONAVIR (Précaution d'emploi) : Risque de baisse de l’efficacité des hormones thyroïdiennes par augmentation de leur métabolisme hépatique par le ritonavir. Conduite à tenir : Surveillance clinique et biologique et adaptation éventuelle de la posologie des hormones thyroïdiennes."))
  (interaction
    (title "HORMONES THYROÏDIENNES + MILLEPERTUIS")
    (level "Association DECONSEILLEE")
    (drugs-a "levothyroxine" "liothyronine sodique" "thyroxines" "tiratricol")
    (drugs-b "millepertuis")
    (alert "Interaction HORMONES THYROÏDIENNES + MILLEPERTUIS (Association DECONSEILLEE) : Risque de baisse de l’efficacité des hormones thyroïdiennes."))
  (interaction
    (title "HORMONES THYROÏDIENNES + PROGUANIL")
    (level "Précaution d'emploi")
    (drugs-a "levothyroxine" "liothyronine sodique" "thyroxines" "tiratricol")
    (drugs-b "proguanil")
    (alert "Interaction HORMONES THYROÏDIENNES + PROGUANIL (Précaution d'emploi) : Risque d’hypothyroïdie clinique chez les patients substitués par hormones thyroïdiennes. Conduite à tenir : Surveillance clinique et biologique. Adaptation, si besoin, de la posologie des hormones thyroïdiennes pendant le traitement par l’antipaludique et après son arrêt."))
  (interaction
    (title "HORMONES THYROÏDIENNES + RÉSINES CHÉLATRICES")
    (level "Précaution d'emploi")
    (drugs-a "levothyroxine" "liothyronine sodique" "thyroxines" "tiratricol")
    (drugs-b "colesevelam" "colestyramine" "polystyrene sulfonate de calcium" "polystyrene sulfonate de sodium" "sevelamer")
    (alert "Interaction HORMONES THYROÏDIENNES + RÉSINES CHÉLATRICES (Précaution d'emploi) : Diminution de l'absorption digestive des hormones thyroïdiennes. Conduite à tenir : Prendre les hormones thyroïdiennes à distance de la résine (plus de 2 heures, si possible)."))
  (interaction
    (title "HORMONES THYROÏDIENNES + RIFABUTINE")
    (level "Précaution d'emploi")
    (drugs-a "levothyroxine" "liothyronine sodique" "thyroxines" "tiratricol")
    (drugs-b "rifabutine")
    (alert "Interaction HORMONES THYROÏDIENNES + RIFABUTINE (Précaution d'emploi) : Décrit pour la phénytoïne, la rifampicine, la carbamazépine. Risque d'hypothyroïdie clinique chez les patients hypothyroïdiens, par augmentation du métabolisme de la T3 et de la T4. Conduite à tenir : Surveillance clinique et biologique. Adaptation, si besoin, de la posologie des hormones thyroïdiennes pendant le traitement par la rifabutine et après son arrêt."))
  (interaction
    (title "HORMONES THYROÏDIENNES + RIFAMPICINE")
    (level "Précaution d'emploi")
    (drugs-a "levothyroxine" "liothyronine sodique" "thyroxines" "tiratricol")
    (drugs-b "rifampicine")
    (alert "Interaction HORMONES THYROÏDIENNES + RIFAMPICINE (Précaution d'emploi) : Risque d'hypothyroïdie clinique chez les patients hypothyroïdiens, par augmentation du métabolisme de la T3 et de la T4. Conduite à tenir : Surveillance clinique et biologique. Adaptation, si besoin, de la posologie des hormones thyroïdiennes pendant le traitement par la rifampicine et après son arrêt."))
  (interaction
    (title "HORMONES THYROÏDIENNES + SELPERCATINIB")
    (level "Précaution d'emploi")
    (drugs-a "levothyroxine" "liothyronine sodique" "thyroxines" "tiratricol")
    (drugs-b "selpercatinib")
    (alert "Interaction HORMONES THYROÏDIENNES + SELPERCATINIB (Précaution d'emploi) : Risque de moindre efficacité de la supplémentation en lévothyroxine par baisse de la conversion de T4 en T3 en cas de traitement par selpercatinib. Conduite à tenir : Surveillance clinique et biologique, et adjonction éventuelle de liothyronine au traitement par la lévothyroxine."))
  (interaction
    (title "HORMONES THYROÏDIENNES + SUCRALFATE")
    (level "Précaution d'emploi")
    (drugs-a "levothyroxine" "liothyronine sodique" "thyroxines" "tiratricol")
    (drugs-b "sucralfate")
    (alert "Interaction HORMONES THYROÏDIENNES + SUCRALFATE (Précaution d'emploi) : Diminution de l'absorption digestive des hormones thyroïdiennes. Conduite à tenir : Prendre les hormones thyroïdiennes à distance du sucralfate (plus de 2 heures, si possible)."))
  (interaction
    (title "HYDROCORTISONE + INDUCTEURS ENZYMATIQUES")
    (level "Précaution d'emploi")
    (drugs-a "hydrocortisone")
    (drugs-b "apalutamide" "carbamazepine" "cenobamate" "dabrafenib" "efavirenz" "enzalutamide" "eslicarbazepine" "fosphenytoine" "letermovir" "lorlatinib" "lumacaftor" "nevirapine" "oxcarbazepine" "phenobarbital" "phenytoine" "pitolisant" "primidone" "rifabutine" "rifampicine" "sotorasib")
    (alert "Interaction HYDROCORTISONE + INDUCTEURS ENZYMATIQUES (Précaution d'emploi) : Risque de diminution de l'efficacité de l'hydrocortisone (augmentation de son métabolisme) ; les conséquences sont graves lorsque l'hydrocortisone est administrée en traitement substitutif ou en cas de transplantation. Conduite à tenir : Surveillance clinique et biologique ; adaptation de la posologie de l'hydrocortisone pendant l'association et après l'arrêt de l'inducteur enzymatique."))
  (interaction
    (title "HYDROQUINIDINE + ITRACONAZOLE")
    (level "Précaution d'emploi")
    (drugs-a "hydroquinidine")
    (drugs-b "itraconazole")
    (alert "Interaction HYDROQUINIDINE + ITRACONAZOLE (Précaution d'emploi) : Risque d'acouphènes et/ou de diminution de l'acuité auditive : cinchonisme lié à une diminution du métabolisme hépatique de l'antiarythmique par l'itraconazole. Conduite à tenir : Surveillance des concentrations plasmatiques de l'antiarythmique et diminution éventuelle de sa posologie si nécessaire."))
  (interaction
    (title "HYDROXYCARBAMIDE + VACCINS VIVANTS ATTÉNUÉS")
    (level "Association DECONSEILLEE")
    (drugs-a "hydroxycarbamide")
    (drugs-b "bcg" "rotavirus" "virus de la fievre jaune" "virus de la rougeole" "virus des oreillons" "virus rubeoleux" "virus varicelle-zona" "virus vivant attenue de la grippe")
    (alert "Interaction HYDROXYCARBAMIDE + VACCINS VIVANTS ATTÉNUÉS (Association DECONSEILLEE) : Dans son indication chez le patient drépanocytaire, risque théorique de maladie vaccinale généralisée. Conduite à tenir : L'association ne devra être envisagée que si les bénéfices sont estimés comme étant supérieurs à ce risque. S'il est décidé d’interrompre le traitement par hydroxycarbamide pour effectuer la vaccination, un délai de 3 mois après l’arrêt est recommandé."))
  (interaction
    (title "HYDROXYCHLOROQUINE + SUBSTANCES SUSCEPTIBLES DE DONNER DES TORSADES DE POINTES")
    (level "CI - ASDEC")
    (drugs-a "hydroxychloroquine")
    (drugs-b "amiodarone" "amisulpride" "arsenieux" "chloroquine" "chlorpromazine" "citalopram" "cocaine" "crizotinib" "cyamemazine" "disopyramide" "domperidone" "dronedarone" "droperidol" "erythromycine" "escitalopram" "flupentixol" "fluphenazine" "halofantrine" "haloperidol" "hydroquinidine" "hydroxychloroquine" "hydroxyzine" "levomepromazine" "lumefantrine" "mequitazine" "methadone" "moxifloxacine" "pentamidine" "pimozide" "pipamperone" "piperaquine" "pipotiazine" "quinidine" "sotalol" "spiramycine" "sulpiride" "tiapride" "toremifene" "vandetanib" "vincamine" "zuclopenthixol")
    (alert "Interaction HYDROXYCHLOROQUINE + SUBSTANCES SUSCEPTIBLES DE DONNER DES TORSADES DE POINTES (CI - ASDEC) : Risque majoré de troubles du rythme ventriculaire, notamment de torsades de pointes. Conduite à tenir : Contre-indication : - avec le citalopram, la dompéridone, l'escitalopram, l'hydroxyzine et la pipéraquine. Association déconseillée: - avec les autres médicaments susceptibles de donner des torsades de pointes. Si l’association ne peut être évitée, contrôle clinique et électrocardiographique régulier."))
  (interaction
    (title "HYPOKALIÉMIANTS + AUTRES HYPOKALIÉMIANTS")
    (level "Précaution d'emploi")
    (drugs-a "ricinoleate de)" "tetracosactide" "triamcinolone")
    (drugs-b "ricinoleate de)" "tetracosactide" "triamcinolone")
    (alert "Interaction HYPOKALIÉMIANTS + AUTRES HYPOKALIÉMIANTS (Précaution d'emploi) : Risque majoré d'hypokaliémie. Conduite à tenir : Surveillance de la kaliémie avec si besoin correction."))
  (interaction
    (title "HYPOKALIÉMIANTS + SUBSTANCES SUSCEPTIBLES DE DONNER DES TORSADES DE POINTES")
    (level "Précaution d'emploi")
    (drugs-a "ricinoleate de)" "tetracosactide" "triamcinolone")
    (drugs-b "amiodarone" "amisulpride" "arsenieux" "chloroquine" "chlorpromazine" "citalopram" "cocaine" "crizotinib" "cyamemazine" "disopyramide" "domperidone" "dronedarone" "droperidol" "erythromycine" "escitalopram" "flupentixol" "fluphenazine" "halofantrine" "haloperidol" "hydroquinidine" "hydroxychloroquine" "hydroxyzine" "levomepromazine" "lumefantrine" "mequitazine" "methadone" "moxifloxacine" "pentamidine" "pimozide" "pipamperone" "piperaquine" "pipotiazine" "quinidine" "sotalol" "spiramycine" "sulpiride" "tiapride" "toremifene" "vandetanib" "vincamine" "zuclopenthixol")
    (alert "Interaction HYPOKALIÉMIANTS + SUBSTANCES SUSCEPTIBLES DE DONNER DES TORSADES DE POINTES (Précaution d'emploi) : Risque majoré de troubles du rythme ventriculaire, notamment de torsades de pointes. Conduite à tenir : Corriger toute hypokaliémie avant d’administrer le produit et réaliser une surveillance clinique, électrolytique et électrocardiographique."))
  (interaction
    (title "IBRUTINIB + IMATINIB")
    (level "Association DECONSEILLEE")
    (drugs-a "ibrutinib")
    (drugs-b "imatinib")
    (alert "Interaction IBRUTINIB + IMATINIB (Association DECONSEILLEE) : Risque d’augmentation des concentrations plasmatiques d’ibrutinib par diminution de son métabolisme hépatique par l'imatinib. Conduite à tenir : Si l’association ne peut être évitée, surveillance clinique étroite et réduction de la dose d’ibrutinib à 280 mg par jour pendant la durée de l’association."))
  (interaction
    (title "IBRUTINIB + VERAPAMIL")
    (level "Association DECONSEILLEE")
    (drugs-a "ibrutinib")
    (drugs-b "verapamil")
    (alert "Interaction IBRUTINIB + VERAPAMIL (Association DECONSEILLEE) : Risque d’augmentation des concentrations plasmatiques d’ibrutinib par diminution de son métabolisme hépatique par le vérapamil. Conduite à tenir : Si l’association ne peut être évitée, surveillance clinique étroite et réduction de la dose d’ibrutinib à 280 mg par jour pendant la durée de l’association."))
  (interaction
    (title "IDÉLALISIB + INDUCTEURS ENZYMATIQUES PUISSANTS")
    (level "Association DECONSEILLEE")
    (drugs-a "idelalisib")
    (drugs-b "apalutamide" "carbamazepine" "enzalutamide" "fosphenytoine" "phenobarbital" "phenytoine" "primidone")
    (alert "Interaction IDÉLALISIB + INDUCTEURS ENZYMATIQUES PUISSANTS (Association DECONSEILLEE) : Diminution des concentrations plasmatiques d’idélalisib par augmentation de son métabolisme hépatique par l'inducteur enzymatique."))
  (interaction
    (title "IDÉLALISIB + MILLEPERTUIS")
    (level "Association DECONSEILLEE")
    (drugs-a "idelalisib")
    (drugs-b "millepertuis")
    (alert "Interaction IDÉLALISIB + MILLEPERTUIS (Association DECONSEILLEE) : Risque de diminution importante des concentrations plasmatiques d’idélalisib par augmentation de son métabolisme hépatique par le millepertuis."))
  (interaction
    (title "IDÉLALISIB + RIFAMPICINE")
    (level "Association DECONSEILLEE")
    (drugs-a "idelalisib")
    (drugs-b "rifampicine")
    (alert "Interaction IDÉLALISIB + RIFAMPICINE (Association DECONSEILLEE) : Diminution des concentrations plasmatiques d’idélalisib par augmentation de son métabolisme hépatique par l’inducteur."))
  (interaction
    (title "IDÉLALISIB + SUBSTRATS À RISQUE DU CYP3A4")
    (level "Association DECONSEILLEE")
    (drugs-a "idelalisib")
    (drugs-b "abemaciclib" "alfentanil" "apixaban" "atorvastatine" "axitinib" "bortezomib" "bosutinib" "brigatinib" "cabazitaxel" "cabozantinib" "ceritinib" "ciclosporine" "cobimetinib" "crizotinib" "dabrafenib" "dasatinib" "dihydroergotamine" "docetaxel" "ergotamine" "erlotinib" "everolimus" "gefitinib" "halofantrine" "ibrutinib" "imatinib" "irinotecan" "lapatinib" "lorlatinib" "lumefantrine" "midazolam" "nilotinib" "osimertinib" "oxycodone" "paclitaxel" "palbociclib" "pazopanib" "pimozide" "ponatinib" "quetiapine" "quinine" "rivaroxaban" "ruxolitinib" "simvastatine" "sirolimus" "sorafenib" "sufentanil" "sunitinib" "tacrolimus" "temsirolimus" "ticagrelor" "vandetanib" "vinblastine" "vincristine" "vindesine" "vinflunine" "vinorelbine")
    (alert "Interaction IDÉLALISIB + SUBSTRATS À RISQUE DU CYP3A4 (Association DECONSEILLEE) : Augmentation des concentrations plasmatiques du substrat par diminution de son métabolisme hépatique par l’idelalisib."))
  (interaction
    (title "IFOSFAMIDE + PHÉNOBARBITAL (ET, PAR EXTRAPOLATION, PRIMIDONE)")
    (level "Association DECONSEILLEE")
    (drugs-a "ifosfamide")
    (drugs-b "phenobarbital" "primidone")
    (alert "Interaction IFOSFAMIDE + PHÉNOBARBITAL (ET, PAR EXTRAPOLATION, PRIMIDONE) (Association DECONSEILLEE) : Risque de majoration de la neurotoxicité de l'ifosfamide par augmentation de son métabolisme hépatique par le phénobarbital."))
  (interaction
    (title "IMAO IRRÉVERSIBLES + INHIBITEURS DE LA CATÉCHOL-O-MÉTHYLTRANSFÉRASE (COMT)")
    (level "CONTRE-INDICATION")
    (drugs-a "iproniazide" "phenelzine")
    (drugs-b "entacapone" "tolcapone")
    (alert "Interaction IMAO IRRÉVERSIBLES + INHIBITEURS DE LA CATÉCHOL-O-MÉTHYLTRANSFÉRASE (COMT) (CONTRE-INDICATION) : Potentialisation des effets pharmacologiques, et notamment vasopresseurs, des catécholamines par inhibition conjuguée de leur métabolisme."))
  (interaction
    (title "IMAO IRRÉVERSIBLES + INHIBITEURS SÉLECTIFS DE LA RECAPTURE DE LA SÉROTONINE")
    (level "CONTRE-INDICATION")
    (drugs-a "iproniazide" "phenelzine")
    (drugs-b "citalopram" "dapoxetine" "escitalopram" "fluoxetine" "fluvoxamine" "paroxetine" "sertraline" "vortioxetine")
    (alert "Interaction IMAO IRRÉVERSIBLES + INHIBITEURS SÉLECTIFS DE LA RECAPTURE DE LA SÉROTONINE (CONTRE-INDICATION) : Risque d'apparition d'un syndrome sérotoninergique : diarrhée, tachycardie, sueurs, tremblements, confusion voire coma. Conduite à tenir : Respecter un délai de deux semaines entre l'arrêt de l'IMAO et le début du traitement par l'antidépresseur sérotoninergique, et d'au moins une semaine entre l'arrêt de l'antidépresseur sérotoninergique (sauf pour la fluoxétine : cinq semaines) et le début."))
  (interaction
    (title "IMAO IRRÉVERSIBLES + MÉDICAMENTS MIXTES ADRÉNERGIQUES-SÉROTONINERGIQUES")
    (level "CONTRE-INDICATION")
    (drugs-a "iproniazide" "phenelzine")
    (drugs-b "amitriptyline" "clomipramine" "duloxetine" "imipramine" "milnacipran" "oxitriptan" "venlafaxine")
    (alert "Interaction IMAO IRRÉVERSIBLES + MÉDICAMENTS MIXTES ADRÉNERGIQUES-SÉROTONINERGIQUES (CONTRE-INDICATION) : Risque d'apparition d'un syndrome sérotoninergique : diarrhée, tachycardie, sueurs, tremblements, confusion voire coma. Conduite à tenir : Respecter un délai de deux semaines entre l'arrêt de l'IMAO et le début de l'autre traitement, et d'au moins une semaine entre l'arrêt de l'autre traitement et le début de l'IMAO."))
  (interaction
    (title "IMAO IRRÉVERSIBLES + MIDODRINE")
    (level "CONTRE-INDICATION")
    (drugs-a "iproniazide" "phenelzine")
    (drugs-b "midodrine")
    (alert "Interaction IMAO IRRÉVERSIBLES + MIDODRINE (CONTRE-INDICATION) : Crises hypertensives (inhibition du métabolisme des amines pressives). Du fait de la durée d'action des IMAO, cette interaction est encore possible 15 jours après l'arrêt de l'IMAO."))
  (interaction
    (title "IMAO IRRÉVERSIBLES + MILLEPERTUIS")
    (level "Précaution d'emploi")
    (drugs-a "iproniazide" "phenelzine")
    (drugs-b "millepertuis")
    (alert "Interaction IMAO IRRÉVERSIBLES + MILLEPERTUIS (Précaution d'emploi) : Risque d'apparition d'un syndrome sérotoninergique. Conduite à tenir : Surveillance clinique et biologique régulière, notamment en début d'association."))
  (interaction
    (title "IMAO IRRÉVERSIBLES + PETHIDINE")
    (level "CONTRE-INDICATION")
    (drugs-a "iproniazide" "phenelzine")
    (drugs-b "pethidine")
    (alert "Interaction IMAO IRRÉVERSIBLES + PETHIDINE (CONTRE-INDICATION) : Risque d'apparition d'un syndrome sérotoninergique : diarrhée, tachycardie, sueurs, tremblements, confusion voire coma."))
  (interaction
    (title "IMAO IRRÉVERSIBLES + RESERPINE")
    (level "CONTRE-INDICATION")
    (drugs-a "iproniazide" "phenelzine")
    (drugs-b "reserpine")
    (alert "Interaction IMAO IRRÉVERSIBLES + RESERPINE (CONTRE-INDICATION) : Agitation psychomotrice, convulsions, hypertension."))
  (interaction
    (title "IMAO IRRÉVERSIBLES + SYMPATHOMIMÉTIQUES ALPHA (VOIES ORALE ET/OU NASALE)")
    (level "Association DECONSEILLEE")
    (drugs-a "iproniazide" "phenelzine")
    (drugs-b "etilefrine" "midodrine" "naphazoline" "oxymetazoline" "phenylephrine" "synephrine" "tetryzoline" "tuaminoheptane")
    (alert "Interaction IMAO IRRÉVERSIBLES + SYMPATHOMIMÉTIQUES ALPHA (VOIES ORALE ET/OU NASALE) (Association DECONSEILLEE) : Crises hypertensives (inhibition du métabolisme des amines pressives). Du fait de la durée d'action de l'IMAO, cette interaction est encore possible 15 jours après l'arrêt de l'IMAO."))
  (interaction
    (title "IMAO IRRÉVERSIBLES + SYMPATHOMIMÉTIQUES ALPHA ET BÊTA (VOIE IM ET IV)")
    (level "Précaution d'emploi")
    (drugs-a "iproniazide" "phenelzine")
    (drugs-b "adrenaline" "dopamine" "noradrenaline" "norepinephrine")
    (alert "Interaction IMAO IRRÉVERSIBLES + SYMPATHOMIMÉTIQUES ALPHA ET BÊTA (VOIE IM ET IV) (Précaution d'emploi) : Augmentation de l'action pressive du sympathomimétique, le plus souvent modérée. Conduite à tenir : A n'utiliser que sous contrôle médical strict."))
  (interaction
    (title "IMAO IRRÉVERSIBLES + SYMPATHOMIMÉTIQUES INDIRECTS")
    (level "CONTRE-INDICATION")
    (drugs-a "iproniazide" "phenelzine")
    (drugs-b "bupropion" "cafedrine" "ephedrine" "methylphenidate" "pseudoephedrine" "theodrenaline")
    (alert "Interaction IMAO IRRÉVERSIBLES + SYMPATHOMIMÉTIQUES INDIRECTS (CONTRE-INDICATION) : Hypertension paroxystique, hyperthermie pouvant être fatale. Du fait de la durée d'action de l'IMAO, cette interaction est encore possible 15 jours après l'arrêt de l'IMAO."))
  (interaction
    (title "IMAO IRRÉVERSIBLES + TETRABENAZINE")
    (level "CONTRE-INDICATION")
    (drugs-a "iproniazide" "phenelzine")
    (drugs-b "tetrabenazine")
    (alert "Interaction IMAO IRRÉVERSIBLES + TETRABENAZINE (CONTRE-INDICATION) : Risque de crises hypertensives. Du fait de la durée d'action de l'IMAO, cette interaction est encore théoriquement possible 15 jours après son arrêt."))
  (interaction
    (title "IMAO IRRÉVERSIBLES + TIANEPTINE")
    (level "Association DECONSEILLEE")
    (drugs-a "iproniazide" "phenelzine")
    (drugs-b "tianeptine")
    (alert "Interaction IMAO IRRÉVERSIBLES + TIANEPTINE (Association DECONSEILLEE) : Risque de collapsus, hypertension paroxystique, hyperthermie, convulsions, décès."))
  (interaction
    (title "IMAO IRRÉVERSIBLES + TRAMADOL")
    (level "CONTRE-INDICATION")
    (drugs-a "iproniazide" "phenelzine")
    (drugs-b "tramadol")
    (alert "Interaction IMAO IRRÉVERSIBLES + TRAMADOL (CONTRE-INDICATION) : Risque d'apparition d'un syndrome sérotoninergique : diarrhée, sueurs, tremblements, confusion, voire coma."))
  (interaction
    (title "IMAO IRRÉVERSIBLES + TRIPTANS MÉTABOLISÉS PAR LA MAO")
