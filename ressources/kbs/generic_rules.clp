    (drugs-a "fosphenytoine" "phenytoine")
    (drugs-b "valproique" "valpromide")
    (alert "Interaction PHÉNYTOÏNE (ET, PAR EXTRAPOLATION, FOSPHÉNYTOÏNE) + VALPROÏQUE (ACIDE) ET, PAR EXTRAPOLATION, VALPROMIDE (Précaution d'emploi) : Augmentation de l'hyperammoniémie, avec risque accru d'encéphalopathie. Conduite à tenir : Surveillance clinique et biologique régulière."))
  (interaction
    (title "PIMOZIDE + QUINUPRISTINE")
    (level "Association DECONSEILLEE")
    (drugs-a "pimozide")
    (drugs-b "quinupristine")
    (alert "Interaction PIMOZIDE + QUINUPRISTINE (Association DECONSEILLEE) : Risque majoré de troubles du rythme ventriculaire, notamment de torsades de pointes."))
  (interaction
    (title "PIMOZIDE + SERTRALINE")
    (level "CONTRE-INDICATION")
    (drugs-a "pimozide")
    (drugs-b "sertraline")
    (alert "Interaction PIMOZIDE + SERTRALINE (CONTRE-INDICATION) : Risque majoré de troubles du rythme ventriculaire, notamment de torsades de pointes."))
  (interaction
    (title "PIMOZIDE + STIRIPENTOL")
    (level "CONTRE-INDICATION")
    (drugs-a "pimozide")
    (drugs-b "stiripentol")
    (alert "Interaction PIMOZIDE + STIRIPENTOL (CONTRE-INDICATION) : Risque majoré de troubles du rythme ventriculaire, notamment de torsades de pointes."))
  (interaction
    (title "PIMOZIDE + TRICLABENDAZOLE")
    (level "CONTRE-INDICATION")
    (drugs-a "pimozide")
    (drugs-b "triclabendazole")
    (alert "Interaction PIMOZIDE + TRICLABENDAZOLE (CONTRE-INDICATION) : Risque majoré de troubles du rythme ventriculaire, notamment de torsades de pointes (inhibition du métabolisme hépatique du médicament torsadogène). Conduite à tenir : Respecter un délai de 24 heures entre l’arrêt du triclabendazole et la prise du médicament torsadogène, et inversement."))
  (interaction
    (title "PIMOZIDE + VERAPAMIL")
    (level "CONTRE-INDICATION")
    (drugs-a "pimozide")
    (drugs-b "verapamil")
    (alert "Interaction PIMOZIDE + VERAPAMIL (CONTRE-INDICATION) : Risque majoré de troubles du rythme ventriculaires, notamment, de torsades de pointes."))
  (interaction
    (title "PIPÉRACILLINE/TAZOBACTAM + VANCOMYCINE")
    (level "Association DECONSEILLEE")
    (drugs-a "piperacilline" "tazobactam")
    (drugs-b "vancomycine")
    (alert "Interaction PIPÉRACILLINE/TAZOBACTAM + VANCOMYCINE (Association DECONSEILLEE) : Majoration de la néphrotoxicité par comparaison à la vancomycine seule."))
  (interaction
    (title "POLYSTYRÈNE SULFONATE DE CALCIUM + SORBITOL")
    (level "CONTRE-INDICATION")
    (drugs-a "polystyrene sulfonate de calcium")
    (drugs-b "sorbitol")
    (alert "Interaction POLYSTYRÈNE SULFONATE DE CALCIUM + SORBITOL (CONTRE-INDICATION) : Par voie orale ou rectale du sorbitol ou de la résine, et pour une dose de sorbitol par prise >= 2,5 g chez l'enfant et 5 g chez l'adulte : Risque de nécrose colique, éventuellement fatale."))
  (interaction
    (title "POLYSTYRÈNE SULFONATE DE CALCIUM + TOPIQUES GASTRO-INTESTINAUX, ANTIACIDES ET ADSORBANTS")
    (level "Précaution d'emploi")
    (drugs-a "polystyrene sulfonate de calcium")
    (drugs-b "charbon active" "charbon vegetal officinal" "crospovidone" "diosmectite" "gel d'hydroxyde d'aluminium et de carbonate de magnesium codesseches" "hydrotalcite" "hydroxyde de magnesium" "kaolin lourd" "lanthane" "magaldrate" "magnesium hydroxyde" "magnesium trisilicate" "monmectite" "trisilicate de magnesium")
    (alert "Interaction POLYSTYRÈNE SULFONATE DE CALCIUM + TOPIQUES GASTRO-INTESTINAUX, ANTIACIDES ET ADSORBANTS (Précaution d'emploi) : Risque d'alcalose métabolique chez l'insuffisant rénal. Conduite à tenir : Comme avec tout médicament oral pris avec l’un ou l’autre de ces médicaments, respecter un intervalle entre les prises (plus de 2 heures, si possible)."))
  (interaction
    (title "POLYSTYRÈNE SULFONATE DE SODIUM + SORBITOL")
    (level "CONTRE-INDICATION")
    (drugs-a "polystyrene sulfonate de sodium")
    (drugs-b "sorbitol")
    (alert "Interaction POLYSTYRÈNE SULFONATE DE SODIUM + SORBITOL (CONTRE-INDICATION) : Par voie orale ou rectale du sorbitol ou de la résine, et pour une dose de sorbitol par prise >= 2,5 g chez l'enfant et 5 g chez l'adulte : Risque de nécrose colique, éventuellement fatale."))
  (interaction
    (title "POLYSTYRÈNE SULFONATE DE SODIUM + TOPIQUES GASTRO-INTESTINAUX, ANTIACIDES ET ADSORBANTS")
    (level "Précaution d'emploi")
    (drugs-a "polystyrene sulfonate de sodium")
    (drugs-b "charbon active" "charbon vegetal officinal" "crospovidone" "diosmectite" "gel d'hydroxyde d'aluminium et de carbonate de magnesium codesseches" "hydrotalcite" "hydroxyde de magnesium" "kaolin lourd" "lanthane" "magaldrate" "magnesium hydroxyde" "magnesium trisilicate" "monmectite" "trisilicate de magnesium")
    (alert "Interaction POLYSTYRÈNE SULFONATE DE SODIUM + TOPIQUES GASTRO-INTESTINAUX, ANTIACIDES ET ADSORBANTS (Précaution d'emploi) : Risque d'alcalose métabolique chez l'insuffisant rénal. Conduite à tenir : Comme avec tout médicament oral pris avec l’un ou l’autre de ces médicaments, respecter un intervalle entre les prises (plus de 2 heures, si possible)."))
  (interaction
    (title "PONATINIB + PRAVASTATINE")
    (level "Précaution d'emploi")
    (drugs-a "ponatinib")
    (drugs-b "pravastatine")
    (alert "Interaction PONATINIB + PRAVASTATINE (Précaution d'emploi) : Risque d’augmentation des concentrations plasmatiques de la pravastatine par augmentation de son absorption intestinale par le ponatinib. Conduite à tenir : Surveillance clinique et biologique étroite pendant l’association."))
  (interaction
    (title "PONATINIB + ROSUVASTATINE")
    (level "Précaution d'emploi")
    (drugs-a "ponatinib")
    (drugs-b "rosuvastatine")
    (alert "Interaction PONATINIB + ROSUVASTATINE (Précaution d'emploi) : Risque d’augmentation des concentrations plasmatiques de la rosuvastatine par augmentation de son absorption intestinale par le ponatinib. Conduite à tenir : Surveillance clinique et biologique étroite pendant l’association."))
  (interaction
    (title "PONATINIB + SIMVASTATINE")
    (level "Précaution d'emploi")
    (drugs-a "ponatinib")
    (drugs-b "simvastatine")
    (alert "Interaction PONATINIB + SIMVASTATINE (Précaution d'emploi) : Risque d’augmentation des concentrations plasmatiques de la simvastatine par augmentation de son absorption intestinale par le ponatinib. Conduite à tenir : Surveillance clinique et biologique étroite pendant l’association."))
  (interaction
    (title "PONATINIB + SULFASALAZINE")
    (level "Précaution d'emploi")
    (drugs-a "ponatinib")
    (drugs-b "sulfasalazine")
    (alert "Interaction PONATINIB + SULFASALAZINE (Précaution d'emploi) : Risque d’augmentation des concentrations plasmatiques de la sulfasalazine par augmentation de son absorption intestinale par le ponatinib. Conduite à tenir : Surveillance clinique et biologique étroite pendant l’association."))
  (interaction
    (title "POSACONAZOLE + RIFABUTINE")
    (level "Association DECONSEILLEE")
    (drugs-a "posaconazole")
    (drugs-b "rifabutine")
    (alert "Interaction POSACONAZOLE + RIFABUTINE (Association DECONSEILLEE) : Risque d'accroissement des effets indésirables de la rifabutine (uvéites), par augmentation de ses concentrations et de celles de son métabolite actif. Conduite à tenir : Surveillance clinique et biologique régulière, notamment en début d'association."))
  (interaction
    (title "POSACONAZOLE + RIFAMPICINE")
    (level "Association DECONSEILLEE")
    (drugs-a "posaconazole")
    (drugs-b "rifampicine")
    (alert "Interaction POSACONAZOLE + RIFAMPICINE (Association DECONSEILLEE) : Diminution des concentrations plasmatiques et de l'efficacité des deux anti-infectieux (induction enzymatique par la rifampicine et diminution de l'absorption intestinale par l’azolé antifongique)."))
  (interaction
    (title "POTASSIUM + TACROLIMUS")
    (level "Association DECONSEILLEE")
    (drugs-a "potassium")
    (drugs-b "tacrolimus")
    (alert "Interaction POTASSIUM + TACROLIMUS (Association DECONSEILLEE) : Pour une quantité de potassium > à 1 mmol/prise, hyperkaliémie potentiellement létale, notamment chez l'insuffisant rénale (addition des effets hyperkaliémiants). Conduite à tenir : Sauf en cas d'hypokaliémie."))
  (interaction
    (title "PRAZIQUANTEL + RIFAMPICINE")
    (level "CONTRE-INDICATION")
    (drugs-a "praziquantel")
    (drugs-b "rifampicine")
    (alert "Interaction PRAZIQUANTEL + RIFAMPICINE (CONTRE-INDICATION) : Diminution très importante des concentrations plasmatiques du praziquantel, avec risque d'échec du traitement, par augmentation du métabolisme hépatique du praziquantel par la rifampicine."))
  (interaction
    (title "PROGESTATIFS CONTRACEPTIFS + ULIPRISTAL")
    (level "Association DECONSEILLEE")
    (drugs-a "desogestrel" "dienogest" "drospirenone" "etonogestrel" "levonorgestrel" "medroxyprogesterone" "nomegestrol" "norelgestromine" "norethisterone" "norgestimate")
    (drugs-b "ulipristal")
    (alert "Interaction PROGESTATIFS CONTRACEPTIFS + ULIPRISTAL (Association DECONSEILLEE) : Dans l'indication contraception d'urgence : Antagonisme des effets de l’ulipristal en cas de reprise d’un contraceptif hormonal moins de 5 jours après la prise de la contraception d’urgence. Dans l’indication fibrome : Antagonisme réciproque des effets de l’ulipristal et du progestatif, avec risque d’inefficacité. Conduite à tenir : - Dans l'indication contraception d'urgence: Dans le cas où la (re)prise d’une contraception hormonale est envisagée, utiliser une contraception additionnelle de type mécanique pendant les 12 jours qui suivent la (dernière) prise de l’ulipristal (au cas où il y en aurait eu plus d’une). - Dans l’indication fibrome : Dans le cas où la (re)prise d’une contraception hormonale est envisagée, utiliser une contraception de type mécanique pendant les 7 premiers jours de la contraception hormonale."))
  (interaction
    (title "PROPAFENONE + RIFAMPICINE")
    (level "Précaution d'emploi")
    (drugs-a "propafenone")
    (drugs-b "rifampicine")
    (alert "Interaction PROPAFENONE + RIFAMPICINE (Précaution d'emploi) : Diminution des concentrations plasmatiques de la propafénone, par augmentation de son métabolisme hépatique par la rifampicine. Conduite à tenir : Surveillance clinique et ECG. S'il y a lieu, adaptation de la posologie de la propafénone pendant l'association et après l'arrêt de la rifampicine."))
  (interaction
    (title "PROPAFENONE + ROLAPITANT")
    (level "Précaution d'emploi")
    (drugs-a "propafenone")
    (drugs-b "rolapitant")
    (alert "Interaction PROPAFENONE + ROLAPITANT (Précaution d'emploi) : Augmentation des concentrations plasmatiques de propafénone avec risque de surdosage, par diminution de son métabolisme hépatique par le rolapitant. Conduite à tenir : Surveillance clinique et réduction de la posologie de la propafénone pendant le traitement par le rolapitant et après son arrêt."))
  (interaction
    (title "PROPAFENONE + TERBINAFINE")
    (level "Précaution d'emploi")
    (drugs-a "propafenone")
    (drugs-b "terbinafine")
    (alert "Interaction PROPAFENONE + TERBINAFINE (Précaution d'emploi) : Risque d'augmentation des effets indésirables de la propafénone, par diminution de son métabolisme hépatique par la terbinafine. Conduite à tenir : Surveillance clinique. Si besoin, adaptation de la posologie de la propafénone pendant le traitement par la terbinafine."))
  (interaction
    (title "PROPAFENONE + THEOPHYLLINE")
    (level "Précaution d'emploi")
    (drugs-a "propafenone")
    (drugs-b "theophylline")
    (alert "Interaction PROPAFENONE + THEOPHYLLINE (Précaution d'emploi) : Risque d’augmentation de la théophyllinémie par diminution de son métabolisme hépatique par la propafénone. Conduite à tenir : Surveillance clinique et éventuellement de la théophyllinémie."))
  (interaction
    (title "PYRIMETHAMINE + TRIMETHOPRIME")
    (level "Précaution d'emploi")
    (drugs-a "pyrimethamine")
    (drugs-b "trimethoprime")
    (alert "Interaction PYRIMETHAMINE + TRIMETHOPRIME (Précaution d'emploi) : Anémie mégaloblastique, plus particulièrement à fortes doses des deux produits (déficit en acide folique par l'association de deux 2-4 diaminopyrimidines). Conduite à tenir : Contrôle régulier de l'hémogramme et association d'un traitement par l'acide folique (injections IM régulières)."))
  (interaction
    (title "QUETIAPINE + RIFAMPICINE")
    (level "Association DECONSEILLEE")
    (drugs-a "quetiapine")
    (drugs-b "rifampicine")
    (alert "Interaction QUETIAPINE + RIFAMPICINE (Association DECONSEILLEE) : Diminution très importante des concentrations plasmatiques de quétiapine par augmentation de son métabolisme hépatique par l'inducteur, avec risque d’inefficacité."))
  (interaction
    (title "QUINIDINE + STIRIPENTOL")
    (level "Précaution d'emploi")
    (drugs-a "quinidine")
    (drugs-b "stiripentol")
    (alert "Interaction QUINIDINE + STIRIPENTOL (Précaution d'emploi) : Risque majoré de troubles du rythme ventriculaire, notamment de torsades de pointes. Conduite à tenir : Surveillance clinique."))
  (interaction
    (title "QUINIDINE + TALAZOPARIB")
    (level "Précaution d'emploi")
    (drugs-a "quinidine")
    (drugs-b "talazoparib")
    (alert "Interaction QUINIDINE + TALAZOPARIB (Précaution d'emploi) : Augmentation des concentrations de talazoparib avec risque de majoration de la toxicité. Conduite à tenir : Réduire la dose de talazoparib."))
  (interaction
    (title "QUINIDINE + TAMOXIFENE")
    (level "Association DECONSEILLEE")
    (drugs-a "quinidine")
    (drugs-b "tamoxifene")
    (alert "Interaction QUINIDINE + TAMOXIFENE (Association DECONSEILLEE) : Risque de baisse de l'efficacité du tamoxifène, par inhibition de la formation de son métabolite actif par la quinidine."))
  (interaction
    (title "QUINIDINE + TETRABENAZINE")
    (level "CONTRE-INDICATION")
    (drugs-a "quinidine")
    (drugs-b "tetrabenazine")
    (alert "Interaction QUINIDINE + TETRABENAZINE (CONTRE-INDICATION) : Augmentation possiblement très importante de l’exposition des métabolites actifs de la tétrabénazine."))
  (interaction
    (title "QUINIDINE + TRAMADOL")
    (level "Association DECONSEILLEE")
    (drugs-a "quinidine")
    (drugs-b "tramadol")
    (alert "Interaction QUINIDINE + TRAMADOL (Association DECONSEILLEE) : Diminution de l’efficacité de l’opiacé par inhibition de son métabolisme par l’inhibiteur."))
  (interaction
    (title "QUINIDINE + TRICLABENDAZOLE")
    (level "Précaution d'emploi")
    (drugs-a "quinidine")
    (drugs-b "triclabendazole")
    (alert "Interaction QUINIDINE + TRICLABENDAZOLE (Précaution d'emploi) : Risque majoré de troubles du rythme ventriculaire, notamment de torsades de pointes (inhibition du métabolisme hépatique du médicament torsadogène). Conduite à tenir : Surveillance clinique."))
  (interaction
    (title "QUINIDINE + VERAPAMIL")
    (level "Association DECONSEILLEE")
    (drugs-a "quinidine")
    (drugs-b "verapamil")
    (alert "Interaction QUINIDINE + VERAPAMIL (Association DECONSEILLEE) : Risque de majoration importante des effets hémodynamiques du vérapamil, avec hypotension et bradycardie sévères."))
  (interaction
    (title "QUINIDINE + VORICONAZOLE")
    (level "CONTRE-INDICATION")
    (drugs-a "quinidine")
    (drugs-b "voriconazole")
    (alert "Interaction QUINIDINE + VORICONAZOLE (CONTRE-INDICATION) : Risque majoré de troubles du rythme ventriculaire, notamment de torsades de pointes."))
  (interaction
    (title "QUININE + RIFAMPICINE")
    (level "Association DECONSEILLEE")
    (drugs-a "quinine")
    (drugs-b "rifampicine")
    (alert "Interaction QUININE + RIFAMPICINE (Association DECONSEILLEE) : Risque de perte de l’efficacité de la quinine par augmentation de son métabolisme hépatique par l’inducteur."))
  (interaction
    (title "RALTÉGRAVIR + RIFAMPICINE")
    (level "Association DECONSEILLEE")
    (drugs-a "raltegravir")
    (drugs-b "rifampicine")
    (alert "Interaction RALTÉGRAVIR + RIFAMPICINE (Association DECONSEILLEE) : Diminution des concentrations du raltégravir par la rifampicine. Conduite à tenir : Si l’association ne peut être évitée, un doublement de la dose de raltégravir peut être envisagé."))
  (interaction
    (title "RANOLAZINE + RIFAMPICINE")
    (level "Association DECONSEILLEE")
    (drugs-a "ranolazine")
    (drugs-b "rifampicine")
    (alert "Interaction RANOLAZINE + RIFAMPICINE (Association DECONSEILLEE) : Diminution très importante des concentrations de ranolazine."))
  (interaction
    (title "RANOLAZINE + SIMVASTATINE")
    (level "Précaution d'emploi")
    (drugs-a "ranolazine")
    (drugs-b "simvastatine")
    (alert "Interaction RANOLAZINE + SIMVASTATINE (Précaution d'emploi) : Risque majoré d'effets indésirables (concentration-dépendants) à type de rhabdomyolyse par inhibition du métabolisme de la simvastatine par la ranolazine. Conduite à tenir : Ne pas dépasser la posologie de 20 mg/j de simvastatine ou utiliser une autre statine non concernée par ce type d’interaction."))
  (interaction
    (title "REPAGLINIDE + SELPERCATINIB")
    (level "Association DECONSEILLEE")
    (drugs-a "repaglinide")
    (drugs-b "selpercatinib")
    (alert "Interaction REPAGLINIDE + SELPERCATINIB (Association DECONSEILLEE) : Augmentation importante des concentrations plasmatiques de répaglinide, avec risque d'hypoglycémie, par diminution du métabolisme du répaglinide par le selpercatinib."))
  (interaction
    (title "REPAGLINIDE + TRIMETHOPRIME")
    (level "Association DECONSEILLEE")
    (drugs-a "repaglinide")
    (drugs-b "trimethoprime")
    (alert "Interaction REPAGLINIDE + TRIMETHOPRIME (Association DECONSEILLEE) : Risque d’augmentation des concentrations plasmatiques de répaglinide par inhibition de son métabolisme hépatique par le triméthoprime. Conduite à tenir : Si l’association ne peut être évitée, surveillance clinique et biologique étroite."))
  (interaction
    (title "RÉSINES CHÉLATRICES + ROXADUSTAT")
    (level "Précaution d'emploi")
    (drugs-a "colesevelam" "colestyramine" "polystyrene sulfonate de calcium" "polystyrene sulfonate de sodium" "sevelamer")
    (drugs-b "roxadustat")
    (alert "Interaction RÉSINES CHÉLATRICES + ROXADUSTAT (Précaution d'emploi) : La prise de résine chélatrice peut diminuer l’absorption intestinale et, potentiellement, l’efficacité du roxadustat pris simultanément. Conduite à tenir : Prendre le roxadustat à distance de la résine (plus de 1 heure, si possible)."))
  (interaction
    (title "RÉTINOÏDES + AUTRES RÉTINOÏDES")
    (level "CONTRE-INDICATION")
    (drugs-a "acitretine" "alitretinoine" "isotretinoine" "tretinoine")
    (drugs-b "acitretine" "alitretinoine" "isotretinoine" "tretinoine")
    (alert "Interaction RÉTINOÏDES + AUTRES RÉTINOÏDES (CONTRE-INDICATION) : Risque de symptômes évocateurs d’une hypervitaminose A."))
  (interaction
    (title "RÉTINOÏDES + VITAMINE A")
    (level "CONTRE-INDICATION")
    (drugs-a "acitretine" "alitretinoine" "isotretinoine" "tretinoine")
    (drugs-b "vitamine a")
    (alert "Interaction RÉTINOÏDES + VITAMINE A (CONTRE-INDICATION) : Risque de symptômes évocateurs d’une hypervitaminose A."))
  (interaction
    (title "RIBAVIRINE + STAVUDINE")
    (level "Précaution d'emploi")
    (drugs-a "ribavirine")
    (drugs-b "stavudine")
    (alert "Interaction RIBAVIRINE + STAVUDINE (Précaution d'emploi) : Risque de diminution de l'efficacité de chaque antiviral, par antagonisme compétitif de la réaction de phosphorylation à l'origine des métabolites actifs. Conduite à tenir : Surveillance clinique et biologique régulière, notamment en début d'association."))
  (interaction
    (title "RIBAVIRINE + ZIDOVUDINE")
    (level "Précaution d'emploi")
    (drugs-a "ribavirine")
    (drugs-b "zidovudine")
    (alert "Interaction RIBAVIRINE + ZIDOVUDINE (Précaution d'emploi) : Risque de diminution de l'efficacité de chaque antiviral, par antagonisme compétitif de la réaction de phosphorylation à l'origine des métabolites actifs. Conduite à tenir : Surveillance clinique et biologique régulière, notamment en début d'association."))
  (interaction
    (title "RIFABUTINE + VELPATASVIR")
    (level "CONTRE-INDICATION")
    (drugs-a "rifabutine")
    (drugs-b "velpatasvir")
    (alert "Interaction RIFABUTINE + VELPATASVIR (CONTRE-INDICATION) : Diminution des concentrations plasmatiques de velpatasvir par la rifabutine, avec possible retentissement sur l’efficacité."))
  (interaction
    (title "RIFABUTINE + VORICONAZOLE")
    (level "Association DECONSEILLEE")
    (drugs-a "rifabutine")
    (drugs-b "voriconazole")
    (alert "Interaction RIFABUTINE + VORICONAZOLE (Association DECONSEILLEE) : Diminution des concentrations plasmatiques du voriconazole avec risque de perte d'efficacité, par augmentation de son métabolisme hépatique par la rifabutine d'une part, et risque d'augmentation des effets indésirables (uvéites) de la rifabutine d'autre part. Conduite à tenir : Si l'association est jugée néccessaire, surveillance clinique et adaptation de la posologie du voriconazole (en général doublée) pendant le traitement par la rifabutine."))
  (interaction
    (title "RIFAMPICINE + RIVAROXABAN")
    (level "Association DECONSEILLEE")
    (drugs-a "rifampicine")
    (drugs-b "rivaroxaban")
    (alert "Interaction RIFAMPICINE + RIVAROXABAN (Association DECONSEILLEE) : Diminution des concentrations plasmatiques de rivaroxaban, avec risque de diminution de l'effet thérapeutique."))
  (interaction
    (title "RIFAMPICINE + SIMVASTATINE")
    (level "Association DECONSEILLEE")
    (drugs-a "rifampicine")
    (drugs-b "simvastatine")
    (alert "Interaction RIFAMPICINE + SIMVASTATINE (Association DECONSEILLEE) : Diminution très importante des concentrations plasmatiques de simvastatine, par augmentation de son métabolisme hépatique par la rifampicine."))
  (interaction
    (title "RIFAMPICINE + SOTORASIB")
    (level "Association DECONSEILLEE")
    (drugs-a "rifampicine")
    (drugs-b "sotorasib")
    (alert "Interaction RIFAMPICINE + SOTORASIB (Association DECONSEILLEE) : Diminution notable des concentrations plasmatiques du sotorasib, avec risque de moindre efficacité."))
  (interaction
    (title "RIFAMPICINE + TELITHROMYCINE")
    (level "Association DECONSEILLEE")
    (drugs-a "rifampicine")
    (drugs-b "telithromycine")
    (alert "Interaction RIFAMPICINE + TELITHROMYCINE (Association DECONSEILLEE) : Diminution très importante des concentrations plasmatiques de la télithromycine, avec risque d'échec du traitement anti-infectieux, par augmentation du métabolisme hépatique de la télithromycine par la rifampicine."))
  (interaction
    (title "RIFAMPICINE + TÉNOFOVIR ALAFÉNAMIDE")
    (level "Association DECONSEILLEE")
    (drugs-a "rifampicine")
    (drugs-b "tenofovir alafenamide")
    (alert "Interaction RIFAMPICINE + TÉNOFOVIR ALAFÉNAMIDE (Association DECONSEILLEE) : Diminution des concentrations plasmatiques du ténofovir alafénamide par diminution de son absorption par la rifampicine. Conduite à tenir : Surveillance clinique pendant l’association et 1 à 2 semaines après l’arrêt de la rifampicine."))
  (interaction
    (title "RIFAMPICINE + TERBINAFINE")
    (level "Précaution d'emploi")
    (drugs-a "rifampicine")
    (drugs-b "terbinafine")
    (alert "Interaction RIFAMPICINE + TERBINAFINE (Précaution d'emploi) : Diminution des concentrations plasmatiques et de l'efficacité de la terbinafine, par augmentation de son métabolisme hépatique par la rifampicine. Conduite à tenir : Surveillance clinique. Si besoin, adaptation de la posologie de la terbinafine pendant le traitement par la rifampicine."))
  (interaction
    (title "RIFAMPICINE + THÉOPHYLLINE (ET, PAR EXTRAPOLATION, AMINOPHYLLINE)")
    (level "Précaution d'emploi")
    (drugs-a "rifampicine")
    (drugs-b "aminophylline" "theophylline")
    (alert "Interaction RIFAMPICINE + THÉOPHYLLINE (ET, PAR EXTRAPOLATION, AMINOPHYLLINE) (Précaution d'emploi) : Diminution des concentrations plasmatiques et de l'efficacité de la théophylline (augmentation de son métabolisme par induction enzymatique). Conduite à tenir : Surveillance clinique et, si besoin, de la théophyllinémie. Adapter, s'il y a lieu, la posologie de la théophylline pendant le traitement par la rifampicine et après son arrêt."))
  (interaction
    (title "RIFAMPICINE + TIAGABINE")
    (level "Précaution d'emploi")
    (drugs-a "rifampicine")
    (drugs-b "tiagabine")
    (alert "Interaction RIFAMPICINE + TIAGABINE (Précaution d'emploi) : Diminution des concentrations plasmatiques de la tiagabine par augmentation de son métabolisme hépatique. Conduite à tenir : Une augmentation de la posologie de la tiagabine peut s’avérer nécessaire en cas d’association à la rifampicine."))
  (interaction
    (title "RIFAMPICINE + TICAGRELOR")
    (level "Association DECONSEILLEE")
    (drugs-a "rifampicine")
    (drugs-b "ticagrelor")
    (alert "Interaction RIFAMPICINE + TICAGRELOR (Association DECONSEILLEE) : Diminution importante des concentrations plasmatiques de ticagrelor par augmentation de son métabolisme hépatique par la rifampicine, avec risque de diminution de l’effet thérapeutique."))
  (interaction
    (title "RIFAMPICINE + ULIPRISTAL")
    (level "Association DECONSEILLEE")
    (drugs-a "rifampicine")
    (drugs-b "ulipristal")
    (alert "Interaction RIFAMPICINE + ULIPRISTAL (Association DECONSEILLEE) : Risque de diminution de l’effet de l’ulipristal, par augmentation de son métabolisme hépatique par l’inducteur. Conduite à tenir : Préférer une alternative thérapeutique peu ou pas métabolisée."))
  (interaction
    (title "RIFAMPICINE + VALPROÏQUE (ACIDE) ET, PAR EXTRAPOLATION, VALPROMIDE")
    (level "Précaution d'emploi")
    (drugs-a "rifampicine")
    (drugs-b "valproique" "valpromide")
    (alert "Interaction RIFAMPICINE + VALPROÏQUE (ACIDE) ET, PAR EXTRAPOLATION, VALPROMIDE (Précaution d'emploi) : Risque de survenue de crises convulsives, par augmentation du métabolisme hépatique du valproate par la rifampicine. Conduite à tenir : Surveillance clinique et biologique, et adaptation éventuelle de la posologie de l'anticonvulsivant pendant le traitement par la rifampicine et après son arrêt."))
  (interaction
    (title "RIFAMPICINE + VELPATASVIR")
    (level "CONTRE-INDICATION")
    (drugs-a "rifampicine")
    (drugs-b "velpatasvir")
    (alert "Interaction RIFAMPICINE + VELPATASVIR (CONTRE-INDICATION) : Diminution des concentrations plasmatiques de velpatasvir par la rifampicine, avec possible retentissement sur l’efficacité."))
  (interaction
    (title "RIFAMPICINE + VITAMINE D")
    (level "Précaution d'emploi")
    (drugs-a "rifampicine")
    (drugs-b "alfacalcidol" "calcitriol" "cholecalciferol" "ergocalciferol")
    (alert "Interaction RIFAMPICINE + VITAMINE D (Précaution d'emploi) : Diminution des concentrations de vitamine D plus marquée qu’en l’absence de traitement par la rifampicine. Conduite à tenir : Dosage des concentrations de vitamine D et supplémentation si nécessaire."))
  (interaction
    (title "RIFAMPICINE + VORICONAZOLE")
    (level "CONTRE-INDICATION")
    (drugs-a "rifampicine")
    (drugs-b "voriconazole")
    (alert "Interaction RIFAMPICINE + VORICONAZOLE (CONTRE-INDICATION) : Diminution importante des concentrations plasmatiques du voriconazole avec risque de perte d'efficacité, par augmentation de son métabolisme hépatique par la rifampicine."))
  (interaction
    (title "RIFAMPICINE + VOXELOTOR")
    (level "Association DECONSEILLEE")
    (drugs-a "rifampicine")
    (drugs-b "voxelotor")
    (alert "Interaction RIFAMPICINE + VOXELOTOR (Association DECONSEILLEE) : Diminution notable des concentrations plasmatiques du voxelotor, avec risque de moindre efficacité."))
  (interaction
    (title "RIFAMPICINE + ZIDOVUDINE")
    (level "Association DECONSEILLEE")
    (drugs-a "rifampicine")
    (drugs-b "zidovudine")
    (alert "Interaction RIFAMPICINE + ZIDOVUDINE (Association DECONSEILLEE) : Diminution de moitié des concentrations de la zidovudine par augmentation de son métabolisme par la rifampicine. Conduite à tenir : Si l'association s'avère nécessaire, surveillance clinique et biologique renforcée."))
  (interaction
    (title "RIFAMPICINE + ZOLPIDEM")
    (level "Précaution d'emploi")
    (drugs-a "rifampicine")
    (drugs-b "zolpidem")
    (alert "Interaction RIFAMPICINE + ZOLPIDEM (Précaution d'emploi) : Diminution des concentrations plasmatiques et de l'efficacité du zolpidem par augmentation de son métabolisme hépatique par la rifampicine. Conduite à tenir : Surveillance clinique. Utiliser éventuellement un autre hypnotique."))
  (interaction
    (title "RIFAMPICINE + ZOPICLONE")
    (level "Précaution d'emploi")
    (drugs-a "rifampicine")
    (drugs-b "zopiclone")
    (alert "Interaction RIFAMPICINE + ZOPICLONE (Précaution d'emploi) : Diminution des concentrations plasmatiques et de l'efficacité de la zopiclone par augmentation de son métabolisme hépatique par la rifampicine. Conduite à tenir : Surveillance clinique. Utiliser éventuellement un autre hypnotique."))
  (interaction
    (title "ROLAPITANT + ROSUVASTATINE")
    (level "Précaution d'emploi")
    (drugs-a "rolapitant")
    (drugs-b "rosuvastatine")
    (alert "Interaction ROLAPITANT + ROSUVASTATINE (Précaution d'emploi) : Risque d’augmentation des concentrations de rosuvastatine. Conduite à tenir : Utiliser la rosuvastatine à dose minimale."))
  (interaction
    (title "ROLAPITANT + TAMOXIFENE")
    (level "Association DECONSEILLEE")
    (drugs-a "rolapitant")
    (drugs-b "tamoxifene")
    (alert "Interaction ROLAPITANT + TAMOXIFENE (Association DECONSEILLEE) : Risque de baisse de l’efficacité du tamoxifène par inhibition de la formation de son métabollite actif par le rolapitant."))
  (interaction
    (title "ROSUVASTATINE + TÉDIZOLIDE")
    (level "Association DECONSEILLEE")
    (drugs-a "rosuvastatine")
    (drugs-b "tedizolide")
    (alert "Interaction ROSUVASTATINE + TÉDIZOLIDE (Association DECONSEILLEE) : Risque d’augmentation des concentrations plasmatiques de la rosuvastatine, par augmentation de son absorption avec le tédizolide administré par voie orale, ou par diminution de son élimination avec le tédizolide administré par voie IV."))
  (interaction
    (title "ROSUVASTATINE + VELPATASVIR")
    (level "Précaution d'emploi")
    (drugs-a "rosuvastatine")
    (drugs-b "velpatasvir")
    (alert "Interaction ROSUVASTATINE + VELPATASVIR (Précaution d'emploi) : Augmentation des concentrations plasmatiques de rosuvastatine par augmentation de son absorption intestinale par le velpatasvir. Conduite à tenir : En cas d’association, ne pas dépasser 10 mg par jour de rosuvastatine."))
  (interaction
    (title "ROXITHROMYCINE + SIMVASTATINE")
    (level "Précaution d'emploi")
    (drugs-a "roxithromycine")
    (drugs-b "simvastatine")
    (alert "Interaction ROXITHROMYCINE + SIMVASTATINE (Précaution d'emploi) : Risque majoré d'effets indésirables (concentration-dépendants) à type de rhabdomyolyse. Conduite à tenir : Utiliser des doses plus faibles d’hypocholestérolémiant."))
  (interaction
    (title "ROXITHROMYCINE + SUBSTANCES SUSCEPTIBLES DE DONNER DES TORSADES DE POINTES")
    (level "Précaution d'emploi")
    (drugs-a "roxithromycine")
    (drugs-b "amiodarone" "amisulpride" "arsenieux" "chloroquine" "chlorpromazine" "citalopram" "cocaine" "crizotinib" "cyamemazine" "disopyramide" "domperidone" "dronedarone" "droperidol" "erythromycine" "escitalopram" "flupentixol" "fluphenazine" "halofantrine" "haloperidol" "hydroquinidine" "hydroxychloroquine" "hydroxyzine" "levomepromazine" "lumefantrine" "mequitazine" "methadone" "moxifloxacine" "pentamidine" "pimozide" "pipamperone" "piperaquine" "pipotiazine" "quinidine" "sotalol" "spiramycine" "sulpiride" "tiapride" "toremifene" "vandetanib" "vincamine" "zuclopenthixol")
    (alert "Interaction ROXITHROMYCINE + SUBSTANCES SUSCEPTIBLES DE DONNER DES TORSADES DE POINTES (Précaution d'emploi) : Risque majoré de troubles du rythme ventriculaire, notamment de torsades de pointes. Conduite à tenir : Surveillance clinique et électrocardiographique pendant l'association."))
  (interaction
    (title "RUFINAMIDE + VALPROÏQUE (ACIDE) ET, PAR EXTRAPOLATION, VALPROMIDE")
    (level "Précaution d'emploi")
    (drugs-a "rufinamide")
    (drugs-b "valproique" "valpromide")
    (alert "Interaction RUFINAMIDE + VALPROÏQUE (ACIDE) ET, PAR EXTRAPOLATION, VALPROMIDE (Précaution d'emploi) : Possible augmentation des concentrations de rufinamide, notamment chez l’enfant de moins de 30 kg. Conduite à tenir : Chez l’enfant de moins de 30 kg : ne pas dépasser la dose totale de 600 mg/j après la période de titration."))
  (interaction
    (title "SELEXIPAG + TÉRIFLUNOMIDE")
    (level "Précaution d'emploi")
    (drugs-a "selexipag")
    (drugs-b "teriflunomide")
    (alert "Interaction SELEXIPAG + TÉRIFLUNOMIDE (Précaution d'emploi) : Risque d’augmentation des effets indésirables du sélexipag par diminution de son métabolisme. Conduite à tenir : Surveillance clinique étroite pendant l’association. Réduire de moitié la posologie (une seule prise par jour)."))
  (interaction
    (title "SELEXIPAG + TRIMETHOPRIME")
    (level "Précaution d'emploi")
    (drugs-a "selexipag")
    (drugs-b "trimethoprime")
    (alert "Interaction SELEXIPAG + TRIMETHOPRIME (Précaution d'emploi) : Risque d’augmentation des effets indésirables du sélexipag par diminution de son métabolisme. Conduite à tenir : Surveillance clinique étroite pendant l’association. Réduire de moitié la posologie (une seule prise par jour)."))
  (interaction
    (title "SIMVASTATINE + STIRIPENTOL")
    (level "CONTRE-INDICATION")
    (drugs-a "simvastatine")
    (drugs-b "stiripentol")
    (alert "Interaction SIMVASTATINE + STIRIPENTOL (CONTRE-INDICATION) : Risque majoré d’effets indésirables (dose-dépendants) à type de rhabdomyolyse (diminution du métabolisme hépatique de l’hypocholestérolémiant)."))
  (interaction
    (title "SIMVASTATINE + VERAPAMIL")
    (level "Précaution d'emploi")
    (drugs-a "simvastatine")
    (drugs-b "verapamil")
    (alert "Interaction SIMVASTATINE + VERAPAMIL (Précaution d'emploi) : Risque majoré d’effets indésirables (dose-dépendants) à type de rhabdomyolyse (diminution du métabolisme hépatique de l’hypocholestérolémiant). Conduite à tenir : Ne pas dépasser la posologie de 20 mg/j de simvastatine ou utiliser une autre statine non concernée par ce type d’interaction."))
  (interaction
    (title "SIROLIMUS + VERAPAMIL")
    (level "Précaution d'emploi")
    (drugs-a "sirolimus")
    (drugs-b "verapamil")
    (alert "Interaction SIROLIMUS + VERAPAMIL (Précaution d'emploi) : Augmentation des concentrations sanguines du sirolimus (diminution de son métabolisme hépatique par le vérapamil). Conduite à tenir : Dosage des concentrations sanguines de l’immunosuppresseur, contrôle de la fonction rénale et adaptation de la posologie pendant l’association et après son arrêt."))
  (interaction
    (title "STAVUDINE + THALIDOMIDE")
    (level "Précaution d'emploi")
    (drugs-a "stavudine")
    (drugs-b "thalidomide")
    (alert "Interaction STAVUDINE + THALIDOMIDE (Précaution d'emploi) : Risque majoré de survenue de neuropathies périphériques par addition d'effets indésirables. Conduite à tenir : Surveillance clinique et biologique régulière, notamment en début d'association."))
  (interaction
    (title "STAVUDINE + ZIDOVUDINE")
    (level "Association DECONSEILLEE")
    (drugs-a "stavudine")
    (drugs-b "zidovudine")
    (alert "Interaction STAVUDINE + ZIDOVUDINE (Association DECONSEILLEE) : Risque de diminution de l'efficacité de chaque antiviral par antagoniste compétitif de la réaction de phosphorylation à l'origine des métabolites actifs."))
  (interaction
    (title "STIRIPENTOL + THÉOPHYLLINE (ET, PAR EXTRAPOLATION, AMINOPHYLLINE)")
    (level "Précaution d'emploi")
    (drugs-a "stiripentol")
    (drugs-b "aminophylline" "theophylline")
    (alert "Interaction STIRIPENTOL + THÉOPHYLLINE (ET, PAR EXTRAPOLATION, AMINOPHYLLINE) (Précaution d'emploi) : Augmentation possible de la théophyllinémie, avec risque de surdosage, par inhibition de son métabolisme hépatique. Conduite à tenir : Surveillance clinique, dosage plasmatique et adaptation éventuelle de la posologie de théophylline."))
  (interaction
    (title "STRONTIUM + ZINC")
    (level "Précaution d'emploi")
    (drugs-a "strontium")
    (drugs-b "zinc")
    (alert "Interaction STRONTIUM + ZINC (Précaution d'emploi) : Diminution de l'absorption digestive du strontium. Conduite à tenir : Prendre le strontium à distance des sels de zinc (plus de deux heures, si possible)."))
  (interaction
    (title "SUBSTANCES À ABSORPTION RÉDUITE PAR LES TOPIQUES GASTRO-INTESTINAUX, ANTIACIDES ET ADSORBANTS + TOPIQUES GASTRO-INTESTINAUX, ANTIACIDES ET ADSORBANTS")
    (level "ASDEC - PE")
    (drugs-a "acetylsalicylique" "alendronique" "alimemazine" "atenolol" "betamethasone" "bictegravir" "budesonide" "chlorpromazine" "chlortetracycline" "cimetidine" "ciprofloxacine" "clindamycine" "clodronique" "cortisone" "cyamemazine" "demeclocycline" "dexamethasone" "digoxine" "dolutegravir" "doxycycline" "elvitegravir" "enoxacine" "ethambutol" "etidronique" "famotidine" "fer" "fexofenadine" "fluor" "fluphenazine" "ibandronique" "isoniazide" "lansoprazole" "ledipasvir" "levofloxacine" "levomepromazine" "levothyroxine" "lincomycine" "liothyronine sodique" "lomefloxacine" "lymecycline" "methylenecycline" "methylprednisolone" "metopimazine" "metoprolol" "minocycline" "moxifloxacine" "nizatidine" "norfloxacine" "ofloxacine" "oxidronique" "oxomemazine" "oxytetracycline" "pamidronique" "pefloxacine" "penicillamine" "phosphore" "piperazine" "pipotiazine" "prednisolone" "prednisone" "proguanil" "promethazine" "propericiazine" "propranolol" "raltegravir" "ranitidine" "risedronique" "rosuvastatine" "roxadustat" "sulpiride" "teriflunomide" "tetracycline" "thyroxines" "tigecycline" "tiludronique" "tiratricol" "triamcinolone" "ulipristal" "zoledronique")
    (drugs-b "charbon active" "charbon vegetal officinal" "crospovidone" "diosmectite" "gel d'hydroxyde d'aluminium et de carbonate de magnesium codesseches" "hydrotalcite" "hydroxyde de magnesium" "kaolin lourd" "lanthane" "magaldrate" "magnesium hydroxyde" "magnesium trisilicate" "monmectite" "trisilicate de magnesium")
    (alert "Interaction SUBSTANCES À ABSORPTION RÉDUITE PAR LES TOPIQUES GASTRO-INTESTINAUX, ANTIACIDES ET ADSORBANTS + TOPIQUES GASTRO-INTESTINAUX, ANTIACIDES ET ADSORBANTS (ASDEC - PE) : Diminution de l'absorption de ces substances. Conduite à tenir : Association déconseillée: - avec les inhibiteurs d'intégrase (raltégravir, bictégravir, dolutégravir, cabotégravir) Précaution d'emploi: - avec les autres substances. Par mesure de précaution, il convient de prendre ces topiques ou antiacides à distance de tout autre médicament (plus de 2 heures, si possible)."))
  (interaction
    (title "SUBSTANCES SUSCEPTIBLES DE DONNER DES TORSADES DE POINTES + SULFAMÉTHOXAZOLE + TRIMÉTHOPRIME")
    (level "Association DECONSEILLEE")
    (drugs-a "amiodarone" "amisulpride" "arsenieux" "chloroquine" "chlorpromazine" "citalopram" "cocaine" "crizotinib" "cyamemazine" "disopyramide" "domperidone" "dronedarone" "droperidol" "erythromycine" "escitalopram" "flupentixol" "fluphenazine" "halofantrine" "haloperidol" "hydroquinidine" "hydroxychloroquine" "hydroxyzine" "levomepromazine" "lumefantrine" "mequitazine" "methadone" "moxifloxacine" "pentamidine" "pimozide" "pipamperone" "piperaquine" "pipotiazine" "quinidine" "sotalol" "spiramycine" "sulpiride" "tiapride" "toremifene" "vandetanib" "vincamine" "zuclopenthixol")
    (drugs-b "sulfamethoxazole" "trimethoprime")
    (alert "Interaction SUBSTANCES SUSCEPTIBLES DE DONNER DES TORSADES DE POINTES + SULFAMÉTHOXAZOLE + TRIMÉTHOPRIME (Association DECONSEILLEE) : Risque de troubles ventriculaires, notamment de torsades de pointes. Conduite à tenir : Contre-indication : - avec le citalopram, la dompéridone, l'escitalopram, l'hydroxyzine et la pipéraquine. Association déconseillée: - avec les autres médicaments susceptibles de donner des torsades de pointes. Si l’association ne peut être évitée, contrôle clinique et électrocardiographique régulier."))
  (interaction
    (title "SUBSTANCES SUSCEPTIBLES DE DONNER DES TORSADES DE POINTES + TORSADOGÈNES (SAUF ARSÉNIEUX, ANTIPARASITAIRES, NEUROLEPTIQUES, MÉTHADONE...)")
    (level "CI - ASDEC")
    (drugs-a "amiodarone" "amisulpride" "arsenieux" "chloroquine" "chlorpromazine" "citalopram" "cocaine" "crizotinib" "cyamemazine" "disopyramide" "domperidone" "dronedarone" "droperidol" "erythromycine" "escitalopram" "flupentixol" "fluphenazine" "halofantrine" "haloperidol" "hydroquinidine" "hydroxychloroquine" "hydroxyzine" "levomepromazine" "lumefantrine" "mequitazine" "methadone" "moxifloxacine" "pentamidine" "pimozide" "pipamperone" "piperaquine" "pipotiazine" "quinidine" "sotalol" "spiramycine" "sulpiride" "tiapride" "toremifene" "vandetanib" "vincamine" "zuclopenthixol")
    (drugs-b "amiodarone" "citalopram" "cocaine" "disopyramide" "domperidone" "dronedarone" "erythromycine" "escitalopram" "hydroquinidine" "hydroxyzine" "mequitazine" "moxifloxacine" "piperaquine" "quinidine" "sotalol" "spiramycine" "toremifene" "vandetanib" "vincamine")
    (alert "Interaction SUBSTANCES SUSCEPTIBLES DE DONNER DES TORSADES DE POINTES + TORSADOGÈNES (SAUF ARSÉNIEUX, ANTIPARASITAIRES, NEUROLEPTIQUES, MÉTHADONE...) (CI - ASDEC) : Risque majoré de troubles du rythme ventriculaire, notamment de torsades de pointes. Conduite à tenir : Contre-indication: - Pour l'érythromycine et la vincamine, seules les formes administrées par voie intraveineuse sont concernées par cette interaction. - Pour la spiramycine, la voie IV et la voie orale sont concernées. - Le citalopram, l'escitalopram, l'hydroxyzine, la dompéridone, la pipéraquinei sont contre-indiqués quel que soit le torsadogène. Association déconseillée: - avec les antiparasitaires (chloroquine, halofantrine, luméfantrine, pentamidine), les neuroleptiques, la méthadone, l'arsénieux et l'hydroxychloroquine. Si l’association ne peut être évitée, contrôle clinique et électrocardiographique régulier."))
  (interaction
    (title "SUCRALFATE + SULPIRIDE")
    (level "Précaution d'emploi")
    (drugs-a "sucralfate")
    (drugs-b "sulpiride")
    (alert "Interaction SUCRALFATE + SULPIRIDE (Précaution d'emploi) : Diminution de l'absorption digestive du sulpiride. Conduite à tenir : Prendre le sucralfate à distance du sulpiride (plus de 2 heures, si possible)."))
  (interaction
    (title "SULFASALAZINE + TÉDIZOLIDE")
    (level "Association DECONSEILLEE")
    (drugs-a "sulfasalazine")
    (drugs-b "tedizolide")
    (alert "Interaction SULFASALAZINE + TÉDIZOLIDE (Association DECONSEILLEE) : Risque d’augmentation des concentrations plasmatiques de la sulfasalazine, par augmentation de son absorption avec le tédizolide administré par voie orale."))
  (interaction
    (title "SYMPATHOMIMÉTIQUES ALPHA (VOIES ORALE ET/OU NASALE) + SYMPATHOMIMÉTIQUES INDIRECTS")
    (level "CONTRE-INDICATION")
    (drugs-a "etilefrine" "midodrine" "naphazoline" "oxymetazoline" "phenylephrine" "synephrine" "tetryzoline" "tuaminoheptane")
    (drugs-b "bupropion" "cafedrine" "ephedrine" "methylphenidate" "pseudoephedrine" "theodrenaline")
    (alert "Interaction SYMPATHOMIMÉTIQUES ALPHA (VOIES ORALE ET/OU NASALE) + SYMPATHOMIMÉTIQUES INDIRECTS (CONTRE-INDICATION) : Risque de vasoconstriction et/ou de poussées hypertensives."))
  (interaction
    (title "SYMPATHOMIMÉTIQUES INDIRECTS + AUTRES SYMPATHOMIMETIQUES INDIRECTS")
    (level "CONTRE-INDICATION")
    (drugs-a "bupropion" "cafedrine" "ephedrine" "methylphenidate" "pseudoephedrine" "theodrenaline")
    (drugs-b "bupropion" "cafedrine" "ephedrine" "methylphenidate" "pseudoephedrine" "theodrenaline")
    (alert "Interaction SYMPATHOMIMÉTIQUES INDIRECTS + AUTRES SYMPATHOMIMETIQUES INDIRECTS (CONTRE-INDICATION) : Risque de vasoconstriction et/ou de crises hypertensives."))
  (interaction
    (title "TACROLIMUS + TIGECYCLINE")
    (level "Précaution d'emploi")
    (drugs-a "tacrolimus")
    (drugs-b "tigecycline")
    (alert "Interaction TACROLIMUS + TIGECYCLINE (Précaution d'emploi) : Augmentation des concentrations sanguines de l’immunosuppresseur, avec risque d'effets néphrotoxiques. Conduite à tenir : Dosage des concentrations sanguines de l’immunosuppresseur, contrôle de la fonction rénale et adaptation de la posologie pendant le traitement par la tigécycline."))
  (interaction
    (title "TACROLIMUS + VERAPAMIL")
    (level "Précaution d'emploi")
    (drugs-a "tacrolimus")
    (drugs-b "verapamil")
    (alert "Interaction TACROLIMUS + VERAPAMIL (Précaution d'emploi) : Augmentation des concentrations sanguines du tacrolimus (diminution de son métabolisme hépatique par le verapamil). Conduite à tenir : Dosage des concentrations sanguines de l’immunosuppresseur, contrôle de la fonction rénale et adaptation de la posologie pendant l’association et après son arrêt."))
  (interaction
    (title "TALAZOPARIB + VERAPAMIL")
    (level "Précaution d'emploi")
    (drugs-a "talazoparib")
    (drugs-b "verapamil")
    (alert "Interaction TALAZOPARIB + VERAPAMIL (Précaution d'emploi) : Augmentation des concentrations de talazoparib avec risque de majoration de la toxicité. Conduite à tenir : Réduire la dose de talazoparib."))
  (interaction
    (title "TAMOXIFENE + TERBINAFINE")
    (level "Association DECONSEILLEE")
    (drugs-a "tamoxifene")
    (drugs-b "terbinafine")
    (alert "Interaction TAMOXIFENE + TERBINAFINE (Association DECONSEILLEE) : Risque de baisse de l'efficacité du tamoxifène, par inhibition de la formation de son métabolite actif par la terbinafine."))
  (interaction
    (title "TAMSULOSINE + VERAPAMIL")
    (level "Précaution d'emploi")
    (drugs-a "tamsulosine")
    (drugs-b "verapamil")
    (alert "Interaction TAMSULOSINE + VERAPAMIL (Précaution d'emploi) : Risque de majoration des effets indésirables de la tamsulosine, par inhibition de son métabolisme hépatique. Conduite à tenir : Surveillance clinique et adaptation de la posologie de la tamsulosine pensant le traitement par l’inhibiteur enzymatique et après son arrêt, le cas échéant."))
  (interaction
    (title "TÉDIZOLIDE + TOPOTECANE")
    (level "Association DECONSEILLEE")
    (drugs-a "tedizolide")
    (drugs-b "topotecane")
    (alert "Interaction TÉDIZOLIDE + TOPOTECANE (Association DECONSEILLEE) : Risque d’augmentation des concentrations plasmatiques du topotécan, par augmentation de son absorption avec le tédizolide administré par voie orale, ou par diminution de son élimination avec le tédizolide administré par voie IV."))
  (interaction
    (title "TÉNOFOVIR ALAFÉNAMIDE + VERAPAMIL")
    (level "Précaution d'emploi")
    (drugs-a "tenofovir alafenamide")
    (drugs-b "verapamil")
    (alert "Interaction TÉNOFOVIR ALAFÉNAMIDE + VERAPAMIL (Précaution d'emploi) : Augmentation des concentrations plasmatiques du ténofovir alafénamide par augmentation de son absorption. Conduite à tenir : En cas de co-administration avec le vérapamil, la dose de ténofovir alafénamide doit être limitée à 10 mg par jour."))
  (interaction
    (title "TERBINAFINE + TETRABENAZINE")
    (level "CONTRE-INDICATION")
    (drugs-a "terbinafine")
    (drugs-b "tetrabenazine")
    (alert "Interaction TERBINAFINE + TETRABENAZINE (CONTRE-INDICATION) : Augmentation, possiblement très importante, de l’exposition des métabolites actifs de la tétrabénazine."))
  (interaction
    (title "TERBINAFINE + TRAMADOL")
    (level "Association DECONSEILLEE")
    (drugs-a "terbinafine")
    (drugs-b "tramadol")
    (alert "Interaction TERBINAFINE + TRAMADOL (Association DECONSEILLEE) : Risque d’inefficacité de l’opiacé par inhibition de son métabolisme par l’inhibiteur."))
  (interaction
    (title "TÉRIFLUNOMIDE + VACCINS VIVANTS ATTÉNUÉS")
    (level "Association DECONSEILLEE")
    (drugs-a "teriflunomide")
    (drugs-b "bcg" "rotavirus" "virus de la fievre jaune" "virus de la rougeole" "virus des oreillons" "virus rubeoleux" "virus varicelle-zona" "virus vivant attenue de la grippe")
    (alert "Interaction TÉRIFLUNOMIDE + VACCINS VIVANTS ATTÉNUÉS (Association DECONSEILLEE) : Risque de maladie vaccinale généralisée, éventuellement mortelle."))
  (interaction
    (title "THEOPHYLLINE + VÉMURAFÉNIB")
    (level "Précaution d'emploi")
    (drugs-a "theophylline")
    (drugs-b "vemurafenib")
    (alert "Interaction THEOPHYLLINE + VÉMURAFÉNIB (Précaution d'emploi) : Augmentation importante des concentrations de théophylline, avec risques de majoration de ses effets indésirables. Conduite à tenir : Surveillance clinique et adaptation de la posologie de la théophylline pendant le traitement par vémurafénib et après son arrêt."))
  (interaction
    (title "THÉOPHYLLINE (ET, PAR EXTRAPOLATION, AMINOPHYLLINE) + TIABENDAZOLE")
    (level "Précaution d'emploi")
    (drugs-a "aminophylline" "theophylline")
    (drugs-b "tiabendazole")
    (alert "Interaction THÉOPHYLLINE (ET, PAR EXTRAPOLATION, AMINOPHYLLINE) + TIABENDAZOLE (Précaution d'emploi) : Augmentation de la théophyllinémie avec risque de surdosage, par diminution du métabolisme hépatique de la théophylline. Conduite à tenir : Surveillance clinique et éventuellement de la théophyllinémie ; s'il y a lieu, adaptation de la posologie de la théophylline pendant le traitement (et après son arrêt, dans le cas où l'anthelminthique est prescrit pour une durée excédant 48 heures)."))
  (interaction
    (title "THÉOPHYLLINE (ET, PAR EXTRAPOLATION, AMINOPHYLLINE) + TICLOPIDINE")
    (level "Précaution d'emploi")
    (drugs-a "aminophylline" "theophylline")
    (drugs-b "ticlopidine")
    (alert "Interaction THÉOPHYLLINE (ET, PAR EXTRAPOLATION, AMINOPHYLLINE) + TICLOPIDINE (Précaution d'emploi) : Augmentation de la théophyllinémie avec risque de surdosage (diminution de la clairance plasmatique de la théophylline). Conduite à tenir : Surveillance clinique et éventuellement de la théophyllinémie ; s'il y a lieu, adaptation de la posologie de la théophylline pendant le traitement par la ticlopidine et après son arrêt."))
  (interaction
    (title "TOLVAPTAN + VERAPAMIL")
    (level "Précaution d'emploi")
    (drugs-a "tolvaptan")
    (drugs-b "verapamil")
    (alert "Interaction TOLVAPTAN + VERAPAMIL (Précaution d'emploi) : Augmentation des concentrations de tolvaptan, avec risque de majoration importante des effets indésirables, notamment diurèse importante, déshydratation, insuffisance rénale aiguë. Conduite à tenir : Réduire la posologie de tolvaptan de moitié."))
  (interaction
    (title "TOPIRAMATE + VALPROÏQUE (ACIDE) ET, PAR EXTRAPOLATION, VALPROMIDE")
    (level "Précaution d'emploi")
    (drugs-a "topiramate")
    (drugs-b "valproique" "valpromide")
    (alert "Interaction TOPIRAMATE + VALPROÏQUE (ACIDE) ET, PAR EXTRAPOLATION, VALPROMIDE (Précaution d'emploi) : Augmentation de l'hyperammoniémie, avec risque accru d'encéphalopathie. Conduite à tenir : Surveillance clinique et biologique régulière."))
  (interaction
    (title "VALPROÏQUE (ACIDE) ET, PAR EXTRAPOLATION, VALPROMIDE + ZIDOVUDINE")
    (level "Précaution d'emploi")
    (drugs-a "valproique" "valpromide")
    (drugs-b "zidovudine")
    (alert "Interaction VALPROÏQUE (ACIDE) ET, PAR EXTRAPOLATION, VALPROMIDE + ZIDOVUDINE (Précaution d'emploi) : Risque d’augmentation des effets indésirables, notamment hématologiques, de la zidovudine par diminution de son métabolisme par l’acide valproïque. Conduite à tenir : Surveillance clinique et biologique régulière. Un hémogramme à la recherche d’une anémie devrait être réalisé au cours des deux premiers mois de l’association."))
  (interaction
    (title "VALPROÏQUE (ACIDE) ET, PAR EXTRAPOLATION, VALPROMIDE + ZONISAMIDE")
    (level "Précaution d'emploi")
    (drugs-a "valproique" "valpromide")
    (drugs-b "zonisamide")
    (alert "Interaction VALPROÏQUE (ACIDE) ET, PAR EXTRAPOLATION, VALPROMIDE + ZONISAMIDE (Précaution d'emploi) : Augmentation de l'hyperammoniémie, avec risque accru d'encéphalopathie. Conduite à tenir : Surveillance clinique et biologique régulière."))
  (interaction
    (title "VÉNÉTOCLAX + VERAPAMIL")
    (level "Précaution d'emploi")
    (drugs-a "venetoclax")
    (drugs-b "verapamil")
    (alert "Interaction VÉNÉTOCLAX + VERAPAMIL (Précaution d'emploi) : Risque d’augmentation des effets indésirables du vénétoclax par diminution de son métabolisme hépatique. Conduite à tenir : Surveillance clinique et biologique régulière, notamment hématologique, et adaptation de la posologie du vénétoclax.")))

; DDI-Predictor (ratios d'AUC observés)
(deffacts ddi-predictor
  (interaction
    (title "ABROCITINIB + FLUCONAZOLE")
    (drugs-a "abrocitinib")
    (drugs-b "fluconazole")
    (alert "Interaction pharmacocinétique ABROCITINIB + FLUCONAZOLE : AUC de ABROCITINIB multipliée par 2,54 sous fluconazole à 200 mg/j (1 étude) ; risque de surdosage et d'effets indésirables. Surveiller et adapter la posologie si besoin."))
  (interaction
    (title "ABROCITINIB + RIFAMPICINE")
    (drugs-a "abrocitinib")
    (drugs-b "rifampicine")
    (alert "Interaction pharmacocinétique ABROCITINIB + RIFAMPICINE : AUC de ABROCITINIB diminuée de 56 % (× 0,44) sous rifampicine à 450-600 mg/j (1 étude) ; risque de perte d'efficacité. Surveiller et adapter la posologie si besoin."))
