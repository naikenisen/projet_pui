// Figure 3 : système à base de connaissances (kbs.py, moteur CLIPS) ; export : dot -Tpdf figure_3.dot -o figure_3.pdf
digraph kbs {
    graph [rankdir=TB, fontname="Helvetica", fontsize=10, nodesep=0.45, ranksep=0.35, pad=0.15, newrank=true];
    node  [fontname="Helvetica", fontsize=9.5, color="#3A3A3A", penwidth=0.8,
           shape=box, style="rounded,filled", fillcolor="#E9EEF4", margin="0.16,0.08"];
    edge  [fontname="Helvetica", fontsize=8.5, color="#3A3A3A", arrowsize=0.7, penwidth=0.8];

    record [shape=note, style=filled, fillcolor="#FFFFFF", label=<<B>Patient record</B><BR/>characteristics, laboratory values<BR/>prescription lines {L<SUB>1</SUB>, …, L<SUB>n</SUB>}>];
    rules [shape=note, style=filled, fillcolor="#FFFFFF", label=<<B>Knowledge base (CLIPS)</B><BR/><FONT POINT-SIZE="8.5">base.clp: fact model, unit conversions, dose rules<BR/>generic_rules.clp: 1,877 interaction facts (ANSM, DDI-Predictor)<BR/>personalized_rules.clp: hospital rules</FONT>>];
    { rank=same; record; rules; }

    facts [label=<<B>1. Translation into facts</B> (kbs.py)<BR/>(data name value): age, weight_kg, …, Créatinine (sang), …<BR/>(treatment line quantity unit) · (ingredient line dosage unit)<BR/>(prescribed line drug): word sequences of each label>];

    subgraph cluster_engine {
        label=<<B>2. CLIPS inference engine (forward chaining)</B>>;
        labeljust=l; fontsize=9.5; style="dashed,rounded"; color="#6A6A6A"; margin=12;

        memory [fillcolor="#FFFFFF", label=<<B>Working memory</B><BR/>patient facts + interaction facts>];
        match [shape=diamond, style=filled, fillcolor="#FFFFFF", margin="0.02,0.02", fontsize=9, label=<rule patterns<BR/>matched?<BR/>(Rete)>];
        agenda [label=<<B>Agenda</B><BR/>activations ordered by salience<BR/><FONT POINT-SIZE="8.5">personalized rules before interactions</FONT>>];
        fire [label=<<B>Rule fired</B><BR/>asserts new facts>];
        derived [fillcolor="#F2F2F2", label=<<B>Deduced facts</B><BR/>daily-dose, dose-per-kg,<BR/>criteria, …>];
        alert [fillcolor="#FCEBD7", label=<<B>alert facts</B><BR/>message + prescription lines>];

        memory -> match;
        match -> agenda [label=" yes"];
        agenda -> fire;
        fire -> derived;
        fire -> alert;
        derived -> memory [style=dashed, label=" chaining"];
        { rank=same; derived; alert; }
    }

    example [shape=plain, fontsize=8.5, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#9A9A9A">
        <TR><TD ALIGN="LEFT" BGCOLOR="#FAFAFA"><I>Example of chaining (daptomycin)</I><BR ALIGN="LEFT"/>(treatment quantity 0.7 unit gramme(s))<BR ALIGN="LEFT"/>→ daily-dose 700 mg<BR ALIGN="LEFT"/>→ dose-per-kg 8.75 mg/kg (weight 80 kg)<BR ALIGN="LEFT"/>→ alert: dose &lt; 10 mg/kg/day<BR ALIGN="LEFT"/></TD></TR>
        <TR><TD ALIGN="LEFT" BGCOLOR="#FAFAFA"><I>Example rule (apixaban)</I><BR ALIGN="LEFT"/>3 rules deduce the criteria:<BR ALIGN="LEFT"/>age ≥ 80, weight ≤ 60 kg, creatinine ≥ 133 µmol/L<BR ALIGN="LEFT"/>alert if dose ≠ 2.5 mg and ≥ 2 criteria<BR ALIGN="LEFT"/></TD></TR>
        </TABLE>>];
    { rank=same; match; example; }

    output [shape=note, style=filled, fillcolor="#FFFFFF", label=<<B>Alert list A</B><BR/>one alert per message (possibly empty)<BR/><FONT POINT-SIZE="8.5">→ generation module (Figure 4)</FONT>>];

    record -> facts;
    facts -> memory [label=" assert"];
    rules -> memory [label=" load"];
    example -> match [style=dotted, arrowhead=none];
    alert -> output;
}
