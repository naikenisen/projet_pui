// Figure 2: retrieval of relevant passages for one patient (retrieval.py)
// Export: dot -Tpdf figure_2.dot -o figure_2.pdf
digraph retrieval {
    graph [rankdir=TB, fontname="Helvetica", fontsize=10, nodesep=0.4, ranksep=0.38, pad=0.15, newrank=true];
    node  [fontname="Helvetica", fontsize=9.5, color="#3A3A3A", penwidth=0.8,
           shape=box, style="rounded,filled", fillcolor="#E9EEF4", margin="0.16,0.08"];
    edge  [fontname="Helvetica", fontsize=8.5, color="#3A3A3A", arrowsize=0.7, penwidth=0.8];

    // Inputs
    record [shape=note, style=filled, fillcolor="#FFFFFF", label=<<B>Patient record</B><BR/>age, weight<BR/>laboratory values {b<SUB>1</SUB>, …, b<SUB>m</SUB>}<BR/>prescription lines {L<SUB>1</SUB>, …, L<SUB>n</SUB>}>];
    ranges [shape=note, style=filled, fillcolor="#FFFFFF", label=<<B>Reference ranges</B><BR/><FONT POINT-SIZE="8.5">lab_reference_ranges.json</FONT><BR/>[min, max], label, unit>];
    { rank=same; record; ranges; }

    // Step 1
    bio [label=<<B>1. Detection of abnormal laboratory values</B><BR/>for each referenced parameter b<SUB>j</SUB>:<BR/>value &lt; min  →  “low label (value unit)”<BR/>value &gt; max  →  “high label (value unit)”>];
    profile [shape=box, style=filled, fillcolor="#FFFFFF", label=<<B>Clinical profile T</B><BR/>“patient aged <I>age</I> years, <I>weight</I> kg [, abnormalities]”>];

    // Step 2: iteration over prescription lines
    subgraph cluster_iteration {
        label=<<B>2. For each prescription line L<SUB>i</SUB>  (i = 1, …, n)</B>>;
        labeljust=l; fontsize=9.5; style="dashed,rounded"; color="#6A6A6A"; margin=12;

        query [label=<<B>Query construction q<SUB>i</SUB></B><BR/>“INN dose unit, dosage regimen, T”>];
        embed [label=<<B>Vector encoding</B><BR/>instruction + q<SUB>i</SUB>  →  v<SUB>i</SUB><BR/><FONT POINT-SIZE="8.5">Qwen3-Embedding-8B (n queries in a single call)</FONT>>];
        knn [label=<<B>Nearest-neighbour search</B><BR/>cosine distance, k = 3<BR/>→  P<SUB>i</SUB> = {(passage, source, page, d)}>];
        query -> embed -> knn;
    }

    chroma [shape=cylinder, style=filled, fillcolor="#FFFFFF", label=<<B>ChromaDB index</B><BR/><FONT POINT-SIZE="8.5">1,500-character passages<BR/>200-character overlap</FONT>>];
    { rank=same; knn; chroma; }

    example [shape=plain, fontsize=8.5, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#9A9A9A">
        <TR><TD ALIGN="LEFT" BGCOLOR="#FAFAFA"><I>Example (PAT-0001, apixaban line):</I><BR ALIGN="LEFT"/>q = “apixaban 5 mg, 1 tablet morning and evening,<BR ALIGN="LEFT"/>patient aged 95 years, 52 kg”<BR ALIGN="LEFT"/></TD></TR>
        </TABLE>>];
    { rank=same; query; example; }

    // Step 3
    fusion [label=<<B>3. Result merging</B><BR/>union of the P<SUB>i</SUB>  (≤ 3n passages)<BR/>deduplication (minimum distance kept)<BR/>sorting by increasing distance, top 8 selected>];

    // Output
    output [shape=note, style=filled, fillcolor="#FFFFFF", label=<<B>Documentary context</B><BR/>≤ 8 excerpts “[source, page p] text”<BR/><FONT POINT-SIZE="8.5">→ generation module (Figure 4)</FONT>>];

    record -> bio;
    ranges -> bio;
    bio -> profile;
    profile -> query;
    record -> query [label=< L<SUB>i</SUB>>];
    example -> query [style=dotted, arrowhead=none];
    chroma -> knn [style=dashed];
    knn -> fusion;
    fusion -> output;
}
