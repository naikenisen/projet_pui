// Figure 4 : génération de l'avis pharmaceutique par le LLM (generation.py) ; export : dot -Tpdf figure_4.dot -o figure_4.pdf
digraph generation {
    graph [rankdir=TB, fontname="Helvetica", fontsize=10, nodesep=0.35, ranksep=0.4, pad=0.15, newrank=true];
    node  [fontname="Helvetica", fontsize=9.5, color="#3A3A3A", penwidth=0.8,
           shape=box, style="rounded,filled", fillcolor="#E9EEF4", margin="0.16,0.08"];
    edge  [fontname="Helvetica", fontsize=8.5, color="#3A3A3A", arrowsize=0.7, penwidth=0.8];

    node [shape=note, style=filled, fillcolor="#FFFFFF"];
    record  [label=<<B>Patient record</B><BR/>JSON: patient + treatments>];
    alerts  [label=<<B>Alerts A</B><BR/><FONT POINT-SIZE="8.5">KBS (Figure 3)</FONT>>];
    context [label=<<B>Documentary context</B><BR/><FONT POINT-SIZE="8.5">retrieval (Figure 2)</FONT>>];
    { rank=same; record; alerts; context; }

    node [shape=box, style="rounded,filled", fillcolor="#E9EEF4"];
    message [label=<<B>1. User message construction</B><BR/>patient record JSON<BR/>+ “KBS alerts” (if A ≠ ∅)<BR/>+ “Guideline excerpts” (if context not empty)>];

    prompt [shape=note, style=filled, fillcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1">
        <TR><TD ALIGN="LEFT"><B>System prompt</B></TD></TR>
        <TR><TD ALIGN="LEFT">role: hospital clinical pharmacist</TD></TR>
        <TR><TD ALIGN="LEFT">criteria: clinical profile (age, weight, laboratory values),</TD></TR>
        <TR><TD ALIGN="LEFT">dosages, contraindications, interactions, French guidelines</TD></TR>
        <TR><TD ALIGN="LEFT">priority given to the provided alerts and excerpts</TD></TR>
        <TR><TD ALIGN="LEFT">mandatory JSON response format, source citation</TD></TR>
        </TABLE>>];

    llm [label=<<B>2. Language model inference</B><BR/>Qwen3.6-35B-A3B (via OpenRouter)<BR/><FONT POINT-SIZE="8.5">temperature 0 · ≤ 1,024 tokens · constrained JSON output · reasoning disabled</FONT>>];
    { rank=same; llm; prompt; }

    post [label=<<B>3. Post-processing</B><BR/>extraction of the { … } substring<BR/>JSON parsing>];

    output [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#3A3A3A" BGCOLOR="#FFFFFF">
        <TR><TD COLSPAN="2" ALIGN="LEFT" BGCOLOR="#F2F2F2"><B>Pharmaceutical opinion</B></TD></TR>
        <TR><TD ALIGN="LEFT"><I>decision</I></TD><TD ALIGN="LEFT">PATIENT VALIDATED  |  PHARMACEUTICAL INTERVENTION PROPOSED</TD></TR>
        <TR><TD ALIGN="LEFT"><I>justification</I></TD><TD ALIGN="LEFT">3 to 5 sentences; in case of intervention:<BR ALIGN="LEFT"/>drug(s) involved, issue, proposed adjustment<BR ALIGN="LEFT"/></TD></TR>
        <TR><TD ALIGN="LEFT"><I>sources</I></TD><TD ALIGN="LEFT">“file.pdf, page p”, “KBS”,<BR ALIGN="LEFT"/>or empty list (model knowledge only)<BR ALIGN="LEFT"/></TD></TR>
        </TABLE>>];

    record -> message;
    alerts -> message;
    context -> message;
    message -> llm [label=" user role"];
    prompt -> llm [label="system role"];
    llm -> post;
    post -> output;
}
