// Figure 4 : génération de l'avis pharmaceutique par le LLM (generation.py) ; export : dot -Tpdf figure_4.dot -o figure_4.pdf
digraph generation {
    graph [rankdir=TB, fontname="Helvetica", fontsize=10, nodesep=0.35, ranksep=0.4, pad=0.15, newrank=true];
    node  [fontname="Helvetica", fontsize=9.5, color="#3A3A3A", penwidth=0.8,
           shape=box, style="rounded,filled", fillcolor="#E9EEF4", margin="0.16,0.08"];
    edge  [fontname="Helvetica", fontsize=8.5, color="#3A3A3A", arrowsize=0.7, penwidth=0.8];

    node [shape=note, style=filled, fillcolor="#FFFFFF"];
    record  [label=<<B>Patient record</B><BR/>JSON: patient + treatments>];
    alerts  [label=<<B>Alerts A</B><BR/><FONT POINT-SIZE="8.5">KBS (Figure 3)</FONT>>];
    context [label=<<B>Documentary context</B><BR/><FONT POINT-SIZE="8.5">retrieval (Figure 2)</FONT>>];
    { rank=same; record; alerts; context; }

    node [shape=box, style="rounded,filled", fillcolor="#E9EEF4"];
    message [label=<<B>1. User message construction</B><BR/>summarized record: lab values with (low) / (high) and date,<BR/>lines L<SUB>1</SUB>, …, L<SUB>n</SUB> with status on the reference date and computed daily dose<BR/>+ same drug on several ongoing lines (total dose)<BR/>+ KBS alerts [A1], [A2], … (if A ≠ ∅)<BR/>+ guideline excerpts [R1], [R2], … (if context not empty)>];

    prompt [shape=note, style=filled, fillcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1">
        <TR><TD ALIGN="LEFT"><B>System prompt</B></TD></TR>
        <TR><TD ALIGN="LEFT">role: French hospital clinical pharmacist</TD></TR>
        <TR><TD ALIGN="LEFT">no diagnosis in the record: each point relies on a fact,</TD></TR>
        <TR><TD ALIGN="LEFT">an alert or an excerpt</TD></TR>
        <TR><TD ALIGN="LEFT">ANSM alert levels (CI, ASDEC, PE, APEC):</TD></TR>
        <TR><TD ALIGN="LEFT">an alert never justifies an intervention on its own</TD></TR>
        <TR><TD ALIGN="LEFT">consistency checks with laboratory values and dates</TD></TR>
        <TR><TD ALIGN="LEFT">4 point types · JSON response format</TD></TR>
        </TABLE>>];

    llm [label=<<B>2. Language model inference</B><BR/>Qwen3.6-35B-A3B (via OpenRouter)<BR/><FONT POINT-SIZE="8.5">temperature 0 · reasoning enabled · ≤ 12,000 tokens · JSON output</FONT>>];
    { rank=same; llm; prompt; }

    post [label=<<B>3. Post-processing</B><BR/>JSON parsing · [A] / [R] identifiers → alerts and documents<BR/>[L] identifiers → lines to modify (interventions only)<BR/>decision = most severe point>];

    output [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#3A3A3A" BGCOLOR="#FFFFFF">
        <TR><TD COLSPAN="2" ALIGN="LEFT" BGCOLOR="#F2F2F2"><B>Pharmaceutical opinion</B></TD></TR>
        <TR><TD ALIGN="LEFT"><I>decision</I></TD><TD ALIGN="LEFT">PHARMACEUTICAL INTERVENTION  &gt;  VERIFICATION  &gt;<BR ALIGN="LEFT"/>MONITORING PROPOSED  &gt;  PATIENT VALIDATED<BR ALIGN="LEFT"/></TD></TR>
        <TR><TD ALIGN="LEFT"><I>reasoning</I></TD><TD ALIGN="LEFT">3 to 6 sentences</TD></TR>
        <TR><TD ALIGN="LEFT"><I>points</I></TD><TD ALIGN="LEFT">1 to 4, each with a type, a short proposal (≤ 40 words),<BR ALIGN="LEFT"/>its sources and the lines to modify<BR ALIGN="LEFT"/></TD></TR>
        <TR><TD ALIGN="LEFT"><I>sources</I></TD><TD ALIGN="LEFT">KBS alerts and “file.pdf, page p”,<BR ALIGN="LEFT"/>or empty (model knowledge only)<BR ALIGN="LEFT"/></TD></TR>
        </TABLE>>];

    record -> message;
    alerts -> message;
    context -> message;
    message -> llm [label=" user role"];
    prompt -> llm [label="system role"];
    llm -> post;
    post -> output;
}
