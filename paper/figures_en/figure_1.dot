// Figure 1 : architecture du pipeline ; export : dot -Tpdf figure_1.dot -o figure_1.pdf
digraph architecture {
    graph [rankdir=LR, fontname="Helvetica", nodesep=0.45, ranksep=0.55, pad=0.15, newrank=true];
    node  [fontname="Helvetica", fontsize=10, color="#3A3A3A", penwidth=0.8];
    edge  [fontname="Helvetica", fontsize=8.5, color="#3A3A3A", arrowsize=0.7, penwidth=0.8];

    node [shape=folder, style=filled, fillcolor="#FFFFFF"];
    base     [label=<<B>RAG_Docs/</B><BR/><FONT POINT-SIZE="8.5">guidelines (PDF)</FONT>>];
    patients [shape=note, label=<<B>dataset/</B><BR/><FONT POINT-SIZE="8.5">one JSON file per patient</FONT>>];
    chroma   [shape=cylinder, label=<<B>chroma_db/</B><BR/><FONT POINT-SIZE="8.5">vector index</FONT>>];
    decision [shape=note, label=<<B>LLM decision</B><BR/><FONT POINT-SIZE="8.5">decision, points, sources</FONT>>];
    base_clp           [shape=note, label=<<B>base.clp</B><BR/><FONT POINT-SIZE="8.5">fact model, dose rules</FONT>>];
    generic_rules      [shape=note, label=<<B>generic_rules.clp</B><BR/><FONT POINT-SIZE="8.5">interactions (ANSM, DDI-Predictor)</FONT>>];
    personalized_rules [shape=note, label=<<B>personalized_rules.clp</B><BR/><FONT POINT-SIZE="8.5">hospital rules</FONT>>];

    node [shape=box, style="rounded,filled", fillcolor="#E9EEF4", margin="0.18,0.08"];
    indexing [label=<<B>indexing.py</B>>];
    main       [label=<<B>main.py</B><BR/><FONT POINT-SIZE="8.5">orchestration</FONT>>];
    retrieval      [label=<<B>retrieval.py</B><BR/><FONT POINT-SIZE="8.5">guideline passages</FONT>>];
    kbs        [label=<<B>kbs.py</B><BR/><FONT POINT-SIZE="8.5">KBS alerts</FONT>>];
    generation [label=<<B>generation.py</B>>];
    create_rule [label=<<B>create_rule.py</B><BR/><FONT POINT-SIZE="8.5">new KBS rules (LLM)</FONT>>];

    { rank=same; base; patients; create_rule; }
    { rank=same; indexing; main; base_clp; generic_rules; personalized_rules; }
    { rank=same; chroma; retrieval; kbs; }

    // Invisible edges keep the vertical order: RAG on top, rules at the bottom
    edge [style=invis];
    base -> patients -> create_rule;
    indexing -> main -> base_clp -> generic_rules -> personalized_rules;
    chroma -> retrieval -> kbs;
    edge [style=solid];

    base -> indexing -> chroma;
    chroma -> retrieval [style=dashed, label="read"];

    patients -> main;
    main -> generation;
    main -> retrieval;
    main -> kbs;
    retrieval -> generation;
    kbs -> generation;
    create_rule -> personalized_rules [label="new rule"];
    base_clp -> kbs [style=dashed];
    generic_rules -> kbs [style=dashed];
    personalized_rules -> kbs [style=dashed, label="read"];
    generation -> decision;
}
