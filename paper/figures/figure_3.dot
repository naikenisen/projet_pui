// Figure 3 : système expert à base de règles (expert_system.py)
// Export : dot -Tpdf figure_3.dot -o figure_3.pdf
digraph systeme_expert {
    graph [rankdir=TB, fontname="Helvetica", fontsize=10, nodesep=0.45, ranksep=0.35, pad=0.15, newrank=true];
    node  [fontname="Helvetica", fontsize=9.5, color="#3A3A3A", penwidth=0.8,
           shape=box, style="rounded,filled", fillcolor="#E9EEF4", margin="0.16,0.08"];
    edge  [fontname="Helvetica", fontsize=8.5, color="#3A3A3A", arrowsize=0.7, penwidth=0.8];

    // Entrées
    dossier [shape=note, style=filled, fillcolor="#FFFFFF", label=<<B>Dossier patient</B><BR/>caractéristiques, biologie<BR/>lignes de prescription {L<SUB>1</SUB>, …, L<SUB>n</SUB>}>];
    regles [shape=note, style=filled, fillcolor="#FFFFFF", label=<<B>Base de règles</B><BR/><FONT POINT-SIZE="8.5">regles_expert.json</FONT><BR/>{r<SUB>1</SUB>, …, r<SUB>R</SUB>}>];
    { rank=same; dossier; regles; }

    // Étape 1
    variables [label=<<B>1. Extraction des variables</B><BR/>patient : age, sexe, poids_kg, taille_cm<BR/>biologie : HbA1c_pourcent, creatinine_serique, …<BR/>dose_<I>DCI</I> = dosage de chaque ligne L<SUB>i</SUB><BR/>D = ensemble des DCI prescrites>];

    // Étape 2 : itération sur les règles
    subgraph cluster_regles {
        label=<<B>2. Pour chaque règle r  (r = 1, …, R)</B>>;
        labeljust=l; fontsize=9.5; style="dashed,rounded"; color="#6A6A6A"; margin=12;

        node [shape=diamond, style=filled, fillcolor="#FFFFFF", margin="0.02,0.02", fontsize=9];
        t1 [label=<médicaments(r) ⊆ D ?>];
        t2 [label=<toutes les<BR/>conditions(r)<BR/>vérifiées ?>];
        t3 [label=<nb de critères<BR/>parmi(r) vérifiés<BR/>≥ minimum(r) ?>];

        node [shape=box, style="rounded,filled", margin="0.16,0.08", fontsize=9.5];
        alerte [fillcolor="#FCEBD7", label=<<B>Règle déclenchée</B><BR/>ajout de alerte(r) à A>];
        rejet  [fillcolor="#F2F2F2", label=<<B>Règle non déclenchée</B>>];

        t1 -> t2 [label=" oui"];
        t2 -> t3 [label=" oui"];
        t3 -> alerte [label=" oui"];
        t1 -> rejet [label="non"];
        t2 -> rejet [label="non"];
        t3 -> rejet [label="non"];
        { rank=same; t2; rejet; }
    }

    syntaxe [shape=plain, fontsize=8.5, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#9A9A9A">
        <TR><TD ALIGN="LEFT" BGCOLOR="#FAFAFA"><I>Évaluation d'une condition</I><BR ALIGN="LEFT"/>« variable opérateur seuil »<BR ALIGN="LEFT"/>opérateurs : ≥  ≤  &gt;  &lt;  =  ≠<BR ALIGN="LEFT"/>variable absente du dossier → faux<BR ALIGN="LEFT"/>champ absent de la règle → test vérifié<BR ALIGN="LEFT"/></TD></TR>
        <TR><TD ALIGN="LEFT" BGCOLOR="#FAFAFA"><I>Exemple de règle (apixaban)</I><BR ALIGN="LEFT"/>médicaments : apixaban<BR ALIGN="LEFT"/>conditions : dose_apixaban ≠ 2,5<BR ALIGN="LEFT"/>≥ 2 parmi : age ≥ 80, poids_kg ≤ 60,<BR ALIGN="LEFT"/>creatinine_serique ≥ 133<BR ALIGN="LEFT"/></TD></TR>
        </TABLE>>];
    { rank=same; t1; syntaxe; }

    // Sortie
    sortie [shape=note, style=filled, fillcolor="#FFFFFF", label=<<B>Liste des alertes A</B><BR/>messages des règles déclenchées (éventuellement vide)<BR/><FONT POINT-SIZE="8.5">→ module de génération (figure 4)</FONT>>];

    dossier -> variables;
    variables -> t1 [label=" variables, D"];
    regles -> t1 [label=" r"];
    syntaxe -> t1 [style=dotted, arrowhead=none];
    alerte -> sortie;
}
