// Figure 1 : architecture du pipeline (liens entre les scripts, cf. README.md)
// Export : dot -Tpdf figure_1.dot -o figure_1.pdf
digraph architecture {
    graph [rankdir=LR, fontname="Helvetica", nodesep=0.45, ranksep=0.55, pad=0.15, newrank=true];
    node  [fontname="Helvetica", fontsize=10, color="#3A3A3A", penwidth=0.8];
    edge  [fontname="Helvetica", fontsize=8.5, color="#3A3A3A", arrowsize=0.7, penwidth=0.8];

    // Données
    node [shape=folder, style=filled, fillcolor="#FFFFFF"];
    base     [label=<<B>base_documentaire/</B><BR/><FONT POINT-SIZE="8.5">recommandations (PDF)</FONT>>];
    patients [shape=note, label=<<B>input.json</B><BR/><FONT POINT-SIZE="8.5">patients et prescriptions</FONT>>];
    chroma   [shape=cylinder, label=<<B>chroma_db/</B><BR/><FONT POINT-SIZE="8.5">index vectoriel</FONT>>];
    decision [shape=note, label=<<B>Décision du LLM</B><BR/><FONT POINT-SIZE="8.5">avis, justification, sources</FONT>>];

    // Scripts
    node [shape=box, style="rounded,filled", fillcolor="#E9EEF4", margin="0.18,0.08"];
    indexation [label=<<B>indexation.py</B>>];
    main       [label=<<B>main.py</B><BR/><FONT POINT-SIZE="8.5">orchestration</FONT>>];
    recup      [label=<<B>recuperation.py</B><BR/><FONT POINT-SIZE="8.5">passages des recommandations</FONT>>];
    expert     [label=<<B>expert_system.py</B><BR/><FONT POINT-SIZE="8.5">alertes</FONT>>];
    generation [label=<<B>generation.py</B>>];

    { rank=same; base; patients; }
    { rank=same; indexation; main; }
    { rank=same; chroma; recup; expert; }

    base -> indexation -> chroma;
    chroma -> recup [style=dashed, label="lecture"];

    patients -> main;
    main -> recup;
    main -> expert;
    recup -> generation;
    expert -> generation;
    generation -> decision;
}
