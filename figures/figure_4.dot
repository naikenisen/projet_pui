// Figure 4 : génération de l'avis pharmaceutique par le LLM (generation.py)
// Export : dot -Tpdf figure_4.dot -o figure_4.pdf
digraph generation {
    graph [rankdir=TB, fontname="Helvetica", fontsize=10, nodesep=0.35, ranksep=0.4, pad=0.15, newrank=true];
    node  [fontname="Helvetica", fontsize=9.5, color="#3A3A3A", penwidth=0.8,
           shape=box, style="rounded,filled", fillcolor="#E9EEF4", margin="0.16,0.08"];
    edge  [fontname="Helvetica", fontsize=8.5, color="#3A3A3A", arrowsize=0.7, penwidth=0.8];

    // Entrées
    node [shape=note, style=filled, fillcolor="#FFFFFF"];
    dossier  [label=<<B>Dossier patient</B><BR/>JSON : patient + traitements>];
    alertes  [label=<<B>Alertes A</B><BR/><FONT POINT-SIZE="8.5">système expert (figure 3)</FONT>>];
    contexte [label=<<B>Contexte documentaire</B><BR/><FONT POINT-SIZE="8.5">récupération (figure 2)</FONT>>];
    { rank=same; dossier; alertes; contexte; }

    // Étape 1
    node [shape=box, style="rounded,filled", fillcolor="#E9EEF4"];
    message [label=<<B>1. Construction du message utilisateur</B><BR/>JSON du dossier<BR/>+ « Alertes du système expert » (si A ≠ ∅)<BR/>+ « Extraits des recommandations » (si contexte non vide)>];

    prompt [shape=note, style=filled, fillcolor="#FFFFFF", label=<<TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1">
        <TR><TD ALIGN="LEFT"><B>Prompt système</B></TD></TR>
        <TR><TD ALIGN="LEFT">rôle : pharmacien clinicien hospitalier</TD></TR>
        <TR><TD ALIGN="LEFT">critères : terrain (âge, poids, biologie), posologies,</TD></TR>
        <TR><TD ALIGN="LEFT">contre-indications, interactions, recommandations françaises</TD></TR>
        <TR><TD ALIGN="LEFT">priorité aux alertes et aux extraits fournis</TD></TR>
        <TR><TD ALIGN="LEFT">format de réponse JSON imposé, citation des sources</TD></TR>
        </TABLE>>];

    // Étape 2
    llm [label=<<B>2. Inférence du modèle de langage</B><BR/>Qwen3.6-35B-A3B (via OpenRouter)<BR/><FONT POINT-SIZE="8.5">température 0 · ≤ 1 024 tokens · sortie JSON contrainte · raisonnement désactivé</FONT>>];
    { rank=same; llm; prompt; }

    // Étape 3
    post [label=<<B>3. Post-traitement</B><BR/>extraction de la sous-chaîne { … }<BR/>analyse JSON>];

    // Sortie
    sortie [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#3A3A3A" BGCOLOR="#FFFFFF">
        <TR><TD COLSPAN="2" ALIGN="LEFT" BGCOLOR="#F2F2F2"><B>Avis pharmaceutique</B></TD></TR>
        <TR><TD ALIGN="LEFT"><I>decision</I></TD><TD ALIGN="LEFT">PATIENT VALIDÉ  |  INTERVENTION PHARMACEUTIQUE PROPOSÉE</TD></TR>
        <TR><TD ALIGN="LEFT"><I>justification</I></TD><TD ALIGN="LEFT">3 à 5 phrases ; en cas d'intervention :<BR ALIGN="LEFT"/>médicament(s) en cause, problème, adaptation proposée<BR ALIGN="LEFT"/></TD></TR>
        <TR><TD ALIGN="LEFT"><I>sources</I></TD><TD ALIGN="LEFT">« fichier.pdf, page p », « système expert »,<BR ALIGN="LEFT"/>ou liste vide (connaissances du modèle seules)<BR ALIGN="LEFT"/></TD></TR>
        </TABLE>>];

    dossier -> message;
    alertes -> message;
    contexte -> message;
    message -> llm [label=" rôle user"];
    prompt -> llm [label="rôle system"];
    llm -> post;
    post -> sortie;
}
