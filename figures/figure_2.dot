// Figure 2 : récupération des passages pertinents pour un patient (recuperation.py)
// Export : dot -Tpdf figure_2.dot -o figure_2.pdf
digraph recuperation {
    graph [rankdir=TB, fontname="Helvetica", fontsize=10, nodesep=0.4, ranksep=0.38, pad=0.15, newrank=true];
    node  [fontname="Helvetica", fontsize=9.5, color="#3A3A3A", penwidth=0.8,
           shape=box, style="rounded,filled", fillcolor="#E9EEF4", margin="0.16,0.08"];
    edge  [fontname="Helvetica", fontsize=8.5, color="#3A3A3A", arrowsize=0.7, penwidth=0.8];

    // Entrées
    dossier [shape=note, style=filled, fillcolor="#FFFFFF", label=<<B>Dossier patient</B><BR/>âge, poids<BR/>biologie {b<SUB>1</SUB>, …, b<SUB>m</SUB>}<BR/>lignes de prescription {L<SUB>1</SUB>, …, L<SUB>n</SUB>}>];
    normes [shape=note, style=filled, fillcolor="#FFFFFF", label=<<B>Valeurs de référence</B><BR/><FONT POINT-SIZE="8.5">bio_anormale.json</FONT><BR/>[min, max], libellé, unité>];
    { rank=same; dossier; normes; }

    // Étape 1
    bio [label=<<B>1. Détection des anomalies biologiques</B><BR/>pour chaque paramètre b<SUB>j</SUB> référencé :<BR/>valeur &lt; min  →  « libellé basse (valeur unité) »<BR/>valeur &gt; max  →  « libellé élevée (valeur unité) »>];
    terrain [shape=box, style=filled, fillcolor="#FFFFFF", label=<<B>Terrain T</B><BR/>« patient de <I>âge</I> ans, <I>poids</I> kg [, anomalies] »>];

    // Étape 2 : itération sur les lignes de prescription
    subgraph cluster_iteration {
        label=<<B>2. Pour chaque ligne de prescription L<SUB>i</SUB>  (i = 1, …, n)</B>>;
        labeljust=l; fontsize=9.5; style="dashed,rounded"; color="#6A6A6A"; margin=12;

        requete [label=<<B>Construction de la requête q<SUB>i</SUB></B><BR/>« DCI dosage unité, posologie, T »>];
        embed [label=<<B>Encodage vectoriel</B><BR/>instruction + q<SUB>i</SUB>  →  v<SUB>i</SUB><BR/><FONT POINT-SIZE="8.5">Qwen3-Embedding-8B (n requêtes en un appel)</FONT>>];
        knn [label=<<B>Recherche des plus proches voisins</B><BR/>distance cosinus, k = 3<BR/>→  P<SUB>i</SUB> = {(passage, source, page, d)}>];
        requete -> embed -> knn;
    }

    chroma [shape=cylinder, style=filled, fillcolor="#FFFFFF", label=<<B>Index ChromaDB</B><BR/><FONT POINT-SIZE="8.5">passages de 1 500 caractères<BR/>chevauchement de 200</FONT>>];
    { rank=same; knn; chroma; }

    exemple [shape=plain, fontsize=8.5, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#9A9A9A">
        <TR><TD ALIGN="LEFT" BGCOLOR="#FAFAFA"><I>Exemple (PAT-0001, ligne apixaban) :</I><BR ALIGN="LEFT"/>q = « apixaban 5 mg, 1 cp matin et soir,<BR ALIGN="LEFT"/>patient de 95 ans, 52 kg »<BR ALIGN="LEFT"/></TD></TR>
        </TABLE>>];
    { rank=same; requete; exemple; }

    // Étape 3
    fusion [label=<<B>3. Fusion des résultats</B><BR/>union des P<SUB>i</SUB>  (≤ 3n passages)<BR/>dédoublonnage (distance minimale conservée)<BR/>tri par distance croissante, sélection des 8 premiers>];

    // Sortie
    sortie [shape=note, style=filled, fillcolor="#FFFFFF", label=<<B>Contexte documentaire</B><BR/>≤ 8 extraits « [source, page p] texte »<BR/><FONT POINT-SIZE="8.5">→ module de génération (figure 4)</FONT>>];

    dossier -> bio;
    normes -> bio;
    bio -> terrain;
    terrain -> requete;
    dossier -> requete [label=< L<SUB>i</SUB>>];
    exemple -> requete [style=dotted, arrowhead=none];
    chroma -> knn [style=dashed];
    knn -> fusion;
    fusion -> sortie;
}
